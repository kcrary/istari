
structure Foo =
struct

fun pr f (x, y) =
   (
   print "(";
   print (f x);
   print ", ";
   print (f y);
   print ")\n"
   )

val pri = pr Int.toString
val prii = pr IntInf.toString

val () = pri (Int.ediv 3 2, Int.mod 3 2)
val () = pri (Int.divmod 3 2)
val () = pri (Int.ediv ~3 2, Int.mod ~3 2)
val () = pri (Int.divmod ~3 2)
val () = pri (Int.ediv 3 ~2, Int.mod 3 ~2)
val () = pri (Int.divmod 3 ~2)
val () = pri (Int.ediv ~3 ~2, Int.mod ~3 ~2)
val () = pri (Int.divmod ~3 ~2)
val () = prii (IntInf.ediv 3I 2I, IntInf.mod 3I 2I)
val () = prii (IntInf.divmod 3I 2I)
val () = prii (IntInf.ediv ~3I 2I, IntInf.mod ~3I 2I)
val () = prii (IntInf.divmod ~3I 2I)
val () = prii (IntInf.ediv 3I ~2I, IntInf.mod 3I ~2I)
val () = prii (IntInf.divmod 3I ~2I)
val () = prii (IntInf.ediv ~3I ~2I, IntInf.mod ~3I ~2I)
val () = prii (IntInf.divmod ~3I ~2I)

end
