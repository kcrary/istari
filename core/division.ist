
File.import "bool-load.iml";
File.import "logic-load.iml";
File.import "nat-load.iml";
File.import "omega-load.iml";
File.import "tuple-load.iml";
File.import "integer-load.iml";

openModule /Nat/;

aliasModule /Z/ /Integer/;

beginModule "Division";



define /pos/
/
  { n : nat | 0 < n }
//
  U 0
/;

unfold /pos/.
typecheck.
qed ();
setOpacity /pos/ Constant.SOFT;



definerec /div a b/
/
  if a <? b then
    0
  else
    succ (div (a - b) b)
//
  nat -> pos -> nat
/;

introOf /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /div/.
boolCase /a <? b/ /Hlt/ >> auto.
typecheck.
apply /IH/.
omega.
qed ();



definerec /mod a b/
/
  if a <? b then
    a
  else
    mod (a - b) b
//
  nat -> pos -> nat
/;

introOf /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /mod/.
boolCase /a <? b/ /Hlt/ >> auto.
typecheck.
apply /IH/.
omega.
qed ();



definerec /divmod a b/
/
  if a <? b then
    (0, a)
  else
    (let (q, r) = divmod (a - b) b
     in
       (succ q, r))
//
  nat -> pos -> nat & nat
/;

introOf /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /divmod/.
boolCase /a <? b/ /Hlt/ >> auto.
typecheck.
apply /IH/.
omega.
qed ();



lemma "divmod_equal"
/
  forall a (b : pos) .
    divmod a b = (div a b, mod a b) : (nat & nat)
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /divmod, div, mod/.
boolCase /a <? b/ /Hlt/ >> auto.
exploit /IH (a - b)/ /Heq/.
  {
  omega.
  }
rewrite /-> Heq/.
reduce //.
reflexivity.
qed ();



lemma "mod_lt_r"
/
  forall a (b : pos) .
    mod a b < b
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /mod/.
boolCase /a <? b/ /Hlt/ >> auto.
apply /IH/.
omega.
qed ();



lemma "div_prop"
/
  forall a (b : pos) .
    div a b * b + mod a b = a : nat
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /div, mod/.
boolCase /a <? b/ /Hlt/ >> auto.
so /IH (a - b) __/ /H/.
  {
  omega.
  }
omega.
qed ();



lemma "div_prop'"
/
  forall a (b : pos) .
    div a b * b = a - mod a b : nat
/;

inference.
intro /a b/.
rewrite /<- div_prop a b at 1/.
rewrite /-> plus_minus_cancel_r/.
reflexivity.
qed ();



lemma "mod_prop"
/
  forall a (b : pos) .
    mod a b = a - div a b * b : nat
/;

inference.
intro /a b/.
so /div_prop a b/ /H/.
omega.
qed ();



lemma "division_property"
/
  forall a (b : pos) q r .
    a = q * b + r : nat
    -> r < b
    -> div a b = q : nat & mod a b = r : nat
/;

inference.
intro /a b q r Hq Hr/.
destruct /b/ /b Hpos/.
revert /q Hq/.
sinduction /a/.
reintro /IH/.
intro /q Hq/.
unroll /div, mod/.
boolCase /a <? b/ /Hlt/.
  {
  destruct /q/ /| q/ >> auto.
  exfalso.
  reduce /Hq/.
    omega.
  }

  {
  assert /0 < q/ /Hposq/.
    {
    so /eq_nat_decide q 0/ /Heq | Hneq/.
      {
      subst /q/.
      reduce /Hq/.
      omega.
      }

      {
      omega.
      }
    }
  so /IH (a - b) __ (pred q) __/ /Hdiv Hmod/.
    {
    omega.
    }

    {
    rewrite /-> times_dist_pred_l/.
    assert /b <= q * b/ /Hleq/.
      {
      rewrite /<- times_1_l b/.
      apply /times_leq 1/ >> auto.
      omega.
      }
    omega.
    }
  omega.
  }
qed ();



lemma "division_unique"
/
  forall a (b : pos) q q' r r' .
    a = q * b + r : nat
    -> a = q' * b + r' : nat
    -> r < b
    -> r' < b
    -> q = q' : nat & r = r' : nat
/;

inference.
intro /a b q q' r r' Ha Ha' Hr Hr'/.
so /division_property _# 4 Ha Hr/ /Hdiv Hmod/.
so /division_property _# 4 Ha' Hr'/ /Hdiv' Hmod'/.
omega.
qed ();



lemma "div_leq_l"
/
  forall a (b : pos) .
    div a b <= a
/;

inference.
intro /a b/.
rewrite /<- div_prop a b at 1/.
apply /leq_trans _ (div a b * b)/.
1:{
  omega.
  }
rewrite /<- times_1_r (div a b)/.
apply /times_leq/ >> auto.
destruct /b/ /b Hpos/.
unhide.
omega.
qed ();



lemma "mod_leq_l"
/
  forall a (b : pos) .
    mod a b <= a
/;

inference.
intro /a b/.
rewrite /<- div_prop a b at 1/.
omega.
qed ();



lemma "div_times_r"
/
  forall a (b : pos) .
    div (a * b) b = a : nat
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
induction /a/.
  {
  unroll /div/.
  boolEq true /0 <? b/ >> auto.
  }
intro /a IH/.
unroll /div/.
boolEq false /b + a * b <? b/.
  {
  omega.
  }
rewrite /b + a * b - b = a * b : nat/.
  {
  omega.
  }
auto.
qed ();



lemma "div_times_l"
/
  forall a (b : pos) .
    div (b * a) b = a : nat
/;

inference.
intro /a b/.
rewrite /-> times_commute/.
apply /div_times_r/.
qed ();



lemma "mod_times_r"
/
  forall a (b : pos) .
    mod (a * b) b = 0 : nat
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
induction /a/.
  {
  unroll /mod/.
  boolEq true /0 <? b/ >> auto.
  }
intro /a IH/.
unroll /mod/.
boolEq false /b + a * b <? b/.
  {
  omega.
  }
rewrite /b + a * b - b = a * b : nat/.
  {
  omega.
  }
auto.
qed ();



lemma "mod_times_l"
/
  forall a (b : pos) .
    mod (b * a) b = 0 : nat
/;

inference.
intro /a b/.
rewrite /-> times_commute/.
apply /mod_times_r/.
qed ();



lemma "div_0"
/
  forall (a : pos) . div 0 a = 0 : nat
/;

intro /a/.
rewrite /<- times_0_r a/.
rewrite /-> div_times_l/.
auto.
qed ();



lemma "mod_0"
/
  forall (a : pos) . mod 0 a = 0 : nat
/;

intro /a/.
rewrite /-> mod_prop/.
rewrite /-> div_0/.
omega.
qed ();



lemma "div_1"
/
  forall a . div a 1 = a : nat
/;

inference.
intro /a/.
assertThen /0 < 1/ /Hpos/ omega.
rewrite /<- times_1_r a/.
rewrite /-> div_times_r/.
auto.
qed ();



lemma "mod_1"
/
  forall a . mod a 1 = 0 : nat
/;

inference.
intro /a/.
assertThen /0 < 1/ /Hpos/ omega.
rewrite /-> mod_prop/.
rewrite /-> div_1/.
omega.
qed ();



lemma "div_self"
/
  forall (a : pos) . div a a = 1 : nat
/;

inference.
intro /a/.
rewrite /<- times_1_r a/.
rewrite /-> div_times_l/.
auto.
qed ();



lemma "mod_self"
/
  forall (a : pos) . mod a a = 0 : nat
/;

inference.
intro /a/.
rewrite /-> mod_prop/.
rewrite /-> div_self/.
omega.
qed ();



lemma "div_operands_lt"
/
  forall a (b : pos) .
    a < b
    -> div a b = 0 : nat
/;

inference.
intro /a b Hlt/.
unroll /div/.
boolEq true /a <? b/ >> auto.
qed ();



lemma "mod_operands_lt"
/
  forall a (b : pos) .
    a < b
    -> mod a b = a : nat
/;

inference.
intro /a b Hlt/.
unroll /mod/.
boolEq true /a <? b/ >> auto.
qed ();



lemma "div_mono"
/
  forall a b (c : pos) .
    a <= b
    -> div a c <= div b c
/;

inference.
intro /a/.
sinduction /a/.
reintro /IH/.
intro /b c Hab/.
unroll /div/.
boolCase /a <? c/ /Hsmalla/.
  {
  omega.
  }
unroll /div at 1/.
boolCase /b <? c/ /Hsmallb/.
  {
  exfalso.
  omega.
  }
apply /leq_succ_succ/.
apply /IH/.
  {
  destruct /c/ /c Hpos/.
  unhide.
  omega.
  }

  {
  omega.
  }
qed ();



lemma "mod_idem"
/
  forall a (b : pos) .
    mod a b = mod (mod a b) b : nat
/;

inference.
intro /a b/.
symmetry.
apply /mod_operands_lt/.
apply /mod_lt_r/.
qed ();



lemma "div_plus_r"
/
  forall a (b : pos) .
    div (a + b) b = succ (div a b) : nat
/;

inference.
intro /a b/.
unroll /div/.
boolEq false /a + b <? b/.
  {
  omega.
  }
compat.
compat.
omega.
qed ();



lemma "div_plus_l"
/
  forall a (b : pos) .
    div (b + a) b = succ (div a b) : nat
/;

inference.
intro /a b/.
rewrite /-> plus_commute/.
apply /div_plus_r/.
qed ();



lemma "mod_plus_r"
/
  forall a (b : pos) .
    mod (a + b) b = mod a b : nat
/;

inference.
intro /a b/.
unroll /mod/.
boolEq false /a + b <? b/.
  {
  omega.
  }
compat.
omega.
qed ();



lemma "mod_plus_l"
/
  forall a (b : pos) .
    mod (b + a) b = mod a b : nat
/;

inference.
intro /a b/.
rewrite /-> plus_commute/.
apply /mod_plus_r/.
qed ();



lemma "times_div_l"
/
  forall a (b : pos) .
    div a b * b = a - mod a b : nat
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
sinduction /a/.
reintro /IH/.
unroll /div, mod/.
boolCase /a <? b/ /Hlt/.
  {
  omega.
  }

  {
  rewrite /-> IH (a - b) __/.
    {
    omega.
    }
  so /mod_leq_l (a - b) b/ /Hleq/.
  omega.
  }
qed ();



lemma "times_div_r"
/
  forall a (b : pos) .
    b * div a b = a - mod a b : nat
/;

inference.
intro /a b/.
rewrite /-> times_commute/.
apply /times_div_l/.
qed ();



lemma "div_assoc_with_remainder"
/
  forall a (b c : pos) .
    div (div a b) c = div a (b * c) : nat
    & mod (div a b) c * b + mod a b = mod a (b * c) : nat
/;

inference.
intro /a b c/.
destruct /b/ /b Hposb/.
destruct /c/ /c Hposc/.
unhide.
assert /0 < b * c/ /Hposbc/.
  {
  assert /1 * 1 <= b * c/ /H/ >>> [idtac, omega].
  apply /times_leq 1 _ 1/ >> omega.
  }
apply /division_unique a (b * c)/.
  {
  rewrite /<- div_prop a b/.
  rewrite /<- div_prop (div a b) c/.
  rewrite /-> times_dist_plus_l/.
  rewrite /-> times_assoc/.
  rewrite /-> times_commute at 1/.
  rewrite /<- plus_assoc/.
  reflexivity.
  }

  {
  symmetry.
  apply /div_prop/.
  }

  {
  apply /lt_leq_trans _ (mod (div a b) c * b + b)/.
    {
    so /mod_lt_r a b/ /H/.
    omega.
    }
  rewrite /<- times_1_l b at 2/.
  rewrite /<- times_dist_plus_l _ 1 b/.
  rewrite /-> times_commute/.
  apply /times_leq/ >> auto.
  so /mod_lt_r (div a b) c/ /H/.
  omega.
  }

  {
  apply /mod_lt_r/.
  }
qed ();



lemma "div_assoc"
/
  forall a (b c : pos) .
    div (div a b) c = div a (b * c) : nat
/;

inference.
intro /a b c/.
apply /div_assoc_with_remainder/.
qed ();



lemma "div_assoc_remainder"
/
  forall a (b c : pos) .
    mod (div a b) c * b + mod a b = mod a (b * c) : nat
/;

inference.
intro /a b c/.
apply /div_assoc_with_remainder/.
qed ();




(* Divides *)

define /divides a b/
/
  exists n . a * n = b : nat
//
  nat -> nat -> U 0
/;

unfold /divides/.
typecheck.
qed ();



lemma "divides_iff_modulus"
/
  forall (a : pos) b .
    divides a b <-> mod b a = 0 : nat
/;

inference.
intro /a b/.
split.
  {
  intro /Hdiv/.
  destruct /Hdiv/ /n Heq/.
  subst /b/.
  apply /mod_times_l/.
  }

  {
  intro /Heq/.
  unfold /divides/.
  exists /div b a/.
  rewrite /-> times_div_r/.
  omega.
  }
qed ();



lemma "divides_1"
/
  forall a . divides 1 a
/;

inference.
intro /a/.
unfold /divides/.
exists /a/.
omega.
qed ();



lemma "divides_0"
/
  forall a . divides a 0
/;

inference.
intro /a/.
unfold /divides/.
exists /0/.
omega.
qed ();



lemma "divides_refl"
/
  forall a . divides a a
/;

inference.
intro /a/.
unfold /divides/.
exists /1/.
omega.
qed ();



lemma "divides_trans"
/
  forall a b c .
    divides a b
    -> divides b c
    -> divides a c
/;

inference.
intro /a b c Hab Hbc/.
destruct /Hab/ /m Hab/.
destruct /Hbc/ /n Hbc/.
unfold /divides/.
exists /m * n/.
rewrite /<- times_assoc/.
rewrite /-> Hab/.
auto.
qed ();



lemma "divides_product_r"
/
  forall a b .
    divides a (a * b)
/;

inference.
intro /a b/.
unfold /divides/.
exists /b/.
auto.
qed ();



lemma "divides_product_l"
/
  forall a b .
    divides a (b * a)
/;

inference.
intro /a b/.
rewrite /-> times_commute/.
apply /divides_product_r/.
qed ();
    


lemma "divides_plus"
/
  forall a b c .
    divides a b
    -> divides a c
    -> divides a (b + c)
/;

inference.
intro /a b c (m Hab) (n Hac)/.
unfold /divides/.
exists /m + n/.
rewrite /-> times_dist_plus_r/.
omega.
qed ();



lemma "divides_minus"
/
  forall a b c .
    divides a b
    -> divides a c
    -> divides a (b - c)
/;

inference.
intro /a b c (m Hab) (n Hac)/.
rewrite /<- Hab, <- Hac/.
rewrite /<- times_dist_minus_r/.
apply /divides_product_r/.
qed ();



lemma "divides_times_times_r"
/
  forall a b c .
    divides a b
    -> divides (a * c) (b * c)
/;

inference.
intro /a b c (n Hab)/.
unfold /divides/.
exists /n/.
rewrite /<- Hab/.
rewrite /-> times_assoc at 0 0/.
rewrite /-> times_commute at 1/.
reflexivity.
qed ();


    
lemma "divides_times_times_l"
/
  forall a b c .
    divides a b
    -> divides (c * a) (c * b)
/;

inference.
intro /a b c Hab/.
rewrite /-> times_commute at 0 1/.
apply /divides_times_times_r/ >> auto.
qed ();


    
lemma "divides_times_r"
/
  forall a b c .
    divides a b
    -> divides a (b * c)
/;

inference.
intro /a b c Hab/.
apply /divides_trans _ (a * c)/.
  {
  apply /divides_product_r/.
  }

  {
  apply /divides_times_times_r/ >> auto.
  }
qed ();



lemma "divides_times_l"
/
  forall a b c .
    divides a b
    -> divides a (c * b)
/;

inference.
intro /a b c Hab/.
rewrite /-> times_commute/.
apply /divides_times_r/ >> auto.
qed ();



lemma "divides_mod"
/
  forall a b (c : pos) .
    divides a b
    -> divides a c
    -> divides a (mod b c)
/;

inference.
intro /a b c Hab Hac/.
destruct /c/ /c Hposc/.
unhide.
destruct /Hab/ /m Hab/.
destruct /Hac/ /n Hac/.
unfold /divides/.
exists /m - div b c * n/.
rewrite /-> times_dist_minus_r/.
rewrite /-> mod_prop/.
rewrite /-> Hab/.
rewrite /-> times_commute/.
rewrite /-> times_assoc/.
rewrite /-> times_commute at 1/.
rewrite /-> Hac/.
reflexivity.
qed ();



lemma "divides_div"
/
  forall a b (c : pos) .
    divides (a * c) b
    -> divides a (div b c)
/;

inference.
intro /a b c Hacb/.
destruct /Hacb/ /n Hacn/.
rewrite /<- Hacn/.
rewrite /-> times_commute at 1/.
rewrite /-> times_assoc/.
rewrite /-> div_times_l/.
apply /divides_product_r/.
qed ();



lemma "divides_impl_leq"
/
  forall a b .
    0 < b
    -> divides a b
    -> a <= b
/;

inference.
intro /a b Hpos (n Hab)/.
destruct /n/ /| n/.
  {
  omega.
  }

  {
  reduce /Hab/.
  rewrite /-> times_dist_succ_r in Hab/.
  omega.
  }
qed ();



lemma "divides_antisymm"
/
  forall a b .
    divides a b
    -> divides b a
    -> a = b : nat
/;

inference.
intro /a b Hab Hba/.
so /eq_nat_decide a 0/ /Ha | Ha/.
  {
  destruct /Hab/ /n Hab/.
  subst /a/.
  omega.
  }
so /eq_nat_decide b 0/ /Hb | Hb/.
  {
  destruct /Hba/ /n Hba/.
  subst /b/.
  omega.
  }

  {
  apply /leq_antisymm/.
    {
    apply /divides_impl_leq/ >> auto.
    omega.
    }

    {
    apply /divides_impl_leq/ >> auto.
    omega.
    }
  }
qed ();



lemma "modulus_implies_mod_eq"
/
  forall a b (c : pos) .
    a <= b
    -> divides c (b - a)
    -> mod a c = mod b c : nat
/;

inference.
intro /a b c Hab Hdivides/.
destruct /Hdivides/ /n Heq/.
symmetry.
witness /division_property _ _ (div a c + n) (mod a c) __ __ #2/.
1:{
  apply /mod_lt_r/.
  }
rewrite /-> times_dist_plus_l/.
rewrite /-> times_commute n c/.
rewrite /-> Heq/.
rewrite /<- minus_plus_cancel b a/ >> auto.
rewrite /-> plus_commute at 2/.
rewrite /-> plus_assoc/.
compat.
symmetry.
apply /div_prop/.
qed ();



lemma "mod_plus_alt"
/
  forall a b (c : pos) .
    mod (a + b) c = mod (mod a c + b) c : nat
/;

inference.
intro /a b c/.
symmetry.
apply /modulus_implies_mod_eq/.
  {
  apply /plus_leq/ >> auto.
  apply /mod_leq_l/.
  }
rewrite /-> plus_commute at 1/.
rewrite /<- minus_assoc/.
rewrite /-> plus_minus_cancel_r/.
rewrite /<- times_div_r/.
apply /divides_product_r/.
qed ();



lemma "mod_plus_alt2"
/
  forall a b (c : pos) .
    mod (a + b) c = mod (mod a c + mod b c) c : nat
/;

inference.
intro /a b c/.
rewrite /-> mod_plus_alt/.
rewrite /-> plus_commute/.
rewrite /-> mod_plus_alt/.
rewrite /-> plus_commute/.
reflexivity.
qed ();



lemma "mod_times_alt"
/
  forall a b (c : pos) .
    mod (a * b) c = mod (mod a c * b) c : nat
/;

inference.
intro /a b c/.
symmetry.
apply /modulus_implies_mod_eq/.
  {
  apply /times_leq/ >> auto.
  apply /mod_leq_l/.
  }
rewrite /<- times_dist_minus_l/.
apply /divides_times_r/.
rewrite /<- div_prop'/.
apply /divides_product_l/.
qed ();



lemma "mod_times_alt2"
/
  forall a b (c : pos) .
    mod (a * b) c = mod (mod a c * mod b c) c : nat
/;

inference.
intro /a b c/.
rewrite /-> mod_times_alt/.
rewrite /-> times_commute/.
rewrite /-> mod_times_alt/.
rewrite /-> times_commute/.
reflexivity.
qed ();



lemma "div_times_alt"
/
  forall a b (c : pos) .
    div a c * b <= div (a * b) c
/;

inference.
intro /a b c/.
so /div_prop a c/ /Heqa/.
so /div_prop (a * b) c/ /Heqab/.
apply /times_cancel_leq_r _ _ c/.
  {
  destruct /c/ /c ?/.
  unhide.
  omega.
  }
rewrite /-> times_assoc/.
rewrite /-> times_commute at 1/.
rewrite /<- times_assoc/.
so /times_compat _ _ b b Heqa ()/ /Heqab'/.
so /eq_trans _# 5 Heqab' (eq_symm _# 4 Heqab)/ /Heq1/.
rewrite /-> times_dist_plus_l in Heq1/.
so /minus_compat _ _ (mod (a * b) c) (mod (a * b) c) Heq1 ()/ /Heq2/.
rewrite /-> plus_minus_cancel_r in Heq2/.
rewrite /-> plus_minus_assoc in Heq2/.
1:{
  rewrite /<- Heq2/.
  apply /plus_leq_l/.
  }
rewrite /-> mod_times_alt/.
apply /mod_leq_l/.
qed ();



(* Greatest common divisor *)

definerec /gcd a b/
/
  if mod a b =? 0 then
    b
  else
    gcd b (mod a b)
//
  pos -> pos -> pos
/;

introOf /a b/.
destruct /a/ /a Hposa/.
destruct /b/ /b Hposb/.
unhide.
revert /a Hposa Hposb/.
sinduction /b/.
reintro /IH/.
intro /a Hposa Hposb/.
unroll /gcd/.
boolCase /mod a b =? 0/ /H/ >> auto.
apply /IH/ >> auto.
  {
  apply /mod_lt_r/.
  }

  {
  omega.
  }
qed ();



lemma "gcd_positive"
/
  forall (a b : pos) .
    0 < gcd a b
/;

intro /a b/.
infer /gcd a b/ /Hof/.
destructSet /Hof/ /H/.
unhide.
auto.
qed ();



lemma "gcd_prop"
/
  forall (a b : pos) .
    divides (gcd a b) a
    & divides (gcd a b) b
    & (forall n . divides n a -> divides n b -> divides n (gcd a b))
/;

inference.
intro /a b/.
destruct /a/ /a Hposa/.
destruct /b/ /b Hposb/.
unhide.
revert /a Hposa Hposb/.
sinduction /b/.
reintro /IH/.
intro /a Hposa Hposb/.
unroll /gcd at 2 1 0/.
boolCase /mod a b =? 0/ /Hzero/.
  {
  splitn 2 >> autoWith /divides_refl divides_iff_modulus/.
  }
assert /0 < mod a b/ /Hposmod/.
  {
  omega.
  }
exploit /IH (mod a b) __ b/ /Hdivb Hdivm Hgreatest/ >> auto.
  {
  apply /mod_lt_r/.
  }
splitn 2 >> auto.
  {
  rewrite /<- div_prop a b at 1/.
  apply /divides_plus/ >> auto.
  apply /divides_trans _ b/ >> auto.
  apply /divides_product_l/.
  }

  {
  intro /n Hna Hnb/.
  apply /IH/ >> auto.
    {
    apply /mod_lt_r/.
    }

    {
    apply /divides_mod/ >> auto.
    }
  }
qed ();



lemma "gcd_divides_l"
/
  forall (a b : pos) .
    divides (gcd a b) a
/;

intro /a b/.
apply /gcd_prop/.
qed ();



lemma "gcd_divides_r"
/
  forall (a b : pos) .
    divides (gcd a b) b
/;

intro /a b/.
apply /gcd_prop/.
qed ();



lemma "gcd_glb"
/
  forall (a b : pos) n .
    divides n a
    -> divides n b
    -> divides n (gcd a b)
/;

inference.
intro /a b n Ha Hb/.
apply /gcd_prop/ >> auto.
qed ();



lemma "gcd_commute"
/
  forall (a b : pos) .
    gcd a b = gcd b a : nat
/;

intro /a b/.
apply /divides_antisymm/.
  {
  apply /gcd_glb/ >> autoWith /gcd_divides_l gcd_divides_r/.
  }

  {
  apply /gcd_glb/ >> autoWith /gcd_divides_l gcd_divides_r/.
  }
qed ();



lemma "gcd_assoc"
/
  forall (a b c : pos) .
    gcd (gcd a b) c = gcd a (gcd b c) : nat
/;

intro /a b c/.
so /gcd_positive a b/ /Hposab/.
so /gcd_positive b c/ /Hposbc/.
apply /divides_antisymm/.
  {
  apply /gcd_glb/.
    {
    apply /divides_trans _ (gcd a b)/ >> autoWith /gcd_divides_l/.
    }

    {
    apply /gcd_glb/.
      {
      apply /divides_trans _ (gcd a b)/ >> autoWith /gcd_divides_l gcd_divides_r/.
      }

      {
      apply /gcd_divides_r/.
      }
    }
  }

  {
  apply /gcd_glb/.
    {
    apply /gcd_glb/.
      {
      apply /gcd_divides_l/.
      }

      {
      apply /divides_trans _ (gcd b c)/ >> autoWith /gcd_divides_l gcd_divides_r/.
      }
    }

    {
    apply /divides_trans _ (gcd b c)/ >> autoWith /gcd_divides_r/.
    }
  }
qed ();



lemma "gcd_ann_r"
/
  forall (a : pos) . gcd a 1 = 1 : nat
/;

intro /a/.
assertThen /0 < 1/ /Hpos1/ omega.
apply /divides_antisymm/.
  {
  apply /gcd_divides_r/.
  }

  {
  apply /gcd_glb/ >> apply /divides_1/.
  }
qed ();



lemma "gcd_ann_l"
/
  forall (a : pos) . gcd 1 a = 1 : nat
/;

intro /a/.
rewrite /-> gcd_commute/.
  {
  split.
  omega.
  }

  {
  apply /gcd_ann_r/.
  }
qed ();



(* Logarithms *)

defineInd /a/
/
  exp : nat -> nat of
  | zero . 1

  | succ n . exp n * a
//
  nat -> nat -> nat
/;



lemma "exp_positive"
/
  forall a n .
    0 < a
    -> 0 < exp a n
/;

inference.
intro /a n Ha/.
induction /n/.
  {
  omega.
  }
intro /n IH/.
apply /times_lt_zero/ >> auto.
qed ();



lemma "exp_plus"
/
  forall a m n .
    exp a (m + n) = exp a m * exp a n : nat
/;

inference.
intro /a m n/.
induction /m/.
  {
  omega.
  }
intro /m IH/.
rewrite /-> IH/.
rewrite /-> times_assoc at 0 0/.
rewrite /-> times_commute at 1/.
reflexivity.
qed ();



lemma "exp_times"
/
  forall a m n .
    exp a (m * n) = exp (exp a m) n : nat
/;

inference.
intro /a m n/.
rewrite /-> times_commute/.
induction /n/ >> auto.
intro /n IH/.
rewrite /-> exp_plus/.
rewrite /-> IH/.
apply /times_commute/.
qed ();



lemma "exp_mono_base"
/
  forall a a' b .
    a <= a'
    -> exp a b <= exp a' b
/;

inference.
intro /a a' b Ha/.
induction /b/ >> auto.
intro /b IH/.
apply /times_leq/ >> auto.
qed ();



lemma "exp_mono_exponent"
/
  forall a b b' .
    0 < a
    -> b <= b'
    -> exp a b <= exp a b'
/;

inference.
intro /a b b' Hpos Hb/.
rewriteThen /b' = b + (b' - b) : nat/ omega.
rewrite /-> exp_plus/.
rewrite /<- times_1_r (exp a b)/.
apply /times_leq/ >> auto.
so /exp_positive a (b' - b) Hpos/ /?/.
omega.
qed ();



lemma "exp_mono"
/
  forall a a' b b' .
    0 < a
    -> a <= a'
    -> b <= b'
    -> exp a b <= exp a' b'
/;

inference.
intro /a a' b b' Hpos Ha Hb/.
apply /leq_trans _ (exp a b')/ >> autoWith /exp_mono_base exp_mono_exponent/.
qed ();



lemma "div_2_lt"
/
  forall a .
    0 < a
    -> div a 2 < a
/;

assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
inference.
intro /a Hpos/.
rewrite /<- div_prop a 2 at 1/.
rewrite /<- plus_0_r (div a 2)/.
destruct /a/ /|(| a)/ >> reduce //.
  {
  so /lt_irrefl _ Hpos/ /0/.
  }
 
  {
  unroll /div at 0 1/.
  reduce //.
  unroll /mod/.
  reduce //.
  apply /lt_0_succ/.
  }

  {
  unroll /div at 0 1/.
  reduce //.
  omega.
  }
qed ();



lemma "div_2_pos"
/
  forall a .
    2 <= a
    -> 0 < div a 2
/;

inference.
intro /a Ha/.
unroll /div/.
destruct /a/ /|(| a)/ >> reduce // >> omega.
split.
omega.
qed ();



(* For convenience, set log2 0 = 0. *)
definerec /log2 a/
/
  if a <? 2 then
    0
  else
    succ (log2 (div a 2))
//
  nat -> nat
/;

assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
introOf /a/.
sinduction /a/.
reintro /IH/.
unroll /log2/.
boolCase /a <? 2/ /Hsmall/ >> auto.
typecheck1.
apply /IH/.
apply /div_2_lt/.
omega.
qed ();



lemma "log2_mono"
/
  forall a b .
    a <= b
    -> log2 a <= log2 b
/;

inference.
assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
intro /a/.
sinduction /a/.
reintro /IH/.
intro /b Hab/.
unroll /log2/.
boolCase /a <? 2/ /Hsmalla/.
  {
  omega.
  }
unroll /log2 at 1/.
boolCase /b <? 2/ /Hsmallb/.
  {
  exfalso.
  omega.
  }
apply /leq_succ_succ/.
apply /IH/.
  {
  apply /div_2_lt/.
  omega.
  }

  {
  apply /div_mono/ >> auto.
  }
qed ();



lemma "log2_one"
/
  log2 1 = 0 : nat
/;

unroll /log2/.
auto.
qed ();



lemma "log2_even"
/
  forall a .
    0 < a
    -> log2 (a * 2) = succ (log2 a) : nat
/;

inference.
assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
intro /a Hpos/.
unroll /log2/.
boolCase /a * 2 <? 2/ /Hsmall/.
  {
  omega.
  }
rewrite /-> div_times_r/.
reflexivity.
qed ();



lemma "log2_odd"
/
  forall a .
    0 < a
    -> log2 (succ (a * 2)) = succ (log2 a) : nat
/;

inference.
assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
intro /a Hpos/.
unroll /log2/.
boolCase /succ (a * 2) <? 2/ /Hsmall/.
  {
  omega.
  }
compat.
compat.
witness /division_property _# 3 1 __ __ #1/.
  {
  rewrite /-> plus_commute (a * 2) 1/.
  reflexivity.
  }

  {
  apply /lt_succ_succ/.
  apply /lt_0_succ/.
  }
qed ();



lemma "log2_two"
/
  log2 2 = 1 : nat
/;

rewrite /<- times_1_l 2/.
rewrite /-> log2_even 1/.
  {
  omega.
  }

  {
  compat.
  apply /log2_one/.
  }
qed ();



lemma "log2_exp_inverse"
/
  forall n .
    log2 (exp 2 n) = n : nat
/;

inference.
intro /n/.
induction /n/.
  {
  apply /log2_one/.
  }
intro /n IH/.
rewrite /-> log2_even/.
  {
  apply /exp_positive/.
  omega.
  }
compat.
hyp /IH/.
qed ();



lemma "log2_spec"
/
  forall a .
    0 < a
    -> exists b .
         a = exp 2 (log2 a) + b : nat
         & b < exp 2 (log2 a)
/;

inference.
assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
intro /a/.
sinduction /a/.
reintro /IH/.
intro /Hpos/.
unroll /log2 at 0 1/.
boolCase /a <? 2/ /Hsmall/.
  {
  exists /0/.
  omega.
  }
so /IH (div a 2) __ __/ /b Heq Hb/.
  {
  apply /div_2_lt/.
  omega.
  }

  {
  apply /div_2_pos/.
  omega.
  }
exists /b * 2 + mod a 2/.
split.
  {
  rewrite /<- div_prop a 2/.
  rewrite /-> Heq/.
  rewrite /-> times_dist_plus_l/.
  rewrite /-> plus_assoc/.
  reflexivity.
  }

  {
  unfold /lt in Hb in concl/.
  transitivity /succ b * 2/.
    {
    so /mod_lt_r a 2/ /?/.
    omega.
    }
  apply /times_leq (succ b) (exp 2 (log2 (div a 2))) 2 2/ >> auto.
  }
qed ();



lemma "log2_unique"
/
  forall a e e' r r' .
    0 < a
    -> a = exp 2 e + r : nat
    -> a = exp 2 e' + r' : nat
    -> r < exp 2 e
    -> r' < exp 2 e'
    -> e = e' : nat & r = r' : nat
/;

inference.
intro /a e e' r r' Hpos/.
revert /e e' r r'/.
assert /forall e e' r r' .
          e <= e'
          -> a = exp 2 e + r : nat
          -> a = exp 2 e' + r' : nat
          -> r < exp 2 e
          -> r' < exp 2 e'
          -> e = e' : nat & r = r' : nat/ /Hprop/
>>> [inference, idtac].
1:{
  intro /e e' r r' Heq Heq' Hr Hr'/.
  so /nat_dichotomy_weak e e'/ /Hleq | Hleq/.
    {
    apply /Hprop/ >> auto.
    }

    {
    exploit /Hprop e' e r' r/ /H1 H2/ >> auto.
    }
  }
intro /e f r s Hleq He Hf Hr Hs/.
assert /e = f : nat/ /Hef/.
1:{
  subst /f/.
  split >> auto.
  apply /plus_cancel_l _ _ (exp 2 e)/.
  transitivity /a/ >> auto.
  }
apply /leq_antisymm/ >> auto.
apply /not_lt/.
intro /Hlt/.
apply /lt_irrefl r/.
witness /lt_leq_trans _# 3 Hr __/.
rewrite /f = e + (f - e) : nat in Hf/.
  {
  omega.
  }
rewrite /-> exp_plus in Hf/.
rewrite /-> He in Hf/.
assert /exp 2 e <= exp 2 e * exp 2 (f - e)/ /H1/.
  {
  rewrite /<- exp_plus/.
  apply /exp_mono_exponent/ >> omega.
  }
assertThen /exp 2 e * exp 2 (f - e) - exp 2 e * 1 + s = r : nat/ /H2/ omega.
rewrite /<- times_dist_minus_r in H2/.
rewrite /<- H2/.
apply /leq_trans _ (exp 2 e * (exp 2 (f - e) - 1))/.
1:{
  omega.
  }
rewrite /<- times_1_r (exp 2 e)/.
apply /times_leq/ >> auto.
assert /2 <= exp 2 (f - e)/ /H3/.
1:{
  omega.
  }
rewriteThen /f - e = succ (f - e - 1) : nat/ omega.
reduce //.
apply /times_leq 1 _ 2 2/ >> auto.
so /exp_positive 2 (pred (f - e))/ /?/ >> omega.
qed ();



lemma "log2_property"
/
  forall a e r .
    0 < a
    -> a = exp 2 e + r : nat
    -> r < exp 2 e
    -> log2 a = e : nat
/;

inference.
intro /a e r Hpos Heq Hr/.
so /log2_spec a Hpos/ /r' Heq' Hr'/.
apply /log2_unique a (log2 a) e r' r/ >> auto.
qed ();



lemma "log2_lower"
/
  forall a .
    0 < a
    -> exp 2 (log2 a) <= a
/;

inference.
intro /a Hpos/.
so /log2_spec a Hpos/ /b Heq Hb/.
omega.
qed ();



lemma "log2_upper"
/
  forall a .
    a < exp 2 (succ (log2 a))
/;

inference.
intro /a/.
so /lt_decide 0 a/ /Hpos | Hzero/.
1:{
  assertThen /a = 0 : nat/ /?/ omega.
  subst /a/.
  unroll /log2/.
  reduce //.
  omega.
  }
so /log2_spec a Hpos/ /b Heq Hb/.
reduce //.
omega.
qed ();



lemma "log2_times_leq"
/
  forall a b .
    0 < a
    -> 0 < b
    -> log2 a + log2 b <= log2 (a * b)
/;

inference.
assert /2 : pos/ /Hpos2/.
  {
  typecheck.
  split.
  apply /lt_0_succ/.
  }
intro /a b Hposa Hposb/.
revert /Hposa/.
sinduction /a/.
reintro /IH/.
intro /Hposa/.
unroll /log2/.
boolCase /a <? 2/ /Hsmall/.
  {
  apply /log2_mono/.
  rewrite /<- times_1_l b/.
  apply /times_leq 1/ >> auto.
  omega.
  }
rewrite /<- div_prop a 2 at 1/.
rewrite /-> times_dist_plus_l/.
rewrite /-> times_assoc/.
rewrite /-> times_commute at 1/.
rewrite /<- times_assoc/.
apply /leq_trans _ (log2 (div a 2 * b * 2))/.
1:{
  apply /log2_mono/.
  apply /plus_leq_l/.
  }
rewrite /-> log2_even/.
  {
  apply /times_lt_zero/.
    {
    apply /div_2_pos/.
    omega.
    }

    {
    omega.
    }
  }
apply /leq_succ_succ/.
apply /IH/.
  {
  apply /div_2_lt/.
  omega.
  }

  {
  apply /div_2_pos/.
  omega.
  }
qed ();



(* Parity *)

defineInd //
/
  is_even : nat -> bool of
  | zero . true
  | succ n . Bool.notb (is_even n)
//
  nat -> bool
/;



lemma "is_even_modulus"
/
  forall n .
    (Bool.istrue (is_even n) <-> mod n 2 = 0 : nat)
    & (Bool.istrue (Bool.notb (is_even n)) <-> mod n 2 = 1 : nat)
/;

inference.
intro /n/.
assertThen /0 < 2/ /H02/ omega.
induction /n/.

(* 0 *)
{
split >> split.
  {
  intro /_/.
  rewrite /-> mod_operands_lt/ >> auto.
  }

  {
  intro /_/.
  apply /Bool.istrue_true/.
  }

  {
  intro /H/.
  so /Bool.not_istrue_false H/ /0/.
  }

  {
  intro /H/.
  rewrite /-> mod_operands_lt in H/ >> auto.
  injection /H/.
  }
}

(* succ *)
{
intro /n (IH0 IH1)/.
split >> split.
  {
  intro /Hodd/.
  so /IH1 #1 Hodd/ /Heq/.
  rewriteThen /succ n = n + 1 : nat/ omega.
  rewrite /-> mod_plus_alt/.
  rewrite /-> Heq/.
  reduce //.
  apply /mod_self/.
  }

  {
  intro /Heq/.
  witness /IH1 #2 __/.
  rewrite /<- mod_plus_l/.
  rewriteThen /2 + n = succ n + 1 : nat/ omega.
  rewrite /-> mod_plus_alt (succ n) 1 2/.
  rewrite /-> Heq/.
  reduce //.
  apply /mod_operands_lt/.
  omega.
  }

  {
  intro /Heven/.
  rewrite /-> Bool.notb_invol in Heven/.
  so /IH0 #1 Heven/ /Heq/.
  rewriteThen /succ n = n + 1 : nat/ omega.
  rewrite /-> mod_plus_alt/.
  rewrite /-> Heq/.
  reduce //.
  apply /mod_operands_lt/.
  omega.
  }

  {
  intro /Heq/.
  rewrite /-> Bool.notb_invol/.
  apply /IH0/.
  rewrite /<- mod_plus_l/.
  rewriteThen /2 + n = succ n + 1 : nat/ omega.
  rewrite /-> mod_plus_alt (succ n) 1 2/.
  rewrite /-> Heq/.
  reduce //.
  apply /mod_self/.
  }
}
qed ();



lemma "even_iff_parity_zero"
/
  forall n .
    Bool.istrue (is_even n) <-> mod n 2 = 0 : nat
/;

inference.
intro /n/.
apply /is_even_modulus/.
qed ();



lemma "odd_iff_parity_one"
/
  forall n .
    Bool.istrue (Bool.notb (is_even n)) <-> mod n 2 = 1 : nat
/;

inference.
intro /n/.
apply /is_even_modulus/.
qed ();



(* Relation to integers *)

lemma "div_and_mod_to_integer"
/
  forall a (b : pos) .
    Z.nat_to_integer (div a b) = Z.divz (Z.nat_to_integer a) (Z.nat_to_integer b) : integer
    & Z.nat_to_integer (mod a b) = Z.modz (Z.nat_to_integer a) (Z.nat_to_integer b) : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
assert /Z.nat_to_integer b != z`0 : integer/ /Hnonzero/.
  {
  intro /Heq/.
  rewrite /<- Z.nat_to_integer_inv b in Hpos/.
  rewrite /-> Heq in Hpos/.
  omega.
  }
exploit /Z.division_property (Z.nat_to_integer a) (Z.nat_to_integer b) (Z.nat_to_integer (div a b)) (Z.nat_to_integer (mod a b))/ /Hdiv Hmod/.
  {
  symmetry.
  transitivity /Z.nat_to_integer (div a b * b + mod a b)/.
  1:{
    compat.
    apply /div_prop/.
    }
  rewrite /-> Z.plus_to_integer/.
  rewrite /-> Z.times_to_integer/.
  reflexivity.
  }

  {
  apply /Z.nat_to_integer_nonneg/.
  }

  {
  rewrite /-> Z.absz_nat_to_integer/.
  apply /Z.nat_to_integer_mono_lt/.
  apply /mod_lt_r/.
  }

  {
  auto.
  }
qed ();



lemma "div_to_integer"
/
  forall a (b : pos) .
    Z.nat_to_integer (div a b) = Z.divz (Z.nat_to_integer a) (Z.nat_to_integer b) : integer
/;

inference.
intro /a b/.
apply /div_and_mod_to_integer/.
qed ();



lemma "mod_to_integer"
/
  forall a (b : pos) .
    Z.nat_to_integer (mod a b) = Z.modz (Z.nat_to_integer a) (Z.nat_to_integer b) : integer
/;

inference.
intro /a b/.
apply /div_and_mod_to_integer/.
qed ();



endModule ();
