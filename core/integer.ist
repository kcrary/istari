lemma "integer_integral_domain"
/
  forall a b .
    a *z b = z`0 : integer
    -> a = z`0 : integer % b = z`0 : integer
/;

inference.
intro /a b Heq/.
so /integer_trichotomy a z`0/ /Hnega | Hzero | Hposa/ >> auto.
  {
  so /integer_trichotomy b z`0/ /Hnegb | Hzero | Hposb/ >> auto.
    {
    exfalso.
    apply /ltz_irrefl z`0/.
    rewrite /<- Heq at 1/.
    apply /timesz_ltz_zero_neg_neg/ >> auto.
    }

    {
    exfalso.
    apply /ltz_irrefl z`0/.
    rewrite /<- Heq /.
    apply /timesz_ltz_zero_neg_pos/ >> auto.
    }
  }

  {
  so /integer_trichotomy b z`0/ /Hnegb | Hzero | Hposb/ >> auto.
    {
    exfalso.
    apply /ltz_irrefl z`0/.
    rewrite /<- Heq/.
    apply /timesz_ltz_zero_pos_neg/ >> auto.
    }

    {
    exfalso.
    apply /ltz_irrefl z`0/.
    rewrite /<- Heq at 1/.
    apply /timesz_ltz_zero/ >> auto.
    }
  }
qed ();



lemma "timesz_neq_zero"
/
  forall a b .
    a != z`0 : integer
    -> b != z`0 : integer 
    -> a *z b != z`0 : integer
/;

inference.
intro /a b Ha Hb/.
intro /Heq/.
so /integer_integral_domain _# 2 Heq/ /Ha' | Hb'/.
  {
  apply /Ha/ >> auto.
  }

  {
  apply /Hb/ >> auto.
  }
qed ();



lemma "timesz_ltz_zero_invert"
/
  forall a b .
    z`0 <z a *z b
    -> (a <z z`0 & b <z z`0) % (z`0 <z a & z`0 <z b)
/;

inference.
intro /a b Hab/.
so /integer_trichotomy a z`0/ /Ha | Ha | Ha/.
  {
  left.
  split >> auto.
  so /integer_trichotomy b z`0/ /Hb | Hb | Hb/ >> auto.
    {
    subst /b/.
    rewrite /-> timesz_ann_r in Hab/.
    so /ltz_irrefl _ Hab/ /0/.
    }

    {
    so /timesz_ltz_zero_neg_pos _ _ Ha Hb/ /H/.
    so /ltz_irrefl _ (ltz_trans _# 3 Hab H)/ /0/.
    }
  }

  {
  subst /a/.
  rewrite /-> timesz_ann_l in Hab/.
  so /ltz_irrefl _ Hab/ /0/.
  }

  {
  right.
  split >> auto.
  so /integer_trichotomy b z`0/ /Hb | Hb | Hb/ >> auto.
    {
    so /timesz_ltz_zero_pos_neg _ _ Ha Hb/ /H/.
    so /ltz_irrefl _ (ltz_trans _# 3 Hab H)/ /0/.
    }

    {
    subst /b/.
    rewrite /-> timesz_ann_r in Hab/.
    so /ltz_irrefl _ Hab/ /0/.
    }
  }
qed ();



lemma "timesz_ltz_zero_invert_neg"
/
  forall a b .
    a *z b <z z`0 -> a <z z`0 & z`0 <z b  %  z`0 <z a & b <z z`0
/;

inference.
intro /a b Hneg/.
so /negz_ltz _ _ Hneg/ /Hpos/.
reduce /Hpos/.
rewrite /-> negz_dist_timesz_r in Hpos/.
so /timesz_ltz_zero_invert _ _ Hpos/ /Ha Hb | Ha Hb/.
  {
  left.
  split >> auto.
  apply /negz_ltz'/ >> auto.
  }

  {
  right.
  split >> auto.
  apply /negz_ltz'/ >> auto.
  }
qed ();



lemma "timesz_ltz_l"
/
  forall a b b' .
    z`0 <z a
    -> b <z b'
    -> a *z b <z a *z b'
/;

inference.
intro /a b b' Ha Hb/.
unfold /ltz in Hb in concl/.
so /timesz_leqz_l _ _ _ (ltz_impl_leqz _ _ Ha) Hb/ /H/.
rewrite /-> timesz_dist_plusz_r in H/.
witness /leqz_trans _# 3 __ H/.
apply /plusz_leqz/ >> autoWith /leqz_refl/.
rewrite /-> timesz_id_r/.
unfold /ltz in Ha/.
hyp /Ha/.
qed ();



lemma "timesz_ltz_r"
/
  forall a a' b .
    z`0 <z b
    -> a <z a'
    -> a *z b <z a' *z b
/;

inference.
intro /a a' b Hb Ha/.
rewrite /-> timesz_commute at 0 1/.
apply /timesz_ltz_l/ >> auto.
qed ();



lemma "timesz_cancel_leqz_l"
/
  forall a b c .
    z`0 <z c
    -> c *z a <z= c *z b
    -> a <z= b
/;

inference.
intro /a b c Hpos Hleq/.
so /integer_dichotomy a b/ /H | Hba/ >> auto.
exfalso.
so /timesz_ltz_l _# 3 Hpos Hba/ /H/.
so /ltz_irrefl _ (ltz_leqz_trans _# 3 H Hleq)/ /0/.
qed ();



lemma "timesz_cancel_leqz_r"
/
  forall a b c .
    z`0 <z c
    -> a *z c <z= b *z c
    -> a <z= b
/;

inference.
intro /a b c Hc Hleq/.
rewrite /-> timesz_commute in Hleq at 0 1/.
apply /timesz_cancel_leqz_l/ >> auto.
qed ();



lemma "timesz_cancel_ltz_l"
/
  forall a b c .
    z`0 <z c
    -> c *z a <z c *z b
    -> a <z b
/;

inference.
intro /a b c Hc Hlt/.
apply /ltz_from_leqz_neq/.
  {
  apply /timesz_cancel_leqz_l/ >> auto.
  apply /ltz_impl_leqz/ >> auto.
  }
  
  {
  intro /?/.
  subst /b/.
  so /ltz_irrefl _ Hlt/ /0/.
  }
qed ();



lemma "timesz_cancel_ltz_r"
/
  forall a b c .
    z`0 <z c
    -> a *z c <z b *z c
    -> a <z b
/;

inference.
intro /a b c Hc Hlt/.
rewrite /-> timesz_commute in Hlt at 0 1/.
apply /timesz_cancel_ltz_l/ >> auto.
qed ();



lemma "timesz_cancel_leqz_l_remainder"
/
  forall a b c r .
    z`0 <z c
    -> r <z c
    -> c *z a <z= c *z b +z r
    -> a <z= b
/;

inference.
intro /a b c r Hpos Hr Hleq/.
so /integer_dichotomy a b/ /H | Hba/ >> auto.
exfalso.
unfold /ltz in Hba/.
so /timesz_leqz_l _# 3 (ltz_impl_leqz _ _ Hpos) Hba/ /Hbac/.
rewrite /-> timesz_dist_plusz_r in Hbac/.
rewrite /-> timesz_id_r in Hbac/.
rewrite /-> plusz_commute in Hbac/.
apply /ltz_irrefl (c *z a)/.
apply /leqz_ltz_trans/ >> auto.
apply /ltz_leqz_trans/ >> auto.
apply /plusz_ltz_r/ >> autoWith /leqz_refl/.
qed ();



lemma "timesz_cancel_leqz_r_remainder"
/
  forall a b c r .
    z`0 <z c
    -> r <z c
    -> a *z c <z= b *z c +z r
    -> a <z= b
/;

inference.
intro /a b c r Hpos Hr Hleq/.
rewrite /-> timesz_commute in Hleq at 0 1/.
apply /timesz_cancel_leqz_l_remainder/ >> auto.
qed ();



lemma "timesz_cancel_l"
/
  forall a b c .
    c != z`0 : integer
    -> c *z a = c *z b : integer
    -> a = b : integer
/;

inference.
assert /forall a b c .
          c != z`0 : integer
          -> c *z a = c *z b : integer
          -> a <z= b/ /Hprop/ >> inference.
1:{
  intro /a b c Hnzero Heq/.
  apply /leqz_antisymm/ >> auto.
  }
intro /a b c Hnzero Heq/.
so /integer_dichotomy_neq _ _ Hnzero/ /Hltzero | Hleqzero/.
  {
  apply /timesz_cancel_leqz_l _ _ (~z c)/.
    {
    apply /negz_ltz _ z`0/ >> auto.
    }
  apply /leqz_refl_eq/.
  rewrite /<- negz_dist_timesz_l at 1 0/.
  compat >> auto.
  }

  {
  apply /timesz_cancel_leqz_l _ _ c/ >> auto.
  apply /leqz_refl_eq/ >> auto.
  }
qed ();



lemma "timesz_cancel_r"
/
  forall a b c .
    c != z`0 : integer
    -> a *z c = b *z c : integer
    -> a = b : integer
/;

inference.
intro /a b c Hnzero Heq/.
rewrite /-> timesz_commute in Heq at 0 1/.
apply /timesz_cancel_l/ >> auto.
qed ();



(* Minimum/Maximum *)

define /minz a b/
/
  if leqzb a b then a else b
//
  integer -> integer -> integer
/;

unfold /minz/.
typecheck.
qed ();

Define.registerNative 0 2 (Define.unfold1 (parseConstant /minz/) 2);



define /maxz a b/
/
  if leqzb a b then b else a
//
  integer -> integer -> integer
/;

unfold /maxz/.
typecheck.
qed ();

Define.registerNative 0 2 (Define.unfold1 (parseConstant /maxz/) 2);



lemma "negz_minz"
/
  forall a b . ~z (minz a b) = maxz (~z a) (~z b) : integer
/;

inference.
intro /a b/.
unfold /minz , maxz/.
boolCase /leqzb a b/ /Hab/ >> boolCase /leqzb (~z a) (~z b)/ /Hba/ >> attempt reflexivity.
  {
  reduce //.
  compat.
  apply /leqz_antisymm/ >> auto.
  apply /negz_leqz'/ >> auto.
  }

  {
  rewrite /-> not_leqz in Hab/.
  rewrite /-> not_leqz in Hba/.
  so /negz_ltz' _ _ Hba/ /Hba'/.
  so /ltz_irrefl _ (ltz_trans _ _ _ Hba' Hab)/ /0/.
  }
qed ();



lemma "maxz_as_minz"
/
  forall a b . maxz a b = ~z (minz (~z a) (~z b)) : integer
/;

inference.
intro /a b/.
rewrite /-> negz_minz/.
rewrite /-> negz_invol at all/.
reflexivity.
qed ();



lemma "negz_maxz"
/
  forall a b . ~z (maxz a b) = minz (~z a) (~z b) : integer
/;

inference.
intro /a b/.
rewrite /-> maxz_as_minz/.
rewrite /-> negz_invol/.
reflexivity.
qed ();



lemma "minz_as_maxz"
/
  forall a b . minz a b = ~z (maxz (~z a) (~z b)) : integer
/;

inference.
intro /a b/.
rewrite /-> negz_maxz/.
rewrite /-> negz_invol at all/.
reflexivity.
qed ();



lemma "minz_commute"
/
  forall a b . minz a b = minz b a : integer
/;

inference.
intro /a b/.
unfold /minz at all/.
boolCase /leqzb a b/ /Hab/ >> boolCase /leqzb b a/ /Hba/ >> attempt reflexivity.
  {
  apply /leqz_antisymm/ >> auto.
  }

  {
  so /Hab __/ /0/.
  rewrite /-> not_leqz in Hba/.
  apply /ltz_impl_leqz/ >> auto.
  }
qed ();



lemma "maxz_commute"
/
  forall a b . maxz a b = maxz b a : integer
/;

inference.
intro /a b/.
rewrite /-> maxz_as_minz at all/.
compat.
apply /minz_commute/.
qed ();



lemma "minz_assoc"
/
  forall a b c . minz (minz a b) c = minz a (minz b c) : integer
/;

inference.
intro /a b c/.
unfold /minz at all/.
boolCase /leqzb b c/ /Hbc/ >> reduce // >> boolCase /leqzb a b/ /Hab/ >> attempt reflexivity >> reduce //.
  {
  boolCase /leqzb a c/ /Hac/.
    {
    reflexivity.
    }
  so /Hac __/ /0/.
  apply /leqz_trans/ >> auto.
  }

  {
  boolCase /leqzb b c/ /Hbc'/.
    {
    reflexivity.
    }
  so /Hbc' Hbc/ /0/.
  }

  {
  boolCase /leqzb b c/ /Hbc'/.
    {
    so /Hbc Hbc'/ /0/.
    }
  boolCase /leqzb a c/ /Hac/.
  1:{
    reflexivity.
    }
  rewrite /-> not_leqz in Hbc/.
  rewrite /-> not_leqz in Hab/.
  apply /leqz_antisymm/ >> auto.
  apply /ltz_impl_leqz/.
  apply /ltz_trans/ >> auto.
  }
qed ();



lemma "maxz_assoc"
/
  forall a b c . maxz (maxz a b) c = maxz a (maxz b c) : integer
/;

inference.
intro /a b c/.
rewrite /-> maxz_as_minz at all/.
rewrite /-> negz_invol at all/.
compat.
apply /minz_assoc/.
qed ();



lemma "minz_leq_l"
/
  forall a b . minz a b <z= a
/;

inference.
intro /a b/.
unfold /minz/.
boolCase /leqzb a b/ /Hab/.
  {
  apply /leqz_refl/.
  }
rewrite /-> not_leqz in Hab/.
apply /ltz_impl_leqz/ >> auto.
qed ();



lemma "minz_leq_r"
/
  forall a b . minz a b <z= b
/;

inference.
intro /a b/.
rewrite /-> minz_commute/.
apply /minz_leq_l/.
qed ();



lemma "maxz_leq_l"
/
  forall a b . a <z= maxz a b
/;

inference.
intro /a b/.
rewrite /-> maxz_as_minz/.
apply /negz_leqz'/.
rewrite /-> negz_invol/.
apply /minz_leq_l/.
qed ();



lemma "maxz_leq_r"
/
  forall a b . b <z= maxz a b
/;

inference.
intro /a b/.
rewrite /-> maxz_commute/.
apply /maxz_leq_l/.
qed ();



lemma "minz_glb"
/
  forall a b c . c <z= a -> c <z= b -> c <z= minz a b
/;

inference.
intro /a b c Ha Hb/.
unfold /minz/.
boolCase /leqzb a b/ /Hab/ >> auto.
qed ();



lemma "maxz_lub"
/
  forall a b c . a <z= c -> b <z= c -> maxz a b <z= c
/;

inference.
intro /a b c Ha Hb/.
unfold /maxz/.
boolCase /leqzb a b/ /Hab/ >> auto.
qed ();

  

lemma "minz_eq_l"
/
  forall a b . a <z= b -> minz a b = a : integer
/;

inference.
intro /a b Hab/.
unfold /minz/.
boolCase /leqzb a b/ /H/ >> attempt reflexivity.
rewrite /-> not_leqz in H/.
so /ltz_irrefl _ (leqz_ltz_trans _ _ _ Hab H)/ /0/.
qed ();



lemma "minz_eq_r"
/
  forall a b . b <z= a -> minz a b = b : integer
/;

inference.
intro /a b Hba/.
rewrite /-> minz_commute/.
apply /minz_eq_l/ >> auto.
qed ();



lemma "maxz_eq_l"
/
  forall a b . b <z= a -> maxz a b = a : integer
/;

inference.
intro /a b H/.
rewrite /-> maxz_as_minz/.
rewrite /-> minz_eq_l/.
  {
  apply /negz_leqz/ >> auto.
  }
apply /negz_invol/.
qed ();



lemma "maxz_eq_r"
/
  forall a b . a <z= b -> maxz a b = b : integer
/;

inference.
intro /a b H/.
rewrite /-> maxz_commute/.
apply /maxz_eq_l/ >> auto.
qed ();



lemma "minz_idem"
/
  forall a . minz a a = a : integer
/;

inference.
intro /a/.
rewrite /-> minz_eq_l/ >> auto.
apply /leqz_refl/.
qed ();



lemma "maxz_idem"
/
  forall a . maxz a a = a : integer
/;

inference.
intro /a/.
rewrite /-> maxz_eq_l/ >> auto.
apply /leqz_refl/.
qed ();



lemma "minz_dist_maxz_l"
/
  forall a b c . minz (maxz a b) c = maxz (minz a c) (minz b c) : integer
/;

inference.
intro /a b c/.
revert /a b/.
assert /forall a b . a <z= b -> minz (maxz a b) c = maxz (minz a c) (minz b c) : integer/ /H/.
  {
  inference.
  intro /a b Hab/.
  rewrite /-> maxz_eq_r a b/ >> auto.
  so /integer_dichotomy_weak b c/ /Hbc | Hcb/.
    {
    rewrite /-> minz_eq_l b c at all/ >> auto.
    rewrite /-> minz_eq_l a c/ >> autoWith /leqz_trans/.
    rewrite /-> maxz_eq_r/ >> auto.
    }

    {
    rewrite /-> minz_eq_r b c at all/ >> auto.
    so /integer_dichotomy_weak a c/ /Hac | Hca/.
      {
      rewrite /-> minz_eq_l/ >> auto.
      rewrite /-> maxz_eq_r/ >> auto.
      }

      {
      rewrite /-> minz_eq_r/ >> auto.
      symmetry.
      apply /maxz_idem/.
      }
    }
  }
intro /a b/.
so /integer_dichotomy_weak a b/ /Hab | Hba/.
  {
  apply /H/ >> auto.
  }

  {
  rewrite /-> maxz_commute at 0 1/.
  apply /H/ >> auto.
  }
qed ();



lemma "minz_dist_maxz_r"
/
  forall a b c . minz a (maxz b c) = maxz (minz a b) (minz a c) : integer
/;

inference.
intro /a b c/.
rewrite /-> minz_commute at 0 1 2/.
apply /minz_dist_maxz_l/.
qed ();



lemma "maxz_dist_minz_l"
/
  forall a b c . maxz (minz a b) c = minz (maxz a c) (maxz b c) : integer
/;

inference.
intro /a b c/.
rewrite /-> minz_as_maxz at all/.
rewrite /-> maxz_as_minz at 4 3 0/.
rewrite /-> negz_invol at all/.
compat.
apply /minz_dist_maxz_l/.
qed ();



lemma "maxz_dist_minz_r"
/
  forall a b c . maxz a (minz b c) = minz (maxz a b) (maxz a c) : integer
/;

inference.
intro /a b c/.
rewrite /-> maxz_commute at 0 1 2/.
apply /maxz_dist_minz_l/.
qed ();



lemma "plusz_dist_minz_r"
/
  forall a b c . a +z minz b c = minz (a +z b) (a +z c) : integer
/;

inference.
intro /a b c/.
so /integer_dichotomy_weak b c/ /Hbc | Hcb/.
  {
  rewrite /-> minz_eq_l/ >> auto.
  rewrite /-> minz_eq_l/ >> auto.
  apply /plusz_leqz/ >> auto.
  apply /leqz_refl/.
  }

  {
  rewrite /-> minz_eq_r/ >> auto.
  rewrite /-> minz_eq_r/ >> auto.
  apply /plusz_leqz/ >> auto.
  apply /leqz_refl/.
  }
qed ();



lemma "plusz_dist_minz_l"
/
  forall a b c . minz a b +z c = minz (a +z c) (b +z c) : integer
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1 2/.
apply /plusz_dist_minz_r/.
qed ();



lemma "plusz_dist_maxz_r"
/
  forall a b c . a +z maxz b c = maxz (a +z b) (a +z c) : integer
/;

inference.
intro /a b c/.
so /integer_dichotomy_weak b c/ /Hbc | Hcb/.
  {
  rewrite /-> maxz_eq_r/ >> auto.
  rewrite /-> maxz_eq_r/ >> auto.
  apply /plusz_leqz/ >> auto.
  apply /leqz_refl/.
  }

  {
  rewrite /-> maxz_eq_l/ >> auto.
  rewrite /-> maxz_eq_l/ >> auto.
  apply /plusz_leqz/ >> auto.
  apply /leqz_refl/.
  }
qed ();



lemma "plusz_dist_maxz_l"
/
  forall a b c . maxz a b +z c = maxz (a +z c) (b +z c) : integer
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1 2/.
apply /plusz_dist_maxz_r/.
qed ();



lemma "min_to_integer"
/
  forall m n . nat_to_integer (Nat.min m n) = minz (nat_to_integer m) (nat_to_integer n) : integer
/;

inference.
assert /forall m n . m <= n -> nat_to_integer (Nat.min m n) = minz (nat_to_integer m) (nat_to_integer n) : integer/ /H/.
  {
  inference.
  intro /m n Hmn/.
  rewrite /-> Nat.min_eq_l/ >> auto.
  rewrite /-> minz_eq_l/ >> auto.
  apply /nat_to_integer_mono/ >> auto.
  }
intro /m n/.
so /Nat.nat_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
rewrite /-> Nat.min_commute/.
rewrite /-> minz_commute/.
apply /H/ >> auto.
qed ();



lemma "max_to_integer"
/
  forall m n . nat_to_integer (Nat.max m n) = maxz (nat_to_integer m) (nat_to_integer n) : integer
/;

inference.
assert /forall m n . n <= m -> nat_to_integer (Nat.max m n) = maxz (nat_to_integer m) (nat_to_integer n) : integer/ /H/.
  {
  inference.
  intro /m n Hmn/.
  rewrite /-> Nat.max_eq_l/ >> auto.
  rewrite /-> maxz_eq_l/ >> auto.
  apply /nat_to_integer_mono/ >> auto.
  }
intro /m n/.
so /Nat.nat_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
rewrite /-> Nat.max_commute/.
rewrite /-> maxz_commute/.
apply /H/ >> auto.
qed ();



lemma "minz_to_nat"
/
  forall a b . integer_to_nat (minz a b) = Nat.min (integer_to_nat a) (integer_to_nat b) : nat
/;

inference.
assert /forall a b . a <z= b -> integer_to_nat (minz a b) = Nat.min (integer_to_nat a) (integer_to_nat b) : nat/ /H/.
  {
  inference.
  intro /a b Hab/.
  rewrite /-> minz_eq_l/ >> auto.
  rewrite /-> Nat.min_eq_l/ >> auto.
  apply /integer_to_nat_mono/ >> auto.
  }
intro /a b/.
so /integer_dichotomy_weak a b/ /Hab | Hba/ >> auto.
rewrite /-> minz_commute/.
rewrite /-> Nat.min_commute/.
apply /H/ >> auto.
qed ();



lemma "maxz_to_nat"
/
  forall a b . integer_to_nat (maxz a b) = Nat.max (integer_to_nat a) (integer_to_nat b) : nat
/;

inference.
assert /forall a b . a <z= b -> integer_to_nat (maxz a b) = Nat.max (integer_to_nat a) (integer_to_nat b) : nat/ /H/.
  {
  inference.
  intro /a b Hab/.
  rewrite /-> maxz_eq_r/ >> auto.
  rewrite /-> Nat.max_eq_r/ >> auto.
  apply /integer_to_nat_mono/ >> auto.
  }
intro /a b/.
so /integer_dichotomy_weak a b/ /Hab | Hba/ >> auto.
rewrite /-> maxz_commute/.
rewrite /-> Nat.max_commute/.
apply /H/ >> auto.
qed ();



lemma "integer_total"
/
  Partial.total integer
/;

unfold /Partial.total/.
split >> auto.
intro /x/.
RuleTactic.integerHalts.
hypof.
qed ();



(* Absolute value *)

define /absz a/
/
  if z`0 <z=? a then a else negz a
//
  integer -> integer
/;

unfold /absz/.
typecheck.
qed ();



lemma "absz_nonneg"
/
  forall a . z`0 <z= absz a
/;

inference.
intro /a/.
unfold /absz/.
boolCase /z`0 <z=? a/ /Ha/ >> auto.
apply /negz_leqz _ z`0/.
apply /ltz_impl_leqz/ >> auto.
apply /not_leqz/ >> auto.
qed ();



lemma "absz_of_nonneg"
/
  forall a . z`0 <z= a -> absz a = a : integer
/;

inference.
intro /a Hpos/.
unfold /absz/.
boolEq true /z`0 <z=? a/ >> auto.
qed ();



lemma "absz_of_nonpos"
/
  forall a . a <z= z`0 -> absz a = negz a : integer
/;

inference.
intro /a Hneg/.
unfold /absz/.
boolCase /z`0 <z=? a/ /Hpos/ >> auto.
so /leqz_antisymm _# 2 Hneg Hpos/ /H/.
subst /a/.
reduce //.
reflexivity.
qed ();



lemma "absz_negz"
/
  forall a . absz (negz a) = absz a : integer
/;

inference.
intro /a/.
unfold /absz at 0 0/.
so /integer_trichotomy z`0 a/ /Hneg | Hzero | Hpos/.
  {
  boolEq false /z`0 <z=? ~z a/.
    {
    apply /not_leqz/.
    apply /negz_ltz'/.
    rewrite /-> negz_invol/.
    auto.
    }
  boolEq true /z`0 <z=? a/.
    {
    apply /ltz_impl_leqz/ >> auto.
    }
  apply /negz_invol/.
  }

  {
  subst /a/.
  reduce //.
  reflexivity.
  }

  {
  boolEq true /z`0 <z=? ~z a/.
    {
    apply /negz_leqz'/.
    rewrite /-> negz_invol/.
    reduce //.
    apply /ltz_impl_leqz/ >> auto.
    }
  boolEq false /z`0 <z=? a/.
    {
    apply /not_leqz/ >> auto.
    }
  auto.
  }
qed ();



lemma "absz_timesz"
/
  forall a b .
    absz (a *z b) = absz a *z absz b : integer
/;

inference.
assert /forall a b . z`0 <z= a -> z`0 <z= b -> absz (a *z b) = absz a *z absz b : integer/ /Hprop/.
  {
  inference.
  intro /a b Ha Hb/.
  unfold /absz at all/.
  boolEq true /z`0 <z=? a/ >> auto.
  boolEq true /z`0 <z=? b/ >> auto.
  boolEq true /z`0 <z=? a *z b/ >> auto.
  apply /timesz_leqz z`0 _ z`0/ >> autoWith /leqz_refl/.
  }
intro /a b/.
so /integer_dichotomy z`0 a/ /Ha | Ha/.
  {
  so /integer_dichotomy z`0 b/ /Hb | Hb/ >> auto.
    {
    so /ltz_impl_leqz _ _ (negz_ltz _# 2 Hb)/ /Hb'/.
    reduce /Hb'/.
    rewrite /<- absz_negz/.
    rewrite /-> negz_dist_timesz_r/.
    rewrite /-> Hprop/ >> auto.
    rewrite /-> absz_negz/ >> auto.
    }
  }
so /ltz_impl_leqz _ _ (negz_ltz _# 2 Ha)/ /Ha'/.
reduce /Ha'/.
so /integer_dichotomy z`0 b/ /Hb | Hb/ >> auto.
  {
  rewrite /<- absz_negz/.
  rewrite /-> negz_dist_timesz_l/.
  rewrite /-> Hprop/ >> auto.
  rewrite /-> absz_negz/ >> auto.
  }

  {
  so /ltz_impl_leqz _ _ (negz_ltz _# 2 Hb)/ /Hb'/.
  reduce /Hb'/.
  rewrite /<- absz_negz/.
  rewrite /<- absz_negz/.
  rewrite /-> negz_dist_timesz_l/.
  rewrite /-> negz_dist_timesz_r/.
  rewrite /-> Hprop/ >> auto.
  rewrite /-> absz_negz at 0 0/ >> auto.
  }
qed ();



lemma "absz_plusz_leqz"
/
  forall a b . absz (a +z b) <z= absz a +z absz b
/;

inference.
intro /a b/.
unfold /absz at all/.
boolCase /z`0 <z=? a/ /Ha/.
  {
  boolCase /z`0 <z=? b/ /Hb/.
    {
    boolEq true /z`0 <z=? a +z b/.
      {
      apply /plusz_leqz z`0 _ z`0/ >> auto.
      }
    apply /leqz_refl/.
    }

    {
    rewrite /-> not_leqz in Hb/.
    boolCase /z`0 <z=? a +z b/ /Hab/.
      {
      apply /plusz_leqz/.
        {
        apply /leqz_refl/.
        }

        {
        apply /leqz_trans _ z`0/ >> autoWith /ltz_impl_leqz/.
        apply /negz_leqz _ z`0/.
        apply /ltz_impl_leqz/ >> auto.
        }
      }

      {
      rewrite /-> negz_plusz/.
      apply /plusz_leqz/ >> autoWith /leqz_refl/.
      apply /leqz_trans _ z`0/ >> auto.
      apply /negz_leqz z`0/ >> auto.
      }
    }
  }

  {
  rewrite /-> not_leqz in Ha/.
  boolCase /z`0 <z=? b/ /Hb/.
    {
    boolCase /z`0 <z=? a +z b/ /Hab/.
      {
      apply /plusz_leqz/ >> autoWith /leqz_refl/.
      apply /leqz_trans _ z`0/.
        {
        apply /ltz_impl_leqz/ >> auto.
        }

        {
        apply /negz_leqz _ z`0/.
        apply /ltz_impl_leqz/ >> auto.
        }
      }

      {
      rewrite /-> not_leqz in Hab/.
      rewrite /-> negz_plusz/.
      apply /plusz_leqz/ >> autoWith /leqz_refl/.
      apply /leqz_trans _ z`0/ >> auto.
      apply /negz_leqz z`0/ >> auto.
      }
    }

    {
    rewrite /-> not_leqz in Hb/.
    boolEq false /z`0 <z=? a +z b/.
      {
      apply /not_leqz/.
      apply /plusz_ltz _ z`0 _ z`0/ >> auto.
      }
    rewrite /-> negz_plusz/.
    apply /leqz_refl/.
    }
  }
qed ();



lemma "absz_minusz_leqz"
/
  forall a b . absz (a -z b) <z= absz a +z absz b
/;

inference.
intro /a b/.
unfold /minusz/.
rewrite /<- absz_negz b/.
apply /absz_plusz_leqz/.
qed ();



lemma "absz_nat_to_integer"
/
  forall n . absz (nat_to_integer n) = nat_to_integer n : integer
/;

inference.
intro /n/.
apply /absz_of_nonneg/.
apply /nat_to_integer_nonneg/.
qed ();



lemma "absz_zero"
/
  absz z`0 = z`0 : integer
/;

unfold /absz/.
reflexivity.
qed ();



lemma "absz_zero_invert"
/
  forall a . absz a = z`0 : integer -> a = z`0 : integer
/;

inference.
intro /a/.
unfold /absz/.
boolCase /z`0 <z=? a/ /Hle/ >> auto.
intro /H1/.
so /negz_compat _ _ H1/ /H2/.
rewrite /-> negz_invol in H2/.
hyp /H2/.
qed ();



lemma "absz_one"
/
  absz z`1 = z`1 : integer
/;

unfold /absz/.
reflexivity.
qed ();



lemma "absz_minus_one"
/
  absz z`-1 = z`1 : integer
/;

unfold /absz/.
reflexivity.
qed ();



(* Division *)

define /nonzero/
/
  { x : integer | x != z`0 : integer }
//
  U 0
/;

unfold /nonzero/.
typecheck.
qed ();
setOpacity /nonzero/ Constant.SOFT;



lemma "divz_type"
/
  divz : integer -> nonzero -> integer
/;

assert /_/ /Htype/.
  {
  RuleTactic.divzType.
  }
fold /not _ within _ in Htype/.
fold /neq _ _ _ within _ in Htype/.
unfold /integer_zero in Htype/.
introOf /x/.
  {
  subsume /_/ >>> [idtac, hyp /Htype/].
  typecheck.
  }
introOf /y/.
  {
  inferSpine /Htype/ /__ x/ /Htype'/.
  subsume /_/ >>> [idtac, hyp /Htype'/].
  typecheck.
  }
destruct /y/ /y Hnzero/.
unhide.
inferSpine /Htype/ /__ x y/ /H/ >> auto.
qed ();
recordTyping "divz_type";



lemma "modz_type"
/
  modz : integer -> nonzero -> integer
/;

assert /_/ /Htype/.
  {
  RuleTactic.modzType.
  }
fold /not _ within _ in Htype/.
fold /neq _ _ _ within _ in Htype/.
unfold /integer_zero in Htype/.
introOf /x/.
  {
  subsume /_/ >>> [idtac, hyp /Htype/].
  typecheck.
  }
introOf /y/.
  {
  inferSpine /Htype/ /__ x/ /Htype'/.
  subsume /_/ >>> [idtac, hyp /Htype'/].
  typecheck.
  }
destruct /y/ /y Hnzero/.
unhide.
inferSpine /Htype/ /__ x y/ /H/ >> auto.
qed ();
recordTyping "modz_type";



lemma "modz_spec"
/
  forall (a : integer) (b : nonzero) .
    leqz z`0 (modz a b) & ltz (modz a b) (absz b)
/;

intro /x y/.
destruct /y/ /y Hnzero/.
split.
  {
  unhide.
  revert /x y Hnzero/.
  fold /integer_zero at 0 0/.
  unfold /neq/.
  unfold /not/.
  RuleTactic.modzSpec1.
  }

  {
  unhide.
  revert /x y Hnzero/.
  fold /integer_zero/.
  unfold /ltz/.
  fold /integer_one/.
  unfold /neq/.
  unfold /not/.
  unfold /absz/.
  fold /integer_zero/.
  RuleTactic.modzSpec2.
  }
qed ();



lemma "divz_spec"
/
  forall (a : integer) (b : nonzero) .
    divz a b *z b +z modz a b = a : integer
/;

intro /x (y Hnzero)/.
unhide.
revert /x y Hnzero/.
fold /integer_zero/.
unfold /neq/.
unfold /not/.
RuleTactic.divzSpec.
qed ();



lemma "modz_nonneg"
/
  forall a (b : nonzero) .
    z`0 <z= modz a b
/;

inference.
intro /a b/.
apply /modz_spec a b/.
qed ();



lemma "modz_ltz_r"
/
  forall a (b : nonzero) .
    modz a b <z absz b
/;

inference.
intro /a b/.
destruct /b/ /b Hnzero/.
unhide.
exact /modz_spec a b #2/.
qed ();



(* same as divz_spec *)
lemma "divz_prop"
/
  forall a (b : nonzero) .
    divz a b *z b +z modz a b = a : integer
/;

exact /divz_spec/.
qed ();



lemma "modz_prop"
/
  forall a (b : nonzero) .
    modz a b = a -z divz a b *z b : integer
/;

inference.
intro /a b/.
unfold /minusz/.
apply /plusz_shift_r/.
rewrite /-> plusz_commute/.
apply /divz_spec/.
qed ();



lemma "division_unique"
/
  forall a (b : nonzero) q q' r r' .
    a = q *z b +z r : integer
    -> a = q' *z b +z r' : integer
    -> z`0 <z= r
    -> z`0 <z= r'
    -> r <z absz b
    -> r' <z absz b
    -> q = q' : integer & r = r' : integer
/;

inference.
intro /a b q q' r r' Hdiv Hdiv' Hmodlo Hmodlo' Hmodhi Hmodhi'/.
so /Hdiv'/ /H/.
rewrite /-> Hdiv in H/.
rewrite /-> plusz_shift_l in H/.
rewrite /<- plusz_assoc in H/.
rewrite /-> negz_dist_timesz_l in H/.
rewrite /<- timesz_dist_plusz_l in H/.
rewrite /-> plusz_commute in H at 1/.
assert /exists d . (q +z ~z q') *z b = d *z absz b : integer/ /d Hd/.
  {
  clear /H/.
  inference.
  unfold /absz/.
  boolCase /z`0 <z=? b/ /Hlt/.
    {
    exists /q +z ~z q'/.
    auto.
    }

    {
    exists /~z q +z q'/.
    rewrite /<- negz_dist_timesz_r/.
    rewrite /-> negz_dist_timesz_l/.
    rewrite /-> negz_plusz/.
    rewrite /-> negz_invol/.
    reflexivity.
    }
  }
moveBefore /d/ /H/.
rewrite /-> Hd in H/.
so /integer_trichotomy d z`0/ /Hlt | Heq | Hlt/.
1:{
  subst /d/.
  rewrite /-> timesz_ann_l in H/.
  rewrite /-> plusz_id_l in H/.
  subst /r'/.
  split >> auto.
  rewrite /-> timesz_ann_l in Hd/.
  so /integer_integral_domain _# 2 Hd/ /Heq | Heq/.
    {
    rewrite /<- plusz_shift_rl in Heq/.
    rewrite /-> plusz_id_l in Heq/.
    auto.
    }

    {
    destruct /b/ /b Hnonzero/.
    unhide.
    subst /b/.
    so /Hnonzero ()/ /0/.
    }
  }

  {
  exfalso.
  rewrite /<- not_ltz in Hmodlo'/.
  witness /Hmodlo' __/.
  subst /r'/.
  so /Hmodhi/ /H/.
  so /plusz_ltz_r (d *z absz b) (d *z absz b) _ _ (leqz_refl _) H/ /H'/.
  witness /ltz_leqz_trans _# 3 H' __/.
  clear /H H'/.
  rewrite /<- timesz_id_l (absz b) at 1/.
  rewrite /<- timesz_dist_plusz_l/.
  apply /timesz_leqz_zero_neg_pos/.
    {
    unfold /ltz in Hlt/.
    rewrite /-> plusz_commute/ >> auto.
    }

    {
    apply /absz_nonneg/.
    }
  }

  {
  exfalso.
  rewrite /<- not_leqz in Hmodhi'/.
  witness /Hmodhi' __/.
  subst /r'/.
  so /Hmodlo/ /H/.
  apply /leqz_trans _ (d *z absz b)/.
    {
    rewrite /<- timesz_id_l (absz b)/.
    apply /timesz_leqz_r/.
      {
      apply /absz_nonneg/.
      }

      {
      unfold /ltz in Hlt/.
      rewrite /-> plusz_id_r in Hlt/.
      auto.
      }
    }

    {
    rewrite /<- (plusz_id_r (d *z absz b))/.
    apply /plusz_leqz/ >> auto.
    apply /leqz_refl/.
    }
  }
qed ();



lemma "division_property"
/
  forall a (b : nonzero) q r .
    a = q *z b +z r : integer
    -> z`0 <z= r
    -> r <z absz b
    -> divz a b = q : integer & modz a b = r : integer
/;

inference.
intro /a b q r Hdiv Hmodlo Hmodhi/.
apply /division_unique a b/ >> auto.
  {
  symmetry.
  apply /divz_prop/.
  }

  {
  apply /modz_nonneg/.
  }

  {
  apply /modz_ltz_r/.
  }
qed ();



lemma "divz_timesz_r"
/
  forall a (b : nonzero) .
    divz (a *z b) b = a : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
witness /division_property _ _ a z`0 __ __ __ #1/.
  {
  rewrite /-> plusz_id_r/ >> auto.
  }

  {
  apply /leqz_refl/.
  }

  {
  apply /not_leqz/.
  contrapositive /Hpos/.
  apply /absz_zero_invert/.
  apply /leqz_antisymm/ >> auto.
  apply /absz_nonneg/.
  }
qed ();



lemma "divz_timesz_l"
/
  forall a (b : nonzero) .
    divz (b *z a) b = a : integer
/;

inference.
intro /a b/.
rewrite /-> timesz_commute/.
apply /divz_timesz_r/.
qed ();



lemma "modz_timesz_r"
/
  forall a (b : nonzero) .
    modz (a *z b) b = z`0 : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
witness /division_property _ _ a z`0 __ __ __ #2/.
  {
  rewrite /-> plusz_id_r/ >> auto.
  }

  {
  apply /leqz_refl/.
  }

  {
  apply /not_leqz/.
  contrapositive /Hpos/.
  apply /absz_zero_invert/.
  apply /leqz_antisymm/ >> auto.
  apply /absz_nonneg/.
  }
qed ();



lemma "modz_timesz_l"
/
  forall a (b : nonzero) .
    modz (b *z a) b = z`0 : integer
/;

inference.
intro /a b/.
rewrite /-> timesz_commute/.
apply /modz_timesz_r/.
qed ();



lemma "divz_0"
/
  forall (a : nonzero) . divz z`0 a = z`0 : integer
/;

intro /a/.
rewrite /<- timesz_ann_r a/.
rewrite /-> divz_timesz_l/.
auto.
qed ();



lemma "modz_0"
/
  forall (a : nonzero) . modz z`0 a = z`0 : integer
/;

intro /a/.
rewrite /-> modz_prop/.
rewrite /-> divz_0/.
rewrite /-> timesz_ann_l/.
unfold /minusz/.
reflexivity.
qed ();



lemma "divz_1"
/
  forall a . divz a z`1 = a : integer
/;

inference.
intro /a/.
assert /z`1 != z`0 : integer/ /Hnonzero/.
  {
  intro /H/.
  symmetryIn /H/.
  so /neq_0_1 H/ /0/.
  }
rewrite /<- timesz_id_r a/.
rewrite /-> divz_timesz_r/.
auto.
qed ();



lemma "modz_1"
/
  forall a . modz a z`1 = z`0 : integer
/;

inference.
intro /a/.
assert /z`1 != z`0 : integer/ /Hnonzero/.
  {
  intro /H/.
  symmetryIn /H/.
  so /neq_0_1 H/ /0/.
  }
rewrite /<- timesz_id_r a/.
rewrite /-> modz_timesz_r/.
auto.
qed ();



lemma "divz_self"
/
  forall (a : nonzero) . divz a a = z`1 : integer
/;

inference.
intro /a/.
rewrite /<- timesz_id_r a/.
rewrite /-> divz_timesz_l/.
auto.
qed ();



lemma "modz_self"
/
  forall (a : nonzero) . modz a a = z`0 : integer
/;

inference.
intro /a/.
rewrite /<- timesz_id_r a/.
rewrite /-> modz_timesz_l/.
auto.
qed ();



lemma "divz_plusz_r"
/
  forall a (b : nonzero) .
    divz (a +z b) b = z`1 +z divz a b : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hnonzero/.
unhide.
witness /division_property _ _ (z`1 +z divz a b) (modz a b) __ __ __ #1/.
  {
  rewrite /-> timesz_dist_plusz_l/.
  rewrite /-> timesz_id_l/.
  rewrite /-> plusz_commute/.
  rewrite /-> plusz_assoc/.
  compat.
  symmetry.
  apply /divz_spec/.
  }

  {
  apply /modz_nonneg/.
  }

  {
  apply /modz_spec/.
  }
qed ();



lemma "divz_plusz_l"
/
  forall a (b : nonzero) .
    divz (b +z a) b = z`1 +z divz a b : integer
/;

inference.
intro /a b/.
rewrite /-> plusz_commute/.
apply /divz_plusz_r/.
qed ();



lemma "modz_plusz_r"
/
  forall a (b : nonzero) .
    modz (a +z b) b = modz a b : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hnonzero/.
unhide.
witness /division_property _ _ (z`1 +z divz a b) (modz a b) __ __ __ #2/.
  {
  rewrite /-> timesz_dist_plusz_l/.
  rewrite /-> timesz_id_l/.
  rewrite /-> plusz_commute/.
  rewrite /-> plusz_assoc/.
  compat.
  symmetry.
  apply /divz_spec/.
  }

  {
  apply /modz_nonneg/.
  }

  {
  apply /modz_spec/.
  }
qed ();



lemma "modz_plusz_l"
/
  forall a (b : nonzero) .
    modz (b +z a) b = modz a b : integer
/;

inference.
intro /a b/.
rewrite /-> plusz_commute/.
apply /modz_plusz_r/.
qed ();



lemma "divz_minusz"
/
  forall a (b : nonzero) .
    divz (a -z b) b = z`-1 +z divz a b : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hnonzero/.
unhide.
witness /division_property _ _ (z`-1 +z divz a b) (modz a b) __ __ __ #1/.
  {
  unfold /minusz/.
  rewrite /-> timesz_dist_plusz_l/.
  rewrite /<- negz_as_timesz/.
  rewrite /-> plusz_commute/.
  rewrite /-> plusz_assoc/.
  compat.
  symmetry.
  apply /divz_spec/.
  }

  {
  apply /modz_nonneg/.
  }

  {
  apply /modz_spec/.
  }
qed ();



lemma "modz_minusz"
/
  forall a (b : nonzero) .
    modz (a -z b) b = modz a b : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hnonzero/.
unhide.
witness /division_property _ _ (z`-1 +z divz a b) (modz a b) __ __ __ #2/.
  {
  unfold /minusz/.
  rewrite /-> timesz_dist_plusz_l/.
  rewrite /<- negz_as_timesz/.
  rewrite /-> plusz_commute/.
  rewrite /-> plusz_assoc/.
  compat.
