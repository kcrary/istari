inference.
intro /m n/.
boolCase /Nat.neqb m n/ /H/.
  {
  boolEq true /neqzb (nat_to_integer m) (nat_to_integer n)/ >> auto.
  contrapositive /H/.
  rewrite /<- nat_to_integer_inv m , <- nat_to_integer_inv n/.
  compat >> auto.
  }

  {
  boolEq false /neqzb (nat_to_integer m) (nat_to_integer n)/ >> auto.
  contrapositive /H/.
  contrapositive /H/.
  compat >> auto.
