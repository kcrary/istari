
File.import "acc-load.iml";
File.import "nat-load.iml";
File.import "logic-load.iml";
File.import "bool-load.iml";
File.import "decidable-load.iml";
File.import "partial-load.iml";
File.import "stable-load.iml";

File.import "integer-aux.iml";

Namespace.beginModule "Integer";


aliasExport /eqzb/ Prim.eqzb;
aliasExport /leqzb/ Prim.leqzb;
aliasExport /negz/ Prim.negz;
aliasExport /plusz/ Prim.plusz;
aliasExport /timesz/ Prim.timesz;
aliasExport /divz/ Prim.divz;
aliasExport /modz/ Prim.modz;


(* Built-in:

defineRaw /integer_zero/
/
  z`0
/;

defineRaw /integer_one/
/
  z`1
/;

definerecRaw /nat_to_integer n/
/
  nat_case n
    z`0
    (fn n' . plusz (z`1) (nat_to_integer n'))
/;

defineRaw /leqz m n/
/
  isquash (exists (p : nat) . plusz m (nat_to_integer p) = n : integer)
/;

*)

aliasExport /integer_zero/ Prim.integer_zero;
aliasExport /integer_one/ Prim.integer_one;
aliasExport /nat_to_integer/ Prim.nat_to_integer;
aliasExport /leqz/ Prim.leqz;



lemma "integer_type"
/
  integer : U 0
/;

RuleTactic.integerFormUniv.
RuleTactic.lzeroLevel.
qed ();
Define.recordTyping "integer_type";



lemma "eqzb_type"
/
  eqzb : integer -> integer -> bool
/;

RuleTactic.eqzbType.
qed ();
Define.recordTyping "eqzb_type";



lemma "leqzb_type"
/
  leqzb : integer -> integer -> bool
/;

RuleTactic.leqzbType.
qed ();
Define.recordTyping "leqzb_type";



lemma "plusz_type"
/
  plusz : integer -> integer -> integer
/;

RuleTactic.pluszType.
qed ();
Define.recordTyping "plusz_type";



lemma "negz_type"
/
  negz : integer -> integer
/;

RuleTactic.negzType.
qed ();
Define.recordTyping "negz_type";



lemma "timesz_type"
/
  timesz : integer -> integer -> integer
/;

RuleTactic.timeszType.
qed ();
Define.recordTyping "timesz_type";



lemma "integer_zero_type"
/
  integer_zero : integer
/;

unfold /integer_zero/.
RuleTactic.integerIntroOf.
qed ();
Define.recordTyping "integer_zero_type";



lemma "integer_one_type"
/
  integer_one : integer
/;

unfold /integer_one/.
RuleTactic.integerIntroOf.
qed ();
Define.recordTyping "integer_one_type";



Database.setUnroll Prim.nat_to_integer
  (Reduction.trans
     [DefineInternal.recUnroller Prim.nat_to_integer,
      Reduction.beta 1]);

reductions
/
  nat_to_integer (zero) --> z`0 ;
  nat_to_integer (succ n) --> plusz z`1 (nat_to_integer n) ;
  unrolling nat_to_integer
/;



lemma "nat_to_integer_type"
/
  nat_to_integer : nat -> integer
/;

introOf /n/.
sinduction /n/.
reintro /IH/.
destruct /n/ /| n/.
  {
  reduce //.
  typecheck.
  }

  {
  reduce //.
  typecheck.
  apply /IH/.
  apply /Nat.lt_succ/.
  }
qed ();
Define.recordTyping "nat_to_integer_type";



lemma "leqz_type"
/
  leqz : integer -> integer -> U 0
/;

unfold /leqz/.
typecheck.
qed ();
Define.recordTyping "leqz_type";
  


define /ltzb x y/
/
  leqzb (plusz z`1 x) y
//
  integer -> integer -> bool
/;

unfold /ltzb/.
typecheck.
qed ();

Define.registerNative 0 2 (Define.unfold1 (parseConstant /ltzb/) 2);



define /ltz x y/
/
  leqz (plusz z`1 x) y
//
  integer -> integer -> U 0
/;

unfold /ltz/.
typecheck.
qed ();



define /minusz x y/
/
  plusz x (negz y)
//
  integer -> integer -> integer
/;

unfold /minusz/.
typecheck.
qed ();

Define.registerNative 0 2 (Define.unfold1 (parseConstant /minusz/) 2);



structure Nothing = AfterLtz ();



lemma "neq_0_1"
/
  z`0 = z`1 : integer -> void
/;

intro /H/.
assert /_/ /Hchar/.
  {
  RuleTactic.integerCharacteristic.
  }
witness /Hchar 0 __/.
reduce //.
unfold /integer_zero/.
symmetry.
hyp /H/.
qed ();



(* Plus and Negation *)

lemma "plusz_commute"
/
  forall a b . a +z b = b +z a : integer
/;

inference.
RuleTactic.pluszCommute >> auto.
qed ();



lemma "plusz_assoc"
/
  forall a b c . (a +z b) +z c = a +z (b +z c) : integer
/;

inference.
RuleTactic.pluszAssoc >> auto.
qed ();



lemma "plusz_id_l"
/
  forall a . z`0 +z a = a : integer
/;

inference.
fold /integer_zero/.
RuleTactic.pluszIdentity >> auto.
qed ();



lemma "plusz_id_r"
/
  forall a . a +z z`0 = a : integer
/;

inference.
intro /a/.
rewrite /-> plusz_commute/.
apply /plusz_id_l/.
qed ();



lemma "plusz_inverse_r"
/
  forall a . a +z ~z a = z`0 : integer
/;

inference.
fold /integer_zero/.
RuleTactic.pluszInverse >> auto.
qed ();



lemma "plusz_inverse_l"
/
  forall a . ~z a +z a = z`0 : integer
/;

inference.
intro /a/.
rewrite /-> plusz_commute/.
apply /plusz_inverse_r/.
qed ();



lemma "negz_invol"
/
  forall a . ~z (~z a) = a : integer
/;

inference.
intro /a/.
rewrite /<- plusz_id_l a at 1/.
rewrite /<- plusz_inverse_l (~z a)/.
rewrite /-> plusz_assoc/.
rewrite /-> plusz_inverse_l/.
rewrite /-> plusz_id_r/.
reflexivity.
qed ();



lemma "negz_plusz"
/
  forall a b . ~z (a +z b) = ~z a +z ~z b : integer
/;

inference.
intro /a b/.
rewrite /<- plusz_id_l (_ +z _) at 1/.
rewrite /<- plusz_inverse_l (a +z b)/.
rewrite /-> plusz_assoc/.
rewrite /-> plusz_commute at 4/.
rewrite /<- plusz_assoc at 1/.
rewrite /-> plusz_assoc at 1/.
rewrite /-> plusz_inverse_r/.
rewrite /-> plusz_id_r/.
rewrite /-> plusz_inverse_r/.
rewrite /-> plusz_id_r/.
reflexivity.
qed ();



lemma "plusz_cancel_l"
/
  forall a b c .
    c +z a = c +z b : integer
    -> a = b : integer
/;

intro /a b c Heq/.
rewrite /<- plusz_id_l a , <- plusz_id_l b/.
rewrite /<- plusz_inverse_l c at all/.
rewrite /-> plusz_assoc at all/.
compat >> auto.
qed ();



lemma "plusz_cancel_r"
/
  forall a b c .
    a +z c = b +z c : integer
    -> a = b : integer
/;

intro /a b c Heq/.
rewrite /-> plusz_commute in Heq at 0 1/.
apply /plusz_cancel_l/ >> auto.
qed ();



lemma "plusz_shift_r"
/
  forall a b c .
    a +z b = c : integer
    <->
    a = c +z ~z b : integer
/;

inference.
intro /a b c/.
split.
  {
  intro /H/.
  apply /plusz_cancel_r _ _ b/.
  rewrite /-> plusz_assoc/.
  rewrite /-> plusz_inverse_l/.
  rewrite /-> plusz_id_r/.
  auto.
  }

  {
  intro /H/.
  apply /plusz_cancel_r _ _ (~z b)/.
  rewrite /-> plusz_assoc/.
  rewrite /-> plusz_inverse_r/.
  rewrite /-> plusz_id_r/.
  auto.
  }
qed ();



lemma "plusz_shift_l"
/
  forall a b c .
    a = b +z c : integer
    <->
    ~z b +z a = c : integer
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
rewrite /-> eq_symm_iff at 0 1/.
apply /plusz_shift_r/.
qed ();



lemma "plusz_shift_lr"
/
  forall a b c .
    a +z b = c : integer
    <->
    b = ~z a +z c : integer
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_shift_r/.
qed ();



lemma "plusz_shift_rl"
/
  forall a b c .
    a = b +z c : integer
    <->
    a +z ~z c = b : integer
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_shift_l/.
qed ();



lemma "plusz_compat"
/
  forall a a' b b' .
    a = a' : integer
    -> b = b' : integer
    -> a +z b = a' +z b' : integer
/;

inference.
intro /a a' b b' Ha Hb/.
subst /a'/.
subst /b'/.
reflexivity.
qed ();



lemma "negz_compat"
/
  forall a a' . a = a' : integer -> negz a = negz a' : integer
/;

inference.
intro /a a' Ha/.
subst /a'/.
reflexivity.
qed ();



lemma "neq_0_neg1"
/
  z`0 = z`-1 : integer -> void
/;

intro /H1/.
so /negz_compat _ _ H1/ /H2/.
reduce /H2/.
apply /neq_0_1/ >> auto.
qed ();



(* Inequalities *)

lemma "leqz_inhabitant"
/
  forall a b . a <z= b -> () : a <z= b
/;

inference.
unfold /leqz at all/.
intro /a b Hle/.
typecheck.
qed ();



lemma "ltz_inhabitant"
/
  forall a b . a <z b -> () : a <z b
/;

inference.
unfold /ltz at all/.
intro /a b Hlt/.
apply /leqz_inhabitant/ >> auto.
qed ();



structure Nothing = AfterLeqzInhabitant ();



lemma "leqz_0_1"
/
  z`0 <z= z`1
/;

unfold /leqz/.
split.
exists /1/.
reduce //.
reflexivity.
qed ();



lemma "ltz_0_1"
/
  z`0 <z z`1
/;

unfold /ltz , leqz/.
split.
exists /0/.
reduce //.
reflexivity.
qed ();



lemma "leqz_neg1_0"
/
  z`-1 <z= z`0
/;

unfold /leqz/.
split.
exists /1/.
reduce //.
reflexivity.
qed ();



lemma "ltz_neg1_0"
/
  z`-1 <z z`0
/;

unfold /ltz , leqz/.
split.
exists /0/.
reduce //.
reflexivity.
qed ();



lemma "leqz_refl"
/
  forall a . a <z= a
/;

inference.
intro /a/.
unfold /leqz/.
split.
exists /0/.
reduce //.
rewrite /-> plusz_id_r/.
reflexivity.
qed ();



lemma "leqz_refl_eq"
/
  forall a b . a = b : integer -> a <z= b
/;

inference.
intro /a b Heq/.
subst /b/.
apply /leqz_refl/.
qed ();



lemma "plus_to_integer"
/
  forall m n . nat_to_integer (m + n) = nat_to_integer m +z nat_to_integer n : integer
/;

inference.
intro /a b/.
induction /a/.

(* 0 *)
{
rewrite /-> plusz_id_l/.
reflexivity.
}

(* succ *)
{
intro /a IH/.
rewrite /-> plusz_assoc/.
compat.
hyp /IH/.
}
qed ();



lemma "leqz_trans"
/
  forall a b c . a <z= b -> b <z= c -> a <z= c
/;

inference.
intro /a b c Hab Hbc/.
unfold /leqz in Hab in Hbc in concl/.
destruct /Hab/ /[(m Hab)]/.
destruct /Hbc/ /[(n Hbc)]/.
split.
exists /m + n/.
rewrite /-> plus_to_integer/.
rewrite /<- plusz_assoc/.
rewrite /-> Hab/.
hyp /Hbc/.
qed ();



lemma "leqz_antisymm"
/
  forall a b . a <z= b -> b <z= a -> a = b : integer
/;

inference.
intro /a b Hab Hba/.
unfold /leqz in Hab in Hba/.
destruct /Hab/ /[(m Hab)]/.
destruct /Hba/ /[(n Hba)]/.
rewrite /<- Hab in Hba in concl/.
rewrite /-> plusz_assoc in Hba/.
rewrite /<- plus_to_integer in Hba/.
rewrite /<- plusz_id_r a in Hba at 1/.
so /plusz_cancel_l _# 3 Hba/ /H/.
destruct /m/ /| m/.
  {
  reduce //.
  rewrite /-> plusz_id_r/ >> auto.
  }

  {
  exfalso.
  fold /integer_zero in H/.
  assert /_/ /Hchar/.
    {
    RuleTactic.integerCharacteristic.
    }
  witness /Hchar (m + n) __/.
  auto.
  }
qed ();



lemma "plusz_leqz"
/
  forall a a' b b' . a <z= a' -> b <z= b' -> a +z b <z= a' +z b'
/;

inference.
intro /a a' b b' Ha Hb/.
unfold /leqz in Ha in Hb in concl/.
destruct /Ha/ /[(m Ha)]/.
destruct /Hb/ /[(n Hb)]/.
split.
exists /m + n/.
rewrite /-> plus_to_integer/.
rewrite /-> plusz_commute at 2/.
rewrite /<- plusz_assoc/.
rewrite /-> plusz_assoc at 1/.
rewrite /-> Hb/.
rewrite /-> plusz_commute/.
rewrite /<- plusz_assoc/.
rewrite /-> plusz_commute at 1/.
rewrite /-> Ha/.
reflexivity.
qed ();



lemma "plusz_cancel_leqz_l"
/
  forall a b c . c +z a <z= c +z b -> a <z= b
/;

inference.
intro /a b c Hle/.
so /plusz_leqz _# 4 (leqz_refl (~z c)) Hle/ /H/.
rewrite /<- plusz_assoc in H at all/.
rewrite /-> plusz_inverse_l in H at all/.
rewrite /-> plusz_id_l in H at all/.
hyp /H/.
qed ();



lemma "plusz_cancel_leqz_r"
/
  forall a b c . a +z c <z= b +z c -> a <z= b
/;

inference.
intro /a b c Hle/.
rewrite /-> plusz_commute in Hle at 0 1/.
apply /plusz_cancel_leqz_l/ >> auto.
qed ();



lemma "leqz_implication"
/
  forall a a' b b' . a' <z= a -> b <z= b' -> a <z= b -> a' <z= b'
/;

inference.
intro /a a' b b' Ha Hb Hab/.
apply /leqz_trans/ >> auto.
apply /leqz_trans/ >> auto.
qed ();



lemma "ltz_impl_leqz"
/
  forall a b . a <z b -> a <z= b
/;

inference.
intro /a b H/.
unfold /ltz in H/.
rewrite /<- plusz_id_l a/.
apply /leqz_trans/ >> auto.
apply /plusz_leqz/.
  {
  apply /leqz_0_1/.
  }

  {
  apply /leqz_refl/.
  }
qed ();



lemma "ltz_succ"
/
  forall a . a <z z`1 +z a
/;

inference.
intro /a/.
unfold /ltz/.
apply /leqz_refl/.
qed ();



lemma "leqz_succ"
/
  forall a . a <z= z`1 +z a
/;

inference.
intro /a/.
apply /ltz_impl_leqz/.
apply /ltz_succ/.
qed ();



lemma "ltz_irrefl"
/
  forall a . a <z a -> void
/;

inference.
intro /a H/.
unfold /ltz in H/.
apply /neq_0_1/.
apply /leqz_antisymm/.
  {
  apply /leqz_0_1/.
  }

  {
  apply /plusz_cancel_leqz_r _ _ a/.
  rewrite /-> plusz_id_l/.
  hyp /H/.
  }
qed ();



lemma "ltz_impl_neq"
/
  forall a b . 
    a <z b
    -> a != b : integer
/;

inference.
intro /a b Hlt/.
intro /?/.
subst /b/.
so /ltz_irrefl _ Hlt/ /0/.
qed ();

    

lemma "ltz_trans"
/
  forall a b c . a <z b -> b <z c -> a <z c
/;

inference.
intro /a b c Hab Hbc/.
unfold /ltz in Hab in Hbc in concl/.
apply /leqz_trans/ >> auto.
apply /leqz_trans/ >> auto.
rewrite /<- plusz_id_l b/.
apply /plusz_leqz/.
  {
  apply /leqz_0_1/.
  }

  {
  apply /leqz_refl/.
  }
qed ();



lemma "leqz_ltz_trans"
/
  forall a b c . a <z= b -> b <z c -> a <z c
/;

inference.
intro /a b c Hab Hbc/.
unfold /ltz in Hbc in concl/.
apply /leqz_trans/ >> auto.
apply /plusz_leqz/ >> auto.
apply /leqz_refl/.
qed ();



lemma "ltz_leqz_trans"
/
  forall a b c . a <z b -> b <z= c -> a <z c
/;

inference.
intro /a b c Hab Hbc/.
unfold /ltz in Hab in concl/.
apply /leqz_trans/ >> auto.
qed ();



lemma "plusz_cancel_leqz_leqz_l"
/
  forall a a' b b' .
    a +z b <z= a' +z b'
    -> a' <z= a
    -> b <z= b'
/;

inference.
intro /a a' b b' Hle Hlea/.
so /leqz_trans _# 3 Hle (plusz_leqz _# 4 Hlea (leqz_refl _))/ /H/.
apply /plusz_cancel_leqz_l/ >> auto.
qed ();



lemma "plusz_cancel_leqz_leqz_r"
/
  forall a a' b b' .
    a +z b <z= a' +z b'
    -> b' <z= b
    -> a <z= a'
/;

inference.
intro /a a' b b' Hle Hleb/.
rewrite /-> plusz_commute in Hle at 0 1/.
apply /plusz_cancel_leqz_leqz_l/ >> auto.
qed ();



lemma "plusz_shift_leqz_l"
/
  forall a b c .
    a <z= b +z c
    <->
    ~z b +z a <z= c
/;

inference.
intro /a b c/.
split.
  {
  intro /H/.
  apply /plusz_cancel_leqz_l _ _ b/.
  rewrite /<- plusz_assoc/.
  rewrite /-> plusz_inverse_r/.
  rewrite /-> plusz_id_l/.
  auto.
  }

  {
  intro /H/.
  apply /plusz_cancel_leqz_l _ _ (~z b)/.
  rewrite /<- plusz_assoc/.
  rewrite /-> plusz_inverse_l/.
  rewrite /-> plusz_id_l/.
  auto.
  }
qed ();



lemma "plusz_shift_leqz_r"
/
  forall a b c .
    a +z b <z= c
    <->
    a <z= c +z ~z b
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
rewrite /-> plusz_shift_leqz_l/.
rewrite /-> negz_invol/.
reflexivity.
qed ();



lemma "plusz_shift_leqz_lr"
/
  forall a b c .
    a +z b <z= c
    <->
    b <z= ~z a +z c
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_shift_leqz_r/.
qed ();



lemma "plusz_shift_leqz_rl"
/
  forall a b c .
    a <z= b +z c
    <-> a +z ~z c <z= b
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_shift_leqz_l/.
qed ();



lemma "plusz_ltz_l"
/
  forall a a' b b' . a <z a' -> b <z= b' -> a +z b <z a' +z b'
/;

inference.
intro /a a' b b' Ha Hb/.
unfold /ltz in Ha in concl/.
rewrite /<- plusz_assoc/.
apply /plusz_leqz/ >> auto.
qed ();



lemma "plusz_ltz_r"
/
  forall a a' b b' . a <z= a' -> b <z b' -> a +z b <z a' +z b'
/;

inference.
intro /a a' b b' Ha Hb/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_ltz_l/ >> auto.
qed ();



lemma "plusz_ltz"
/
  forall a a' b b' . a <z a' -> b <z b' -> a +z b <z a' +z b'
/;

inference.
intro /a a' b b' Ha Hb/.
apply /plusz_ltz_l/ >> auto.
apply /ltz_impl_leqz/ >> auto.
qed ();



lemma "plusz_cancel_ltz_l"
/
  forall a b c . c +z a <z c +z b -> a <z b
/;

inference.
intro /a b c Hlt/.
so /plusz_ltz_r _# 4 (leqz_refl (~z c)) Hlt/ /H/.
rewrite /<- plusz_assoc in H at all/.
rewrite /-> plusz_inverse_l in H at all/.
rewrite /-> plusz_id_l in H at all/.
hyp /H/.
qed ();



lemma "plusz_cancel_ltz_r"
/
  forall a b c . a +z c <z b +z c -> a <z b
/;

inference.
intro /a b c Hle/.
rewrite /-> plusz_commute in Hle at 0 1/.
apply /plusz_cancel_ltz_l/ >> auto.
qed ();



lemma "plusz_shift_ltz_l"
/
  forall a b c .
    a <z b +z c
    <->
    ~z b +z a <z c
/;

inference.
intro /a b c/.
unfold /ltz at all/.
rewrite /-> plusz_shift_leqz_l/.
rewrite /<- plusz_assoc at all/.
rewrite /-> plusz_commute at 1/.
reflexivity.
qed ();



lemma "plusz_shift_ltz_r"
/
  forall a b c .
    a +z b <z c
    <->
    a <z c +z ~z b
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
rewrite /-> plusz_shift_ltz_l/.
rewrite /-> negz_invol/.
reflexivity.
qed ();



lemma "plusz_shift_ltz_lr"
/
  forall a b c .
    a +z b <z c
    <->
    b <z ~z a +z c
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_shift_ltz_r/.
qed ();



lemma "plusz_shift_ltz_rl"
/
  forall a b c .
    a <z b +z c
    <-> a +z ~z c <z b
/;

inference.
intro /a b c/.
rewrite /-> plusz_commute at 0 1/.
apply /plusz_shift_ltz_l/.
qed ();



lemma "negz_leqz"
/
  forall a b . a <z= b -> ~z b <z= ~z a
/;

inference.
intro /a b H/.
apply /plusz_cancel_leqz_l _ _ (a +z b)/.
rewrite /-> plusz_assoc/.
rewrite /-> plusz_inverse_r/.
rewrite /-> plusz_id_r/.
rewrite /-> plusz_commute/.
rewrite /<- plusz_assoc/.
rewrite /-> plusz_inverse_l/.
rewrite /-> plusz_id_l/.
hyp /H/.
qed ();



lemma "negz_leqz'"
/
  forall a b . ~z b <z= ~z a -> a <z= b
/;

inference.
intro /a b H/.
so /negz_leqz _ _ H/ /H'/.
rewrite /-> negz_invol in H' at all/.
hyp /H'/.
qed ();



lemma "negz_ltz"
/
  forall a b . a <z b -> ~z b <z ~z a
/;

inference.
intro /a b Hab/.
unfold /ltz in Hab in concl/.
rewrite /<- plusz_id_l (~z a)/.
rewrite /<- plusz_inverse_r (z`1)/.
rewrite /--> plusz_assoc/.
apply /plusz_leqz/.
  {
  apply /leqz_refl/.
  }
change /concl/ /_ <z= ~z z`1 +z _/.
rewrite /<-- negz_plusz/.
apply /negz_leqz/.
hyp /Hab/.
qed ();



lemma "negz_ltz'"
/
  forall a b . ~z b <z ~z a -> a <z b
/;

inference.
intro /a b H/.
so /negz_ltz _ _ H/ /H'/.
rewrite /-> negz_invol in H' at all/.
hyp /H'/.
qed ();



lemma "not_leqz"
/
  forall a b . not (a <z= b) <-> b <z a
/;

inference.
intro /a b/.
split.
1:{
  intro /Hba Hab/.
  so /leqz_ltz_trans _# 3 Hab Hba/ /H/.
  so /ltz_irrefl _ H/ /0/.
  }
intro /Hab/.
assert /_/ /Helem/.
  {
  RuleTactic.integerElements.
  }
so /Helem (a -z (z`1 +z b))/ /[(n (Heq | Heq))]/.
  {
  exfalso.
  witness /Hab __/.
  reduce /Heq/.
  rewrite /-> negz_plusz in Heq/.
  unfold /minusz in Heq/.
  rewrite /-> negz_plusz in Heq/.
  rewrite /-> plusz_commute in Heq/.
  rewrite /-> plusz_assoc (negz z`1) in Heq/.
  so /plusz_cancel_l _ _ _ Heq/ /H/.
  rewrite /<- plusz_shift_l in H/.
  rewrite /<- plusz_shift_r in H/.
  unfold /leqz/.
  split.
  exists /n/.
  hyp /H/.
  }

  {
  so /plusz_compat _ _ (z`1 +z b) (z`1 +z b) Heq ()/ /H/.
  symmetryIn /H/.
  unfold /minusz in H/.
  rewrite /-> plusz_assoc in H/.
  rewrite /-> plusz_inverse_l in H/.
  rewrite /-> plusz_id_r in H/.
  unfold /ltz, leqz/.
  split.
  exists /n/.
  rewrite /-> plusz_commute/.
  hyp /H/.
  }
qed ();



lemma "not_ltz"
/
  forall a b . not (a <z b) <-> b <z= a
/;

inference.
intro /a b/.
unfold /ltz/.
rewrite /-> not_leqz/.
unfold /ltz/.
split.
  {
  intro /H/.
  apply /plusz_cancel_leqz_l/ >> auto.
  }

  {
  intro /H/.
  apply /plusz_leqz/ >> auto.
  apply /leqz_refl/.
  }
qed ();



lemma "ltz_from_leqz_neq"
/
  forall a b . a <z= b -> not (a = b : integer) -> a <z b
/;

inference.
intro /a b Hab Hneq/.
rewrite /<- not_leqz/.
intro /Hba/.
witness /Hneq __/.
apply /leqz_antisymm/ >> auto.
qed ();



lemma "ltz_as_leqz_l"
/
  forall a b .
    a <z b <-> z`1 +z a <z= b
/;

inference.
intro /a b/.
unfold /ltz/.
reflexivity.
qed ();



lemma "ltz_as_leqz_r"
/
  forall a b .
    a <z b <-> a +z z`1 <z= b
/;

inference.
intro /a b/.
rewrite /-> plusz_commute/.
apply /ltz_as_leqz_l/.
qed ();



lemma "leqz_as_ltz_l"
/
  forall a b .
    a <z= b <-> a <z z`1 +z b
/;

inference.
intro /a b/.
unfold /ltz/.
split.
  {
  intro /H/.
  apply /plusz_leqz/ >> auto.
  apply /leqz_refl/.
  }

  {
  intro /H/.
  apply /plusz_cancel_leqz_l/ >> auto.
  }
qed ();



lemma "leqz_as_ltz_r"
/
  forall a b .
    a <z= b <-> a <z b +z z`1
/;

inference.
intro /a b/.
rewrite /-> plusz_commute/.
apply /leqz_as_ltz_l/.
qed ();



(* Effective comparisons *)

lemma "istrue_eqzb"
/
  forall a b . Bool.istrue (eqzb a b) <-> a = b : integer
/;

inference.
intro /a b/.
split.
  {
  intro /H/.
  RuleTactic.eqzbSpec2 >> auto.
  apply /Bool.istrue_iff_eq_true/ >> auto.
  }

  {
  intro /H/.
  apply /Bool.istrue_iff_eq_true/.
  RuleTactic.eqzbSpec1 >> auto.
  }
qed ();



lemma "istrue_leqzb"
/
  forall a b . Bool.istrue (leqzb a b) <-> a <z= b
/;

inference.
intro /a b/.
split.
  {
  intro /H/.
  RuleTactic.leqzbSpec2 >> auto.
  apply /Bool.istrue_iff_eq_true/ >> auto.
  }

  {
  intro /H/.
  apply /Bool.istrue_iff_eq_true/.
  RuleTactic.leqzbSpec1 >> auto.
  }
qed ();



lemma "istrue_ltzb"
/
  forall a b . Bool.istrue (ltzb a b) <-> a <z b
/;

inference.
intro /a b/.
unfold /ltzb , ltz/.
rewrite /-> istrue_leqzb/.
reflexivity.
qed ();



define /neqzb a b/
/
  Bool.notb (eqzb a b)
//
  integer -> integer -> bool
/;

unfold /neqzb/.
typecheck.
qed ();



