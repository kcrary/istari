  }

  {
  apply /modz_spec/.
  }
qed ();



lemma "timesz_divz_l"
/
  forall a (b : nonzero) .
    divz a b *z b = a -z modz a b : integer
/;

inference.
intro /a b/.
destruct /b/ /b Hpos/.
unhide.
unfold /minusz/.
apply /plusz_shift_r/.
apply /divz_spec/.
qed ();



lemma "timesz_divz_r"
/
  forall a (b : nonzero) .
    b *z divz a b = a -z modz a b : integer
/;

inference.
intro /a b/.
