aliasExport /timesz_ltz_zero_pos_pos/ /timesz_ltz_zero/;



lemma "timesz_ltz_zero_pos_neg"
/
  forall a b .
    z`0 <z a
    -> b <z z`0
    -> a *z b <z z`0
