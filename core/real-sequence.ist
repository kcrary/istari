File.import "bool-load.iml";
File.import "integer-load.iml";
File.import "logic-load.iml";
File.import "nat-load.iml";
File.import "omega-load.iml";
File.import "rational-load.iml";
File.import "sqstable-load.iml";
File.import "real-load.iml";
File.import "squish-load.iml";

openModule /Nat/;
openModule /Real/;
openModule /Squish/;


Ctrl.use "autoQ.iml";


beginModule "RealSequence";


(* SET PARSING TO REAL *)
setArithReal ();


define /converges s x/
/
  squish
    (forall k . 
       n`0 <n k
       -> exists m . forall n .
            m <n= n
            -> absr (s n - x) <= invr (nat_to_real k))
//
  intersect i . (nat -> real) -> real -> U i
/;

inference.
unfold /converges/.
typecheck.
split.
apply /nat_to_real_nonzero/.
omega.
qed ();



lemma "converges_unique"
/
  forall s x y .
    converges s x
    -> converges s y
    -> x = y : real
/;

inference.
intro /s x y Hconvx Hconvy/.
apply /infinitely_close/.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /k Hposk/.
so /Hnonzeroall k Hposk/ /Hnonzerok/.
unfold /converges in Hconvx in Hconvy/.
so /squish_impl_squash _# 2 Hconvx/ /H/ >> auto.
clear /Hconvx/.
destruct /H/ /[Hconvx]/ >> auto.
so /squish_impl_squash _# 2 Hconvy/ /H/ >> auto.
clear /Hconvy/.
destruct /H/ /[Hconvy]/ >> auto.
unhide.
exploit /Hconvx (k *n n`2)/ /m Hm/.
  {
  omega.
  }
exploit /Hconvy (k *n n`2)/ /n Hn/.
  {
  omega.
  }
unfold /minusr/.
rewrite /<- plusr_id_r (_ +r _)/.
rewrite /<- plusr_inverse_l (s (max m n))/.
rewrite /<- plusr_assoc at all/.
rewrite /-> plusr_commute3 at 1/.
rewrite /-> plusr_commute3/.
rewrite /-> plusr_assoc/.
rewrite /-> absr_plusr_leqr/.
fold /minusr _ _ at 0 0/.
rewrite /-> absr_minusr_commute/.
assert /nat_to_real (k *n n`2) != r`0 : real/ /Hnonzero2k/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
rewrite /-> Hm (max m n)/.
1:{
  omega.
  }
rewrite /-> Hn (max m n)/.
1:{
  omega.
  }
rewrite /-> plusr_self/.
rewrite /nat_to_real (k *n n`2) = nat_to_real k *r r`2 : nonzero_real/.
  {
  apply /eq_nonzero_real/.
    {
    apply /nat_to_real_nonzero/.
    omega.
    }

    {
    rewrite /-> times_to_real/.
    compat.
    unfold /nat_to_real/.
    fold /integer_to_real _/.
    reflexivity.
    }
  }
assert /r`2 != r`0 : real/ /Hnonzero2/.
  {
  apply /integer_to_real_neq/.
  omega.
  }
rewrite /-> invr_timesr/.
rewrite /-> timesr_commute/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_l/.
rewrite /-> timesr_id_r/.
reflexivity.
qed ();



lemma "converges_equal"
/
  forall s s' x .
    (forall i . n`0 <n i -> s i = s' i : real)
    -> converges s x
    -> converges s' x
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s s' x Heq Hconv/.
unfold /converges in Hconv in concl/.
witness /squish_bind Hconv __/ >> auto.
clear /Hconv/.
intro /Hconv/ >> auto.
apply /squish_ret/ >> auto.
intro /k Hposk/.
so /Hconv k Hposk/ /m Hm/.
exists /succ m/ >> auto.
intro /n Hn/.
rewrite /<- Heq/ >> auto.
  {
  omega.
  }
apply /Hm/.
omega.
qed ();



define /cauchy s/
/
  squish
    (forall k .
       n`0 <n k
       -> exists m . forall n p .
            m <n= n
            -> m <n= p
            -> absr (s n - s p) <= invr (nat_to_real k))
//
  intersect i . (nat -> real) -> U i
/;

inference.
unfold /cauchy/.
typecheck.
split.
apply /nat_to_real_nonzero/.
omega.
qed ();



beginModule "Primitive";

openModule /Rational/;
openModule /Real.Primitive/;


setOpacity /prereal/ Constant.HARD;


lemma "cauchy_impl_converges_prereal"
/
  forall (s : nat -> prereal) .
    (forall k .
       n`0 <n k
       -> exists m . forall n p .
            m <n= n
            -> m <n= p
            -> absr (realintro (s n) - realintro (s p)) <= invr (nat_to_real k))
    -> exists (x : prereal) .
         forall k .
           n`0 <n k
           -> exists m . forall n .
                m <n= n
                -> absr (realintro (s n) - realintro x) <= invr (nat_to_real k)
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s Hcauchy/ >> auto.
unfold /prereal in s/.
assert /forall k . regular (s k)/ /Hregs/.
  {
  inference.
  intro /k/.
  squashConcl.
    {
    apply /regular_sqstable/.
    }
  infer /s k/ /Hofsk/.
  destructSet /Hofsk/ /H/.
  split.
  hyp /H/.
  }
set /M/ /fn k . nat_case k n`0 (fn _ . Hcauchy k () #1)/.
assert /M : nat -> nat/ /HofM/.
  {
  introOf /k/.
  unfold /M/.
  reduce //.
  destruct /k/ /| k/ >> reduce // >> typecheck.
  omega.
  }
set /N/ /fn k . max (k *n n`3) (M (k *n n`2))/.
assert /N : nat -> nat/ /HofN/.
  {
  unfold /N/.
  typecheck.
  }
assert /forall k n p .
          n`0 <n k
          -> M k <n= n
          -> M k <n= p
          -> absr (rintro (s n) (Hregs n) - rintro (s p) (Hregs p)) <= invr (nat_to_real k)/ /Hcauchy'/.
  {
  inference.
  intro /k n p Hposk Hn Hp/.
  so /Hcauchy k Hposk #2/ /H/.
  unfold /rintro at 0 0/.
  fold /realintro (s n)/.
  fold /realintro (s p)/.
  apply /H/.
    {
    unfold /M in Hn/.
    destruct /k/ /| k/ >>> [omega, idtac].
    reduce /Hn/.
    forceExact /Hn/.
    compat.
    compat.
    destruct /Hposk/ /()/.
    typecheck.
    clear /Hn Hp H/.
    omega.
    }

    {
    unfold /M in Hp/.
    destruct /k/ /| k/ >>> [omega, idtac].
    reduce /Hp/.
    forceExact /Hp/.
    compat.
    compat.
    destruct /Hposk/ /()/.
    typecheck.
    clear /Hn Hp H/.
    omega.
    }
  }
set /x/ /fn k . s (N k) (k *n n`2)/.
assert /x : nat -> rational/ /Hofx/.
  {
  unfold /x/.
  typecheck.
  }
assert /regular x/ /Hregx/.
  {
  intro /m n Hposm Hposn/.
  apply /rational_to_real_mono_conv/.
  rewrite /-> absq_to_real/.
  rewrite /-> minusq_to_real/.
  rewrite /-> plusq_to_real/.
  unfold /minusr/.
  rewrite /<- plusr_id_r (_ +r _)/.
  rewrite /<- plusr_inverse_l (rintro (s (N m)) (Hregs (N m)))/.
  rewrite /<- plusr_assoc at all/.
  rewrite /-> plusr_commute3 _ (~ (rational_to_real (x n)))/.
  rewrite /-> plusr_commute3 _ (~ (rational_to_real (x n)))/.
  rewrite /-> plusr_assoc/.
  rewrite /-> absr_plusr_leqr/.
  rewrite /<- plusr_id_r (_ +r _) at 2/.
  rewrite /<- plusr_inverse_l (rintro (s (N n)) (Hregs (N n)))/.
  rewrite /<- plusr_assoc at all/.
  rewrite /-> plusr_commute3 _ (~ (rational_to_real (x n)))/.
  rewrite /-> plusr_commute3 _ (~ (rational_to_real (x n)))/.
  rewrite /-> plusr_assoc/.
  rewrite /-> absr_plusr_leqr at 1/.
  fold /minusr _ _ at 0 0 0/.
  rewrite /-> absr_minusr_commute at 0/.
  rewrite /-> plusr_commute at 1/.
  rewrite /<- plusr_assoc/.
  exploit /approximations_nearby (s (N m)) (Hregs (N m)) (m *n n`2)/ /H/.
    {
    omega.
    }
  rewrite /s (N m) (m *n n`2) = x m : rational in H/.
    {
    unfold /x/.
    reflexivity.
    }
  rewrite /-> H/.
  clear /H/.
  exploit /approximations_nearby (s (N n)) (Hregs (N n)) (n *n n`2)/ /H/.
    {
    omega.
    }
  rewrite /s (N n) (n *n n`2) = x n : rational in H/.
    {
    unfold /x/.
    reflexivity.
    }
  rewrite /-> H/.
  clear /H/.
  assert /nat_to_real (m *n n`2) != r`0 : real/ /Hnonzero2m/.
    {
    apply /nat_to_real_nonzero/.
    omega.
    }
  assert /nat_to_real (n *n n`2) != r`0 : real/ /Hnonzero2n/.
    {
    apply /nat_to_real_nonzero/.
    omega.
    }
  assert /absr (rintro (s (N m)) (Hregs (N m)) - rintro (s (N n)) (Hregs (N n))) <= rational_to_real (invq (nat_to_rational (m *n n`2))) + rational_to_real (invq (nat_to_rational (n *n n`2)))/ /H/.
    {
    so /nat_dichotomy_weak (M (m *n n`2)) (M (n *n n`2))/ /Hleq | Hleq/.
      {
      exploit /Hcauchy' (m *n n`2) (N m) (N n)/ /H/.
        {
        omega.
        }
       
        {
        unfold /N at 0/.
        omega.
        }
        
        {
        unfold /N at 0/.
        omega.
        }
      rewrite /-> H/.
      clear /H/.
      unfold /nat_to_real/.
      fold /nat_to_rational _/.
      rewrite /<- invq_to_real/.
        {
        unfold /nat_to_rational/.
        apply /integer_to_rational_neq/.
        omega.
        }
      rewrite /<- plusr_id_r (rational_to_real _)/.
      apply /plusr_leqr/ >> auto.
      unfold /integer_to_real/.
      apply /rational_to_real_mono/.
      apply /invq_nonnegative/.
      unfold /nat_to_rational/.
      apply /integer_to_rational_mono/.
      omega.
      }

      {
      exploit /Hcauchy' (n *n n`2) (N n) (N m)/ /H/.
        {
        omega.
        }
       
        {
        unfold /N at 0/.
        omega.
        }
        
        {
        unfold /N at 0/.
        omega.
        }
      rewrite /-> absr_minusr_commute in H/.
      rewrite /-> H/.
      clear /H/.
      unfold /nat_to_real/.
      fold /nat_to_rational _/.
      rewrite /<- invq_to_real/.
        {
        unfold /nat_to_rational/.
        apply /integer_to_rational_neq/.
        omega.
        }
      rewrite /<- plusr_id_l (rational_to_real _)/.
      apply /plusr_leqr/ >> auto.
      unfold /integer_to_real/.
      apply /rational_to_real_mono/.
      apply /invq_nonnegative/.
      unfold /nat_to_rational/.
      apply /integer_to_rational_mono/.
      omega.
      }
    }
  rewrite /-> H/.
  clear /H/.
  rewrite /<- plusr_assoc/.
  rewrite /<- plusq_to_real at all/.
  apply /rational_to_real_mono/.
  rewrite /-> times_to_rational at all/.
  rewrite /-> invq_timesq at all/.
  rewrite /-> plusq_commute3 at 1/.
  rewrite /-> plusq_assoc/.
  rewrite /<- timesq_dist_plusq_r at 0 0/.
  assert /invq (nat_to_rational n`2) +q invq (nat_to_rational n`2) = q`1 : rational/ /H/.
    {
    rewrite /-> plusq_self/.
    unfold /nat_to_rational/.
    reduce //.
    apply /timesq_inverse_r/.
    apply /integer_to_rational_neq/.
    omega.
    }
  rewrite /-> H at 0 0/.
  clear /H/.
  rewrite /-> timesq_id_r at all/.
  reflexivity.
  }
assert /x : prereal/ /Hofx'/.
  {
  unfold /prereal/.
  typecheck.
  }
fold /prereal in s/.
exists /x/ >> auto.
clear /Hofx'/.
unfold /prereal in s/.
intro /k Hposk/.
unfold /realintro at 0 0/.
fold /rintro (s n) (Hregs n) within m n/.
fold /rintro x Hregx/.
exists /N k/ >> auto.
intro /n Hn/.
so /Hnonzeroall k Hposk/ /Hnonzero/.
rewrite /-> absr_minusr_commute/.
unfold /minusr/.
rewrite /<- plusr_id_r (_ + _)/.
rewrite /<- plusr_inverse_l (rational_to_real (x n))/.
rewrite /<- plusr_assoc/.
rewrite /-> plusr_commute3 at 1/.
rewrite /-> plusr_commute3 at 0/.
rewrite /-> plusr_assoc/.
rewrite /-> absr_plusr_leqr/.
rewrite /<- plusr_id_r (_ + _) at 2/.
rewrite /<- plusr_inverse_l (rintro (s (N n)) (Hregs (N n)))/.
rewrite /<- plusr_assoc/.
rewrite /-> plusr_commute3 at 1/.
rewrite /-> plusr_commute3 at 0/.
rewrite /-> plusr_assoc/.
rewrite /-> absr_plusr_leqr at 1/.
rewrite /<- plusr_assoc/.
assert /n`0 <n n/ /Hposn/.
  {
  unfold /N in Hn/.
  omega.
  }
fold /_ - _ at 0 0 0/.
rewrite /-> approximations_nearby x Hregx n Hposn/.
unfold /x/.
rewrite /-> absr_minusr_commute at 0/.
rewrite /-> approximations_nearby (s (N n)) (Hregs (N n)) (n *n n`2)/.
1:{
  omega.
  }
assert /nat_to_real (k *n n`2) != r`0 : real/ /Hnonzero2k/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
rewrite /-> Hcauchy' (k *n n`2) (N n) n/.
1:{
  omega.
  }

2:{
  unfold /N in Hn/.
  omega.
  }

1:{
  apply /leq_trans _ n/.
    {
    unfold /N in Hn/.
    omega.
    }
    
    {
    unfold /N/.
    omega.
    }
  }
unfold /nat_to_real/.
rewrite /<- invq_to_real/.
  {
  apply /integer_to_rational_neq/.
  omega.
  }
unfold /nat_to_real/.
rewrite /<- invq_to_real/.
  {
  apply /integer_to_rational_neq/.
  omega.
  }
rewrite /<- plusq_to_real at all/.
apply /rational_to_real_mono/.
rewrite /-> times_to_rational/.
unfold /nat_to_rational at 2/.
reduce //.
fold /nat_to_rational _/.
rewrite /-> times_to_rational/.
unfold /nat_to_rational at 3/.
reduce //.
fold /nat_to_rational _/.
rewrite /-> invq_timesq at 0 0/.
assert /k *n n`3 <n= n/ /H/.
  {
  unfold /N in Hn/.
  omega.
  }
rewrite /<- H at all/.
1:{
  autoQ.
  }

1:{
  autoQ.
  }

1:{
  apply /samesign_pos/ >> autoQ.
  }

1:{
  apply /samesign_pos/ >> autoQ.
  }
rewrite /-> times_to_rational at all/.
unfold /nat_to_rational at 1 2/.
reduce //.
rewrite /-> invq_timesq at 0 0/.
rewrite /-> timesq_assoc/.
rewrite /<- timesq_dist_plusq_r at all/.
rewrite /invq q`3 +q invq q`3 *q invq q`2 +q invq q`2 = q`1 : rational/.
1:{
  rewrite /-> timesq_id_r/.
  reflexivity.
  }
rewrite /<- invq_timesq/.
rewrite /<- timesz_to_rational z`3 z`2/.
reduce //.
apply /timesq_cancel_r _ _ q`6/.
  {
  autoQ.
  }
rewrite /-> timesq_id_l/.
rewrite /-> timesq_dist_plusq_l at 0 0/.
rewrite /-> timesq_inverse_l q`6/.
  {
  autoQ.
  }
rewrite /-> timesz_to_rational z`3 z`2/.
rewrite /<- timesq_assoc/.
rewrite /-> timesq_inverse_l/.
  {
  autoQ.
  }
rewrite /-> timesq_id_l/.
rewrite /-> timesz_to_rational z`2 z`3/.
rewrite /<- timesq_assoc/.
rewrite /-> timesq_inverse_l/.
  {
  autoQ.
  }
rewrite /-> timesq_id_l/.
rewrite /<- plusz_to_rational at 0 0/.
reflexivity.
qed ();



setOpacity /prereal/ Constant.OPAQUE;



endModule ();  (* RealSequence.Primitive *)


aliasExport /cauchy_impl_converges_prereal/ /Primitive.cauchy_impl_converges_prereal/;



lemma "cauchy_impl_converges"
/
  forall s .
    cauchy s
    -> exists x . converges s x
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s Hcauchy/.
assert /squish (exists (x : real) . converges s x)/ /Hprop/.
  {
  so /real_sequence_to_prereal_sequence s/ /H/.
  witness /Squish.squish_bind H __/.
  intro /(s' ?)/.
  subst /s/.
  rename /s'/ /s/.
  clear /H/.
  unfold /cauchy in Hcauchy/.
  witness /squish_bind Hcauchy __/ >> auto.
  clear /Hcauchy/.
  intro /Hcauchy/ >> auto.
  reduce /Hcauchy/.
  apply /squish_ret/.
  so /cauchy_impl_converges_prereal s Hcauchy/ /x Hconv/.
  exists /realintro x/.
  unfold /converges/.
  apply /squish_ret/ >> auto.
  }
apply /squish_elim/ >> auto.
intro /(x Hconvx) (y Hconvy)/.
assert /x = y : real/ /Heq/.
  {
  apply /converges_unique s/ >> auto.
  }
subst /y/.
extensionality >> reduce // >> auto.
unfold /converges in Hconvx in Hconvy in concl/.
apply /squish_ext/ >> auto.
qed ();



lemma "combine_halves"
/
  forall k .
    n`0 <n k
    -> invr (nat_to_real (k *n n`2)) + invr (nat_to_real (k *n n`2)) = invr (nat_to_real k) : real
/;

inference.
intro /k Hposk/.
assert /nat_to_real k != 0 : real/ /Hnonzerok/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
assert /nat_to_real (k *n n`2) != 0 : real/ /Hnonzero2k/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
assert /nat_to_real n`2 != 0 : real/ /Hnonzero2/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
rewrite /-> plusr_self/.
rewrite /nat_to_real (k *n n`2) = nat_to_real k * nat_to_real n`2 : nonzero_real/.
  {
  apply /eq_nonzero_real/.
    {
    apply /nat_to_real_nonzero/.
    omega.
    }

    {
    apply /times_to_real/.
    }
  }
rewrite /-> invr_timesr/.
rewrite /-> timesr_commute at 1/.
rewrite /<- timesr_assoc/.
unfold /nat_to_real/.
fold /integer_to_real _/.
rewrite /-> timesr_inverse_r/.
  {
  split.
  apply /integer_to_real_neq/.
  omega.
  }
rewrite /-> timesr_id_l/.
reflexivity.
qed ();



lemma "converges_impl_cauchy"
/
  forall s x .
    converges s x
    -> cauchy s
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s x Hconv/.
unfold /converges in Hconv/.
unfold /cauchy/.
witness /squish_bind Hconv __/ >> auto.
clear /Hconv/.
intro /Hconv/ >> auto.
apply /squish_ret/ >> auto.
intro /k Hposk/.
exploit /Hconv (k *n n`2)/ /H/.
  {
  omega.
  }
destruct /H/ /m Hm/.
assert /nat_to_real k != 0 : real/ /Hnonzerok/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
exists /m/.
intro /n p Hn Hp/.
rewrite /<- plusr_id_r (_ - _)/.
unfold /minusr/.
rewrite /<- plusr_inverse_l x/.
rewrite /<- plusr_assoc at all/.
rewrite /-> plusr_commute3 at 1/.
rewrite /-> plusr_assoc/.
rewrite /-> absr_plusr_leqr/.
rewrite /-> plusr_commute at 2/.
fold /_ - _ at 0 0/.
rewrite /-> absr_minusr_commute at 1/.
assert /nat_to_real (k *n n`2) != 0 : real/ /Hnonzero2k/.
  {
  apply /nat_to_real_nonzero/.
  omega.
  }
rewrite /-> Hm n/ >> auto.
rewrite /-> Hm p/ >> auto.
rewrite /-> combine_halves/ >> auto.
qed ();



lemma "converges_constant"
/
  forall x .
    converges (fn _ . x) x
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /x/.
unfold /converges/.
apply /squish_ret/ >> auto.
intro /k Hposk/.
so /Hnonzeroall k Hposk/ /Hnonzerok/.
exists /n`1/.
intro /m Hposn/.
reduce //.
rewrite /-> minusr_self/.
rewrite /-> absr_zero/.
apply /ltr_impl_leqr/.
apply /invr_positive/.
unfold /nat_to_real/.
fold /integer_to_real _/.
apply /integer_to_real_mono_lt/.
omega.
qed ();



lemma "converges_plusr"
/
  forall s s' x y .
    converges s x
    -> converges s' y
    -> converges (fn i . s i + s' i) (x + y)
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s s' x y Hconvx Hconvy/.
unfold /converges in Hconvx in Hconvy in concl/.
witness /squish_bind Hconvx __/ >> auto.
clear /Hconvx/.
intro /Hconvx/ >> auto.
