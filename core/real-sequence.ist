lemma "convergent_split"
/
  forall s n x .
    converges (sums (fn i . s (i +n n))) x
    -> converges (sums s) (sums s n + x)
/;

inference.
intro /s n x Hconv/.
apply /converges_equal (fn i . sums s n + sums (fn j . s (j +n n)) (i -n n)) _ _ n/.
  {
  intro /i Hi/.
  reduce //.
  symmetry.
  rewrite /-> plus_commute j n within j/.
  fold /ssums s n i/.
  apply /sums_split/ >> auto.
  }
apply /converges_plusr/.
  {
  apply /converges_constant/.
  }
apply /converges_from_tail _ n/.
reduce //.
witness /converges_equal _# 3 n __ Hconv/.
intro /i Hi/.
reduce //.
rewrite /-> Nat.plus_minus_cancel_r/.
reflexivity.
qed ();



lemma "convergent_from_tail"
/
  forall s n .
    cauchy (sums (fn i . s (i +n n)))
    -> cauchy (sums s)
/;

inference.
intro /s n Hconv/.
rewrite /-> cauchy_iff_converges in Hconv in concl/.
destruct /Hconv/ /x Hconv/.
exists /sums s n + x/.
apply /convergent_split/ >> auto.
qed ();



lemma "ratio_test"
/
  forall s c n .
    0 < c
    -> c < 1
    -> (forall i . n <n= i -> absr (s (succ i)) <= c * (absr (s i)))
    -> cauchy (sums s)
/;

inference.
intro /s c n Hposc Hc Hratio/.
assert /1 - c != 0 : real/ /Hnonzero1minusc/.
  {
  symmetry.
  apply /ltr_impl_neq/.
  rewrite /<- minusr_shift_ltr_rr/.
  rewrite /-> plusr_id_l/.
  hyp /Hc/.
  }
apply /comparison_test _ (fn i . nexpr c (i -n n) * absr (s n)) n/.
  {
  apply /convergent_from_tail _ n/.
  reduce //.
  rewrite /-> Nat.plus_minus_cancel_r within _/.
  apply /converges_impl_cauchy _ (absr (s n) * invr (1 - c))/.
  rewrite /-> timesr_commute within _/.
  apply /convergent_timesr_const (fn i . nexpr c i)/.
  apply /convergent_nexpr/ >> auto.
  }
reduce //.
intro /i Hi/.
revert /Hi/.
sinduction /i/.
reintro /IH/.
intro /Hi/.
rewrite /-> Nat.leq_iff_lt_or_eq in Hi/.
destruct /Hi/ /Hi | ?/.
1:{
  subst /i/.
  rewriteThen /n -n n = n`0 : nat/ omega.
  reduce //.
  rewrite /-> timesr_id_l/.
  reflexivity.
  }
destruct /i/ /| i/.
  {
  exfalso.
  omega.
  }
rewrite /-> Hratio/ >>> [idtac, omega].
rewrite /-> IH/.
  {
  rewriteThen /succ i -n n = succ (i -n n) : nat/ omega.
  reduce //.
  rewrite /<- timesr_assoc/.
  reflexivity.
  }

  {
  apply /ltr_impl_leqr/ >> auto.
  }

  {
  apply /absr_nonneg/.
  }

  {
  omega.
  }

  {
  omega.
  }
qed ();



lemma "convergent_alternation"
/
  forall s .
    (forall i . 0 <= s i)
    -> (forall i . s (succ i) <= s i)
    -> converges s 0
    -> cauchy (sums (fn i . nexpr -1 i * s i))
/;

inference.
intro /s Hpos Hdecrease Hconv/.
assert /forall m n . 
          m <n= n
          -> 0 <= nexpr -1 m * ssums (fn i . nexpr -1 i * s i) m n/ /Hlow/.
  {
  inference.
  intro /m n Hmn/.
  setEq /k/ /n -n m/ /_/ /Heqk/.
  revert /m n Hmn Heqk/.
  sinduction /k/.
  reintro /IH/.
  intro /m n Hmn Heqk/.
  rewrite /-> Nat.leq_iff_lt_or_eq in Hmn/.
  destruct /Hmn/ /Hmn | ?/.
  1:{
    subst /m/.
    rewrite /-> ssums_empty/.
    rewrite /-> timesr_ann_r/.
    reflexivity.
    }
  so /Nat.nat_dichotomy (n`2 +n m) n/ /Hmn' | Hmn'/.
  1:{
    assertThen /n = succ m : nat/ /?/ omega.
    subst /n/.
    reduce //.
    rewrite /-> ssums_singleton/.
    reduce //.
    rewrite /<- timesr_assoc at all/.
    rewrite /-> nexpr_minus_one_squared/.
    rewrite /-> timesr_id_l/.
    apply /Hpos/.
    }
  rewrite /-> timesr_commute/.
  rewrite /-> ssums_split _ m (succ (succ m)) n/ >> auto.
    {
    omega.
    }
  rewrite /-> timesr_dist_plusr_l/.
  rewrite /<- plusr_id_r 0/.
  apply /plusr_leqr/.
    {
    rewrite /-> ssums_right/ >>> [omega, idtac].
    rewrite /-> ssums_singleton/.
    reduce //.
    rewrite /-> timesr_commute -1/.
    rewrite /-> timesr_assoc/.
    rewrite /<- timesr_dist_plusr_r/.
    rewrite /-> timesr_rotate/.
    rewrite /-> nexpr_minus_one_squared/.
    rewrite /-> timesr_id_l/.
    rewrite /<- negr_as_timesr/.
    rewrite /<- plusr_shift_leqr_rll/.
    rewrite /-> plusr_id_r/.
    apply /Hdecrease/.
    }

    {
    exploit /IH (k -n n`2) __ (succ (succ m)) n/ /H/ >> attempt omega.
    rewrite /-> timesr_commute/.
    forceExact /H/.
    compat.
    compat.
    reduce //.
    rewrite /<- timesr_assoc/.
    calculate //.
    rewrite /-> timesr_id_l/.
    reflexivity.
    }
  }
assert /forall m n .
          m <n= n
          -> nexpr -1 m * ssums (fn i . nexpr -1 i * s i) m n <= s m/ /Hhigh/.
  {
  inference.
  intro /m n Hmn/.
  rewrite /-> Nat.leq_iff_lt_or_eq in Hmn/.
  destruct /Hmn/ /Hmn | ?/.
  1:{
    subst /n/.
    rewrite /-> ssums_empty/.
    rewrite /-> timesr_ann_r/.
    apply /Hpos/.
    }
  rewrite /-> ssums_left/ >> auto.
  reduce //.
  rewrite /-> timesr_dist_plusr_r/.
  rewrite /<- timesr_assoc/.
  rewrite /-> nexpr_minus_one_squared/.
  rewrite /-> timesr_id_l/.
  rewrite /<- plusr_id_r (s m) at 1/.
  apply /plusr_leqr/ >> auto.
  so /Hlow (succ m) n __/ /H/.
    {
    omega.
    }
  reduce /H/.
  rewrite /<- negr_as_timesr in H/.
  rewrite /<- negr_dist_timesr_l in H/.
  apply /negr_leqr'/.
  rewrite /-> negr_zero/.
  hyp /H/.
  }
unfold /cauchy/.
assert /forall (k : nat) . n`0 <n k -> nat_to_real k != 0 : real/ /Hnonzeroall/.
  {
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
unfold /converges in Hconv/.
witness /squish_bind Hconv __/ >> auto.
clear /Hconv/.
intro /Hconv/ >> auto.
apply /squish_ret/ >> auto.
intro /k Hposk/.
so /Hnonzeroall k Hposk/ /Hnonzerok/.
so /Hconv k Hposk/ /m Hm/.
exists /m/.
assert /forall n p .
          m <n= n
          -> n <n= p
          -> absr (sums (fn i . nexpr -1 i * s i) n - sums (fn i . nexpr -1 i * s i) p) <= invr (nat_to_real k)/ /Hprop/ >>> [inference, idtac].
1:{
  intro /n p Hn Hp/.
  so /Nat.nat_dichotomy_weak n p/ /Hnp | Hpn/ >> auto.
  rewrite /-> absr_minusr_commute/.
  apply /Hprop/ >> auto.
  }
intro /n p Hmn Hnp/.
rewrite /-> minusr_id_r within _ in Hm/.
rewrite /-> absr_minusr_commute/.
rewrite /<- sums_difference/ >> auto.
rewrite /<- timesr_id_l (absr _)/.
rewrite /<- absr_nexpr_minus_one n/.
rewrite /<- absr_timesr/.
rewrite /-> absr_of_nonneg/.
  {
  apply /Hlow/ >> auto.
  }
rewrite /-> Hhigh/ >> auto.
rewrite /<- absr_of_nonneg (s n)/ >> auto.
qed ();


endModule ();  (* RealSequence *)
