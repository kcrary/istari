    converges s x
    -> converges (fn i . invr (s i)) (invr x)
/;

assert /forall k . n`0 <n k -> nat_to_real k != 0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
