  }
apply /converges_maxr/ >> apply /converges_minusr/ >> auto.
qed ();



lemma "dual_convergence"
/
  forall s1 s2 c .
    0 < c
    -> c < 1
    -> (forall i . s1 i <= s2 i)
    -> (forall i j . i <n= j -> s1 i <= s1 j & s2 j <= s2 i)
    -> (forall i . s2 (succ i) - s1 (succ i) <= c * (s2 i - s1 i))
    -> exists x .
         converges s1 x
         & converges s2 x
/;

inference.
intro /s1 s2 c Hclo Hchi Hsep Hinc Hadj/.
assert /forall k . n`0 <n k -> nat_to_real k != 0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
assert /forall m k .
          n`0 <n k
          -> nat_to_real k * (s2 n`0 - s1 n`0) < nexpr (invr c) m
          -> s2 m - s1 m <= invr (nat_to_real k)/ /Hbound/.
  {
  inference.
  assert /c != 0 : real/ /Hnzc/.
    {
    symmetry.
    apply /ltr_impl_neq/ >> auto.
    }
  intro /m k Hposk Hm/.
  rewrite /-> nexpr_invr in Hm/.
  rewrite /-> timesr_shift_ltr_rll in Hm/.
    {
    split.
    apply /nexpr_nonzero/ >> auto.
    }
  
    {
    unfold /nat_to_real/.
    fold /integer_to_real _/.
    apply /integer_to_real_mono_lt/.
    omega.
    }
  rewrite /<- timesr_shift_ltr_rlr in Hm/ >> auto.
    {
    apply /nexpr_positive/ >> auto.
    }
  rewrite /<- ltr_impl_leqr _# 2 Hm/ >> auto.
  clear /Hm/.
  induction /m/.
    {
    rewrite /-> timesr_id_l/.
    reflexivity.
    }

    {
    intro /m IH/.
    rewrite /-> Hadj/.
    rewrite /-> IH/.
      {
      rewrite /<- timesr_assoc/.
      reflexivity.
      }

      {
      apply /ltr_impl_leqr/ >> auto.
      }

      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/.
      apply /Hsep/.
      }
    }
  }
assert /cauchy s1/ /Hcauchy1/.
  {
  unfold /cauchy/.
  witness /squish_bind (real_to_prereal c) __/ >> auto.
  intro /(c' ?)/.
  subst /c/.
  rename /c'/ /c/.
  witness /squish_bind (real_to_prereal (s2 n`0 - s1 n`0)) __/ >> auto.
  intro /(d Hd)/.
  apply /squish_ret/ >> auto.
  assert /realintro c != 0 : real/ /Hnzc/.
    {
    symmetry.
    apply /ltr_impl_neq/ >> auto.
    }
  intro /k Hposk/.
  exploit /logarithm_bound_prereal (preinvr c) (pretimesr (integer_to_prereal (Integer.nat_to_integer k)) d)/ /m Hm/.
    {
    rewrite /-> preinvr_to_real/.
    rewrite /<- invr_one/.
    apply /invr_ltr_pos/ >> auto.
    }
  exists /m/ >> auto.
  rewrite /-> pretimesr_to_real in Hm/.
  rewrite /-> integer_to_prereal_to_real in Hm/.
  unfold /integer_to_real in Hm/.
  fold /nat_to_real _ in Hm/.
  rewrite /-> preinvr_to_real in Hm/.
  assert /forall n p .
            m <n= n
            -> n <n= p
            -> absr (s1 n - s1 p) <= invr (nat_to_real k)/ /H/
  >>> [inference, idtac].
  1:{
    intro /n p Hmn Hmp/.
    so /Nat.nat_dichotomy_weak n p/ /Hnp | Hpn/ >> auto.
    rewrite /-> absr_minusr_commute/ >> auto.
    }
  intro /n p Hmn Hnp/.
  rewrite /-> absr_minusr_commute/ >> auto.
  rewrite /-> absr_of_nonneg/ >> auto.
    {
    rewrite /<- minusr_shift_leqr_rr/.
    rewrite /-> plusr_id_l/.
    apply /Hinc/ >> auto.
    }
  transitivity /s2 m - s1 m/ >> auto.
    {
    apply /minusr_leqr/.
      {
      transitivity /s2 p/ >> auto.
      apply /Hinc/.
      omega.
      }

      {
      apply /Hinc/ >> auto.
      }
    }
  rewrite /<- Hd in Hm/.
  apply /Hbound/ >> auto.
  }
so /cauchy_impl_converges _ Hcauchy1/ /x Hconv1/.
exists /x/.
split >> auto.
unfold /converges/.
witness /squish_bind (real_to_prereal c) __/ >> auto.
intro /(c' ?)/.
subst /c/.
rename /c'/ /c/.
witness /squish_bind (real_to_prereal (s2 n`0 - s1 n`0)) __/ >> auto.
intro /(d Hd)/.
apply /squish_ret/ >> auto.
assert /realintro c != 0 : real/ /Hnzc/.
  {
  symmetry.
  apply /ltr_impl_neq/ >> auto.
  }
intro /k Hposk/.
exploit /logarithm_bound_prereal (preinvr c) (pretimesr (integer_to_prereal (Integer.nat_to_integer k)) d)/ /m Hm/.
  {
  rewrite /-> preinvr_to_real/.
  rewrite /<- invr_one/.
  apply /invr_ltr_pos/ >> auto.
  }
exists /m/ >> auto.
intro /n Hn/.
rewrite /-> pretimesr_to_real in Hm/.
rewrite /-> integer_to_prereal_to_real in Hm/.
unfold /integer_to_real in Hm/.
fold /nat_to_real _ in Hm/.
rewrite /-> preinvr_to_real in Hm/.
rewrite /-> absr_of_nonneg/ >> auto.
  {
  rewrite /<- minusr_shift_leqr_rr/.
  rewrite /-> plusr_id_l/.
  apply /converges_leqr s1 (fn _ . s2 n) _ _ n/ >> auto.
    {
    apply /converges_constant/.
    }

    {
    intro /i Hi/.
    reduce //.
    transitivity /s2 i/.
      {
      apply /Hsep/.
      }

      {
      apply /Hinc/ >> auto.
      }
    }
  }
transitivity /s2 m - s1 m/ >> auto.
  {
  apply /minusr_leqr/.
    {
    apply /Hinc/ >> auto.
    }

    {
    apply /converges_leqr (fn _ . s1 m) s1 _ _ m/ >> auto.
    apply /converges_constant/.
    }
  }
rewrite /<- Hd in Hm/.
apply /Hbound/ >> auto.
qed ();



(* Series *)

(* partial sums *)
defineInd /s/
/
  sums : nat -> real of
  | zero . 0

  | succ n . s n + sums n
//
  (nat -> real) -> nat -> real
/;



(* segment sum *)
define /ssums s m n/
/
  sums (fn i . s (m +n i)) (n -n m)
//
  (nat -> real) -> nat -> nat -> real
/;

unfold /ssums/.
typecheck.
qed ();



lemma "ssums_all"
/
  forall s n .
    sums s n = ssums s n`0 n : real
/;

inference.
intro /s n/.
unfold /ssums/.
rewrite /-> Nat.minus_0_r/.
compat.
introEq /i/ >> auto.
qed ();



lemma "ssums_split"
/
  forall s m k n .
    m <n= k
    -> k <n= n
    -> ssums s m n = ssums s m k + ssums s k n : real
/;

inference.
intro /s m k n Hmk/.
unfold /ssums at all/.
sinduction /n/.
reintro /IH/.
intro /Hkn/.
rewrite /-> Nat.leq_iff_lt_or_eq in Hkn/.
destruct /Hkn/ /Hkn | ?/.
1:{
  subst /k/.
  rewriteThen /n -n n = n`0 : nat/ omega.
  reduce //.
  rewrite /-> plusr_id_r/.
  reflexivity.
  }
destruct /n/ /| n/.
  {
  omega.
  }
rewriteThen /succ n -n m = succ (n -n m) : nat/ omega.
reduce //.
rewrite /-> IH/ >> attempt omega.
rewriteThen /succ n -n k = succ (n -n k) : nat/ omega.
reduce //.
rewrite /<- plusr_assoc at all/.
rewrite /-> plusr_commute at 1/.
compat.
compat.
compat.
omega.
qed ();



lemma "sums_split"
/
  forall s m n .
    m <n= n
    -> sums s n = sums s m + ssums s m n : real
/;

inference.
intro /s m n Hmn/.
rewrite /-> ssums_all at 0 0/.
apply /ssums_split/ >> auto.
omega.
qed ();



lemma "sums_difference"
/
  forall s m n .
    m <n= n
    -> ssums s m n = sums s n - sums s m : real
/;

inference.
intro /s m n Hmn/.
rewrite /<- minusr_shift_rl/.
symmetry.
apply /sums_split/ >> auto.
qed ();



lemma "ssums_empty"
/
  forall s n .
    ssums s n n = 0 : real
/;

inference.
intro /s n/.
unfold /ssums/.
rewriteThen /n -n n = n`0 : nat/ omega.
reduce //.
reflexivity.
qed ();



lemma "ssums_singleton"
/
  forall s n .
    ssums s n (succ n) = s n : real
/;

inference.
intro /s n/.
unfold /ssums/.
rewriteThen /succ n -n n = n`1 : nat/ omega.
reduce //.
rewrite /-> Nat.plus_0_r/.
apply /plusr_id_r/.
qed ();



lemma "ssums_left"
/
  forall s m n .
    m <n n
    -> ssums s m n = s m + ssums s (succ m) n : real
/;

inference.
intro /s m n Hmn/.
rewrite /-> ssums_split s m (succ m) n/ >> attempt omega.
rewrite /-> ssums_singleton/.
reflexivity.
qed ();



lemma "ssums_right_succ"
/
  forall s m n .
    m <n= n
    -> ssums s m (succ n) = s n + ssums s m n : real
/;

inference.
intro /s m n Hmn/.
rewrite /-> ssums_split s m n (succ n)/ >> attempt omega.
rewrite /-> ssums_singleton/.
apply /plusr_commute/.
qed ();



lemma "ssums_right"
/
  forall s m n .
    m <n n
    -> ssums s m n = s (pred n) + ssums s m (pred n) : real
/;

inference.
intro /s m n Hmn/.
destruct /n/ /| n/.
  {
  omega.
  }
reduce //.
apply /ssums_right_succ/.
omega.
qed ();



(* We use the word "convergent" (as opposed to "converges"), to say
   that a series converges.  Since we do not define the term formally,
   we can use it loosely to refer both to when a series converges (at
   all) and to when it converges to a particular value.
*)


lemma "convergent_impl_converges_zero"
/
  forall s .
    cauchy (sums s)
    -> converges s 0
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != 0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s Hconv/.
unfold /cauchy in Hconv/.
unfold /converges/.
witness /squish_bind Hconv __/ >> auto.
clear /Hconv/.
intro /Hconv/ >> auto.
apply /squish_ret/ >> auto.
intro /k Hposk/.
so /Hconv k Hposk/ /m Hm/.
so /Hnonzeroall k Hposk/ /Hnonzerok/.
exists /succ m/.
intro /n Hn/.
rewrite /-> minusr_id_r/.
so /Hm (succ n) n __ __/ /H/.
  {
  omega.
  }

  {
  omega.
  }
reduce /H/.
rewrite /-> plusr_minusr_assoc in H/.
rewrite /-> minusr_self in H/.
rewrite /-> plusr_id_r in H/.
hyp /H/.
qed ();



lemma "convergent_plusr"
/
  forall s s' x y .
    converges (sums s) x
    -> converges (sums s') y
    -> converges (sums (fn i . s i + s' i)) (x + y)
/;

inference.
intro /s s' x y Hconvx Hconvy/.
so /converges_plusr _# 4 Hconvx Hconvy/ /Hconv/.
forceExact /Hconv/.
compat.
introEq /i/.
reduce //.
induction /i/.
  {
  apply /plusr_id_l/.
  }
intro /i IH/.
rewrite /<- plusr_assoc at all/.
rewrite /-> plusr_commute3 at 1/.
rewrite /-> plusr_assoc at 0/.
compat.
hyp /IH/.
qed ();



lemma "convergent_timesr_const"
/
  forall s x y .
    converges (sums s) y
    -> converges (sums (fn i . x * s i)) (x * y)
/;

inference.
intro /s x y Hconvy/.
so /converges_timesr _# 4 (converges_constant x) Hconvy/ /Hconv/.
reduce /Hconv/.
forceExact /Hconv/.
compat.
introEq /i/.
reduce //.
induction /i/.
  {
  apply /timesr_ann_r/.
  }
intro /i IH/.
rewrite /-> timesr_dist_plusr_r/.
compat.
hyp /IH/.
qed ();



lemma "sums_nexpr_increment"
/
  forall x n .
    x * sums (fn i . nexpr x i) n = sums (fn i . nexpr x i) (succ n) - 1 : real
/;

inference.
intro /x n/.
induction /n/.

(* 0 *)
{
rewrite /-> timesr_ann_r/.
unfold /minusr/.
calculate //.
reflexivity.
}

(* succ *)
{
intro /n IH/.
rewrite /-> timesr_dist_plusr_r/.
rewrite /-> IH/.
unfold /minusr at all/.
rewrite /<- plusr_assoc at all/.
reflexivity.
}
qed ();



lemma "convergent_nexpr"
/
  forall x .
    0 < x
    -> x < 1
    -> converges (sums (fn i . nexpr x i)) (invr (1 - x))
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != 0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
assert /forall x . x < 1 -> 1 - x != 0 : real/ /Hnonzero1minusx/.
  {
  intro /x Hx/.
  symmetry.
  apply /ltr_impl_neq/.
  rewrite /<- minusr_shift_ltr_rl/.
  rewrite /-> plusr_id_r/ >> auto.
  }
intro /x' Hxlo Hxhi/.
unfold /converges/.
witness /squish_bind (real_to_prereal x') __/ >> auto.
intro /(x ?)/.
subst /x'/ >> auto.
apply /squish_ret/ >> auto.
assert /realintro x != 0 : real/ /Hnonzerox/.
  {
  symmetry.
  apply /ltr_impl_neq/ >> auto.
  }
intro /k Hposk/.
so /Hnonzeroall k Hposk/ /Hnonzerok/.
assert /1 != 0 : real/ /Hnonzero1/.
  {
  apply /integer_to_real_neq/.
  omega.
  }
assert /realintro (preplusr (integer_to_prereal z`1) (prenegr x)) != 0 : real/ /Hnonzero1minusx1'/.
  {
  rewrite /-> preplusr_to_real/.
  rewrite /-> prenegr_to_real/.
  fold /minusr _ _/.
  calculate //.
  auto.
  }
so /logarithm_bound_prereal (preinvr x) (pretimesr (integer_to_prereal (Z.nat_to_integer k)) (preinvr (preplusr (integer_to_prereal z`1) (prenegr x)))) __/ /m Hm/ >> auto.
  {
  rewrite /-> preinvr_to_real/.
  rewrite /<- invr_invol 1/.
  apply /invr_ltr_pos/ >> auto.
  rewrite /-> invr_one/ >> auto.
  }
rewrite /-> pretimesr_to_real in Hm/.
rewrite /-> integer_to_prereal_to_real in Hm/.
unfold /integer_to_real in Hm/.
fold /nat_to_real k in Hm/.
rewrite /-> preinvr_to_real in Hm/.
rewrite /realintro (preplusr (integer_to_prereal z`1) (prenegr x)) = 1 - realintro x : nonzero_real in Hm/.
  {
  apply /eq_nonzero_real'/ >> auto.
  rewrite /-> preplusr_to_real/.
  calculate //.
  rewrite /-> prenegr_to_real/.
  fold /minusr _ _/.
  reflexivity.
  }
rewrite /-> preinvr_to_real in Hm/ >> auto.
exists /m/ >> auto.
intro /n Hn/.
rewrite /<- timesr_shift_ltr_lrr in Hm/.
  {
  rewrite /<- minusr_shift_ltr_rr/.
  rewrite /-> plusr_id_l/.
  auto.
  }
so /invr_ltr_pos _# 2 __ Hm/ /Hm'/.
  {
  unfold /nat_to_real/.
  fold /integer_to_real _/.
  apply /integer_to_real_mono_lt/.
  omega.
  }
rewrite /-> invr_timesr in Hm'/ >> auto.
  {
  split.
  apply /nexpr_nonzero/.
  apply /invr_nonzero/.
  }
rewrite /<- nexpr_invr in Hm'/ >> auto.
  {
  split.
  apply /invr_nonzero/ >> auto.
  }
rewrite /-> invr_invol in Hm'/ >> auto.
rewrite /<- Hm'/ >> auto.
clear /Hm Hm'/.
assert /0 < 1 - realintro x/ /Hpos1minusx/.
  {
  rewrite /<- minusr_shift_ltr_rr/.
  rewrite /-> plusr_id_l/.
  auto.
  }
rewrite /<- timesr_shift_leqr_rrr/ >> auto.
rewrite /<- absr_of_nonneg (1 - realintro x) at 1/ >> autoWith /ltr_impl_leqr/.
rewrite /<- absr_timesr/ >> auto.
rewrite /-> timesr_dist_minusr_l/ >> auto.
rewrite /-> timesr_inverse_l/ >> auto.
apply /leqr_trans _ (nexpr (realintro x) n)/.
1:{
  rewriteThen /n = m +n (n -n m) : nat/ omega.
  rewrite /-> nexpr_plus_exponent/.
  rewrite /<- timesr_id_r (nexpr (realintro x) m) at 1/.
  apply /timesr_leqr_l/.
    {
    apply /nexpr_nonnegative/.
    apply /ltr_impl_leqr/ >> auto.
    }

    {
    apply /nexpr_leqr_one/ >> autoWith /ltr_impl_leqr/.
    }
  }
clear /m Hn/.
apply /leqr_refl'/.
rewrite /-> absr_minusr_commute/.
rewrite /<- absr_of_nonneg (nexpr (realintro x) n)/.
  {
  apply /nexpr_nonnegative/.
  apply /ltr_impl_leqr/ >> auto.
  }
compat.
unfold /minusr at all/.
rewrite /-> timesr_dist_plusr_r/.
rewrite /-> timesr_id_r/.
rewrite /-> negr_plusr/.
rewrite /<- plusr_assoc at all/.
rewrite /-> negr_dist_timesr_r/.
rewrite /-> negr_invol/.
rewrite /<- timesr_commute/.
rewrite /-> sums_nexpr_increment/.
reduce //.
unfold /minusr at all/.
rewrite /<- plusr_assoc at all/.
rewrite /-> plusr_rotate at 2/.
rewrite /-> plusr_rotate4/.
rewrite /-> plusr_assoc/.
rewrite /-> plusr_inverse_l/.
rewrite /-> plusr_id_r/.
rewrite /-> plusr_assoc/.
rewrite /-> plusr_inverse_r/.
rewrite /-> plusr_id_r/.
reflexivity.
qed ();



lemma "comparison_test"
/
  forall s s' n .
    cauchy (sums s')
    -> (forall i . n <n= i -> absr (s i) <= s' i)
    -> cauchy (sums s)
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != 0 : real/ /Hnonzeroall/.
  {
  inference.
  intro /k Hposk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
intro /s s' l Hconv Hbound/.
unfold /cauchy in Hconv in concl/.
witness /squish_bind Hconv __/ >> auto.
clear /Hconv/.
intro /Hconv/ >> auto.
apply /squish_ret/ >> auto.
intro /k Hposk/.
so /Hnonzeroall k Hposk/ /Hnonzerok/.
so /Hconv k Hposk/ /m Hm/.
exists /l +n m/.
assert /forall n p . l +n m <n= p -> p <n= n -> absr (sums s n - sums s p) <= invr (nat_to_real k)/ /Hprop/ >>> [inference, idtac].
1:{
  intro /n p Hn Hp/.
  so /nat_dichotomy_weak n p/ /Hnp | Hpn/.
    {
    rewrite /-> absr_minusr_commute/.
    apply /Hprop/ >> auto.
    }

    {
    apply /Hprop/ >> auto.
    }
  }
intro /n p Hp Hn/.
rewrite /<- Hm n p/ >>> [idtac, omega, omega].
assert /forall q n p .
          l +n m <n= p
          -> p <n= n
          -> n -n p = q : nat
          -> absr (sums s n - sums s p) <= sums s' n - sums s' p/ /Hprop/ >>> [inference, idtac].
1:{
  rewrite /-> Hprop (n -n p) n p/ >> auto.
  apply /absr_ub/.
  }
clear /n p Hp Hn/.
intro /q/.
induction /q/.
  {
  intro /n p Hp Hn Hq/.
  assertThen /n = p : nat/ /?/ omega.
  subst /p/.
  rewrite /-> minusr_self at 0 0/.
  rewrite /-> absr_zero/.
  reflexivity.
  }
intro /q IH n p Hp Hn Hq/.
destruct /n/ /| n/.
  {
  omega.
  }
reduce //.
rewrite /-> plusr_minusr_assoc at 0 0/.
rewrite /-> absr_plusr_leqr/.
apply /plusr_leqr/.
  {
  apply /Hbound/.
  omega.
  }

  {
  apply /IH/ >> omega.
  }
qed ();



define /convergent_absolutely s/
/
  cauchy (sums (fn i . absr (s i)))
//
  (nat -> real) -> U 0
/;

unfold /convergent_absolutely/.
typecheck.
qed ();



lemma "convergent_absolutely_impl_convergent"
/
  forall s .
    convergent_absolutely s
    -> cauchy (sums s)
/;

inference.
intro /s Hconvabs/.
unfold /convergent_absolutely in Hconvabs/.
witness /comparison_test _ _ n`0 Hconvabs __/.
intro /i _/.
reduce //.
reflexivity.
qed ();



