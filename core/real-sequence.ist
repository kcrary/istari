    }
  }
rewrite /-> invr_timesr/ >> auto.
  {
  split.
  apply /timesr_neq_zero/ >> auto.
  apply /timesr_neq_zero/ >> auto.
  }
rewrite /-> invr_timesr/ >> auto.
  {
  split.
  apply /timesr_neq_zero/ >> auto.
  }
assert /nat_to_real z != 0 : real/ /Hnonzeroz/.
  {
  auto.
  }
rewrite /-> invr_timesr/.
rewrite /<- timesr_assoc at all/.
rewrite /-> timesr_rotate4 _ _ _ (invr (nat_to_real k))/.
rewrite /-> timesr_assoc at 2/.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_id_r/.
rewrite /-> timesr_assoc at 1/.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_id_r/.
rewrite /-> timesr_commute at 1/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_id_r/.
apply /leqr_refl/.
qed ();



lemma "converges_maxr"
/
  forall s s' x y .
    converges s x
    -> converges s' y
    -> converges (fn i . maxr (s i) (s' i)) (maxr x y)
