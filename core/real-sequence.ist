    apply /invr_positive/.
    apply /integer_to_real_mono_lt/ >> omega.
    }

    {
    apply /ltr_impl_leqr/ >> auto.
    apply /invr_positive/.
    unfold /nat_to_real/.
    fold /integer_to_real _/.
    apply /integer_to_real_mono_lt/ >> omega.
    }

    {
    apply /leqr_refl'/.
    rewrite /<- minusr_shift_rr/.
    rewrite /-> plusr_self/.
    rewrite /-> timesr_inverse_r/.
    reflexivity.
    }

    {
    rewrite /<- invr_invol (absr x)/ >> auto.
    apply /invr_leqr_pos/ >> auto.
      {
      apply /invr_positive/.
      apply /absr_positive_iff_nonzero/.
