lemma "maxr_of_signs"
/
  forall x .
    0 <= maxr x (~ x)
/;

inference.
intro /x/.
apply /real_dichotomy_weak_if_stable _ _ 0 x/.
  {
  apply /leqr_stable/.
  }
intro /(Hpos | Hneq)/.
  {
  rewrite /-> maxr_eq_l/ >> auto.
  apply /leqr_trans _ 0/ >> auto.
  apply /negr_leqr'/ >> auto.
  rewrite /-> negr_zero/.
  rewrite /-> negr_invol/.
  auto.
  }

  {
  rewrite /-> maxr_eq_r/.
    {
    apply /leqr_trans _ 0/ >> auto.
    apply /negr_leqr'/ >> auto.
    rewrite /-> negr_zero/.
    rewrite /-> negr_invol/.
    auto.
    }

    {
    apply /negr_leqr'/.
    rewrite /-> negr_zero/.
    rewrite /-> negr_invol/.
    auto.
    }
  }
qed ();



lemma "converges_leqr"
/
  forall s s' x y .
    converges s x
    -> converges s' y
    -> (forall i . n`0 <n i -> s i <= s' i)
    -> x <= y
/;

inference.
intro /s s' x y Hconvx Hconvy Hallleq/.
rewrite /<- plusr_id_l x/.
rewrite /-> minusr_shift_leqr_rr/.
rewrite /y - x = maxr (y - x) (x - y) : real/.
1:{
  rewrite /<- negr_minusr at 1/.
  apply /maxr_of_signs/.
  }
apply /converges_unique (fn i . s' i - s i)/.
  {
  apply /converges_minusr/ >> auto.
  }
apply /converges_equal (fn i . maxr (s' i - s i) (s i - s' i))/.
  {
  intro /i Hposi/.
  reduce //.
  apply /maxr_eq_l/.
  apply /minusr_leqr/ >> auto.
  }
apply /converges_maxr/ >> apply /converges_minusr/ >> auto.
qed ();



