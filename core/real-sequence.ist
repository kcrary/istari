        rewrite /-> invr_timesr/ >> auto.
        rewrite /-> invr_invol/.
        apply /HleqM/.
        omega.
        }

        {
        apply /timesr_leqr_l/.
          {
          apply /integer_to_real_mono/ >> omega.
          }

          {
          apply /ltr_impl_leqr/ >> auto.
          }
        }
      }

      {
      rewrite /-> absr_invr/.
      apply /ltr_impl_leqr/ >> auto.
      }
    }

    {
    apply /HN/.
    omega.
    }
  }
rewrite /nat_to_real (k *n z *n z *n n`2) = nat_to_real k * nat_to_real z * nat_to_real z * 2 : nonzero_real/.
  {
  apply /eq_nonzero_real/.
    {
    apply /nat_to_real_nonzero/.
    symmetry.
    apply /lt_impl_neq/.
    apply /times_lt_zero/ >>> [idtac, omega].
    apply /times_lt_zero/ >> auto.
    apply /times_lt_zero/ >> auto.
    }

    {
    rewrite /-> times_to_real/.
    rewrite /-> times_to_real/.
    rewrite /-> times_to_real/.
    unfold /nat_to_real at 3/.
    fold /integer_to_real _/.
