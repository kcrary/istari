lemma "timesr_regular"
/
  forall x y . 
    regular x
    -> regular y
    -> regular (fn i . x (max (bound x) (bound y) *n i *n n`2) * y (max (bound x) (bound y) *n i *n n`2))
/;

inference.
intro /u v Hu Hv m n Hposm Hposn/.
unfold /regular at all/.
reduce //.
remember /max (bound u) (bound v)/ /_/ /k/ /Heqk/.
assert /n`0 <n k/ /Hposk/.
  {
  subst /k/.
  unfold /bound/.
  omega.
  }
assert /nat_to_rational k != 0 : rational/ /Hknonzero/ >> autoQ.
assert /n`0 <n k *n m *n n`2/ /Hpos2km/.
  {
  apply /times_lt_zero/.
    {
    apply /times_lt_zero/ >> auto.
    }

    {
    omega.
    }
  }
assert /n`0 <n k *n n *n n`2/ /Hpos2kn/.
  {
  apply /times_lt_zero/.
    {
    apply /times_lt_zero/ >> auto.
    }

    {
    omega.
    }
  }
unfold /minusq/.
rewrite /<- plusq_id_r (plusq _ _)/.
rewrite /<- plusq_inverse_l (u (k *n m *n n`2) * v (k *n n *n n`2))/.
rewrite /<- plusq_assoc at all/.
rewrite /<- plusq_rotate4/.
rewrite /-> plusq_assoc/.
rewrite /-> negq_dist_timesq_r/.
rewrite /<- timesq_dist_plusq_r/.
rewrite /-> negq_dist_timesq_l/.
rewrite /<- timesq_dist_plusq_l/.
rewrite /-> timesq_commute _ (v (k *n n *n n`2))/.
fold /minusq _ _ at all/.
rewrite /-> absq_plusq_leqq/.
rewrite /-> absq_timesq at 0 0/.
assert /absq (u (k *n m *n n`2)) <= nat_to_rational k/ /H/.
  {
  rewrite /-> (bound_ub u (k *n m *n n`2))/ >> auto.
  apply /nat_to_rational_mono/.
  subst /k/ >> omega.
  }
rewrite /-> H/ >> autoWith /absq_nonneg/.
clear /H/.
assert /absq (v (k *n n *n n`2)) <= nat_to_rational k/ /H/.
  {
  rewrite /-> (bound_ub v (k *n n *n n`2))/ >> auto.
  apply /nat_to_rational_mono/.
  subst /k/ >> omega.
  }
rewrite /-> H/ >> autoWith /absq_nonneg/.
clear /H/.
unfold /regular in Hu in Hv/.
rewrite /-> Hu/ >> autoQ.
rewrite /-> Hv/ >> autoQ.
rewrite /-> timesq_dist_plusq_r at 0 0/.
rewrite /-> times_assoc at all/.
rewrite /-> times_to_rational k at all/.
rewrite /-> invq_timesq at all/.
rewrite /<- timesq_assoc at all/.
rewrite /-> timesq_inverse_r at all/ >> auto.
rewrite /-> timesq_id_l at all/.
rewrite /-> times_to_rational _ n`2 at all/.
unfold /nat_to_rational at 7 5 3 1/.
reduce //.
rewrite /-> timesq_commute at 0 1 2 3/.
rewrite /-> invq_timesq at all/.
rewrite /<- plusq_assoc/.
rewrite /<- plusq_rotate4/.
rewrite /-> plusq_assoc/.
rewrite /-> plusq_self at 0 0/.
rewrite /<- timesq_assoc at 0 0/.
assert /2 != 0 : rational/ /H2nonzero/ >> autoQ.
rewrite /-> timesq_inverse_r at 0 0/ >> auto.
rewrite /-> timesq_id_l at 0 0/.
apply /leqq_refl/.
qed ();



define /timesr x y/
/
  fn i . x (max (bound x) (bound y) *n i *n n`2) * y (max (bound x) (bound y) *n i *n n`2)
//
  real -> real -> real
/;

introOf /x y/.
unfold /timesr/.
infer /real/ /Hrealof/.
unfold /real in Hrealof in concl in x in y/.
destruct /x/ /[x x' Hx]/.
destruct /y/ /[y y' Hy]/.
extensionality.
clear /Hrealof/.
destruct /Hx/ /Hx Hx' Heqx/.
destruct /Hy/ /Hy Hy' Heqy/.
splitn 2.
  {
  apply /timesr_regular x y/ >> auto.
  }

  {
  apply /timesr_regular x' y'/ >> auto.
  }
  
  {
  (* Bishop & Bridges imply that this proof is easy, so I wonder if
     there's some simple proof that escapes me.
  *)
  apply /realequiv_cauchy/.
    {
    apply /timesr_regular x y/ >> auto.
    }

    {
    apply /timesr_regular x' y'/ >> auto.
    }
  intro /j Hposj/.
  reduce //.
  exists /j *n n`8/.  (* This number is taken from what we need at the end. *)
  split.
    {
    omega.
    }
  intro /m Hm/.
  assertThen /n`0 <n m/ /Hposm/ omega.
  remember /max (bound x) (bound y)/ /_/ /k/ /Heqk/.
  remember /max (bound x') (bound y')/ /_/ /k'/ /Heqk'/.
  (* the pauses are to hide irrelevant fact from omega, to improve performance *)
  fold /pause (eq _ _ _) in Heqk/.
  fold /pause (eq _ _ _) in Heqk'/.
  assert /n`0 <n k/ /Hposk/.
    {
    unfold /pause in Heqk/.
    subst /k/.
    unfold /bound/.
    omega.
    }
  assert /n`0 <n k'/ /Hposk'/.
    {
    unfold /pause in Heqk'/.
    subst /k'/.
    unfold /bound/.
    omega.
    }
  assert /pause (n`0 <n k *n m *n n`2)/ /Hpos2km/.
    {
    unfold /pause/.
    apply /times_lt_zero/.
      {
      apply /times_lt_zero/ >> auto.
      }

      {
      omega.
      }
    }
  assert /pause (n`0 <n k' *n m *n n`2)/ /Hpos2km'/.
    {
    unfold /pause/.
    apply /times_lt_zero/.
      {
      apply /times_lt_zero/ >> auto.
      }

      {
      omega.
      }
    }
  assert /pause ((k' <n= k *n n`2) & (k <n= k' *n n`2))/ /Hratios/.
    {
    unfold /pause in Heqk in Heqk' in concl/.
    subst /k k'/.
    so /bound_ratio x x' Heqx/ /Hratiox/.
    so /bound_ratio y y' Heqy/ /Hratioy/.
    so /bound_ratio x' x (realequiv_symm _ _ Heqx)/ /Hratiox'/.
    so /bound_ratio y' y (realequiv_symm _ _ Heqy)/ /Hratioy'/.
    assert /n`2 <n= bound x/ /Hboundx/.
      {
      unfold /bound/.
      omega.
      }
    assert /n`2 <n= bound x'/ /Hboundx'/.
      {
      unfold /bound/.
      omega.
      }
    assert /n`2 <n= bound y/ /Hboundy/.
      {
      unfold /bound/.
      omega.
      }
    assert /n`2 <n= bound y'/ /Hboundy'/.
      {
      unfold /bound/.
      omega.
      }
    omega.
    }
  unfold /minusq/.
  rewrite /<- plusq_id_r (plusq _ _)/.
  rewrite /<- plusq_inverse_l (x (k *n m *n n`2) *q y' (k' *n m *n n`2))/.
  rewrite /<- plusq_assoc at all/.
  rewrite /<- plusq_rotate4/.
  rewrite /-> plusq_assoc/.
  rewrite /-> negq_dist_timesq_r/.
  rewrite /<- timesq_dist_plusq_r/.
  rewrite /-> negq_dist_timesq_l/.
  rewrite /<- timesq_dist_plusq_l/.
  rewrite /-> timesq_commute _ (y' (k' *n m *n n`2))/.
  fold /minusq _ _ at all/.
  rewrite /-> absq_plusq_leqq/.
  rewrite /-> absq_timesq at 0 0/.
  assert /absq (x (k *n m *n n`2)) <q= nat_to_rational k/ /H/.
    {
    unfold /pause in Heqk in Hpos2km/ >> auto.
    rewrite /-> (bound_ub x (k *n m *n n`2))/ >> autoQ.
    }
  rewrite /-> H/ >> autoWith /absq_nonneg/.
  clear /H/.
  assert /absq (y' (k' *n m *n n`2)) <q= nat_to_rational k'/ /H/.
    {
    unfold /pause in Heqk' in Hpos2km'/ >> auto.
    rewrite /-> (bound_ub y' (k' *n m *n n`2))/ >> autoQ.
    }
  rewrite /-> H/ >> autoWith /absq_nonneg/.
  clear /H/.
  assert /_/ /Hratiok/.
    {
    unfold /pause in Hratios/.
    exact /Hratios #1/.
    }
  rewrite /-> Hratiok at 1/ >> autoWith /nat_to_rational_nonneg absq_nonneg/.
  clear /Hratiok/.
  unfold /minusq at all/.
  rewrite /<- plusq_id_r (plusq (y _) _)/.
  rewrite /<- plusq_inverse_l (y' (k *n m *n n`2))/.
  rewrite /<- plusq_assoc at all/.
  rewrite /<- plusq_rotate4/.
  rewrite /-> plusq_assoc/.
  rewrite /-> absq_plusq_leqq/ >> autoWith /nat_to_rational_nonneg absq_nonneg/.
  rewrite /<- plusq_id_r (plusq (x _) _)/.
  rewrite /<- plusq_inverse_l (x' (k *n m *n n`2))/.
  rewrite /<- plusq_assoc at all/.
  rewrite /<- plusq_rotate4/.
  rewrite /-> plusq_assoc/.
  rewrite /-> absq_plusq_leqq at 2/ >> autoWith /nat_to_rational_nonneg absq_nonneg/.
  fold /minusq _ _ at all/.
  assert /forall a b . 0 <= absq a + absq b/ /double_absq_nonneg/.
    {
    inference.
    intro /a b/.
    rewrite /<- plusq_id_l 0/.
    apply /plusq_leqq/ >> apply /absq_nonneg/.
    }
  exploit /Heqy (k *n m *n n`2)/ /H/ >> auto.
    {
    unfold /pause in Hpos2km/ >> auto.
    }
  rewrite /-> H/ >> autoWith /nat_to_rational_nonneg/ >> clear /H/.
  exploit /Heqx (k *n m *n n`2)/ /H/ >> auto.
    {
    unfold /pause in Hpos2km/ >> auto.
    }
  rewrite /-> H/ >> autoWith /nat_to_rational_nonneg/ >> clear /H/.
  exploit /Hy' (k *n m *n n`2) (k' *n m *n n`2)/ /H/ >> auto.
    {
    unfold /pause in Hpos2km/ >> auto.
    }

    {
    unfold /pause in Hpos2km'/ >> auto.
    }
  assert /forall (z : nat -> rational) . 0 <= 2 *q invq (nat_to_rational (k *n m *n n`2)) + absq (z (k *n m *n n`2) - z (k' *n m *n n`2))/ /Hmessynneg/.
    {
    intro /z/.
    unfold /pause in Hpos2km in Hpos2km'/.
    rewrite /<- plusq_id_l 0/.
    apply /plusq_leqq/ >> autoQ.
    }
  rewrite /-> H/ >> autoWith /nat_to_rational_nonneg/ >> clear /H/.
  1:{
    apply /Hmessynneg y'/.
    }
  exploit /Hx' (k *n m *n n`2) (k' *n m *n n`2)/ /H/ >> auto.
    {
    unfold /pause in Hpos2km/ >> auto.
    }

    {
    unfold /pause in Hpos2km'/ >> auto.
    }
  rewrite /-> H/ >> autoWith /nat_to_rational_nonneg/ >> clear /H/.
  1:{
    apply /Hmessynneg x'/.
    }
  clear /Hmessynneg/.
  rewrite /<- plusq_assoc at all/.
  rewrite /<- timesq_id_l (invq _) at 1 4/.
  rewrite /<- timesq_dist_plusq_l at 1/.
  rewrite /<- timesq_dist_plusq_l/.
  rewrite /<- timesq_dist_plusq_l/.
  rewrite /<- plus_to_rational k (k *n n`2)/.
  rewriteThen /k +n k *n n`2 = k *n n`3 : nat/ omega.
  rewrite /<- plusz_to_rational z`2 z`1/.
  reduce //.
  exploit /invq_leqq_pos (nat_to_rational (k *n m *n n`2) *q invq q`2) (nat_to_rational (k' *n m *n n`2))/ /H/.
    {
    unfold /pause in Hpos2km/ >> auto.
    apply /timesq_ltq_zero/ >> autoQ.
    }
    
    {
    unfold /pause in Hratios/ >> destruct /Hratios/ /_ Hratiok'/.
    rewrite /-> Hratiok'/ >> autoQ.
    rewrite /-> times_commute/.
    rewrite /-> times_to_rational n`2/.
    rewrite /-> timesq_commute/.
    rewrite /<- timesq_assoc/.
    unfold /nat_to_rational/.
    reduce //.
    rewrite /-> timesq_inverse_l/ >> autoQ.
    rewrite /-> timesq_id_l/.
    rewrite /-> times_assoc/.
    rewrite /-> times_commute n`2 m/.
    rewrite /<- times_assoc/.
    apply /leqq_refl/.
    }
  rewrite /-> H/ >> clear /H/ >> autoQ.
  1:{
    rewrite /<- plusq_id_l 0/.
    unfold /pause in Hpos2km in Hpos2km'/.
    apply /plusq_leqq/ >> autoQ.
    }
  rewrite /-> invq_timesq/.
  rewrite /-> invq_invol/.
  rewrite /-> timesq_commute at 2/.
  rewrite /<- timesq_dist_plusq_l/.
  rewrite /<- plusz_to_rational/.
  reduce //.
  rewrite /<- timesq_assoc/.
  rewrite /integer_to_rational z`5 = nat_to_rational n`5 : rational/ >> autoQ.
  rewrite /<- times_to_rational (k *n n`3) n`5/.
  rewrite /-> times_assoc/.
  reduce //.
  rewrite /-> times_to_rational/.
  rewrite /-> timesq_commute3/.
  rewrite /-> times_assoc/.
  rewrite /-> times_to_rational/.
  rewrite /-> invq_timesq/.
  rewrite /<- timesq_assoc/.
  rewrite /-> timesq_inverse_r/ >> autoQ.
  rewrite /-> timesq_id_l/.
  rewrite /-> times_to_rational/.
  rewrite /-> invq_timesq/.
  rewrite /-> timesq_assoc/.
  rewrite /<- invq_invol (timesq _ _) at 1/.
  rewrite /<- invq_timesq/.
  apply /invq_leqq_pos/ >> autoQ.
  rewrite /<- Hm/ >> autoQ.
  rewrite /-> times_to_rational/.
  rewrite /<- timesq_id_r (nat_to_rational _)/.
  rewrite /-> timesq_assoc/.
  apply /timesq_leqq/ >> autoQ.
  rewrite /-> invq_timesq/.
  rewrite /-> invq_invol/.
  rewrite /<- timesq_assoc/.
  rewrite /<- times_to_rational n`8 n`2/.
  reduce //.
  rewrite /<- timesq_inverse_r (nat_to_rational n`15)/ >> autoQ.
  apply /timesq_leqq_pos_pos/ >> autoQ.
  }
qed ();



