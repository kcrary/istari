lemma "ltr_0_1"
/
  0 < 1
/;

apply /integer_to_real_mono_lt/.
omega.
qed ();



lemma "leqr_0_1"
/
  0 <= 1
/;

apply /ltr_impl_leqr/.
apply /ltr_0_1/.
