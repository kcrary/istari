    -> x < y
    -> invr y < invr x
/;

intro /x y Hnegx Hxy/.
assert /x != 0 : real/ /Hnzx/.
  {
  apply /ltr_impl_neq/ >> autoWith /ltr_trans/.
  }
assert /y != 0 : real/ /Hnzy/.
  {
  apply /ltr_impl_neq/ >> auto.
  }
apply /timesr_cancel_ltr_l_neg _ _ x/ >> autoWith /ltr_trans/.
apply /timesr_cancel_ltr_r_neg _ _ y/ >> auto.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_l/.
rewrite /-> timesr_id_l/.
rewrite /-> timesr_id_r/.
hyp /Hxy/.
qed ();



lemma "invr_leqr_neg"
/
  forall x y .
    y < 0
    -> x <= y
    -> invr y <= invr x
/;

intro /x y Hnegx Hxy/.
assert /x != 0 : real/ /Hnzx/.
  {
  apply /ltr_impl_neq/ >> autoWith /leqr_ltr_trans/.
  }
assert /y != 0 : real/ /Hnzy/.
  {
  apply /ltr_impl_neq/ >> auto.
  }
apply /timesr_cancel_leqr_l_neg _ _ x/ >> autoWith /leqr_ltr_trans/.
apply /timesr_cancel_leqr_r_neg _ _ y/ >> auto.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_l/.
rewrite /-> timesr_id_l/.
rewrite /-> timesr_id_r/.
hyp /Hxy/.
qed ();



typedef
/
  datatype
    intersect (i : level) .
    U i
  of
    samesign : real -> real -> type =

    | samesign_pos :
        forall x y .
          r`0 <r x
          -> r`0 <r y
          -> samesign x y

    | samesign_neg :
        forall x y .
          x <r r`0
          -> y <r r`0
          -> samesign x y
/;



lemma "invr_ltr_samesign"
/
  forall x y .
    samesign x y
    -> x <r y
    -> invr y <r invr x
/;

inference.
intro /x y Hsign Hler/.
inversion /Hsign/.
  {
  reintro /Hposx Hposy/.
  apply /invr_ltr_pos/ >> auto.
  }

  {
  reintro /Hnegx Hnegy/.
  apply /invr_ltr_neg/ >> auto.
  }
qed ();



lemma "invr_leqr_samesign"
/
  forall x y .
    samesign x y
    -> x <r= y
    -> invr y <r= invr x
/;

inference.
intro /x y Hsign Hler/.
inversion /Hsign/.
  {
  reintro /Hposx Hposy/.
  apply /invr_leqr_pos/ >> auto.
  }

  {
  reintro /Hnegx Hnegy/.
  apply /invr_leqr_neg/ >> auto.
  }
qed ();



(* Limited decidability *)

(* shadowing the name from Primitive *)
lemma "plusr_positive_invert_prereal"
/
  forall x y .
    0 < realintro x + realintro y
    -> 0 < realintro x % 0 < realintro y
/;

inference.
intro /x y Hpos/.
unfold /ltr in Hpos in concl at 0 0/.
rewrite /-> minusr_id_r in Hpos in concl at 0 0/.
apply /Primitive.plusr_positive_invert_prereal/ >> auto.
qed ();



(* shadowing the name from Primitive *)
lemma "plusr_positive_invert"
/
  forall x y .
    0 < x + y
    -> squish (0 < x % 0 < y)
/;

inference.
intro /x y Hpos/.
so /real_to_prereal x/ /Hx/.
witness /squish_bind Hx __/.
intro /(x' ?)/.
so /real_to_prereal y/ /Hy/.
witness /squish_bind Hy __/.
intro /(y' ?)/.
subst /x y/.
clear /Hx Hy/.
apply /squish_ret/.
apply /plusr_positive_invert_prereal/ >> auto.
qed ();



lemma "plusr_positive_invert_squash"
/
  forall x y .
    0 < x + y
    -> { 0 < x % 0 < y }
/;

inference.
intro /x y Hpos/.
apply /squish_impl_squash/.
apply /plusr_positive_invert/ >> auto.
qed ();



lemma "overlapping_ranges_prereal"
/
  forall x y z .
    realintro y < realintro z
    -> realintro x < realintro z % realintro y < realintro x
/;

inference.
unfold /ltr at all, minusr at all/.
intro /x y z Hyz/.
so /Primitive.plusr_positive_invert_prereal (preplusr z (prenegr x)) (preplusr x (prenegr y)) __/ /H | H/.
  {
  rewrite /-> preplusr_to_real at 0 0/.
  rewrite /-> prenegr_to_real at 0 0/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_rotate4/.
  rewrite /-> plusr_assoc/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_r/.
  hyp /Hyz/.
  }

  {
  left.
  rewrite /-> preplusr_to_real in H, -> prenegr_to_real in H/.
  hyp /H/.
  }

  {
  right.
  rewrite /-> preplusr_to_real in H, -> prenegr_to_real in H/.
  hyp /H/.
  }
qed ();



lemma "overlapping_ranges"
/
  forall x y z .
    y < z
    -> squish (x < z % y < x)
/;

inference.
intro /x' y' z' Hyz/.
so /real_to_prereal x'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(x ?)/.
so /real_to_prereal y'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(y ?)/.
so /real_to_prereal z'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(z ?)/.
subst /x' y' z'/.
apply /squish_ret/.
apply /overlapping_ranges_prereal/ >> auto.
qed ();



lemma "overlapping_ranges_squash"
/
  forall x y z .
    y < z
    -> { x < z % y < x }
/;

inference.
intro /x y z Hyz/.
apply /squish_impl_squash/.
apply /overlapping_ranges/ >> auto.
qed ();



(* Absolute value *)

lemma "absr_of_nonneg"
/
  forall x .
    0 <= x
    -> absr x = x : real
/;

inference.
intro /x Hx/.
unfold /leqr in Hx/.
unfold /ltr in Hx/.
unfold /minusr in Hx/.
rewrite /-> plusr_id_l in Hx/.
apply /absr_spec/ >> auto.
qed ();



lemma "absr_of_nonpos"
/
  forall x .
    x <= 0
    -> absr x = ~ x : real
/;

inference.
intro /x Hx/.
rewrite /<- absr_negr/.
apply /absr_of_nonneg/.
rewrite /<- negr_zero/.
apply /negr_leqr/ >> auto.
qed ();



lemma "absr_nonneg"
/
  forall x . 0 <= absr x
/;

inference.
intro /x/.
unfold /leqr/.
unfold /ltr/.
unfold /minusr/.
rewrite /-> plusr_id_l/.
intro /Hposneg/.
witness /Stable.not_not_excluded_middle _ (positive (negr x)) __/.
intro /(Hneg | Hpos)/.
  {
  rewrite /<- absr_negr in Hposneg/.
  rewrite /-> absr_spec' in Hposneg/ >> auto.
  rewrite /-> negr_invol in Hposneg/.
  apply /positive_negative_contra x/ >> auto.
  }

  {
  rewrite /-> absr_spec in Hposneg/ >> auto.
  witness /Hpos Hposneg/.
  }
qed ();



lemma "absr_zero"
/
  absr 0 = 0 : real
/;

apply /absr_spec/.
rewrite /<- negz_to_real/.
reduce //.
apply /not_positive_zero/.
qed ();



lemma "absr_one"
/
  absr 1 = 1 : real
/;

apply /absr_of_nonneg/.
apply /leqr_0_1/.
qed ();



lemma "absr_minus_one"
/
  absr -1 = 1 : real
/;

rewrite /-> absr_of_nonpos/ >> autoWith /leqr_neg1_0/.
apply /negr_minus_one/.
qed ();



lemma "absr_timesr"
/
  forall x y . absr (timesr x y) = timesr (absr x) (absr y) : real
/;

inference.
intro /x y/.
apply /Stable.excluded_middle_if_stable _ _ (x = 0 : real)/.
  {
  apply /eq_real_stable/.
  }
intro /(Hzero | Hnzerox)/.
  {
  subst /x/.
  rewrite /-> timesr_ann_l/.
  rewrite /-> absr_zero at 0 0/.
  rewrite /-> timesr_ann_l/.
  reflexivity.
  }
apply /Stable.excluded_middle_if_stable _ _ (y = 0 : real)/.
  {
  apply /eq_real_stable/.
  }
intro /(Hzero | Hnzeroy)/.
  {
  subst /y/.
  rewrite /-> timesr_ann_r/.
  rewrite /-> absr_zero at 0 0/.
  rewrite /-> timesr_ann_r/.
  reflexivity.
  }
unfold /integer_to_real in Hnzerox in Hnzeroy/.
so /positive_or_negative _ Hnzerox/ /Hposx | Hnegx/ >> so /positive_or_negative _ Hnzeroy/ /Hposy | Hnegy/.
  {
  rewrite /-> absr_spec' x/ >> auto.
  rewrite /-> absr_spec' y/ >> auto.
  rewrite /-> absr_spec'/ >> auto.
  apply /timesr_positive/ >> auto.
  }

  {
  rewrite /<- absr_negr y/.
  rewrite /-> absr_spec' x/ >> auto.
  rewrite /-> absr_spec' (~ y)/ >> auto.
  rewrite /<- absr_negr/.
  rewrite /-> negr_dist_timesr_r/.
  rewrite /-> absr_spec'/ >> auto.
  apply /timesr_positive/ >> auto.
  }

  {
  rewrite /<- absr_negr x/.
  rewrite /-> absr_spec' (~ x)/ >> auto.
  rewrite /-> absr_spec' y/ >> auto.
  rewrite /<- absr_negr/.
  rewrite /-> negr_dist_timesr_l/.
  rewrite /-> absr_spec'/ >> auto.
  apply /timesr_positive/ >> auto.
  }

  {
  rewrite /<- absr_negr x/.
  rewrite /<- absr_negr y/.
  rewrite /-> absr_spec' (~ x)/ >> auto.
  rewrite /-> absr_spec' (~ y)/ >> auto.
  rewrite /<- negr_invol (x * y)/.
  rewrite /-> negr_dist_timesr_l/.
  rewrite /-> negr_dist_timesr_r/.
  rewrite /-> absr_spec'/ >> auto.
  apply /timesr_positive/ >> auto.
  }
qed ();



lemma "absr_plusr_leqr"
/
  forall x y . absr (x + y) <= absr x + absr y
/;

inference.
assert /forall x y . absr y <= absr x -> absr (x + y) <= absr x + absr y/ /Hprop/ >>> [inference, idtac].
1:{
  intro /x y/.
  apply /Stable.excluded_middle_if_stable _ _ (absr y <= absr x)/.
    {
    apply /leqr_stable/.
    }
  intro /(Hyx | Hnyx)/ >> auto.
  rewrite /-> plusr_commute at 0 1/.
  apply /Hprop/.
  apply /ltr_impl_leqr/.
  apply /not_leqr/ >> auto.
  }
assert /forall x y . absr y <= absr x -> 0 <= x -> absr (x + y) <= absr x + absr y/ /Hprop/ >>> [inference, idtac].
1:{
  intro /x y Hyx/.
  apply /Stable.excluded_middle_if_stable _ _ (0 <= x)/.
    {
    apply /leqr_stable/.
    }
  intro /(Hpos | Hneg)/ >> auto.
  rewrite /<- absr_negr at 0 1 2/.
  rewrite /-> negr_plusr/.
  apply /Hprop/.
    {
    rewrite /-> absr_negr at 0 0/.
    hyp /Hyx/.
    }

    {
    rewrite /<- negr_zero/.
    apply /negr_leqr/.
    rewrite /-> not_leqr in Hneg/.
    apply /ltr_impl_leqr/ >> auto.
    }
  }
intro /x y Hyx Hx/.
apply /Stable.excluded_middle_if_stable _ _ (0 <= y)/.
  {
  apply /leqr_stable/.
  }
intro /(Hy | Hy)/.
  {
  rewrite /-> absr_of_nonneg at 0 0 0/ >> autoWith /leqr_refl/.
  rewrite /<- plusr_id_l 0/.
  apply /plusr_leqr/ >> auto.
  }

  {
  rewrite /-> not_leqr in Hy/.
  rewrite /-> absr_of_nonneg/.
    {
    rewrite /-> absr_of_nonpos in Hyx/ >> autoWith /ltr_impl_leqr/.
    rewrite /-> absr_of_nonneg in Hyx/ >> auto.
    rewrite /-> plusr_shift_leqr_lrr/.
    rewrite /-> plusr_id_l/.
    hyp /Hyx/.
    }
  rewrite /-> absr_of_nonneg/ >> auto.
  apply /leqr_trans _ x/.
    {
    rewrite /<- plusr_id_r x at 1/.
    apply /plusr_leqr/ >> autoWith /leqr_refl/.
    apply /ltr_impl_leqr/ >> auto.
    }
    
    {
    rewrite /<- plusr_id_r x/.
    apply /plusr_leqr/ >> autoWith /leqr_refl/.
    apply /absr_nonneg/.
    }
  }
qed ();



lemma "absr_preserves_nonzero"
/
  forall x .
    x != 0 : real
    -> absr x != 0 : real
/;

inference.
intro /x Hnz/.
so /real_dichotomy_neq _ _ Hnz/ /Hneg | Hpos/.
  {
  rewrite /-> absr_of_nonpos/ >> autoWith /ltr_impl_leqr negr_nonzero/.
  }

  {
  rewrite /-> absr_of_nonneg/ >> autoWith /ltr_impl_leqr/.
  }
qed ();



lemma "absr_ub"
/
  forall x . x <= absr x
/;

inference.
intro /x/.
apply /Stable.excluded_middle_if_stable _ _ (0 <= x)/.
  {
  apply /leqr_stable/.
  }
intro /(Hpos | Hneg)/.
  {
  rewrite /-> absr_of_nonneg/ >> autoWith /leqr_refl/.
  }

  {
  rewrite /-> not_leqr in Hneg/.
  so /ltr_impl_leqr _ _ Hneg/ /Hleq/.
  rewrite /-> absr_of_nonpos/ >> auto.
  apply /leqr_trans _ 0/ >> auto.
  apply /negr_leqr'/.
  rewrite /-> negr_invol/.
  rewrite /-> negr_zero/.
  auto.
  }
qed ();



lemma "absr_idem"
/
  forall x . absr (absr x) = absr x : real
