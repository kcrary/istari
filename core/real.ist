lemma "invr_ltr_pos"
/
  forall x y .
    0 < x
    -> x < y
    -> invr y < invr x
/;

inference.
intro /x y Hposx Hxy/.
assert /x != 0 : real/ /Hnzx/.
  {
  symmetry.
  apply /ltr_impl_neq/ >> auto.
  }
assert /y != 0 : real/ /Hnzy/.
  {
  symmetry.
  apply /ltr_impl_neq/.
  apply /ltr_trans/ >> auto.
  }
apply /timesr_cancel_ltr_l _ _ x/ >> auto.
apply /timesr_cancel_ltr_r _ _ y/ >> autoWith /ltr_trans/.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_l/.
rewrite /-> timesr_id_l/.
rewrite /-> timesr_id_r/.
hyp /Hxy/.
qed ();



lemma "invr_leqr_pos"
/
  forall x y .
    0 < x
    -> x <= y
    -> invr y <= invr x
/;

inference.
intro /x y Hposx Hxy/.
assert /x != 0 : real/ /Hnzx/.
  {
  symmetry.
  apply /ltr_impl_neq/ >> auto.
  }
assert /y != 0 : real/ /Hnzy/.
  {
  symmetry.
  apply /ltr_impl_neq/.
  apply /ltr_leqr_trans/ >> auto.
  }
apply /timesr_cancel_leqr_l _ _ x/ >> auto.
apply /timesr_cancel_leqr_r _ _ y/ >> autoWith /ltr_leqr_trans/.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_l/.
rewrite /-> timesr_id_l/.
rewrite /-> timesr_id_r/.
hyp /Hxy/.
qed ();



lemma "invr_ltr_neg"
/
