lemma "absr_minusr_absr"
/
  forall a b .
    absr (absr a -r absr b) <r= absr (a -r b)
/;

inference.
assert /forall a b . r`0 <r= a -> b <r= r`0 -> absr (absr a -r absr b) <r= absr (a -r b)/ /Hacross/.
  {
  inference.
  intro /a b Hposa Hnegb/.
  rewrite /-> absr_of_nonneg at 1/ >> auto.
  rewrite /-> absr_of_nonpos at 1/ >> auto.
  unfold /minusr/.
  rewrite /-> negr_invol/.
  rewrite /-> absr_of_nonneg at 1/.
    {
    unfold /minusr/.
    rewrite /<- plusr_id_l r`0/.
    apply /plusr_leqr/ >> auto.
    apply /negr_leqr'/.
    rewrite /-> negr_invol/.
    rewrite /-> negr_zero/.
    auto.
    }
  apply /leqr_trans/.
    {
    apply /absr_plusr_leqr/.
    }

    typechecker ();
  rewrite /-> absr_of_nonneg/ >> auto.
  rewrite /-> absr_of_nonpos/ >> auto.
  unfold /minusr/.
  apply /leqr_refl/.
  }
intro /a b/.
apply /real_dichotomy_weak_if_stable _ _ 0 a/ >> autoWith /leqr_stable/.
intro /Ha/.
apply /real_dichotomy_weak_if_stable _ _ 0 b/ >> autoWith /leqr_stable/.
intro /Hb/.
destruct /Ha/ /Hnnega | Hnposa/ >> destruct /Hb/ /Hnnegb | Hnposb/.
  {
  rewrite /-> absr_of_nonneg at 1 1/ >> autoWith /leqr_refl/.
  }

  {
  apply /Hacross/ >> auto.
  }

  {
  rewrite /-> absr_minusr_commute at 0 1/.
  apply /Hacross/ >> auto.
  }

  {
  rewrite /-> absr_of_nonpos at 1 1/ >> auto.
  unfold /minusr/.
  rewrite /-> negr_invol/.
  rewrite /-> plusr_commute/.
  fold /minusr _ _/.
  rewrite /-> absr_minusr_commute/.
  apply /leqr_refl/.
  }
qed ();



lemma "absr_minusr_leqr_lower"
