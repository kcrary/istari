rewrite /-> timesr_commute at 1/.
apply /timesr_shift_ltr_rrr_neg/ >> auto.
qed ();



lemma "timesr_shift_ltr_lll_neg"
/
  forall x y z .
    y <r r`0
    -> x <r y *r z <-> z <r invr y *r x
/;

inference.
intro /x y z Hnegy/.
assert /y != r`0 : real/ /Hner/.
  {
  apply /ltr_impl_neq/ >> auto.
  }
split.
  {
  intro /Hler/.
  apply /timesr_cancel_ltr_l_neg _ _ y/ >> auto.
  rewrite /<- timesr_assoc/.
  rewrite /-> timesr_inverse_r/ >> auto.
  rewrite /-> timesr_id_l/.
  hyp /Hler/.
  }

  {
  intro /Hler/.
  apply /timesr_cancel_ltr_r_neg _ _ (invr y)/.
    {
    apply /invr_negative/ >> auto.
    }
  rewrite /-> timesr_commute at 0 2/.
  rewrite /<- timesr_assoc/.
  rewrite /-> timesr_inverse_l/ >> auto.
  rewrite /-> timesr_id_l/.
  hyp /Hler/.
  }
qed ();



