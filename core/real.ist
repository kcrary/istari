rewrite /-> timesr_commute3 _ c d/.
rewrite /-> timesr_commute3 _ b d/.
reflexivity.
qed ();



lemma "timesr_cancel_l"
/
  forall x y z .
    z != r`0 : real
    -> z *r x = z *r y : real
    -> x = y : real
/;

inference.
intro /x y z Hnzero Her/.
rewrite /<- timesr_id_l x/.
rewrite /<- timesr_id_l y/.
rewrite /<- timesr_inverse_l z at 0 0/ >> auto.
rewrite /-> timesr_assoc at 0 0/.
compat.
hyp /Her/.
qed ();



lemma "timesr_cancel_r"
/
  forall x y z .
    z != r`0 : real
    -> x *r z = y *r z : real
    -> x = y : real
/;

inference.
intro /x y z Hnzero Her/.
rewrite /-> timesr_commute in Her at 0 1/.
apply /timesr_cancel_l/ >> auto.
qed ();



lemma "timesr_shift_lll"
/
  forall x y z .
    y != r`0 : real
    -> x = y *r z : real <-> invr y *r x = z : real
/;

inference.
intro /x y z Hzero/.
split.
  {
  intro /Her/.
  apply /timesr_cancel_l _ _ y/ >> auto.
  rewrite /<- timesr_assoc/.
  rewrite /-> timesr_inverse_r/ >> auto.
  rewrite /-> timesr_id_l/.
  hyp /Her/.
  }

  {
  intro /Her/.
  apply /timesr_cancel_l _ _ (invr y)/.
    {
    apply /invr_nonzero/ >> auto.
    }
  rewrite /<- timesr_assoc/.
  rewrite /-> timesr_inverse_l/ >> auto.
  rewrite /-> timesr_id_l/.
  hyp /Her/.
  }
qed ();


 
