lemma "minr_dist_maxr_l"
/
  forall a b c . minr (maxr a b) c = maxr (minr a c) (minr b c) : real
/;

inference.
intro /a b c/.
revert /a b/.
assert /forall a b . a <r= b -> minr (maxr a b) c = maxr (minr a c) (minr b c) : real/ /H/.
  {
  inference.
  intro /a b Hab/.
  rewrite /-> maxr_eq_r a b/ >> auto.
  apply /real_dichotomy_weak_if_stable _ _ b c/ >> autoWith /eq_real_stable/.
  intro /(Hbc | Hcb)/.
    {
    rewrite /-> minr_eq_l b c at all/ >> auto.
    rewrite /-> minr_eq_l a c/ >> autoWith /leqr_trans/.
    rewrite /-> maxr_eq_r/ >> auto.
    }

    {
    rewrite /-> minr_eq_r b c at all/ >> auto.
    apply /real_dichotomy_weak_if_stable _ _ a c/ >> autoWith /eq_real_stable/.
    intro /(Hac | Hca)/.
      {
      rewrite /-> minr_eq_l/ >> auto.
      rewrite /-> maxr_eq_r/ >> auto.
      }

      {
      rewrite /-> minr_eq_r/ >> auto.
      symmetry.
      apply /maxr_idem/.
      }
    }
  }
intro /a b/.
apply /real_dichotomy_weak_if_stable _ _ a b/ >> autoWith /eq_real_stable/.
intro /(Hab | Hba)/.
  {
  apply /H/ >> auto.
  }

  {
  rewrite /-> maxr_commute at 0 1/.
  apply /H/ >> auto.
  }
qed ();



