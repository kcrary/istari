  split >> auto.
  }
qed ();



lemma "approximations_nearby"
/
  forall (x : nat -> rational) (h : regular x) (n : nat) .
    n`0 <n n
    -> leqr (absr (minusr (rintro x h) (rational_to_real (x n)))) (rational_to_real (invq (nat_to_rational n)))
/;

intro /x Hreg n Hposn/.
unfold /leqr, ltr/.
intro /Hpos/.
unfold /minusr in Hpos at all, plusr in Hpos at all, negr in Hpos at all, absr in Hpos at all, rational_to_real in Hpos at all, rintro in Hpos at all/.
reduce /Hpos/.
unfold /positive in Hpos/.
destruct /Hpos/ /[Hpos]/.
unhide.
unfold /prepositive in Hpos/.
destruct /Hpos/ /m Hposm Hlt/.
reduce /Hlt/.
rewrite /-> plus_0_r in Hlt at all/.
rewrite /<- not_leqq in Hlt/.
witness /Hlt __/.
clear /Hlt/.
apply /negq_leqq'/.
rewrite /-> negq_dist_plusq/.
rewrite /-> negq_invol/.
rewrite /-> plusq_commute/.
rewrite /<- plus_assoc at all/.
rewriteThen /m +n m +n m +n m = m *n n`4 : nat/ omega.
unfold /regular in Hreg/.
fold /minusq _ _ at 1/.
rewrite /-> Hreg/ >> auto.
1:{
  omega.
  }
rewrite /-> negq_dist_plusq/.
rewrite /-> plusq_commute at 1/.
rewrite /<- plusq_assoc/.
rewrite /-> plusq_inverse_r/.
rewrite /-> plusq_id_l/.
apply /negq_leqq/.
rewrite /-> times_to_rational/.
rewrite /-> invq_timesq/.
rewrite /<- timesq_id_r (invq _) at 2/.
apply /timesq_leqq_l/.
  {
  autoQ.
  }

  {
  rewrite /<- invq_one/.
  autoQ.
  }
qed ();



lemma "real_sequence_to_prereal_sequence"
/
  forall (f : nat -> real) .
    squish (exists (g : nat -> prereal) . f = (fn x . realintro (g x)) : (nat -> real))
/;

assert /Q.PER (nat -> rational) (fn x y . regular x & regular y & realequiv x y)/ /Hper/.
  {
  unfold /Q.PER/.
  reduce //.
  split.
    {
    intro /x y (Hx Hy Hxy)/.
    splitn 2 >> auto.
    apply /realequiv_symm/ >> auto.
    }

    {
    intro /x y z (Hx Hy Hxy) (_ Hz Hyz)/.
    splitn 2 >> auto.
    apply /realequiv_trans _ y/ >> auto.
    }
  }
assert /Q.PER (nat -> nat -> rational) (fn f g . forall n . regular (f n) & regular (g n) & realequiv (f n) (g n))/ /Hperarr/.
  {
  inference.
  unfold /Q.PER/.
  reduce //.
  split.
    {
    intro /f g Hfg n/.
    so /Hfg n/ /Hf Hg H/.
    splitn 2 >> auto.
    apply /realequiv_symm/ >> auto.
    }

    {
    intro /f g h Hfg Hgh n/.
    so /Hfg n/ /Hf Hg Hfg'/.
    so /Hgh n/ /_ Hh Hgh'/.
    splitn 2 >> auto.
    apply /realequiv_trans _ (g n)/ >> auto.
    }
  }
intro /f/.
tightenRaw /f/ /Q.quotient1 (nat -> nat -> rational) (fn f g . forall n . regular (f n) & regular (g n) & realequiv (f n) (g n)) Hper/.
  {
  inference.
  clear /f/.
  unfold /Q.quotient1/.
  unfold /real/.
  apply /Q.arrow_quotient_commute _ nat (nat -> rational) (fn x y . regular x & regular y & realequiv x y)/.
  auto.
  }

  {
  subsume /nat -> real/.
  1:{
    hypof.
    }
  clear /f/.
  unfold /real/.
  unfold /Q.quotient1/.
  reduce //.
  apply /Q.nat_arrow_quotient_commute_conv/ >> auto.
    {
    RuleTactic.arrowSymmetrical.
      {
      RuleTactic.natSymmetrical.
      }
    unfold /rational/.
    RuleTactic.quotientSymmetrical.
      {
      fold /rational/.
      typecheck.
      }
    RuleTactic.prodSymmetrical >> RuleTactic.integerSymmetrical.
    }

    {
    intro /x y/.
    reduce //.
    intro /[H]/.
    so /regular_sqstable/ /Hstable/.
    assert /regular x/ /Hx/.
      {
      squashConcl >> auto.
      split.
      destruct /H/ /? ? ?/.
      auto.
      }
    assert /regular y/ /Hy/.
      {
      squashConcl >> auto.
      split.
      destruct /H/ /? ? ?/.
      auto.
      }
    splitn 2 >> auto.
    squashConcl.
      {
      apply /realequiv_sqstable/ >> auto.
      }
    split.
    destruct /H/ /? ? ?/.
    auto.
    }
  }
exactRaw /squish_ret (f, ())/.
destruct /f/ /[f g Hfg]/.
  {
  typecheck.
  reduce /Hfg/.
  unfold /Q.qintro1 at 0 0/.
  introEqRaw /n/.
    {
    introOf /n/.
    fold /rintro (f n) (Hfg n #1)/.
    typecheck.
    }

    {
    introOf /n/.
    fold /rintro (g n) (Hfg n #2 #1)/.
    typecheck.
    }
  fold /rintro (f n) (Hfg n #1)/.
  fold /rintro (g n) (Hfg n #2 #1)/.
  apply /real_equality/.
  split.
  unfold /rintro at 0 0/.
  auto.
  }
unfold /Q.qintro1 at all/.
reduce /Hfg/.
assert /f : nat -> real/ /Hoff/.
  {
  introOf /n/.
  fold /rintro (f n) (Hfg n #1)/.
  typecheck.
  }
assert /g : nat -> real/ /Hofg/.
  {
  introOf /n/.
  fold /rintro (g n) (Hfg n #2 #1)/.
  typecheck.
  }
assert /f : nat -> prereal/ /Hoff'/.
  {
  introOf /n/.
  unfold /prereal/.
  typecheck.
  auto.
  }
assert /g : nat -> prereal/ /Hofg'/.
  {
  introOf /n/.
  unfold /prereal/.
  typecheck.
  auto.
  }
assert /forall (x : nat) . f x : real/ /Hoff''/.
  {
  intro /x/.
  inferSpine /Hoff/ /__ x/ /H/.
  hyp /H/.
  }
assert /forall (x : nat) . g x : real/ /Hofg''/.
  {
  intro /x/.
  inferSpine /Hofg/ /__ x/ /H/.
  hyp /H/.
  }
applyRaw /squish_ext/ >> auto.
  {
  typecheck.
  unfold /realintro/.
  introEq /x/ >> auto.
  }

  {
  typecheck.
  unfold /realintro/.
  introEq /x/ >> auto.
  reduce //.
  apply /real_equality/.
  split.
  apply /Hfg/.
  }
qed ();



lemma "real_sequence_to_prereal_sequence_squash"
/
  forall (f : nat -> real) .
    { exists (g : nat -> prereal) . f = (fn x . realintro (g x)) : (nat -> real) }
/;

intro /f/.
apply /squish_impl_squash/.
apply /real_sequence_to_prereal_sequence/.
qed ();



lemma "real_upper_bound_prereal"
/
  forall (x : prereal) . exists (y : integer) . ltr (realintro x) (integer_to_real y)
/;

intro /(x Hx)/.
unfold /realintro/.
unfold /integer_to_real, rational_to_real/.
unfold /ltr, positive/.
unfold /minusr, negr, plusr/.
exists /ceiling (x n`2) +z z`2/.
unfold /prepositive/.
split.
exists /n`1/.
split.
  {
  omega.
  }
unfold /nat_to_rational/.
reduce //.
rewrite /-> invq_one/.
rewrite /-> plusz_to_rational/.
rewrite /<- plusq_shift_ltq_rrr/.
rewrite /-> plusq_commute/.
apply /plusq_ltq_r/.
  {
  apply /ceiling_ub/.
  }

  {
  apply /integer_to_rational_mono_lt/.
  omega.
  }
qed ();



endModule ();  (* Primitive *)

