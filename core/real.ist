lemma "invr_compat"
/
  forall (x x' : nonzero_real) .
    x = x' : real
    -> invr x = invr x' : real
/;

inference.
intro /x x' H/.
substitution /x'/ /x/ >> auto.
unfold /nonzero_real in x' in concl/.
destruct /x'/ /x' Hx'/.
extensionality >> auto.
qed ();



(* Distributivity *)

lemma "negr_dist_timesr_l"
/
  forall x y .
    ~ (x * y) = ~ x * y : real
/;

inference.
intro /x y/.
rewrite /-> negr_as_timesr at 0 0/.
rewrite /<- timesr_assoc/.
reflexivity.
qed ();



lemma "negr_dist_timesr_r"
/
  forall x y .
    ~ (x * y) = x * ~ y : real
/;

inference.
intro /x y/.
rewrite /-> timesr_commute at 0 1/.
apply /negr_dist_timesr_l/.
qed ();



lemma "timesr_dist_minusr_r"
/
  forall a b c . a *r (b -r c) = a *r b -r a *r c : real
/;

inference.
intro /a b c/.
unfold /minusr at 0 0/.
rewrite /-> timesr_dist_plusr_r/.
rewrite /-> negr_dist_timesr_r/.
reflexivity.
qed ();



lemma "timesr_dist_minusr_l"
/
  forall a b c . (a -r b) *r c = a *r c -r b *r c : real
/;

inference.
intro /a b c/.
unfold /minusr at 0 0/.
rewrite /-> timesr_dist_plusr_l/.
rewrite /-> negr_dist_timesr_l/.
reflexivity.
qed ();



lemma "timesr_positive_invert"
/
  forall x y .
    positive (timesr x y)
    -> (positive x & positive y) % (positive (negr x) & positive (negr y))
/;

inference.
intro /x y Hpos/.
so /positive_or_negative x __/ /Hx/.
  {
  intro /Hzero/.
  subst /x/.
  fold /integer_to_real z`0 in Hpos/.
  rewrite /-> timesr_ann_l in Hpos/.
  so /not_positive_zero Hpos/ /0/.
  }
so /positive_or_negative y __/ /Hy/.
  {
  intro /Hzero/.
  subst /y/.
  fold /integer_to_real z`0 in Hpos/.
  rewrite /-> timesr_ann_r in Hpos/.
  so /not_positive_zero Hpos/ /0/.
  }
destruct /Hx/ /Hposx | Hnegx/ >> destruct /Hy/ /Hposy | Hnegy/ >> auto.
  {
  exfalso.
  witness /positive_negative_contra _ Hpos __/.
  rewrite /-> negr_dist_timesr_r/.
  apply /timesr_positive/ >> auto.
  }

  {
  exfalso.
  witness /positive_negative_contra _ Hpos __/.
  rewrite /-> negr_dist_timesr_l/.
  apply /timesr_positive/ >> auto.
  }
qed ();



lemma "timesr_ltr_zero_invert"
/
  forall x y .
    0 < x * y
    -> x < 0 & y < 0 % 0 < x & 0 < y
/;

inference.
intro /x y/.
unfold /ltr at all/.
unfold /minusr at all/.
rewrite /-> plusr_id_l at all/.
rewrite /-> negr_zero at all/.
rewrite /-> plusr_id_r at all/.
intro /H/.
so /timesr_positive_invert _ _ H/ /? | ?/ >> auto.
qed ();



lemma "timesr_ltr_zero_invert_neg"
/
  forall x y .
    x * y < 0
    -> x < 0 & 0 < y % 0 < x & y < 0
/;

inference.
intro /x y/.
unfold /ltr at all/.
unfold /minusr at all/.
rewrite /-> plusr_id_l at all/.
rewrite /-> negr_zero at all/.
rewrite /-> plusr_id_r at all/.
intro /H/.
rewrite /-> negr_dist_timesr_l in H/.
rewrite /<- negr_invol x at 1/.
so /timesr_positive_invert _ _ H/ /? | ?/ >> auto.
qed ();



lemma "negr_dist_invr"
/
  forall (x : nonzero_real) .
    ~r (invr x) = invr (~r x) : real
/;

inference.
intro /x/.
destruct /x/ /x Hx/.
unhide.
so /negr_nonzero x Hx/ /Hnegnzero/.
apply /plusr_cancel_l _ _ (invr x)/.
rewrite /-> plusr_inverse_r/.
apply /timesr_cancel_r _ _ (negr x)/ >> autoWith /negr_nonzero/.
rewrite /-> timesr_ann_l/.
rewrite /-> timesr_dist_plusr_l/.
rewrite /-> timesr_inverse_l/ >> autoWith /negr_nonzero/.
rewrite /<- negr_dist_timesr_r/.
rewrite /<- plusr_shift_rll/.
rewrite /-> plusr_id_r/.
apply /timesr_inverse_l/ >> auto.
qed ();



lemma "negr_dist_divr_l"
/
  forall x (y : nonzero_real) .
    ~r (x |r y) = ~r x |r y : real
/;

inference.
intro /x y/.
unfold /divr at all/.
apply /negr_dist_timesr_l/.
qed ();
    


lemma "negr_dist_divr_r"
/
  forall x (y : nonzero_real) .
    ~r (x |r y) = x |r ~r y : real
/;

inference.
intro /x y/.
unfold /divr at all/.
rewrite /<- negr_dist_invr/.
apply /negr_dist_timesr_r/.
qed ();
    


lemma "plusr_self"
/
  forall x . x +r x = r`2 *r x : real
/;

inference.
intro /x/.
rewrite /-> plusz_to_real z`1 z`1/.
rewrite /-> timesr_dist_plusr_l/.
rewrite /-> timesr_id_l at 0 0/.
reflexivity.
qed ();



(* Inequalities *)

lemma "ltr_impl_leqr"
/
  forall x y . ltr x y -> leqr x y
/;

inference.
intro /x y Hxy Hyx/.
unfold /ltr in Hxy in Hyx/.
witness /positive_negative_contra _ Hxy __/.
rewrite /-> negr_minusr/ >> auto.
qed ();



lemma "ltr_irrefl"
/
  forall x . not (ltr x x)
/;

inference.
intro /x/.
unfold /ltr/.
unfold /minusr/.
rewrite /-> plusr_inverse_r/.
apply /not_positive_zero/.
qed ();



lemma "ltr_impl_neq"
/
  forall x y .
    x < y
    -> x != y : real
/;

inference.
intro /x y Hlt Heq/.
subst /y/.
exact /ltr_irrefl _ Hlt/.
qed ();



lemma "leqr_refl"
/
  forall x . leqr x x
/;

inference.
intro /x/.
unfold /leqr/.
apply /ltr_irrefl/.
qed ();



lemma "leqr_refl'"
/
  forall x y .
    x = y : real
    -> x <= y
/;

inference.
intro /x y ?/.
subst /y/.
apply /leqr_refl/.
qed ();



lemma "leqr_antisymm"
/
  forall x y . leqr x y -> leqr y x -> x = y : real
/;

inference.
unfold /leqr at 0 0/.
intro /x y Hnxy Hnyx/.
apply /eq_real_stable/.
intro /Hneq/.
exploit /positive_or_negative (minusr x y)/ /(Hxy | Hyx)/.
  {
  unfold /minusr/.
  contrapositive /Hneq/.
  rewrite /<- plusr_id_r y/.
  unfold /integer_to_real/.
  rewrite /<- Hneq/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_rotate/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_l/.
  reflexivity.
  }

  {
  unfold /ltr in Hnxy/.
  exact /Hnxy Hxy/.
  }

  {
  rewrite /-> negr_minusr in Hyx/.
  unfold /ltr in Hnyx/.
  exact /Hnyx Hyx/.
  }
qed ();



lemma "leqr_ltr_trans"
/
  forall x y z . leqr x y -> ltr y z -> ltr x z
/;

inference.
unfold /leqr, ltr at 0 0/.
intro /x y z Hxy Hyz/.
rewrite /<- negr_minusr in Hxy/.
so /plusr_positive_nonnegative _ _ Hyz Hxy/ /Hxz/.
unfold /minusr in Hxz at 0 0/.
rewrite /<- plusr_assoc in Hxz at all/.
rewrite /-> plusr_rotate4 in Hxz/.
rewrite /-> plusr_assoc in Hxz at all/.
rewrite /-> plusr_inverse_l in Hxz/.
rewrite /-> plusr_id_r in Hxz/.
fold /minusr z x in Hxz/.
unfold /ltr/.
hyp /Hxz/.
qed ();



lemma "ltr_leqr_trans"
/
  forall x y z . ltr x y -> leqr y z -> ltr x z
/;

inference.
unfold /leqr, ltr at 0 0/.
intro /x y z Hxy Hyz/.
rewrite /<- negr_minusr in Hyz/.
so /plusr_positive_nonnegative _ _ Hxy Hyz/ /Hxz/.
unfold /minusr in Hxz at 0 0/.
rewrite /<- plusr_assoc in Hxz at all/.
rewrite /-> plusr_rotate _ _ z in Hxz/.
rewrite /-> plusr_commute3 _ y (negr x) in Hxz/.
rewrite /-> plusr_assoc in Hxz at all/.
rewrite /-> plusr_inverse_r in Hxz/.
rewrite /-> plusr_id_r in Hxz/.
fold /minusr z x in Hxz/.
unfold /ltr/.
hyp /Hxz/.
qed ();



lemma "ltr_trans"
/
  forall x y z . ltr x y -> ltr y z -> ltr x z
/;

inference.
intro /x y z Hxy Hyz/.
apply /leqr_ltr_trans/ >> auto.
apply /ltr_impl_leqr/ >> auto.
qed ();



lemma "leqr_trans"
/
  forall x y z . leqr x y -> leqr y z -> leqr x z
/;

inference.
unfold /leqr at all/.
intro /x y z Hnxy Hnyz Hxz/.
exploit /plusr_positive_invert_squash (minusr x y) (minusr y z)/ /[(Hxy | Hyz)]/.
  {
  unfold /minusr at 0 0/.
  rewrite /<- plusr_assoc at all/.
  rewrite /-> plusr_rotate4/.
  rewrite /-> plusr_assoc at all/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_r/.
  fold /minusr x z/.
  unfold /ltr in Hxz/.
  hyp /Hxz/.
  }

  {
  unfold /ltr in Hnxy/.
  exact /Hnxy Hxy/.
  }

  {
  unfold /ltr in Hnyz/.
  exact /Hnyz Hyz/.
  }
qed ();



lemma "ltr_inhabitant"
/
  forall x y .
    ltr x y
    -> () : ltr x y
/;

inference.
intro /x y H/.
unfold /ltr in H in concl/.
apply /positive_inhabitant/ >> auto.
qed ();



lemma "leqr_inhabitant"
/
  forall x y .
    leqr x y
    -> (fn _ . ()) : leqr x y
/;

inference.
intro /x y H/.
unfold /leqr/.
typecheck.
witness /ltr_irrefl x __/.
apply /leqr_ltr_trans/ >> auto.
qed ();



lemma "ltr_ext"
/
  forall x y (h h' : x <r y) .
    h = h' : (x <r y)
/;

inference.
intro /x y h h'/.
unfold /ltr in h in h' in concl/.
apply /positive_ext/.
qed ();
    


lemma "leqr_ext"
/
  forall x y (h h' : x <r= y) .
    h = h' : (x <r= y)
/;

inference.
intro /x y h h'/.
unfold /leqr in h in h' in concl/.
introEq /Hyx/.
so /h Hyx/ /0/.
qed ();



lemma "leqr_implication"
/
  forall x x' y y' .
    x' <= x
    -> y <= y'
    -> x <= y
    -> x' <= y'
/;

inference.
intro /x x' y y' Hx Hy Hxy/.
apply /leqr_trans/ >> auto.
apply /leqr_trans/ >> auto.
qed ();



lemma "ltr_implication"
/
  forall x x' y y' .
    x' <= x
    -> y <= y'
    -> x < y
    -> x' < y'
/;

inference.
intro /x x' y y' Hx Hy Hxy/.
apply /leqr_ltr_trans/ >> auto.
apply /ltr_leqr_trans/ >> auto.
qed ();



lemma "not_leqr"
/
  forall x y .
    not (x <= y) <-> y < x
/;

inference.
intro /x y/.
unfold /leqr/.
split.
  {
  intro /H/.
  apply /ltr_stable/ >> auto.
  }

  {
  intro /H H'/.
  witness /H' H/.
  }
qed ();



lemma "not_ltr"
/
  forall x y .
    not (x < y) <-> y <= x
/;

inference.
intro /x y/.
unfold /leqr/.
reflexivity.
qed ();



lemma "ltr_from_leqr_neq"
/
  forall x y . x <= y -> x != y : real -> x < y
/;

intro /x y Hxy Hneq/.
unfold /leqr in Hxy/.
so /real_dichotomy_neq _# 2 Hneq/ /H | H/ >> auto.
so /Hxy H/ /0/.
qed ();



lemma "real_dichotomy_if_stable"
/
  forall i (P : U i) x y .
    Stable.stable P
    -> ((x <= y % y < x) -> P)
    -> P
/;

inference.
intro /i P x y Hstable Hprop/.
apply /Stable.excluded_middle_if_stable _ _ (x <= y)/ >> auto.
intro /(Hxy | Hyx)/ >> auto.
rewrite /-> not_leqr in Hyx/ >> auto.
qed ();



lemma "real_dichotomy_weak_if_stable"
/
  forall i (P : U i) x y .
    Stable.stable P
    -> ((x <= y % y <= x) -> P)
    -> P
/;

inference.
intro /i P x y Hstable Hprop/.
apply /real_dichotomy_if_stable _ _ x y/ >> auto.
intro /(Hxy | Hyx)/ >> autoWith /ltr_impl_leqr/.
qed ();



(* Plus and negation inequalities *)

lemma "plusr_ltr"
/
  forall x x' y y' .
    x < x'
    -> y < y'
    -> x + y < x' + y'
/;

inference.
intro /x x' y y' Hltx Hlty/.
unfold /ltr in Hltx in Hlty in concl/.
unfold /minusr/.
rewrite /-> negr_plusr/.
rewrite /<- plusr_assoc at all/.
rewrite /<- plusr_commute3 at 1/.
rewrite /-> plusr_assoc/.
fold /minusr _ _ at 0 0/.
apply /plusr_positive/ >> auto.
qed ();



lemma "plusr_leqr"
/
  forall x x' y y' .
    x <= x'
    -> y <= y'
    -> x + y <= x' + y'
/;

inference.
intro /x x' y y' Hleqx Hleqy/.
unfold /leqr in Hleqx in Hleqy in concl/.
unfold /ltr in Hleqx in Hleqy in concl/.
unfold /minusr/.
rewrite /-> negr_plusr/.
rewrite /<- plusr_assoc at all/.
rewrite /<- plusr_commute3 at 1/.
rewrite /-> plusr_assoc/.
fold /minusr _ _ at 0 0/.
intro /Hpositive/.
so /plusr_positive_invert_squash _ _ Hpositive/ /[(Hlt | Hlt)]/.
  {
  apply /Hleqx/ >> auto.
  }

  {
  apply /Hleqy/ >> auto.
  }
qed ();



lemma "negr_ltr"
/
  forall x y .
    x < y
    -> ~ y < ~ x
/;

inference.
intro /x y/.
unfold /ltr at all, minusr at all/.
intro /Hxy/.
rewrite /-> negr_invol/.
rewrite /-> plusr_commute/.
hyp /Hxy/.
qed ();



lemma "negr_ltr'"
/
  forall x y .
    ~ y < ~ x
    -> x < y
/;

inference.
intro /x y H/.
so /negr_ltr _# 2 H/ /H'/.
rewrite /-> negr_invol in H' at 0 0/.
hyp /H'/.
qed ();



lemma "negr_leqr"
/
  forall x y .
    x <= y
    -> ~ y <= ~ x
/;

inference.
intro /x y/.
unfold /leqr at all, ltr at all, minusr at all/.
intro /Hxy/.
rewrite /-> negr_invol/.
rewrite /-> plusr_commute/.
hyp /Hxy/.
qed ();



lemma "negr_leqr'"
/
  forall x y .
    ~ y <= ~ x
    -> x <= y
/;

inference.
intro /x y H/.
so /negr_leqr _# 2 H/ /H'/.
rewrite /-> negr_invol in H' at 0 0/.
hyp /H'/.
qed ();



lemma "plusr_cancel_leqr_l"
/
  forall x y z .
    z + x <= z + y
    -> x <= y
/;

inference.
intro /x y z Hleq/.
rewrite /<- plusr_id_l x/.
rewrite /<- plusr_id_l y/.
rewrite /<- plusr_inverse_l z at 0 0/.
rewrite /-> plusr_assoc at 0 0/.
apply /plusr_leqr/ >> auto.
apply /leqr_refl/.
qed ();



lemma "plusr_cancel_leqr_r"
/
  forall x y z .
    x + z <= y + z
    -> x <= y
/;

inference.
intro /x y z Hleq/.
rewrite /-> plusr_commute in Hleq at 0 1/.
apply /plusr_cancel_leqr_l/ >> auto.
qed ();



lemma "plusr_cancel_leqr_leqr_l"
/
  forall x x' y y' .
    x + y <= x' + y'
    -> x' <= x
    -> y <= y'
/;

inference.
intro /x x' y y' Hleq Hleqx/.
apply /plusr_cancel_leqr_l _ _ x/.
apply /leqr_trans/ >> auto.
apply /plusr_leqr/ >> auto.
apply /leqr_refl/.
qed ();



lemma "plusr_cancel_leqr_leqr_r"
/
  forall x x' y y' .
    x + y <= x' + y'
    -> y' <= y
    -> x <= x'
/;
    
inference.
intro /x x' y y' Hleq Hleqy/.
rewrite /-> plusr_commute in Hleq at 0 1/.
apply /plusr_cancel_leqr_leqr_l/ >> auto.
qed ();



lemma "plusr_shift_leqr_lll"
/
  forall x y z .
    x <= y + z <-> ~ y + x <= z
/;

inference.
intro /x y z/.
split.
  {
  intro /Heq/.
  apply /plusr_cancel_leqr_l _ _ y/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_r/.
  rewrite /-> plusr_id_l/.
  hyp /Heq/.
  }

  {
  intro /Heq/.
  apply /plusr_cancel_leqr_l _ _ (~ y)/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_l/.
  hyp /Heq/.
  }
qed ();



lemma "plusr_shift_leqr_lrr"
/
  forall x y z .
    x <= y + z <-> x + ~ z <= y
/;

inference.
intro /x y z/.
rewrite /-> plusr_commute at 0 1/.
apply /plusr_shift_leqr_lll/.
qed ();



lemma "plusr_shift_leqr_llr"
/
  forall x y z .
    x <= y + z <-> x + ~ y <= z
/;

inference.
intro /x y z/.
rewrite /-> plusr_commute at 1/.
apply /plusr_shift_leqr_lll/.
qed ();



lemma "plusr_shift_leqr_lrl"
/
  forall x y z .
    x <= y + z <-> ~ z + x <= y
/;

inference.
intro /x y z/.
rewrite /-> plusr_commute at 0/.
apply /plusr_shift_leqr_lll/.
qed ();



lemma "plusr_shift_leqr_rrr"
/
  forall x y z .
    x + y <= z <-> x <= z + ~ y
/;

inference.
intro /x y z/.
symmetry.
rewrite /-> plusr_commute at 0 1/.
rewrite /<- negr_invol y at 1/.
apply /plusr_shift_leqr_lll/.
qed ();



lemma "plusr_shift_leqr_rll"
/
  forall x y z .
    x + y <= z <-> y <= ~ x + z
/;

inference.
intro /x y z/.
