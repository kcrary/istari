lemma "square_nonnegative"
/
  forall x . 0 <= x * x
/;

inference.
intro /x/.
apply /real_dichotomy_weak_if_stable _ _ 0 x/.
  {
  apply /leqr_stable/.
  }
intro /(Hpos | Hneg)/.
  {
  apply /timesr_leqr_zero/ >> auto.
  }

  {
  rewrite /<- negr_invol (x * x)/.
  rewrite /-> negr_dist_timesr_r/.
  rewrite /-> negr_dist_timesr_l/.
  assert /0 <= ~ x/ /Hpos/.
    {
    apply /negr_leqr'/.
    rewrite /-> negr_zero/.
    rewrite /-> negr_invol/.
    hyp /Hneg/.
    }
  apply /timesr_leqr_zero/ >> auto.
  }
qed ();



lemma "invr_positive"
/
  forall x .
    0 < x
    -> 0 < invr x
/;

inference.
intro /x Hposx/.
assert /x != 0 : real/ /Hnzx/.
  {
  intro /?/.
  subst /x/.
  exact /ltr_irrefl _ Hposx/.
  }
so /invr_nonzero x/ /Hnzix/.
unfold /integer_to_real in Hnzix/.
so /positive_or_negative _ Hnzix/ /Hpos | Hneg/.
  {
  unfold /ltr/.
  unfold /minusr/.
  rewrite /-> negr_zero/.
  rewrite /-> plusr_id_r/.
  auto.
  }

  {
  exfalso.
  unfold /ltr in Hposx/.
  unfold /minusr in Hposx/.
  rewrite /-> negr_zero in Hposx/.
  rewrite /-> plusr_id_r in Hposx/.
  so /timesr_positive _ _ Hneg Hposx/ /H/.
  rewrite /<- negr_dist_timesr_l in H/.
  rewrite /-> timesr_inverse_l in H/.
  so /leqr_0_1/ /H'/.
  unfold /leqr in H'/.
  witness /H' __/.
  unfold /ltr/.
  unfold /minusr/.
  rewrite /-> plusr_id_l/.
  hyp /H/.
  }
qed ();



lemma "invr_negative"
/
  forall x .
    x < 0
    -> invr x < 0
/;

inference.
intro /x Hneg/.
assert /x != 0 : real/ /Hnzx/.
  {
  intro /?/.
  subst /x/.
  exact /ltr_irrefl _ Hneg/.
  }
apply /negr_ltr'/.
rewrite /-> negr_zero/.
rewrite /-> negr_dist_invr/.
apply /invr_positive/.
apply /negr_ltr'/.
rewrite /-> negr_zero/.
rewrite /-> negr_invol/.
hyp /Hneg/.
qed ();



lemma "divr_leqr_zero"
/
  forall x y .
    r`0 <r= x
    -> r`0 <r y
    -> r`0 <r= x |r y
/;

inference.
intro /x y Hx Hy/.
unfold /divr/.
so /ltr_impl_neq _# 2 Hy/ /Hneqy/.
symmetryIn /Hneqy/.
apply /timesr_leqr_zero/ >> auto.
apply /ltr_impl_leqr/ >> autoWith /invr_positive/.
qed ();

