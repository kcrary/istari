lemma "negr_one"
/
  ~ 1 = -1 : real
/;

rewrite /z`-1 = ~z z`1 : integer/.
rewrite /-> negz_to_real z`1/.
reflexivity.
qed ();



lemma "negr_minus_one"
/
  ~ -1 = 1 : real
/;

rewrite /<- negr_one/.
apply /negr_invol/.
qed ();



(* Relation to natural numbers *)

define /nat_to_real n/
/
  rational_to_real (integer_to_rational (nat_to_integer n))
//
  nat -> real
/;

unfold /nat_to_real/.
typecheck.
qed ();



lemma "nat_to_real_injective"
/
  forall x y .
    nat_to_real x = nat_to_real y : real
    -> x = y : nat
/;

inference.
intro /x y Heq/.
unfold /nat_to_real in Heq at 0 0/.
apply /nat_to_integer_injective/.
apply /integer_to_rational_injective/.
