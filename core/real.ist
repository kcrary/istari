(* SET PARSING TO REAL *)
structure RealParsing = RealParsingFun ();
RealParsing.setArithReal ();



lemma "eq_nonzero_real"
/
  forall (x y : real) .
    x != integer_to_real z`0 : real
    -> x = y : real
    -> x = y : nonzero_real
/;

intro /x y Hnonzero Heq/.
unfold /nonzero_real/.
extensionality >> auto.
qed ();



lemma "eq_nonzero_real'"
/
  forall (x y : real) . y != 0 : real -> x = y : real -> x = y : nonzero_real
/;

intro /x y Hnzero Heq/.
apply /eq_nonzero_real/ >> auto.
subst /y/ >> auto.
qed ();



lemma "plusr_id_r"
/
  forall x . x + 0 = x : real
/;

inference.
intro /x/.
rewrite /-> plusr_commute/.
apply /plusr_id_l/.
qed ();



lemma "plusz_to_real"
/
  forall x y . integer_to_real (x +z y) = integer_to_real x +r integer_to_real y : real
/;

inference.
intro /x y/.
unfold /integer_to_real at all/.
rewrite /-> plusz_to_rational/.
apply /plusq_to_real/.
qed ();



lemma "plusr_commute3"
/
  forall a b c .
    a + b + c = a + c + b : real
/;

inference.
intro /a b c/.
rewrite /-> plusr_assoc at 0 0/.
rewrite /-> plusr_commute at 1/.
reflexivity.
qed ();



lemma "plusr_rotate"
/
  forall a b c .
    a + b + c = c + a + b : real
/;

inference.
intro /a b c/.
rewrite /-> plusr_commute c a/.
rewrite /-> plusr_assoc at 1/.
rewrite /-> plusr_commute c b/.
apply /plusr_assoc/.
qed ();



lemma "plusr_rotate4"
/
  forall a b c d .
    a + b + c + d = a + d + b + c : real
/;

inference.
intro /a b c d/.
rewrite /-> plusr_commute3 _ c d/.
rewrite /-> plusr_commute3 _ b d/.
reflexivity.
qed ();



lemma "plusr_cancel_l"
/
  forall a b c .
    c + a = c + b : real
    -> a = b : real
/;

intro /a b c Heq/.
rewrite /<- plusr_id_l a , <- plusr_id_l b/.
rewrite /<- plusr_inverse_l c at all/.
rewrite /-> plusr_assoc at all/.
compat >> auto.
qed ();



lemma "timesr_dist_plusr_l"
/
  forall x y z .
    (x + y) * z = x * z + y * z : real
/;

inference.
intro /x y z/.
rewrite /-> timesr_commute at 0 1 2/.
apply /timesr_dist_plusr_r/.
qed ();



lemma "timesr_ann_l"
/
  forall x . 0 * x = 0 : real
/;

inference.
intro /x/.
apply /plusr_cancel_l _ _ (0 * x)/.
rewrite /-> plusr_id_r/.
rewrite /<- timesr_dist_plusr_l/.
rewrite /-> plusr_id_r/.
reflexivity.
qed ();



lemma "timesr_ann_r"
/
  forall x . x * 0 = 0 : real
/;

inference.
intro /a/.
rewrite /-> timesr_commute/.
apply /timesr_ann_l/.
qed ();



lemma "negr_as_timesr"
/
  forall x . ~ x = -1 * x : real
/;

inference.
intro /x/.
transitivity /~ x + (x + -1 * x)/.
  {
  rewrite /<- timesr_id_l x at 2/.
  rewrite /<- timesr_dist_plusr_l/.
  rewrite /<- plusz_to_real/.
  reduce //.
  rewrite /-> timesr_ann_l/.
  rewrite /-> plusr_id_r/.
  reflexivity.
  }

  {
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_l/.
  reflexivity.
  }
qed ();



lemma "plusr_inverse_r"
/
  forall x . x + ~ x = 0 : real
/;

inference.
intro /x/.
rewrite /-> plusr_commute/.
apply /plusr_inverse_l/.
qed ();



lemma "negr_invol"
/
  forall x . ~ (~ x) = x : real
/;

inference.
intro /x/.
apply /plusr_cancel_l _ _ (~ x)/.
rewrite /-> plusr_inverse_r/.
rewrite /-> plusr_inverse_l/.
reflexivity.
qed ();



lemma "negr_minusr"
/
  forall x y .
    ~ (x - y) = y - x : real
/;

inference.
intro /x y/.
unfold /minusr at 0 0/.
rewrite /-> negr_plusr/.
rewrite /-> negr_invol/.
apply /plusr_commute/.
qed ();



lemma "negq_to_real"
/
  forall x . rational_to_real (~q x) = ~r (rational_to_real x) : real
/;

inference.
intro /x/.
rewrite /-> negq_as_timesq/.
rewrite /-> negr_as_timesr/.
rewrite /-> timesq_to_real/.
compat.
unfold /integer_to_real/.
reflexivity.
qed ();



lemma "negz_to_real"
/
  forall x . integer_to_real (~z x) = ~r (integer_to_real x) : real
/;

inference.
intro /x/.
unfold /integer_to_real at 0 0/.
rewrite /-> negz_to_rational/.
apply /negq_to_real/.
qed ();



lemma "integer_to_real_injective"
/
  forall x y .
    integer_to_real x = integer_to_real y : real
    -> x = y : integer
/;

inference.
intro /x y Heq/.
unfold /integer_to_real in Heq at 0 0/.
apply /integer_to_rational_injective/.
apply /rational_to_real_injective/ >> auto.
qed ();



lemma "integer_to_real_neq"
/
  forall x y .
    x != y : integer
    -> integer_to_real x != integer_to_real y : real
/;

inference.
intro /x y Hneq/.
contrapositive /Hneq/.
apply /integer_to_real_injective/ >> auto.
qed ();



lemma "ltr_stable"
/
  forall x y . Stable.stable (x < y)
/;

inference.
intro /x y/.
unfold /ltr/.
apply /positive_stable/.
qed ();



lemma "leqr_stable"
/
  forall x y . Stable.stable (x <= y)
/;

inference.
intro /x y/.
unfold /leqr/.
apply /Stable.stable_not/.
qed ();



lemma "ltr_sqstable"
/
  forall x y . Sqstable.sqstable (x < y)
/;

inference.
intro /x y/.
apply /Sqstable.stable_impl_sqstable/.
apply /ltr_stable/.
qed ();



lemma "leqr_sqstable"
/
  forall x y . Sqstable.sqstable (x <= y)
/;

inference.
intro /x y/.
apply /Sqstable.stable_impl_sqstable/.
apply /leqr_stable/.
qed ();



structure Nothing = AfterRealInequalitiesStable ();



lemma "real_dichotomy_neq"
/
  forall x y .
    x != y : real
    -> x < y % y < x
/;

inference.
intro /x y Hneq/.
so /positive_or_negative (minusr y x) __/ /Hpos | Hneg/.
  {
  unfold /minusr/.
  contrapositive /Hneq/.
  symmetry.
  rewrite /<- plusr_id_l x/.
  rewrite /<- plusr_id_r y/.
  rewrite /<- plusr_inverse_l x/.
  rewrite /<- plusr_assoc/.
  compat.
  unfold /integer_to_real/.
  auto.
  }

  {
  left.
  unfold /ltr/ >> auto.
  }

  {
  right.
  unfold /ltr/.
  rewrite /-> negr_minusr in Hneg/.
  hyp /Hneg/.
  }
qed ();



lemma "real_trichotomy_if_stable"
/
  forall i (P : U i) x y .
    Stable.stable P
    -> ((x < y % x = y : real % y < x) -> P)
    -> P
/;

inference.
intro /i P x y Hstable Hprop/.
apply /Stable.excluded_middle_if_stable _ _ (x = y : real)/ >> auto.
intro /(Heq | Hneq)/ >> auto.
so /real_dichotomy_neq _# 2 Hneq/ /Hxy | Hyx/ >> auto.
qed ();



lemma "real_total"
/
  Partial.total real
/;

unfold /real/.
RuleTactic.quotientTotal >> auto.
fold /real/.
typecheck.
qed ();



lemma "real_strict"
/
  Partial.strict real
/;

so /real_total/ /H/.
unfold /Partial.total in H/.
exact /H #1/.
qed ();



(* Plus and negation *)

lemma "negr_zero"
/
  ~ 0 = 0 : real
/;

rewrite /<- negz_to_real/.
reduce //.
reflexivity.
qed ();



lemma "negr_injective"
/
  forall x y .
    ~r x = ~r y : real
    -> x = y : real
/;

inference.
intro /x y Her/.
rewrite /<- negr_invol x/.
rewrite /<- negr_invol y/.
compat >> auto.
qed ();



lemma "negr_nonzero"
/
  forall x .
    x != r`0 : real
    -> ~r x != r`0 : real
/;

intro /x Hnzero/.
contrapositive /Hnzero/.
apply /negr_injective/.
rewrite /-> negr_zero/.
auto.
qed ();



lemma "minusr_assoc"
/
  forall a b c . (a -r b) -r c = a -r (b +r c) : real
/;

inference.
intro /a b c/.
unfold /minusr at all/.
rewrite /-> negr_plusr/.
apply /plusr_assoc/.
qed ();



lemma "plusr_minusr_assoc"
/
  forall a b c . (a +r b) -r c = a +r (b -r c) : real
/;

inference.
intro /a b c/.
unfold /minusr at all/.
apply /plusr_assoc/.
qed ();



lemma "minusr_plusr_assoc"
/
  forall a b c . (a -r b) +r c = a -r (b -r c) : real
/;

inference.
intro /a b c/.
unfold /minusr at all/.
rewrite /-> negr_plusr/.
rewrite /-> negr_invol/.
apply /plusr_assoc/.
qed ();



lemma "minusr_id_l"
/
  forall a . r`0 -r a = ~r a : real
/;

inference.
intro /a/.
unfold /minusr/.
apply /plusr_id_l/.
qed ();



lemma "minusr_id_r"
/
  forall a . a -r r`0 = a : real
/;

inference.
intro /a/.
unfold /minusr/.
rewrite /-> negr_zero/.
apply /plusr_id_r/.
qed ();



lemma "minusr_self"
/
  forall x . x -r x = r`0 : real
/;

inference.
intro /x/.
unfold /minusr/.
apply /plusr_inverse_r/.
qed ();



lemma "plusr_cancel_r"
/
  forall x y z .
    x +r z = y +r z : real
    -> x = y : real
/;

inference.
intro /x y z Her/.
apply /plusr_cancel_l _ _ z/.
rewrite /-> plusr_commute at 0 1/.
hyp /Her/.
qed ();



lemma "plusr_shift_lll"
/
  forall x y z .
    x = y +r z : real <-> ~r y +r x = z : real
/;

inference.
intro /x y z/.
split.
  {
  intro /Her/.
  apply /plusr_cancel_l _ _ y/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_r/.
  rewrite /-> plusr_id_l/.
  hyp /Her/.
  }

  {
  intro /Her/.
  apply /plusr_cancel_l _ _ (~r y)/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_l/.
  hyp /Her/.
  }
qed ();



lemma "plusr_shift_lrr"
/
  forall x y z .
    x = y +r z : real <-> x +r ~r z = y : real
/;

inference.
intro /x y z/.
rewrite /-> plusr_commute at 0 1/.
apply /plusr_shift_lll/.
qed ();



lemma "plusr_shift_llr"
/
  forall a b c .
    a = b +r c : real
    <->
    a +r ~r b = c : real
/;

inference.
intro /a b c/.
rewrite /-> plusr_commute at 1/.
apply /plusr_shift_lll/.
qed ();



lemma "plusr_shift_lrl"
/
  forall a b c .
    a = b +r c : real
    <->
    ~r c +r a = b : real
/;

inference.
intro /a b c/.
rewrite /-> plusr_commute at 0/.
apply /plusr_shift_lll/.
qed ();



lemma "plusr_shift_rrr"
/
  forall x y z .
    x +r y = z : real <-> x = z +r ~r y : real
/;

inference.
intro /x y z/.
symmetry.
rewrite /-> plusr_commute at 0 1/.
rewrite /<- negr_invol y at 1/.
apply /plusr_shift_lll/.
qed ();



lemma "plusr_shift_rll"
/
  forall x y z .
    x +r y = z : real <-> y = ~r x +r z : real
