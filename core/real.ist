lemma "timesr_shift_leqr_rrr"
/
  forall x y z .
    r`0 <r y
    -> x *r y <r= z <-> x <r= z *r invr y
/;

inference.
intro /x y z Hposy/.
assert /y != r`0 : real/ /Hner/.
  {
  symmetry.
  apply /ltr_impl_neq/ >> auto.
  }
split.
  {
  intro /Hler/.
  apply /timesr_cancel_leqr_l _ _ y/ >> auto.
  rewrite /-> timesr_commute at 0 1/.
  rewrite /-> timesr_assoc/.
  rewrite /-> timesr_inverse_l/ >> auto.
  rewrite /-> timesr_id_r/.
  hyp /Hler/.
  }

  {
  intro /Hler/.
  apply /timesr_cancel_leqr_r _ _ (invr y)/.
    {
    apply /invr_positive/ >> auto.
    }
  rewrite /-> timesr_assoc/.
  rewrite /-> timesr_inverse_r/ >> auto.
  rewrite /-> timesr_id_r/.
  hyp /Hler/.
  }
qed ();

  

