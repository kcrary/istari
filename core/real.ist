reduce //.
intro /j Hposj/.
remember /bound x/ /_/ /k1/ /Heqk1/.
remember /bound _/ /_/ /k2/ /Heqk2/.
remember /max k2 k1/ /_/ /k/ /Heqk/.
exists /j *n N/.
