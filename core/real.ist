split.
rewrite /-> prepositive_enduring in Hposx in Hposy/ >> auto.
destruct /Hposx/ /N HposN Hall/.
destruct /Hposy/ /N' HposN' Hall'/.
unfold /prepositive/.
exists /N +n N'/.
