apply /ltr_irrefl (integer_to_real x)/.
apply /leqr_ltr_trans/ >> auto.
qed ();



lemma "integer_to_real_mono_lt_conv"
/
  forall x y .
    integer_to_real x < integer_to_real y
    -> x <z y
/;

inference.
intro /x y Hleq/.
apply /not_leqz/.
intro /Hyx/.
