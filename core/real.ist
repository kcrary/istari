lemma "timesr_inverse_l"
/
  forall (x : nonzero_real) .
    timesr (invr x) x = integer_to_real z`1 : real
/;

intro /x'/.
so /real_impl_regular (timesr (invr x') x')/ /Hreg/.
destruct /x'/ /[x' Hnz]/.
unhide.
