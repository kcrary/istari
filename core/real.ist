(* Times and inverse *)

lemma "timesr_id_r"
/
  forall x . x * 1 = x : real
/;

inference.
intro /x/.
rewrite /-> timesr_commute/.
apply /timesr_id_l/.
qed ();



lemma "timesr_inverse_r"
/
  forall (x : nonzero_real) .
    x * invr x = 1 : real
/;

intro /x/.
rewrite /-> timesr_commute/.
apply /timesr_inverse_l/.
qed ();



lemma "real_integral_domain"
/
  forall x y .
    x *r y = r`0 : real
    -> not (not (x = r`0 : real % y = r`0 : real))
/;

inference.
intro /x y Heq/.
apply /Stable.excluded_middle_if_stable _ _ (x = r`0 : real)/.
  {
  apply /Stable.stable_not/.
  }
intro /(Heqx | Hneqx)/.
  {
  intro /H/.
  witness /H __/.
  left >> auto.
  }
intro /H/.
witness /H __/.
right.
clear /H/.
applyEq /fn z . invr x *r z/ /_/ /Heq/ /H/.
reduce /H/.
rewrite /<- timesr_assoc in H/.
rewrite /-> timesr_inverse_l in H/ >> auto.
rewrite /-> timesr_id_l in H/.
rewrite /-> timesr_ann_r in H/.
hyp /H/.
qed ();



lemma "timesr_neq_zero"
/
  forall x y .
     x != r`0 : real
     -> y != r`0 : real
     -> x *r y != r`0 : real
/;

inference.
intro /x y Hx Hy/.
intro /Heq/.
witness /real_integral_domain _ _ Heq __/.
intro /(Hx' | Hy')/.
  {
  so /Hx Hx'/ /0/.
  }

  {
  so /Hy Hy'/ /0/.
  }
qed ();



lemma "timesr_neq_zero_invert"
/
  forall x y .
    x * y != 0 : real
    -> x != 0 : real & y != 0 : real
/;

inference.
intro /x y Hnzero/.
split.
  {
  intro /?/.
  subst /x/.
  rewrite /-> timesr_ann_l in Hnzero/.
  exact /Hnzero ()/.
  }

  {
  intro /?/.
  subst /y/.
  rewrite /-> timesr_ann_r in Hnzero/.
  exact /Hnzero ()/.
  }
qed ();



lemma "invr_nonzero"
/
  forall (x : nonzero_real) .
    invr x != 0 : real
/;

intro /x/.
intro /Hz/.
so /timesr_inverse_l x/ /H/.
rewrite /-> Hz in H/.
rewrite /-> timesr_ann_l in H/.
revert /H/.
apply /integer_to_real_neq/.
omega.
qed ();



lemma "invr_invol"
/
  forall (x : nonzero_real) . invr (invr x) = x : real
/;

inference.
intro /x/.
assert /invr x != 0 : real/ /Hofinvr/.
  {
  autoWith /invr_nonzero/.
  }
rewrite /<- timesr_id_l (invr _)/.
rewrite /<- timesr_inverse_r x/.
rewrite /-> timesr_assoc/.
rewrite /-> timesr_inverse_r (invr x)/.
apply /timesr_id_r/.
qed ();



lemma "invr_timesr"
/
  forall (x y : nonzero_real) .
    invr (x *r y) = invr x *r invr y : real
/;

intro /x y/.
destruct /x/ /x Hx/.
destruct /y/ /y Hy/.
unhide.
so /timesr_neq_zero _ _ Hx Hy/ /Hnzero/.
rewrite /<- timesr_id_r (invr (x *r y))/.
rewrite /<- timesr_id_l (invr x *r invr y)/.
rewrite /<- timesr_inverse_l (x *r y) at 1/ >> auto.
rewrite /-> timesr_assoc/.
compat.
rewrite /-> timesr_commute at 2/.
rewrite /<- timesr_assoc/.
rewrite /-> timesr_assoc at 1/.
rewrite /-> timesr_inverse_r/.
rewrite /-> timesr_id_r/.
symmetry.
apply /timesr_inverse_r/.
qed ();



lemma "divr_assoc"
/
  forall a (b c : nonzero_real) .
    (a |r b) |r c = a |r (b *r c) : real
/;

inference.
intro /a b c/.
unfold /divr at all/.
rewrite /-> invr_timesr/.
apply /timesr_assoc/.
qed ();



lemma "timesr_divr_assoc"
/
  forall a (b c : nonzero_real) . (a *r b) |r c = a *r (b |r c) : real
/;

inference.
intro /a b c/.
unfold /divr at all/.
apply /timesr_assoc/.
qed ();



lemma "divr_timesr_assoc"
/
  forall a (b c : nonzero_real) . (a |r b) *r c = a |r (b |r c) : real
/;

inference.
intro /a b c/.
unfold /divr at all/.
so /invr_nonzero c/ /Hinvc/.
rewrite /-> invr_timesr/.
rewrite /-> invr_invol/.
apply /timesr_assoc/.
qed ();



lemma "invr_injective"
/
  forall (x y : nonzero_real) .
    invr x = invr y : real
    -> x = y : real
/;

inference.
intro /x y Heq/.
rewrite /<- invr_invol x/.
rewrite /<- invr_invol y/ >> autoWith /invr_nonzero/.
compat.
unfold /nonzero_real/.
extensionality >> autoWith /invr_nonzero/.
qed ();



lemma "invr_one"
/
  invr 1 = 1 : real
/;

assert /1 != 0 : real/ /Hnonzero/.
  {
  intro /H/.
  so /integer_to_real_injective _ _ H/ /H'/.
  omega.
  }
rewrite /1 = invr 1 * 1 : real at 1/ >> auto.
  {
  symmetry.
  apply /timesr_inverse_l/.
  }

  {
  rewrite /-> timesr_id_r/.
  reflexivity.
  }
qed ();



lemma "divr_id_l"
/
  forall (a : nonzero_real) . r`1 |r a = invr a : real
/;

inference.
intro /a/.
unfold /divr/.
apply /timesr_id_l/.
qed ();



lemma "divr_id_r"
/
  forall a . a |r r`1 = a : real
