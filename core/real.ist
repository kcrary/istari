  apply /negq_ltq'/.
  rewrite /-> negq_zero/.
  apply /ltq_leqq_trans/ >> auto.
  autoQ.
  }

  {
  rewrite /-> absq_of_nonneg in Hdist/ >> auto.
  apply /neq_symm/.
  apply /ltq_impl_neq/.
  apply /ltq_leqq_trans _ (invq _)/ >> auto.
  autoQ.
  }
qed ();



