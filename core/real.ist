  {
  rewrite /<- absr_of_nonneg (absr x - absr y)/.
    {
    rewrite /<- minusr_shift_leqr_rr/.
    rewrite /-> plusr_id_l/.
    hyp /Hleq/.
    }
  apply /absr_minusr_absr/.
  }
qed ();



