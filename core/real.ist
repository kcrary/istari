lemma "rational_to_real_injective"
/
  forall x y .
    rational_to_real x = rational_to_real y : real
    -> x = y : rational
/;

inference.
assert /forall x y . rational_to_real x = rational_to_real y : real -> x <q= y/ /H/ >>> [inference, idtac].
1:{
  intro /x y Heq/.
  apply /leqq_antisymm/ >> auto.
  }
intro /x y Heq/.
unfold /rational_to_real in Heq at 0 0/.
unfold /real in Heq/.
injection /Heq/.
reintro /H/.
unhide.
clear /Heq/.
destruct /H/ /_ _ Hequiv/.
apply /not_ltq/.
intro /Hyx/.
so /Hequiv (succ (integer_to_nat (ceiling (invq (invq 3 * (x - y)))))) __/ /Hdist/.
  {
  omega.
  }
reduce /Hdist/.
assert /0 < x - y/ /Hyx'/.
  {
  rewrite /<- minusq_shift_ltq_rr/.
  rewrite /-> plusq_id_l/ >> auto.
  }
assert /0 < invq 3 * (x - y)/ /Hyx3/.
  {
  apply /timesq_ltq_zero/ >> autoQ.
  }
rewrite /<- jaunt_into_nat in Hdist/ >> autoQ >> auto.
  {
  apply /samesign_pos/ >> autoQ >> auto.
  }
rewrite /-> invq_invol in Hdist/.
rewrite /-> absq_of_nonneg in Hdist/ >> autoQ.
  {
  apply /ltq_impl_leqq/ >> auto.
  }
apply /ltq_irrefl (x - y)/.
apply /leqq_ltq_trans/ >> auto.
rewrite /<- timesq_assoc/.
rewrite /<- timesq_id_l (x - y) at 1/.
apply /timesq_ltq_r/ >> auto.
rewrite /<- timesq_shift_ltq_lrr/ >> autoQ.
rewrite /<- timesz_to_rational/.
autoQ.
qed ();



lemma "plusq_to_real"
/
  forall x y . rational_to_real (x + y) = plusr (rational_to_real x) (rational_to_real y) : real
/;

inference.
intro /x y/.
apply /real_equality/.
so /real_impl_regular (rational_to_real (x + y))/ /Hreg/.
so /real_impl_regular (plusr (rational_to_real x) (rational_to_real y))/ /Hreg'/.
unfold /rational_to_real in Hreg at all in Hreg' at all in concl at all/.
unfold /plusr in Hreg' in concl/.
destruct /Hreg/ /[Hreg]/.
destruct /Hreg'/ /[Hreg']/.
split.
intro /n Hn/.
reduce //.
rewrite /-> minusq_self/.
rewrite /-> absq_of_nonneg/ >> autoQ.
qed ();



lemma "timesq_to_real"
/
  forall x y . rational_to_real (x * y) = timesr (rational_to_real x) (rational_to_real y) : real
/;

inference.
intro /x y/.
apply /real_equality/.
so /real_impl_regular (rational_to_real (x * y))/ /Hreg/.
so /real_impl_regular (timesr (rational_to_real x) (rational_to_real y))/ /Hreg'/.
unfold /rational_to_real in Hreg at all in Hreg' at all in concl at all/.
unfold /timesr in Hreg' in concl/.
destruct /Hreg/ /[Hreg]/.
destruct /Hreg'/ /[Hreg']/.
split.
intro /n Hn/.
reduce //.
rewrite /-> minusq_self/.
rewrite /-> absq_of_nonneg/ >> autoQ.
qed ();



define /prepositive x/
/
  exists n . n`0 <n n &d invq (nat_to_rational n) < x n
//
  (nat -> rational) -> U 0
/;

unfold /prepositive/.
typecheck.
qed ();



lemma "prepositive_stable"
/
  forall x . Stable.stable (prepositive x)
/;

inference.
intro /x Hnnpositive/.
unfold /prepositive/.
apply /Markov.markov_search/.
  {
  intro /i/.
  reduce //.
  apply /Decidable.decidable_dprod/.
    {
    apply /lt_decide/.
    }

    {
    intro /Hposi/.
    apply /ltq_decide/.
    }
  }
contrapositive /Hnnpositive/.
unfold /prepositive/.
intro /(n Hposn Hlt)/.
witness /Hnnpositive n __/.
reduce //.
split >> auto.
qed ();



lemma "prepositive_sqstable"
/
  forall x . Sqstable.sqstable (prepositive x)
/;

inference.
intro /x/.
apply /Sqstable.stable_impl_sqstable/.
apply /prepositive_stable/.
qed ();



lemma "prepositive_enduring"
/
  forall x .
    regular x
    -> prepositive x
       <->
       (exists n . n`0 <n n &d (forall m . n <n= m -> invq (nat_to_rational n) <= x m))
/;

inference.
intro /x Hregx/.
split.
  {
  intro /(n Hposn Hlt)/.
  assert /q`0 < x n -q invq (nat_to_rational n)/ /Hlt'/.
    {
    unfold /minusq/.
    rewrite /<- plusq_shift_ltq_rrr/.
    rewrite /-> plusq_id_l/.
    hyp /Hlt/.
    }
  setEq /N/ /succ (integer_to_nat (ceiling (2 * invq (x n - invq (nat_to_rational n)))))/ /_/ /HeqN/.
  assert /2 * invq (nat_to_rational N) <= x n - invq (nat_to_rational n)/ /HN/.
    {
    subst /N/.
    rewrite /<- jaunt_into_nat (timesq _ _)/.
    1:{
      apply /integer_to_rational_mono/ >> omega.
      }

    1:{
      apply /ltq_impl_leqq/.
      apply /invq_positive/.
      apply /integer_nat_to_rational_mono_lt/.
      omega.
      }

    1:{
      apply /samesign_pos/.
        {
        apply /timesq_ltq_zero/.
          {
          apply /integer_to_rational_mono_lt/ >> omega.
          }
          
          {
          apply /invq_positive/ >> auto.
          }
        }

        {
        apply /integer_nat_to_rational_mono_lt/.
        omega.
        }
      }

    1:{
      apply /ltq_impl_leqq/.
      apply /timesq_ltq_zero/.
        {
        apply /integer_to_rational_mono_lt/.
        omega.
        }

        {
        apply /invq_positive/ >> auto.
        }
      }
    rewrite /-> invq_timesq/.
    rewrite /-> invq_invol/.
    rewrite /<- timesq_assoc/.
    rewrite /-> timesq_inverse_r/.
      {
      apply /integer_to_rational_neq/ >> omega.
      }
    rewrite /-> timesq_id_l/.
    reflexivity.
    }
  exists /N/.
  split.
    {
    subst /N/.
    apply /lt_0_succ/.
    }

    {
    intro /m Hm/.
    assert /n`0 <n m/ /Hposm/.
      {
      omega.
      }
    apply /leqq_trans _ (x n - absq (x m - x n))/.
    1:{
      so /absq_minusq_upper_bound (x n) (x m) (absq (x n - x m)) ()/ /H/ >> auto.
      unfold /minusq/.
      rewrite /<- plusq_shift_leqq_lrr/.
      rewrite /-> absq_minusq_commute/.
      hyp /H/.
      }
    unfold /minusq/.
    rewrite /-> Hregx m n Hposm Hposn/.
    rewrite /-> negq_dist_plusq/.
    rewrite /<- plusq_assoc/.
    rewrite /<- Hm/.
    1:{
      apply /samesign_pos/.
        {
        apply /integer_nat_to_rational_mono_lt/ >> omega.
        }

        {
        apply /integer_nat_to_rational_mono_lt/ >> omega.
        }
      }
    rewrite /-> plusq_commute3/.
    fold /minusq _ _ at 1/.
    rewrite /<- HN/.
    rewrite /-> negq_as_timesq/.
    rewrite /<- timesq_dist_plusq_l/.
    rewrite /<- plusz_to_rational/.
    reduce //.
    rewrite /-> timesq_id_l/.
    reflexivity.
    }
  }

  {
  intro /(n Hposn Hn)/.
  unfold /prepositive/.
  exists /succ n/.
  split.
    {
    apply /lt_0_succ/.
    }
  rewrite /<- Hn/.
  1:{
    apply /lt_impl_leq/.
    apply /lt_succ/ >> auto.
    }
  apply /invq_ltq_pos/.
    {
    apply /integer_nat_to_rational_mono_lt/ >> omega.
    }
  apply /nat_to_rational_mono_lt/.
  omega.
  }
qed ();



lemma "prepositive_resp_realequiv"
/
  forall x y .
    regular x
    -> regular y
    -> realequiv x y
    -> prepositive x
    -> prepositive y
/;

inference.
intro /x y Hx Hy Hxy Hpositivex/.
rewrite /-> prepositive_enduring in Hpositivex in concl/ >> auto.
destruct /Hpositivex/ /n Hposn Hn/.
exists /n *n n`4/.
split.
  {
  omega.
  }
intro /m Hm/.
assert /n`0 <n m/ /Hposm/.
  {
  omega.
  }
so /Hxy m Hposm/ /Hdist/.
rewrite /-> absq_minusq_commute in Hdist/.
so /absq_minusq_lower_bound _# 3 Hdist/ /H/.
rewrite /<- H/ >> clear /H/.
unfold /minusq/.
rewrite /<- Hn m/ >>> [idtac, omega].
rewrite /<- Hm/.
1:{
  apply /integer_to_rational_mono/ >> omega.
  }

1:{
  apply /ltq_impl_leqq/.
  apply /invq_positive/.
  apply /integer_nat_to_rational_mono_lt/ >> omega.
  }

1:{
  apply /samesign_pos/.
    {
    apply /integer_nat_to_rational_mono_lt/.
    omega.
    }

    {
    apply /integer_nat_to_rational_mono_lt/.
    omega.
    }
  }
rewrite /-> timesq_commute/.
rewrite /<- times_assoc n n`2 n`2 at 1/.
rewrite /-> times_to_rational at 1/.
rewrite /-> invq_timesq/.
rewrite /-> timesq_assoc/.
unfold /nat_to_rational at 3/.
reduce //.
rewrite /-> timesq_inverse_l/.
  {
  apply /integer_to_rational_neq/ >> omega.
  }
rewrite /-> timesq_id_r/.
rewrite /<- timesq_id_l (invq _) at 1/.
rewrite /<- timesq_inverse_r 2/.
  {
  apply /integer_to_rational_neq/ >> omega.
  }
rewrite /-> timesq_assoc/.
rewrite /<- invq_timesq/.
rewrite /-> timesq_commute at 1/.
unfold /nat_to_rational at 1/.
rewrite /<- timesz_to_rational/.
rewrite /<- times_to_integer n n`2/.
fold /nat_to_rational _/.
rewrite /-> negq_as_timesq/.
rewrite /<- timesq_dist_plusq_l/.
rewrite /<- plusz_to_rational/.
reduce //.
rewrite /-> timesq_id_l/.
apply /invq_leqq_pos/.
  {
  apply /integer_nat_to_rational_mono_lt/.
  omega.
  }

  {
  apply /nat_to_rational_mono/.
  omega.
  }
qed ();



define /positive x/
/
  { prepositive x }
//
  real -> U 0
/;

unfold /positive/.
introOf /x/.
reduce //.
unfold /real in x/.
destruct /x/ /[x y (Hx Hy Hxy)]/.
typecheck.
split >> apply /prepositive_resp_realequiv/ >> autoWith /realequiv_symm/.
qed ();



lemma "positive_inhabitant"
/
  forall x .
    positive x
    -> () : positive x
/;

inference.
intro /x Hpos/.
destruct /x/ /[x y Hxy]/.
  {
  destruct /Hxy/ /Hx Hy Hxy/.
  unfold /positive at 0 0/.
  typecheck.
  split >> apply /prepositive_resp_realequiv/ >> autoWith /realequiv_symm/.
  }
unfold /positive/.
typecheck.
unfold /positive in Hpos/.
hyp /Hpos/.
qed ();



val positive = parseConstant /positive/;
val positive_inhabitant = parseConstant /positive_inhabitant/;

ConstantTable.insert 
  TypecheckTables.trivialIntroTactics
  positive
  (Backchain.witnessPriority /\Term.Const positive_inhabitant\ _ __/);



lemma "positive_ext"
/
  forall x (h h' : positive x) .
    h = h' : positive x
/;

inference.
intro /x' h h'/.
so /real_representative x'/ /[(x Hregx ?)]/.
subst /x'/.
unfold /positive in h in h' in concl/.
unfold /rintro in h in h' in concl/.
extensionality.
qed ();



lemma "positive_stable"
/
  forall x . Stable.stable (positive x)
/;

inference.
intro /x/.
intro /Hnnpos/.
so /real_representative x/ /[Hrep]/.
unhide.
destruct /Hrep/ /x' Hregx ?/.
subst /x/.
unfold /positive in Hnnpos in concl/.
unfold /rintro in Hnnpos in concl/.
split.
apply /prepositive_stable/.
contrapositive /Hnnpos/.
contrapositive /Hnnpos/.
destruct /Hnnpos/ /H/.
exact /prepositive_sqstable x' H/.
qed ();



lemma "positive_sqstable"
/
  forall x . Sqstable.sqstable (positive x)
/;

inference.
intro /x/.
apply /Sqstable.stable_impl_sqstable/.
apply /positive_stable/.
qed ();



ConstantTable.insert SqstableTactic.sqstableLemmas (parseConstant /positive/) (parseConstant /positive_sqstable/);



(* Note: using prereals here.  This result does not actually hold as
   stated for reals.  If both x and y are positive, distinct but
   equivalent representatives of x and y could result in returning
   different sides of the sum.
*)

lemma "plusr_positive_invert_prereal"
/
  forall (x y : prereal) .
    positive (plusr (realintro x) (realintro y))
    -> positive (realintro x) % positive (realintro y)
/;

inference.
intro /x y Hpos/.
so /real_impl_regular (plusr (realintro x) (realintro y))/ /Hregplus/.
destruct /x/ /x Hx/.
destruct /y/ /y Hy/.
so /regular_sqstable x __/ /Hregx/ >> auto.
so /regular_sqstable y __/ /Hregy/ >> auto.
clear /Hx Hy/.
unfold /realintro in Hpos at all in Hregplus at all in concl at all/.
unfold /rintro in Hpos at all in concl at all in Hregplus at all/.
unfold /plusr in Hpos in Hregplus/.
unfold /positive in Hpos in concl at 0 0/.
so /regular_sqstable _ Hregplus/ /H/.
renameOver /H/ /Hregplus/.
so /prepositive_sqstable _ Hpos/ /H/.
renameOver /H/ /Hpos/.
rewrite /-> prepositive_enduring in Hpos/ >> auto.
destruct /Hpos/ /n Hposn Hall/.
rewrite /-> times_commute within _ in Hall at 0 1/.
so /rational_dichotomy (x (n *n n`4)) (invq (nat_to_rational (n *n n`4)))/ /Hleqx | Hlt/.
1:{
  left.
  split.
  unfold /prepositive/.
  exists /n *n n`4/.
  split >> auto.
  omega.
  }
so /rational_dichotomy (y (n *n n`4)) (invq (nat_to_rational (n *n n`4)))/ /Hleqy | Hlt/.
1:{
  right.
  split.
  unfold /prepositive/.
  exists /n *n n`4/.
  split >> auto.
  omega.
  }
exfalso.
so /Hall (n *n n`2) __/ /Hleqxy/.
  {
  omega.
  }
reduce /Hleqxy Hleqx Hleqy/.
rewrite /-> times_assoc in Hleqxy at 0 0/.
reduce /Hleqxy/.
so /plusq_leqq _# 4 Hleqx Hleqy/ /Hleqxy'/.
so /leqq_trans _ _ _ Hleqxy Hleqxy'/ /H/.
rewrite /-> plusq_self in H/.
so /invq_leqq_pos _# 2 __ H/ /H1/ >> autoQ.
rewrite /-> invq_invol in H1/.
rewrite /<- invq_invol 2 in H1/.
rewrite /<- invq_timesq in H1/.
rewrite /-> invq_invol in H1/.
rewrite /-> times_to_rational in H1/.
rewrite /-> timesq_commute in H1/.
rewrite /-> timesq_assoc in H1/.
rewrite /<- timesq_id_r (nat_to_rational _) in H1 at 2/.
so /timesq_cancel_leqq_l _# 3 __ H1/ /H2/ >> autoQ.
rewrite /<- timesq_shift_leqq_lrr in H2/ >> autoQ.
unfold /nat_to_rational in H2/.
reduce /H2/.
rewrite /-> timesq_id_l in H2/.
so /integer_to_rational_mono_conv _ _ H2/ /H3/.
omega.
qed ();



(* This name is re-used later. *)
lemma "plusr_positive_invert"
/
  forall x y .
    positive (plusr x y)
    -> squish (positive x % positive y)
/;

inference.
intro /x y Hpos/.
so /real_to_prereal x/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(x' ?)/.
so /real_to_prereal y/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(y' ?)/.
subst /x y/.
apply /squish_ret/.
apply /plusr_positive_invert_prereal/ >> auto.
qed ();




lemma "plusr_positive_invert_squash"
/
  forall x y .
    positive (plusr x y)
    -> { positive x % positive y }
/;

inference.
intro /x y Hpos/.
apply /squish_impl_squash/.
apply /plusr_positive_invert/ >> auto.
qed ();



lemma "prepositive_or_negative"
/
  forall x .
    not (realequiv x (fn _ . 0))
    -> prepositive x % prepositive (fn i . negq (x i))
/;

inference.
intro /x Hnnz/.
unfold /prepositive at 0 0/.
assert /exists n . n`0 <n n &d (invq (nat_to_rational n) < x n % invq (nat_to_rational n) < negq (x n))/ /H/ >> inference.
1:{
  destruct /H/ /n Hposn (H | H)/.
    {
    left >> existsAuto.
    }

    {
    right >> existsAuto.
    }
  }
apply /Markov.markov_search/ >> reduce //.
  {
  intro /i/.
  apply /Decidable.decidable_dprod/.
    {
    apply /lt_decide/.
    }

    {
    intro /Hposi/.
    apply /Decidable.decidable_or/ >> apply /ltq_decide/.
    }
  }

  {
  contrapositive /Hnnz/.
  unfold /realequiv/.
  intro /n Hposn/.
  apply /not_ltq/.
  intro /Hlt/.
  so /Hnnz n/ /H/.
  witness /H __/ >> clear /H/.
  split >> auto.
  reduce /Hlt/.
  unfold /minusq in Hlt/.
  rewrite /-> negq_zero in Hlt/.
  rewrite /-> plusq_id_r in Hlt/.
  so /rational_dichotomy_weak q`0 (x n)/ /Hpos | Hneg/.
    {
    rewrite /-> absq_of_nonneg in Hlt/ >> auto.
    left.
    apply /ltq_trans _ (2 * invq (nat_to_rational n))/ >> auto.
    rewrite /<- timesq_id_l (invq _)/.
    apply /timesq_ltq_r/.
      {
      apply /invq_positive/.
      apply /integer_nat_to_rational_mono_lt/.
        {
        omega.
        }
      }

      {
      apply /integer_to_rational_mono_lt/.
      omega.
      }
    }
    
    {
    rewrite /-> absq_of_nonpos in Hlt/ >> auto.
    right.
    apply /ltq_trans _ (2 * invq (nat_to_rational n))/ >> auto.
    rewrite /<- timesq_id_l (invq _)/.
    apply /timesq_ltq_r/.
      {
      apply /invq_positive/.
      apply /integer_nat_to_rational_mono_lt/.
        {
        omega.
        }
      }

      {
      apply /integer_to_rational_mono_lt/.
      omega.
      }
    }
  }
qed ();



lemma "positive_or_negative"
/
  forall x .
    x != rational_to_real q`0 : real
    -> positive x % positive (negr x)
/;

inference.
intro /x Hnonzero/.
exactRaw /(case prepositive_or_negative x (fn _ . ()) of | inl _ . inl () | inr _ . inr ())/.
destruct /x/ /[x y Hxy]/.
  {
  destruct /Hxy/ /Hx Hy Hxy/.
  typecheck.
    {
    fold /rintro x Hx/.
    fold /rintro y Hy/.
    apply /real_equality/.
    split.
    unfold /rintro at all/.
    auto.
    }

    {
    fold /rintro x Hx/.
    fold /rintro y Hy/.
    compat.
    apply /real_equality/.
    split.
    unfold /rintro at all/.
    auto.
    }
  }

  {
  destruct /Hxy/ /Hx Hy Hxy/.
  assert /not (realequiv x (fn _ . q`0))/ /Hnequiv/.
    {
    contrapositive /Hnonzero/.
    fold /rintro x Hx/.
    apply /real_equality/.
    split.
    unfold /rintro/.
    unfold /rational_to_real/.
    hyp /Hnonzero/.
    }
  generalize /prepositive_or_negative x (fn _ . ())/ /_/ /X/.
    {
    reintro /H/.
    exact /Hnequiv H/.
    }
  generalize /prepositive_or_negative y (fn _ . ())/ /_/ /Y/.
    {
    reintro /H/.
    witness /Hnequiv __/.
    apply /realequiv_trans _ y/ >> autoWith /constant_regular/.
    }
  assert /forall x y .
            regular x
            -> regular y
            -> realequiv x y
            -> prepositive x
            -> prepositive (fn i . ~q (y i))
            -> void/ /Hcontra/.
    {
    inference.
    clear /x y Hx Hy Hxy Hnonzero Hnequiv X Y/.
    intro /x y Hx Hy Hxy Hposx Hnegy/.
    rewrite /-> prepositive_enduring in Hposx in Hnegy/ >> autoWith /negr_regular/.
    destruct /Hposx/ /nx Hposnx Hnx/.
    destruct /Hnegy/ /ny Hposny Hny/.
    setEq /N/ /succ (max nx ny)/ /_/ /HeqN/.
    so /Hnx N __/ /Hltx/ >>> [omega, idtac].
    so /Hny N __/ /Hlty/ >>> [omega, idtac].
    so /Hxy N __/ /Hdist/ >>> [omega, idtac].
    so /absq_minusq_upper_bound _# 3 Hdist/ /Hbound/.
    clear /Hdist/.
    reduce /Hny Hlty/.
    rewrite /<- not_ltq in Hbound/.
    witness /Hbound __/ >> clear /Hbound/.
    apply /ltq_leqq_trans/ >> auto.
    so /negq_leqq _# 2 Hlty/ /Hlty'/.
    rewrite /-> negq_invol in Hlty'/.
    rewrite /-> Hlty'/.
    rewrite /<- plusq_shift_ltq_lll/.
    rewrite /2 = q`1 + q`1 : rational/.
      {
      rewrite /<- plusz_to_rational/.
      reflexivity.
      }
    rewrite /-> timesq_dist_plusq_l/.
    rewrite /-> timesq_id_l at 0 0/.
    apply /plusq_ltq/.
      {
      apply /invq_ltq_pos/.
        {
        apply /integer_nat_to_rational_mono_lt/.
        omega.
        }

        {
        apply /nat_to_rational_mono_lt/.
        omega.
        }
      }

      {
      apply /invq_ltq_pos/.
        {
        apply /integer_nat_to_rational_mono_lt/.
        omega.
        }

        {
        apply /nat_to_rational_mono_lt/.
        omega.
        }
      }
    }
  destruct /X/ /Hposx | Hnegx/ >> destruct /Y/ /Hposy | Hnegy/ >> reduce //.
    {
    fold /rintro x Hx at 0 1/.
    typecheck.
    unfold /positive, rintro/.
    split >> auto.
    }

    {
    exfalso.
    apply /Hcontra x y/ >> auto.
    }

    {
    exfalso.
    apply /Hcontra y x/ >> auto.
    apply /realequiv_symm/ >> auto.
    }

    {
    fold /rintro x Hx at 0 1/.
    typecheck.
    unfold /positive, rintro/.
    unfold /negr/.
    split >> auto.
    }
  }
qed ();



lemma "nonzero_transition"
/
  forall (x : { x : nat -> rational | regular x & not (realequiv x (fn _ . 0)) }) .
    exists N . 
      n`0 <n N 
      & (forall m . N <n= m -> invq (nat_to_rational N) <= absq (x m))
/;

inference.
intro /[x H]/.
assert /regular x/ /Hx/.
  {
  witness /regular_sqstable x __/.
  split.
  exact /H #1/.
  }
assert /not (realequiv x (fn _ . 0))/ /Hnz/.
  {
  unhide.
  exact /H #2/.
  }
clear /H/.
so /prepositive_or_negative _ Hnz/ /Hpos | Hneg/.
  {
  rewrite /-> prepositive_enduring in Hpos/ >> auto.
  destruct /Hpos/ /N HposN Hall/.
  exists /N/.
  split >> auto.
  intro /m Hm/.
  rewrite /<- absq_ub/ >> auto.
  }

  {
  rewrite /-> prepositive_enduring in Hneg/ >> autoWith /negr_regular/.
  destruct /Hneg/ /N HposN Hall/.
  exists /N/.
  split >> auto.
  intro /m Hm/.
  rewrite /<- absq_negq (x m)/.
  rewrite /<- absq_ub/ >> auto.
  }
qed ();
      


define /nonzero_real/
/
  { x : real | x != integer_to_real z`0 : real }
