lemma "negr_plusr"
/
  forall x y .
    negr (plusr x y) = plusr (negr x) (negr y) : real
/;

inference.
intro /x y/.
rewrite /<- plusr_id_l (negr _)/.
rewrite /-> plusr_commute/.
rewrite /<- plusr_id_l (integer_to_real z`0)/.
rewrite /<- plusr_inverse_l x/.
rewrite /<- plusr_inverse_l y/.
rewrite /-> plusr_commute at 3 4/.
rewrite /-> plusr_assoc _ (negr x)/.
rewrite /<- plusr_assoc _ y/.
rewrite /-> plusr_commute (negr x) y/.
rewrite /-> plusr_assoc _ (negr x)/.
rewrite /<- plusr_assoc _ y/.
rewrite /<- plusr_assoc/.
rewrite /-> plusr_inverse_l/.
rewrite /-> plusr_id_l/.
reflexivity.
qed ();



lemma "rational_to_real_mono"
/
