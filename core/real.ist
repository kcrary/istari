lemma "absr_minusr_maxr"
/
  forall a b c d .
    absr (maxr a b - maxr c d) <= maxr (absr (a - c)) (absr (b - d))
/;

inference.
intro /a b c d/.
apply /real_dichotomy_weak_if_stable _ _ a b/.
  {
  apply /leqr_stable/.
  }
intro /Hab/.
apply /real_dichotomy_weak_if_stable _ _ c d/.
  {
  apply /leqr_stable/.
  }
intro /Hcd/.
destruct /Hab/ /Hab | Hba/ >> destruct /Hcd/ /Hcd | Hdc/.
  {
  rewrite /-> maxr_eq_r/ >> auto.
  rewrite /-> maxr_eq_r/ >> auto.
  apply /maxr_leq_r/.
  }

  {
  rewrite /-> maxr_eq_r/ >> auto.
  rewrite /-> maxr_eq_l/ >> auto.
  apply /real_dichotomy_weak_if_stable _ _ b c/.
    {
    apply /leqr_stable/.
    }
  intro /(Hbc | Hcb)/.
    {
    apply /leqr_trans _ (absr (a - c))/.
    1:{
      apply /maxr_leq_l/.
      }
    rewrite /-> absr_minusr_commute at 0 1/.
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/ >> auto.
      }
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/.
      apply /leqr_trans/ >> auto.
      }
    apply /minusr_leqr/ >> autoWith /leqr_refl/.
    }

    {
    apply /leqr_trans _ (absr (b - d))/.
    1:{
      apply /maxr_leq_r/.
      }
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/ >> auto.
      }
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/.
      apply /leqr_trans/ >> auto.
      }
    apply /minusr_leqr/ >> autoWith /leqr_refl/.
    }
  }

  {
  rewrite /-> maxr_eq_l/ >> auto.
  rewrite /-> maxr_eq_r/ >> auto.
  apply /real_dichotomy_weak_if_stable _ _ a d/.
    {
    apply /leqr_stable/.
    }
  intro /(Had | Hda)/.
    {
    apply /leqr_trans _ (absr (b - d))/.
    1:{
      apply /maxr_leq_r/.
      }
    rewrite /-> absr_minusr_commute at 0 1/.
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/ >> auto.
      }
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/.
      apply /leqr_trans/ >> auto.
      }
    apply /minusr_leqr/ >> autoWith /leqr_refl/.
    }

    {
    apply /leqr_trans _ (absr (a - c))/.
    1:{
      apply /maxr_leq_l/.
      }
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/ >> auto.
      }
    rewrite /-> absr_of_nonneg/.
      {
      rewrite /<- minusr_shift_leqr_rr/.
      rewrite /-> plusr_id_l/.
      apply /leqr_trans/ >> auto.
      }
    apply /minusr_leqr/ >> autoWith /leqr_refl/.
    }
  }

  {
  rewrite /-> maxr_eq_l/ >> auto.
  rewrite /-> maxr_eq_l/ >> auto.
  apply /maxr_leq_l/.
  }
qed ();



lemma "maxq_to_real"
/
  forall a b . rational_to_real (maxq a b) = maxr (rational_to_real a) (rational_to_real b) : real
/;

inference.
assert /forall m n . n <q= m -> rational_to_real (maxq m n) = maxr (rational_to_real m) (rational_to_real n) : real/ /H/.
  {
  inference.
  intro /m n Hmn/.
  rewrite /-> maxq_eq_l/ >> auto.
  rewrite /-> maxr_eq_l/ >> auto.
  apply /rational_to_real_mono/ >> auto.
  }
intro /m n/.
so /rational_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
rewrite /-> maxq_commute/.
rewrite /-> maxr_commute/.
apply /H/ >> auto.
qed ();



lemma "minq_to_real"
/
  forall a b . rational_to_real (minq a b) = minr (rational_to_real a) (rational_to_real b) : real
/;

inference.
intro /a b/.
unfold /minr/.
rewrite /-> minq_as_maxq/.
rewrite /-> negq_to_real/.
rewrite /-> maxq_to_real/.
rewrite /-> negq_to_real at 0 0/.
reflexivity.
qed ();



lemma "maxz_to_real"
/
  forall a b . integer_to_real (maxz a b) = maxr (integer_to_real a) (integer_to_real b) : real
/;

inference.
intro /a b/.
unfold /integer_to_real at all/.
rewrite /-> maxz_to_rational/.
rewrite /-> maxq_to_real/.
reflexivity.
qed ();



lemma "minz_to_real"
/
  forall a b . integer_to_real (minz a b) = minr (integer_to_real a) (integer_to_real b) : real
/;

inference.
intro /a b/.
unfold /integer_to_real at all/.
rewrite /-> minz_to_rational/.
rewrite /-> minq_to_real/.
reflexivity.
qed ();



(* Prereals *)

define /integer_to_prereal x/
/
  rational_to_prereal (integer_to_rational x)
//
  integer -> prereal
/;

unfold /integer_to_prereal/.
typecheck.
qed ();



lemma "integer_to_prereal_to_real"
/
  forall x .
    realintro (integer_to_prereal x) = integer_to_real x : real
/;

inference.
intro /x/.
unfold /integer_to_prereal, rational_to_prereal, realintro, integer_to_real/.
reflexivity.
qed ();



lemma "plusz_to_prereal"
/
  forall x y .
    integer_to_prereal (plusz x y) = preplusr (integer_to_prereal x) (integer_to_prereal y) : prereal
/;

inference.
intro /x y/.
unfold /integer_to_prereal at all/.
rewrite /-> plusz_to_rational/.
rewrite /-> plusq_to_prereal/.
reflexivity.
qed ();



lemma "negz_to_prereal"
/
  forall x .
    integer_to_prereal (negz x) = prenegr (integer_to_prereal x) : prereal
/;

inference.
intro /x/.
unfold /integer_to_prereal at all/.
rewrite /-> negz_to_rational/.
rewrite /-> negq_to_prereal/.
reflexivity.
qed ();



lemma "timesz_to_prereal"
/
  forall x y .
    integer_to_prereal (timesz x y) = pretimesr (integer_to_prereal x) (integer_to_prereal y) : prereal
/;

inference.
intro /x y/.
unfold /integer_to_prereal at all/.
rewrite /-> timesz_to_rational/.
rewrite /-> timesq_to_prereal/.
reflexivity.
qed ();



(* Miscellaneous *)

lemma "rational_dense_within_real_prereal"
/
  forall x y .
    ltr (realintro x) (realintro y)
    -> exists (z : rational) .
         ltr (realintro x) (rational_to_real z) & ltr (rational_to_real z) (realintro y)
/;

inference.
intro /x y Hxy/.
destruct /x/ /x Hx/.
destruct /y/ /y Hy/.
so /regular_sqstable x __/ /Hregx/ >> auto.
so /regular_sqstable y __/ /Hregy/ >> auto.
clear /Hx Hy/.
unfold /realintro in Hxy at all in concl at all/.
moveBefore /Hxy/ /concl/.
fold /rintro x Hregx in Hxy in concl/.
fold /rintro y Hregy in Hxy in concl/.
unfold /ltr in Hxy, positive in Hxy/.
unfold /rintro in Hxy at all, minusr in Hxy, negr in Hxy, plusr in Hxy/.
so /prepositive_sqstable _ Hxy/ /(n Hposn Hlt)/.
clear /Hxy/.
rewrite /-> times_commute within _ in Hlt at 0 1/.
reduce /Hlt/.
revert /Hlt/.
remember /n *n n`2/ /_/ /N/ /HeqN/.
setEq /z/ /invq q`2 *q (x N +q y N)/ /_/ /Heqz/.
intro /Hlt/.
exists /z/.
split.
  {
  rewrite /<- plusr_id_l (rintro _ _)/.
  rewrite /-> minusr_shift_ltr_rr/.
  apply /ltr_leqr_trans _ (rational_to_real z - rational_to_real (x N) - absr (rintro x Hregx - rational_to_real (x N)))/.
  1:{
    apply /leqr_trans _ (rational_to_real z - rational_to_real (x N) - (rintro x Hregx - rational_to_real (x N)))/.
      {
      apply /minusr_leqr/ >> autoWith /leqr_refl/.
      apply /absr_ub/.
      }
    unfold /minusr at all/.
    rewrite /-> negr_plusr/.
    rewrite /<- plusr_assoc/.
    rewrite /-> negr_invol/.
    rewrite /-> plusr_commute3 at 1/.
    rewrite /-> plusr_assoc/.
    rewrite /-> plusr_inverse_l/.
    rewrite /-> plusr_id_r/.
    apply /leqr_refl/.
    }
  apply /ltr_leqr_trans _ (rational_to_real z - rational_to_real (x N) - rational_to_real (invq (nat_to_rational N)))/.
  1:{
    apply /minusr_leqr/ >> autoWith /leqr_refl/.
    apply /approximations_nearby/.
    omega.
    }
  rewrite /<- minusr_shift_ltr_rr/.
  rewrite /-> plusr_id_l/.
  rewrite /<- minusq_to_real/.
  apply /rational_to_real_mono_lt/.
  subst /N/.
  rewrite /-> times_to_rational/.
  unfold /nat_to_rational at 1/.
  reduce //.
  rewrite /-> invq_timesq/.
  rewrite /-> timesq_commute/.
  subst /z/.
  apply /timesq_cancel_ltq_l _ _ q`2/.
    {
    autoQ.
    }
  rewrite /<- timesq_assoc/.
  rewrite /-> timesq_inverse_r/.
    {
    autoQ.
    }
  rewrite /-> timesq_id_l/.
  rewrite /-> timesq_dist_minusq_r/.
  rewrite /<- timesq_assoc/.
  rewrite /-> timesq_inverse_r/.
    {
    autoQ.
    }
  rewrite /-> timesq_id_l/.
  rewrite /-> plusq_commute/.
  rewrite /-> plusq_minusq_assoc/.
  rewrite /<- timesq_id_l (x _)/.
  rewrite /<- timesq_dist_minusq_l/.
  rewrite /q`1 -q q`2 = q`-1 : rational/.
    {
    rewrite /-> minusz_to_rational z`1 z`2/.
    reflexivity.
    }
  rewrite /<- negq_as_timesq/.
  hyp /Hlt/.
  }

  {
  rewrite /<- plusr_id_l (rational_to_real _)/.
  rewrite /-> minusr_shift_ltr_rr/.
  apply /ltr_leqr_trans _ (rational_to_real (y N) - rational_to_real z - absr (rational_to_real (y N) - rintro y Hregy))/.
  1:{
    apply /leqr_trans _ (rational_to_real (y N) - rational_to_real z - (rational_to_real (y N) - rintro y Hregy))/.
      {
      apply /minusr_leqr/ >> autoWith /leqr_refl/.
      apply /absr_ub/.
      }
    unfold /minusr at all/.
    rewrite /-> negr_plusr/.
    rewrite /<- plusr_assoc/.
    rewrite /-> negr_invol/.
    rewrite /-> plusr_commute/.
    rewrite /<- plusr_assoc at all/.
    rewrite /<- plusr_rotate4/.
    rewrite /-> plusr_assoc/.
    rewrite /-> plusr_inverse_l/.
    rewrite /-> plusr_id_r/.
    apply /leqr_refl/.
    }
  apply /ltr_leqr_trans _ (rational_to_real (y N) - rational_to_real z - rational_to_real (invq (nat_to_rational N)))/.
  1:{
    apply /minusr_leqr/ >> autoWith /leqr_refl/.
    rewrite /-> absr_minusr_commute/.
    apply /approximations_nearby/.
    omega.
    }
  rewrite /<- minusr_shift_ltr_rr/.
  rewrite /-> plusr_id_l/.
  rewrite /<- minusq_to_real/.
  apply /rational_to_real_mono_lt/.
  subst /N/.
  rewrite /-> times_to_rational/.
  unfold /nat_to_rational at 1/.
  reduce //.
  rewrite /-> invq_timesq/.
  rewrite /-> timesq_commute/.
  subst /z/.
  apply /timesq_cancel_ltq_l _ _ q`2/.
    {
    autoQ.
    }
  rewrite /<- timesq_assoc/.
  rewrite /-> timesq_inverse_r/.
    {
    autoQ.
    }
  rewrite /-> timesq_id_l/.
  rewrite /-> timesq_dist_minusq_r/.
  rewrite /<- timesq_assoc/.
  rewrite /-> timesq_inverse_r/.
    {
    autoQ.
    }
  rewrite /-> timesq_id_l/.
  rewrite /-> plusq_commute/.
  rewrite /<- minusq_assoc/.
  rewrite /<- timesq_id_l (y _) at 1/.
  rewrite /<- timesq_dist_minusq_l/.
  rewrite /q`2 -q q`1 = q`1 : rational/.
    {
    rewrite /<- minusz_to_rational z`2 z`1/.
    reflexivity.
    }
  rewrite /-> timesq_id_l/.
  unfold /minusq/.
  hyp /Hlt/.
  }
qed ();



lemma "rational_dense_within_real"
/
  forall x y .
    ltr x y
    -> squish
         (exists (z : rational) .
            ltr x (rational_to_real z) & ltr (rational_to_real z) y)
/;

inference.
intro /x' y' Hxy/.
so /real_to_prereal x'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(x ?)/.
so /real_to_prereal y'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(y ?)/.
subst /x' y'/.
apply /squish_ret/.
apply /rational_dense_within_real_prereal/ >> auto.
qed ();



lemma "rational_dense_within_real_squash"
/
  forall x y .
    ltr x y
    -> { exists (z : rational) .
           ltr x (rational_to_real z) & ltr (rational_to_real z) y }
/;

inference.
intro /x y Hxy/.
apply /squish_impl_squash/.
apply /rational_dense_within_real/ >> auto.
qed ();



lemma "infinitely_close"
/
  forall x y .
    (forall k . n`0 <n k -> leqr (absr (x -r y)) (invr (nat_to_real k)))
    -> x = y : real
/;

inference.
assert /forall k . n`0 <n k -> nat_to_real k != r`0 : real/ /Hnonzero/.
  {
  inference.
  intro /k Hk/.
  apply /nat_to_real_nonzero/.
  omega.
  }
assert /forall x y .
          x <r y
          -> (forall k . n`0 <n k -> leqr (absr (x -r y)) (invr (nat_to_real k)))
          -> void/ /Hprop/.
  {
  inference.
  intro /x y Hxy Hclose/ >> auto.
  so /rational_dense_within_real_squash _# 2 Hxy/ /[(a Hxa Hay)]/.
  so /rational_dense_within_real_squash _# 2 Hay/ /[(b Hab Hby)]/.
  so /rational_to_real_mono_lt_conv _# 2 Hab/ /Hab'/.
  exploit /Hclose (succ (integer_to_nat (ceiling (invq (b -q a)))))/ /Hleq/.
    {
    omega.
    }
  assert /nat_to_real (succ (integer_to_nat (ceiling (invq (b -q a))))) != r`0 : real/ /Hnonzeroceil/.
    {
    apply /nat_to_real_nonzero/.
    omega.
    }
  rewrite /<- not_ltr in Hleq/ >> auto.
  witness /Hleq __/.
  assert /absr (x -r y) != r`0 : real/ /Hnonzerodiff/.
    {
    apply /absr_preserves_nonzero/.
    apply /ltr_impl_neq/.
    rewrite /<- minusr_shift_ltr_ll/.
    rewrite /-> plusr_id_r/.
    hyp /Hxy/.
    }
  rewrite /<- invr_invol (absr _)/ >> auto.
  apply /invr_ltr_pos/.
    {
    apply /invr_positive/.
    apply /absr_positive_iff_nonzero/.
    apply /ltr_impl_neq/.
    rewrite /<- minusr_shift_ltr_lr/.
    rewrite /-> plusr_id_l/.
    hyp /Hxy/.
    }
  apply /ltr_leqr_trans/.
  1:{
    exploit /jaunt_into_nat (invq (b -q a))/ /H/.
      {
      apply /invq_nonnegative/.
      rewrite /<- minusq_shift_leqq_rr/.
      rewrite /-> plusq_id_l/.
      apply /ltq_impl_leqq/.
      hyp /Hab'/.
      }
    unfold /nat_to_real/.
    fold /nat_to_rational (succ _)/.
    apply /rational_to_real_mono/.
      {
      hyp /H/.
      }

      typechecker ();
    }

    typechecker ();
  rewrite /-> invq_to_real/.
    {
    symmetry.
    apply /ltq_impl_neq/.
    rewrite /<- minusq_shift_ltq_rr/.
    rewrite /-> plusq_id_l/.
    hyp /Hab'/.
    }
  apply /invr_ltr_pos/.
    {
    unfold /integer_to_real/.
    apply /rational_to_real_mono_lt/.
    rewrite /<- minusq_shift_ltq_rr/.
    rewrite /-> plusq_id_l/.
    hyp /Hab'/.
    }
  rewrite /-> absr_minusr_commute/.
  rewrite /-> absr_of_nonneg/.
    {
    rewrite /<- minusr_shift_leqr_rr/.
    rewrite /-> plusr_id_l/.
    apply /ltr_impl_leqr/ >> auto.
    }
  rewrite /-> minusq_to_real/.
  unfold /minusr at 1/.
  rewrite /<- plusr_id_r (_ +r _)/.
  rewrite /<- plusr_inverse_l (rational_to_real b)/.
  rewrite /<- plusr_assoc at all/.
  rewrite /-> plusr_commute3 at 1/.
  rewrite /-> plusr_assoc/.
  apply /ltr_trans _ (r`0 +r (~r x +r rational_to_real b))/.
  1:{
    apply /plusr_ltr_l/.
      {
      fold /_ -r _/.
      rewrite /<- minusr_shift_ltr_rr/.
      rewrite /-> plusr_id_l/ >> auto.
      }
      
      {
      apply /leqr_refl/.
      }
    }
  rewrite /-> plusr_id_l/.
  rewrite /<- plusr_id_r (_ +r _)/.
  rewrite /<- plusr_inverse_l (rational_to_real a)/.
  rewrite /<- plusr_assoc at all/.
  rewrite /-> plusr_commute at 2/.
  rewrite /<- plusr_rotate4/.
  rewrite /-> plusr_assoc/.
  rewrite /<- plusr_id_r (_ -r _)/.
  apply /plusr_ltr_r/.
    {
    unfold /minusr/.
    apply /leqr_refl/.
    }

    {
    fold /minusr _ _/.
    rewrite /<- minusr_shift_ltr_rr/.
    rewrite /-> plusr_id_l/ >> auto.
    }
  }
intro /x y Hclose/ >> auto.
apply /eq_real_stable/.
intro /Hneq/.
so /real_dichotomy_neq _# 2 Hneq/ /Hlt | Hgt/.  
  {
  apply /Hprop/ >> auto.
  }

  {
  apply /Hprop/ >> auto.
  intro /k Hk/.
  rewrite /-> absr_minusr_commute/ >> auto.
  }
qed ();

  
  
lemma "real_upper_bound"
/
  forall (x : real) . squish (exists (y : integer) . ltr x (integer_to_real y))
/;

intro /x'/.
witness /squish_bind (real_to_prereal x') __/.
intro /(x Heq)/.
subst /x'/.
apply /squish_ret/.
so /real_upper_bound_prereal x/ /y Hy/.
existsAuto.
qed ();



lemma "real_upper_bound_squash"
/
  forall (x : real) . { exists (y : integer) . ltr x (integer_to_real y) }
/;

intro /x/.
apply /squish_impl_squash/.
apply /real_upper_bound/.
qed ();



lemma "real_upper_bound_nat_prereal"
/
  forall (x : prereal) .
    exists (n : nat) .
      n`0 <n n
      & realintro x < nat_to_real n
/;

intro /x/.
so /real_upper_bound_prereal x/ /z Hz/.
so /Integer.integer_dichotomy z z`0/ /Hneg | Hpos/.
  {
  exists /n`1/.
  split.
    {
    omega.
    }
  unfold /nat_to_real/.
  fold /integer_to_real _/.
  apply /ltr_leqr_trans _ (integer_to_real z)/ >> auto.
  apply /integer_to_real_mono/.
  omega.
  }

  {
  exists /Integer.integer_to_nat z/.
  split.
    {
    omega.
    }
  unfold /nat_to_real/.
  fold /integer_to_real _/.
  rewrite /-> Integer.integer_to_nat_inv/ >> auto.
  apply /Integer.ltz_impl_leqz/ >> auto.
  }
qed ();



lemma "real_upper_bound_nat"
/
  forall (x : real) .
    squish
      (exists (n : nat) . n`0 <n n & x < nat_to_real n)
/;

intro /x'/.
witness /squish_bind (real_to_prereal x') __/.
intro /(x Heq)/.
subst /x'/.
apply /squish_ret/.
so /real_upper_bound_nat_prereal x/ /z Hpos Hz/.
existsAuto.
qed ();



lemma "real_upper_bound_nat_squash"
/
  forall (x : real) .
    { exists (n : nat) . n`0 <n n & x < nat_to_real n }
/;

intro /x/.
apply /squish_impl_squash/.
apply /real_upper_bound_nat/.
qed ();



(* Calculate *)

structure R = Reduction;

val regroup_nat_to_real =
  R.user $
  makeReduction
  /
    nat_to_real n --> integer_to_real (nat_to_integer n) ;

    unfolding nat_to_real integer_to_real
  /;

writeRegistry /regroup_nat_to_real/ /reduction/ regroup_nat_to_real;

val regroup_integer_to_rational_to_real =
  R.user $
  makeReduction
  /
    rational_to_real (integer_to_rational x) --> integer_to_real x ;

    unfolding integer_to_real
  /;

writeRegistry /regroup_integer_to_rational_to_real/ /reduction/ regroup_integer_to_rational_to_real;

val regroup_nat_to_rational_to_real =
  R.user $
  makeReduction
  /
    rational_to_real (nat_to_rational n) --> integer_to_real (nat_to_integer n) ;

    unfolding integer_to_real nat_to_rational
  /;

writeRegistry /regroup_nat_to_rational_to_real/ /reduction/ regroup_integer_to_rational_to_real;

val regroup_integer_to_prereal_to_real =
  R.user $
  makeReduction
  /
    realintro (integer_to_prereal x) --> integer_to_real x ;

    unfolding realintro rational_to_prereal integer_to_prereal integer_to_real
  /;

writeRegistry /regroup_integer_to_prereal_to_real/ /reduction/ regroup_integer_to_prereal_to_real;

val regroup_integer_to_rational_to_prereal =
  R.user $
  makeReduction
  /
    rational_to_prereal (integer_to_rational x) --> integer_to_prereal x ;

    unfolding integer_to_prereal
  /;

writeRegistry /regroup_integer_to_rational_to_prereal/ /reduction/ regroup_integer_to_rational_to_prereal;

val regroup_plusz_to_real = 
   R.user $
   makeReduction
   /
      plusr (integer_to_real x) (integer_to_real y) --> 
         integer_to_real (plusz (timesz x z`1) (timesz y z`1)) ;

      unfolding integer_to_real plusr plusq integer_to_rational rational_to_real
   /;

writeRegistry /regroup_plusz_to_real/ /reduction/ regroup_plusz_to_real;

val regroup_minusz_to_real = 
   R.user $
   makeReduction
   /
      minusr (integer_to_real x) (integer_to_real y) --> 
         integer_to_real (plusz (timesz x z`1) (timesz (negz y) z`1)) ;

      unfolding integer_to_real minusr negr negq plusr plusq integer_to_rational rational_to_real
   /;

writeRegistry /regroup_minusz_to_real/ /reduction/ regroup_minusz_to_real;

val regroup_negz_to_real = 
   R.user $
   makeReduction
   /
      negr (integer_to_real x) --> integer_to_real (negz x) ;

      unfolding integer_to_real negr negq integer_to_rational rational_to_real
   /;

writeRegistry /regroup_negz_to_real/ /reduction/ regroup_negz_to_real;

val regroup_timesz_to_real = 
   R.user $
   makeReduction
   /
      timesr (integer_to_real x) (integer_to_real y) --> integer_to_real (timesz x y) ;

      unfolding integer_to_real timesr timesq integer_to_rational rational_to_real
   /;

writeRegistry /regroup_timesz_to_real/ /reduction/ regroup_timesz_to_real;

val regroup_plusz_to_prereal =
   R.user $
   makeReduction
   /
      preplusr (integer_to_prereal x) (integer_to_prereal y) --> 
         integer_to_prereal (plusz (timesz x z`1) (timesz y z`1)) ;

      unfolding integer_to_real plusr plusq preplusr integer_to_rational rational_to_prereal rational_to_real integer_to_prereal
   /;

writeRegistry /regroup_plusz_to_prereal/ /reduction/ regroup_plusz_to_prereal;

val regroup_negz_to_prereal =
   R.user $
   makeReduction
   /
      prenegr (integer_to_prereal x) --> integer_to_prereal (negz x) ;

      unfolding integer_to_real negr negq prenegr integer_to_rational rational_to_prereal rational_to_real integer_to_prereal
   /;

writeRegistry /regroup_negz_to_prereal/ /reduction/ regroup_negz_to_prereal;

val regroup_timesz_to_prereal =
   R.user $
   makeReduction
   /
      pretimesr (integer_to_prereal x) (integer_to_prereal y) --> 
         integer_to_prereal (timesz x y) ;

      unfolding integer_to_real timesr timesq pretimesr integer_to_rational rational_to_prereal rational_to_real integer_to_prereal
   /;

writeRegistry /regroup_timesz_to_prereal/ /reduction/ regroup_timesz_to_prereal;



setOpacity /real/ Constant.OPAQUE;
setOpacity /prereal/ Constant.OPAQUE;
setOpacity /rational_to_real/ Constant.OPAQUE;
setOpacity /plusr/ Constant.OPAQUE;
setOpacity /negr/ Constant.OPAQUE;
setOpacity /timesr/ Constant.OPAQUE;
setOpacity /invr/ Constant.OPAQUE;
setOpacity /absr/ Constant.OPAQUE;
setOpacity /maxr/ Constant.OPAQUE;
setOpacity /ltr/ Constant.OPAQUE;


endModule ();  (* Real *)
