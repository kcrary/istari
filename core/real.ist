(* Real numbers, loosely following the development in Bishop and Bridges. *)

File.import "bool-load.iml";
File.import "integer-load.iml";
File.import "logic-load.iml";
File.import "markov-load.iml";
File.import "nat-load.iml";
File.import "omega-load.iml";
File.import "quotient-load.iml";
File.import "rational-load.iml";
File.import "sqstable-load.iml";
File.import "stable-load.iml";
File.import "squish-load.iml";
File.import "real-aux.iml";
File.import "autoQ.iml";

openModule /Rational/;
openModule /Integer/;
openModule /Nat/;
openModule /Squish/;

aliasModule /Q/ /Quotient/;


(* A tool to hide hypotheses from Omega. *)

val red = Reduction.trans [Reduction.unfold, Reduction.beta 1];
val pause = Namespace.resolveStr "pause";

fun disguise1 hyp =
   let
      do goal as (jud, dir) = Tactic.withgoal
      val i = Hyp.hypothesisToHyp goal hyp
   in
      (case Judgement.hyp jud i of
         Judgement.Tm t =>
           let
              val t' = ETerm.absolute (Directory.shift dir (i + 1)) (Term.apply1 pause t)
           in
              unreduceUsing [(([], t', red), [(hyp, SOME (true, [0]))])]
           end
    
       | _ =>
           fail "wrong sort to disguise")
   end;

fun disguise hyps =
   (case hyps of
       nil => idtac

     | hyp :: rest =>
          disguise1 hyp >>+ disguise rest);

fun undisguise hyps =
   unfold [((fn _ => Directory.Hconst pause), 
            map (fn h => (h, NONE)) hyps)];

fun autoQWith hyps =
   undisguise hyps >>+ autoQ ;

grammardef Disguise

  start disguise Hypotheses
  start undisguise Hypotheses
  start autoQWith Hypotheses

end

grammaron Disguise;



beginModule "Real";


(* SET PARSING TO RATIONAL *)
setArithRational ();


lemma "jaunt_into_nat"
/
  forall a .
    0 <= a
    -> a <= nat_to_rational (succ (integer_to_nat (ceiling a)))
/;

inference.
intro /a Ha/.
apply /ltq_impl_leqq/.
unfold /nat_to_rational/.
rewrite /-> succ_to_integer/.
rewrite /-> plusz_to_rational/.
rewrite /-> integer_to_nat_inv/.
  {
  apply /ceiling_nonneg/ >> auto.
  }
apply /leqq_ltq_trans _ (integer_to_rational (ceiling a))/.
  {
  apply /ceiling_ub/.
  }

  {
  rewrite /<- plusq_id_l (integer_to_rational _)/.
  apply /plusq_ltq_l/ >> auto.
  apply /ltq_0_1/.
  }
qed ();



(* Primitive definitions and properties *)
beginModule "Primitive";


(* The arithmetic goes much more smoothly if you index from 1.  Thus
   the first number in the sequences is unimportant (which is
   mathematically correct since it has margin of error 0^-1).
*)


define /regular x/
/
  forall m n . n`0 <n m -> n`0 <n n -> absq (x m - x n) <= invq (nat_to_rational m) + invq (nat_to_rational n)
//
  (nat -> rational) -> U 0
/;

unfold /regular/.
typecheck.
qed ();



lemma "regular_sqstable"
/
  forall (x : nat -> rational) .
    Sqstable.sqstable (regular x)
/;

intro /x [Hx]/.
intro /m n Hposm Hposn/.
unhide.
apply /Hx m n/ >> auto.
qed ();



define /realequiv x y/
/
  forall n . n`0 <n n -> absq (x n - y n) <= 2 * invq (nat_to_rational n)
//
  (nat -> rational) -> (nat -> rational) -> U 0
/;

unfold /realequiv/.
typecheck.
qed ();



lemma "realequiv_cauchy"
/
  forall x y .
    regular x
    -> regular y
    -> realequiv x y
       <->
       (forall j . 
          n`0 <n j
          -> exists n .
               n`0 <n n
               & (forall i .
                    n <n= i
                    -> absq (x i - y i) <= invq (nat_to_rational j)))
/;

inference.
intro /x y Hx Hy/.
split.
  {
  intro /Hxy j Hposj/.
  exists /n`2 *n j/.
  split.
    {
    omega.
    }
  intro /i Hi/.
  assertThen /n`0 <n i/ /Hposi/ omega.
  unfold /realequiv in Hxy/.
  rewrite /-> Hxy/ >> auto.
  rewrite /<- invq_invol q`2/.
  rewrite /<- invq_timesq/.
  apply /invq_leqq_pos/ >> autoQ.
  apply /timesq_cancel_leqq_l _ _ q`2/ >> autoQ.
  rewrite /<- timesq_assoc/.
  rewrite /-> timesq_inverse_r/ >> autoQ.
  rewrite /-> timesq_id_l/.
  unfold /nat_to_rational at 0 0/.
  rewrite /<- timesz_to_rational/.
  apply /integer_to_rational_mono/.
  omega.
  }

  {
  intro /Hcauchy/.
  unfold /realequiv/.
  unfold /regular in Hx in Hy/.
  intro /n Hposn/.
  assert /forall j . n`0 <n j -> absq (x n - y n) <= 2 * invq (nat_to_rational n) + 3 * invq (nat_to_rational j)/ /Hprop/.
    {
    inference.
    intro /j Hposj/.
    so /Hcauchy j Hposj/ /N HposN HN/.
    setEq /k/ /Nat.max j N/ /_/ /Heq/.
    assert /n`0 <n k/ /Hposk/.
      {
      omega.
      }
    apply /leqq_trans _ (2 * invq (nat_to_rational n) + (2 * invq (nat_to_rational k) + invq (nat_to_rational j)))/.
      {
      rewrite /x n - y n = (x n - x k) +q (x k - y k) +q (y k - y n) : rational/.
        {
        unfold /minusq at all/.
        rewrite /<- plusq_assoc at all/.
        rewrite /-> plusq_assoc at 1/.
        rewrite /-> plusq_inverse_l/.
        rewrite /-> plusq_id_r/.
        rewrite /-> plusq_assoc at 1/.
        rewrite /-> plusq_inverse_l/.
        rewrite /-> plusq_id_r/.
        reflexivity.
        }
      rewrite /-> absq_plusq_leqq/.
      rewrite /-> absq_plusq_leqq/.
      rewrite /-> Hx n k/ >> auto.
      rewrite /-> HN k/. 
      1:{
        omega.
        }
      rewrite /<- absq_negq/.
      rewrite /-> negq_minusq/.
      rewrite /-> Hy n k/ >> auto.
      rewrite /<- plusq_assoc at all/.
      rewrite /-> plusq_rotate4 at 1/.
      assert /2 = 1 + 1 : rational/ /Heq2/.
        {
        apply /plusz_to_rational z`1 z`1/.
        }
      rewrite /-> Heq2 at 0 0/.
      rewrite /-> timesq_dist_plusq_l at all/.
      rewrite /-> timesq_id_l at all/.
      rewrite /<- plusq_assoc at all/.
      rewrite /<- plusq_commute3/.
      reflexivity.
      }

      {
      apply /plusq_leqq/ >> auto.
      rewrite /3 = 2 + 1 : rational/.
        {
        apply /plusz_to_rational z`2 z`1/.
        }
      rewrite /-> timesq_dist_plusq_l at all/.
      rewrite /-> timesq_id_l at all/.
      apply /plusq_leqq/ >> auto.
      apply /timesq_leqq_l/ >> autoQ.
      }
    }
  apply /leqq_from_upper_bounds/.
  intro /z Hz/.
  setEq /j/ /succ (Integer.integer_to_nat (ceiling (invq ((z - 2 * invq (nat_to_rational n)) * invq 3))))/ /nat/ /Heqj/.
  assert /n`0 <n j/ /Hposj/.
    {
    subst /j/.
    omega.
    }
  so /Hprop j Hposj/ /H/.
  apply /leqq_trans/ >> auto.
  clear /H/.
  apply /plusq_shift_leqq_rll/.
  rewrite /-> plusq_commute/.
  fold /minusq _ _/.
  subst /j/.
  assert /0 < invq ((z - 2 * invq (nat_to_rational n)) * invq 3)/ /H1/.
    {
    apply /invq_positive/.
    apply /timesq_ltq_zero_pos_pos/ >> autoQ.
    rewrite /<- plusq_id_l (_ *q _) in Hz/.
    rewrite /-> plusq_shift_ltq_rrr in Hz/.
    unfold /minusq/ >> auto.
    }
  so /jaunt_into_nat (invq ((z - 2 * invq (nat_to_rational n)) * invq 3)) __/ /H2/.
    {
    apply /ltq_impl_leqq/ >> auto.
    }
  so /invq_leqq_pos _ _ __ H2/ /H3/ >> auto.
  so /timesq_leqq_l 3 _ _ __ H3/ /H4/ >> autoQ.
  rewrite /-> H4/.
  clear /H1 H2 H3 H4/.
  rewrite /-> invq_invol/.
  rewrite /-> timesq_commute/.
  rewrite /-> timesq_assoc/.
  rewrite /-> timesq_inverse_l/ >> autoQ.
  rewrite /-> timesq_id_r/.
  apply /leqq_refl/.
  }
qed ();



lemma "realequiv_refl"
/
  forall x . realequiv x x
/;

inference.
intro /x n Hposn/.
rewrite /-> minusq_self/.
rewrite /-> absq_zero/.
apply /timesq_leqq_zero/.
  {
  apply /integer_to_rational_mono/.
  omega.
  }
  
  {
  apply /ltq_impl_leqq/.
  apply /invq_positive/.
  unfold /nat_to_rational/.
  apply /integer_to_rational_mono_lt/.
  omega.
  }
qed ();



lemma "realequiv_symm"
/
  forall x y .
    realequiv x y
    -> realequiv y x
/;

inference.
unfold /realequiv at all/.
intro /x y Hxy n Hposn/.
rewrite /<- Hxy/ >> auto.
apply /leqq_refl_eq/.
rewrite /<- absq_negq/.
rewrite /-> negq_minusq/.
reflexivity.
qed ();



lemma "realequiv_trans"
/
  forall x y z .
    regular x
    -> regular y
    -> regular z
    -> realequiv x y
    -> realequiv y z
    -> realequiv x z
/;

inference.
intro /x y z Hx Hy Hz Hxy Hyz/.
rewrite /-> realequiv_cauchy in Hxy in Hyz in concl/ >> auto.
intro /j Hposj/.
so /Hxy (j *n n`2) __/ /m Hposm Hm/ >>> [omega, idtac].
so /Hyz (j *n n`2) __/ /n Hposn Hn/ >>> [omega, idtac].
exists /Nat.max m n/.
split.
  {
  omega.
  }
intro /i Hi/.
so /Hm i __/ /Hxy'/.
  {
  omega.
  }
so /Hn i __/ /Hyz'/.
  {
  omega.
  }
rewrite /x i - z i = (x i - y i) + (y i - z i) : rational/.
  {
  unfold /minusq at all/.
  rewrite /<- plusq_assoc/.
  rewrite /-> plusq_assoc at 1/.
  rewrite /-> plusq_inverse_l/.
  rewrite /-> plusq_id_r/.
  reflexivity.
  }
rewrite /-> absq_plusq_leqq/.
rewrite /-> Hxy'/.
rewrite /-> Hyz'/.
apply /leqq_refl_eq/.
rewrite /<- timesq_id_l (invq _) at 0 1/.
rewrite /<- timesq_dist_plusq_l/.
rewrite /<- plusz_to_rational z`1 z`1/.
reduce //.
rewrite /-> times_to_rational j n`2/.
unfold /nat_to_rational at 1/.
reduce //.
rewrite /-> invq_timesq/.
rewrite /-> timesq_commute at 1/.
rewrite /<- timesq_assoc/.
rewrite /-> timesq_inverse_r/ >> autoQ.
rewrite /-> timesq_id_l/.
reflexivity.
qed ();



lemma "realequiv_per"
/
  Q.PER2
    (nat -> rational)
    regular
    realequiv
/;

unfold /Q.PER2/.
reduce //.
splitn 2.
  {
  intro /x _/.
  apply /realequiv_refl/.
  }

  {
  intro /x y _ _ Hxy/.
  apply /realequiv_symm/ >> auto.
  }

  {
  intro /x y z Hx Hy Hz Hxy Hyz/.
  apply /realequiv_trans _ y/ >> auto.
  }
qed ();



(* Bishop and Bridges define the canonical bound as the least integer
   that is greater than |x(1)|+2.  Instead, I'm defining it as the
   least integer that is greater than or equal to |x(1)|+3 since the
   arithmetic is a little easier.
*)
define /bound x/
/
  n`3 +n integer_to_nat (ceiling (absq (x n`1)))
//
  (nat -> rational) -> nat
/;

unfold /bound/.
typecheck.
qed ();



lemma "bound_positive"
/
  forall x . n`0 <n bound x
/;

inference.
intro /x/.
unfold /bound/.
omega.
qed ();



lemma "bound_ub"
/
  forall (x : nat -> rational) n .
    regular x
    -> n`0 <n n
    -> absq (x n) < nat_to_rational (bound x)
/;

inference.
intro /x n Hreg Hposn/.
unfold /bound/.
unfold /regular in Hreg/.
so /Hreg n n`1 Hposn __/ /H1/.
  {
  omega.
  }
rewrite /<- absq_minusq_absq in H1/.
so /absq_minusq_upper_bound _# 3 H1/ /H2/.
rewrite /-> plus_to_rational n`3 (integer_to_nat _)/.
unfold /nat_to_rational at all/.
reduce //.
rewrite /-> integer_to_nat_inv/.
  {
  apply /ceiling_nonneg/.
  apply /absq_nonneg/.
  }
rewrite /-> H2/.
rewrite /<- ceiling_ub/.
rewrite /-> plusq_commute/.
apply /plusq_ltq_l/ >> auto.
unfold /nat_to_rational at 1/.
reduce //.
rewrite /-> invq_one/.
rewrite /-> plusz_to_rational z`2 z`1/.
apply /plusq_ltq_l/ >> auto.
rewrite /<- invq_invol 2/.
apply /invq_ltq_pos/ >> autoQ.
apply /ltq_leqq_trans _ 1/ >> autoQ.
rewrite /<- invq_invol 1/.
apply /invq_ltq_pos/ >> autoQ.
rewrite /-> invq_one/.
apply /integer_to_rational_mono_lt/ >> omega.
qed ();



lemma "bound_ratio"
/
  forall (x y : nat -> rational) .
    realequiv x y
    -> bound x <n= bound y *n n`2
/;

inference.
intro /x y Hxy/.
unfoldHead /bound at 0 0/.
rewrite /--> plus_commute n`3 within _ at 0 0/.
reduce //.
unfold /realequiv in Hxy/.
so /Hxy n`1 __/ /H/.
  {
  omega.
  }
rewrite /<- absq_minusq_absq in H/.
so /absq_minusq_upper_bound _# 3 H/ /Hleq/.
clear /H/.
unfold /nat_to_rational in Hleq/.
rewrite /-> invq_one in Hleq/.
rewrite /<- timesz_to_rational z`2 z`1 in Hleq/.
reduce /Hleq/.
rewrite /-> Hleq/.
rewrite /-> ceiling_plus_r/.
omega.
qed ();



define /real/
/
  quotient (x y : nat -> rational) .
    regular x
    & regular y
    & realequiv x y

//
  U 0
/;

unfold /real/.
fold /Q.quotient2 _ regular realequiv realequiv_per/.
typecheck.
qed ();



define /rintro x h/
/
  x
//
  forall (x : nat -> rational) . regular x -> real
/;

introOf /x h/.
unfold /rintro/.
fold /Q.qintro2 _ regular realequiv realequiv_per x h/.
unfold /real/.
fold /Q.quotient2 _ regular realequiv realequiv_per/.
typecheck.
qed ();



lemma "real_representative"
/
  forall (x : real) .
    isquash
      (exists y h .
         x = rintro y h : real)
/;

inference.
intro /x/.
infer /real/ /Hof/.
unfold /of in Hof, real in Hof/.
fold /Q.quotient2 _ regular realequiv realequiv_per in Hof/.
unfold /real in x/.
fold /Q.quotient2 _ regular realequiv realequiv_per in x/.
destruct /x/ /[x Hx]/.
split.
exists /x/.
exists /Hx/.
unfold /rintro/.
fold /Q.qintro2 _ regular realequiv realequiv_per x Hx at 1/.
reflexivity.
qed ();



lemma "real_impl_regular"
/
  forall (x : real) . { regular x }
/;

intro /x/.
exactRaw /()/.
unfold /real in x/.
destruct /x/ /[x y (Hx Hy Hxy)]/.
  {
  typecheck.
  split >> auto.
  }

  {
  typecheck.
  }
qed ();



lemma "real_equality"
/
  forall (x y : real) .
    { realequiv x y }
    -> x = y : real
/;

inference.
unfold /real at all/.
fold /Q.quotient2 _ regular realequiv realequiv_per at all/.
exact /Q.quotient2_equality _ (nat -> rational) regular realequiv realequiv_per/.
qed ();



lemma "real_representative_squish"
/
  forall (x : real) .
    squish
      (exists y h .
         { x = rintro y h : real })
/;

inference.
intro /x/.
infer /real/ /Hof/.
unfold /of in Hof, real in Hof/.
fold /Q.quotient2 _ regular realequiv realequiv_per in Hof/.
unfold /real in x/.
fold /Q.quotient2 _ regular realequiv realequiv_per in x/.
exactRaw /squish_ret (x, (fn _ _ _ _ . ()), ())/.
destruct /x/ /[x Hx x' Hx' Hxx]/.
  {
  typecheck.
  assert /Q.qintro2 (nat -> rational) regular realequiv realequiv_per x Hx
          = Q.qintro2 (nat -> rational) regular realequiv realequiv_per x' Hx'
          : real/ /Heqreal/.
    {
    unfold /Q.qintro2 at 0 0/.
    fold /rintro x Hx/.
    fold /rintro x' Hx'/.
    apply /real_equality/.
    unfold /rintro at 0 0/.
    auto.
    }
  split.
    {
    intro /Heq/.
    rewrite /<- Heq/.
    symmetry.
    hyp /Heqreal/.
    }

    {
    intro /Heq/.
    rewrite /<- Heq/.
    hyp /Heqreal/.
    }
  }

  {
  unfold /Q.qintro2 at all/.
  fold /rintro x Hx at 0/.
  assert /forall z . regular z -> (fn _ _ _ _ . ()) : regular z/ /Hregall/.
    {
    inference.
    intro /z Hz/.
    unfold /regular in Hz in concl/.
    introOf /m n Hm Hn/ >> auto.
    reduce //.
    typecheck.
    apply /Hz/ >> auto.
    }
  so /Hregall x Hx/ /Hregx/.
  so /Hregall x' Hx'/ /Hregx'/.
  apply /squish_ext/.
    {
    split.
    apply /real_equality/.
    unfold /rintro at all/.
    split.
    apply /realequiv_refl/.
    }

    {
    split.
    apply /real_equality/.
    unfold /rintro at all/.
    split.
    auto.
    }
  }
qed ();



lemma "realequiv_stable"
/
  forall (x y : nat -> rational) .
    regular x
    -> regular y
    -> Stable.stable (realequiv x y)
/;

intro /x y Hregx Hregy/.
unfold /Stable.stable/.
intro /Hnneq/.
unfold /realequiv/.
intro /n Hposn/.
apply /leqq_stable/.
contrapositive /Hnneq/.
contrapositive /Hnneq/.
exact /Hnneq n Hposn/.
qed ();



lemma "realequiv_sqstable"
/
  forall (x y : nat -> rational) .
    regular x
    -> regular y
    -> Sqstable.sqstable (realequiv x y)
/;

intro /x y Hx Hy/.
apply /Sqstable.stable_impl_sqstable/.
apply /realequiv_stable/ >> auto.
qed ();



lemma "eq_real_stable"
/
  forall (x y : real) .
    Stable.stable (x = y : real)
/;

intro /x y Hnneq/.
so /real_representative x/ /[Hx]/.
so /real_representative y/ /[Hy]/.
unhide.
destruct /Hx/ /x' Hx ?/.
destruct /Hy/ /y' Hy ?/.
subst /x y/.
apply /real_equality/.
split.
unfold /rintro at all/.
apply /realequiv_stable/ >> auto.
contrapositive /Hnneq/.
contrapositive /Hnneq/.
squashConcl.
  {
  apply /Sqstable.stable_impl_sqstable/.
  apply /realequiv_stable/ >> auto.
  }
unfold /real in Hnneq/.
unfold /rintro in Hnneq at 0 0/.
injection /Hnneq/.
reintro /H/.
split.
exact /H #2 #2/.
qed ();



define /prereal/
/
  { x : nat -> rational | regular x }
//
  U 0
/;

unfold /prereal/.
typecheck.
qed ();



define /realintro x/
/
  x
//
  prereal -> real
/;

introOf /x/.
unfold /realintro/.
destruct /x/ /[x Hreg]/.
unhide.
fold /rintro x Hreg/.
typecheck.
qed ();



lemma "real_to_prereal"
/
  forall (x : real) . squish (exists (y : prereal) . x = realintro y : real)
/;

intro /x/.
witness /squish_bind (real_representative_squish x) __/.
intro /(y Hy [Heq])/.
unhide.
apply /squish_ret/.
assert /y : prereal/ /Hofy/.
  {
  unfold /prereal/.
  typecheck.
  }
exists /y/.
unfold /realintro/.
fold /rintro y Hy/.
hyp /Heq/.
qed ();



lemma "real_to_prereal_squash"
/
  forall (x : real) . { exists (y : prereal) . x = realintro y : real }
/;

intro /x/.
apply /squish_impl_squash/.
apply /real_to_prereal/.
qed ();



lemma "constant_regular"
/
  forall x . regular (fn _ . x)
/;

inference.
intro /x/.
unfold /regular/.
intro /m n Hposm Hposn/.
reduce //.
rewrite /-> minusq_self/.
rewrite /-> absq_of_nonneg/.
rewrite /-> plusz_to_rational z`0 z`0/.
apply /plusq_leqq/ >> autoQ.
qed ();



define /rational_to_real x/
/
  fn _ . x
//
  rational -> real
/;

introOf /x/.
unfold /rational_to_real/.
unfold /real/.
fold /Q.quotient2 _ regular realequiv realequiv_per/.
so /constant_regular x/ /Hreg/.
fold /Q.qintro2 _ _ _ realequiv_per (fn _ . x) Hreg/.
typecheck.
qed ();



define /integer_to_real x/
/
  rational_to_real (integer_to_rational x)
//
  integer -> real
/;

unfold /integer_to_real/.
typecheck.
qed ();



lemma "plusr_regular"
/
  forall x y . regular x -> regular y -> regular (fn i . x (n`2 *n i) + y (n`2 *n i))
/;

inference.
unfold /regular at all/.
intro /u v Hu Hv m n Hposm Hposn/.
reduce //.
rewrite /-> Nat.plus_0_r at all/.
unfold /minusq/.
rewrite /-> negq_dist_plusq/.
rewrite /<- plusq_assoc/.
rewrite /<- plusq_rotate4/.
rewrite /-> plusq_assoc/.
rewrite /-> plusq_commute at 2/.
rewrite /-> absq_plusq_leqq/.
fold /minusq _ _ at all/.
rewrite /-> Hu/ >> attempt omega.
rewrite /-> Hv/ >> attempt omega.
rewrite /<- plusq_assoc at all/.
rewrite /<- plusq_rotate4/.
rewrite /-> plusq_assoc/.
rewrite /-> plusq_self at 0 0/.
rewriteThen /m +n m = n`2 *n m : nat/ omega.
rewriteThen /n +n n = n`2 *n n : nat/ omega.
rewrite /-> times_to_rational n`2 m/.
rewrite /-> times_to_rational n`2 n/.
rewrite /-> invq_timesq at 0 0/.
rewrite /<- timesq_assoc at 0 0/.
unfold /nat_to_rational at 2 0/.
reduce //.
rewrite /-> timesq_inverse_r/ >> autoQ.
rewrite /-> timesq_inverse_r/ >> autoQ.
rewrite /-> timesq_id_l at all/.
reflexivity.
qed ();



define /plusr x y/
/
  fn i . x (n`2 *n i) + y (n`2 *n i)
//
  real -> real -> real
/;

introOf /x y/.
unfold /plusr/.
infer /real/ /Hrealof/.
unfold /real in Hrealof in concl in x in y/.
destruct /x/ /[x x' Hx]/.
destruct /y/ /[y y' Hy]/.
extensionality.
clear /Hrealof/.
destruct /Hx/ /Hx Hx' Heqx/.
destruct /Hy/ /Hy Hy' Heqy/.
splitn 2.
  {
  apply /plusr_regular x y/ >> auto.
  }

  {
  apply /plusr_regular x' y'/ >> auto.
  }

  {
  unfold /realequiv in Heqx in Heqy in concl/.
  reduce //.
  rewrite /-> plus_0_r within _ at all/.
  intro /n Hposn/.
  unfold /minusq/.
  rewrite /-> negq_dist_plusq/.
  rewrite /<- plusq_assoc/.
  rewrite /<- plusq_rotate4/.
  rewrite /-> plusq_assoc/.
  rewrite /-> plusq_commute at 2/.
  rewrite /-> absq_plusq_leqq/.
  fold /minusq _ _ at all/.
  rewrite /-> Heqx/ >> attempt omega.
  rewrite /-> Heqy/ >> attempt omega.
  rewrite /-> plusq_self/.
  rewrite /-> plus_to_rational/.
  rewrite /-> plusq_self/.
  rewrite /-> invq_timesq/.
  rewrite /<- timesq_assoc at all/.
  rewrite /-> timesq_assoc at 1/.
  unfold /nat_to_rational/.
  reduce //.
  rewrite /-> timesq_inverse_r/ >> autoQ.
  rewrite /-> timesq_id_r/.
  unfold /nat_to_rational/.
  reflexivity.
  }
qed ();



lemma "negr_regular"
/
  forall x .
    regular x
    -> regular (fn i . ~ (x i))
/;

inference.
intro /x Hx/.
