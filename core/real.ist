lemma "plusr_ltr_l"
/
  forall x x' y y' .
    x <r x'
    -> y <r= y'
    -> x +r y <r x' +r y'
/;

inference.
intro /x x' y y' Hltx Hleqy/.
unfold /leqr in Hleqy/.
unfold /ltr in Hltx in Hleqy in concl/.
unfold /minusr/.
rewrite /-> negr_plusr/.
rewrite /<- plusr_assoc at all/.
rewrite /<- plusr_commute3 at 1/.
rewrite /-> plusr_assoc/.
fold /minusr _ _ at 0 0/.
apply /plusr_positive_nonnegative/ >> auto.
contrapositive /Hleqy/.
rewrite /-> negr_minusr in Hleqy/.
hyp /Hleqy/.
qed ();



lemma "plusr_ltr_r"
/
  forall x x' y y' .
    x <r= x'
    -> y <r y'
    -> x +r y <r x' +r y'
/;

inference.
intro /x x' y y' Hltx Hlty/.
rewrite /-> plusr_commute at 0 1/.
apply /plusr_ltr_l/ >> auto.
qed ();



lemma "plusr_cancel_ltr_l"
/
  forall x y z .
    z +r x <r z +r y
    -> x <r y
/;

inference.
intro /x y z Hler/.
rewrite /<- plusr_id_l x/.
rewrite /<- plusr_id_l y/.
rewrite /<- plusr_inverse_l z at 0 0/.
rewrite /-> plusr_assoc at 0 0/.
apply /plusr_ltr_r/ >> auto.
apply /leqr_refl/.
qed ();



lemma "plusr_cancel_ltr_r"
/
  forall x y z .
    x +r z <r y +r z
    -> x <r y
/;

inference.
intro /x y z Hler/.
rewrite /-> plusr_commute in Hler at 0 1/.
apply /plusr_cancel_ltr_l/ >> auto.
qed ();



lemma "plusr_shift_ltr_lll"
/
  forall x y z .
    x <r y +r z <-> ~r y +r x <r z
/;

inference.
intro /x y z/.
split.
  {
  intro /Her/.
  apply /plusr_cancel_ltr_l _ _ y/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_r/.
  rewrite /-> plusr_id_l/.
  hyp /Her/.
  }

  {
  intro /Her/.
  apply /plusr_cancel_ltr_l _ _ (~r y)/.
  rewrite /<- plusr_assoc/.
  rewrite /-> plusr_inverse_l/.
  rewrite /-> plusr_id_l/.
  hyp /Her/.
  }
qed ();



lemma "plusr_shift_ltr_lrr"
/
  forall x y z .
    x <r y +r z <-> x +r ~r z <r y
/;

inference.
intro /x y z/.
rewrite /-> plusr_commute at 0 1/.
apply /plusr_shift_ltr_lll/.
qed ();



