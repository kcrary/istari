reduce //.
so /Hall ((N +n N') *n n`2) __/ /Hdistx/.
  {
  omega.
  }
so /Hall' ((N +n N') *n n`2) __/ /Hdisty/.
  {
  omega.
  }
so /plusq_leqq _# 4 Hdistx Hdisty/ /Hdistxy/.
rewrite /<- Hdistxy/.
apply /timesq_cancel_ltq_l _ _ (nat_to_rational N *q nat_to_rational N')/ >> autoQ.
rewrite /-> timesq_dist_plusq_r/.
rewrite /-> timesq_commute at 3/.
rewrite /-> timesq_assoc at 1/.
rewrite /-> timesq_inverse_r/ >> autoQ.
rewrite /-> timesq_assoc at 1/.
rewrite /-> timesq_inverse_r/ >> autoQ.
rewrite /-> timesq_id_r at 0 0/.
rewrite /<- timesq_shift_ltq_lrr/ >> autoQ.
rewrite /-> plusq_commute/.
rewrite /-> timesq_dist_plusq_l/.
rewrite /<- times_to_rational at all/.
rewrite /<- plus_to_rational/.
apply /nat_to_rational_mono_lt/.
rewrite /<- times_dist_plus_l/.
apply /times_lt/ >> omega.
qed ();



