  }

  {
  intro /Hneq/.
  so /real_dichotomy_neq _ _ Hneq/ /Hneg | Hpos/.
    {
    rewrite /-> absr_of_nonpos/ >> autoWith /ltr_impl_leqr/.
    apply /negr_ltr'/.
    rewrite /-> negr_invol/.
    rewrite /-> negr_zero/.
    auto.
    }

    {
    rewrite /-> absr_of_nonneg/ >> autoWith /ltr_impl_leqr/.
    }
  }
qed ();



