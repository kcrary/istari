apply /absr_nonneg/.
qed ();



lemma "absr_invr"
/
  forall (x : nonzero_real) . absr (invr x) = invr (absr x) : real
/;

inference.
assert /forall x . 0 < x -> absr (invr x) = invr (absr x) : real/ /Hprop/.
  {
  inference.
  intro /x Hpos/.
  so /ltr_impl_neq _ _ Hpos/ /Hnz/.
  symmetryIn /Hnz/.
  so /absr_preserves_nonzero x Hnz/ /Hnz'/.
  rewrite /-> absr_of_nonneg/.
    {
    apply /ltr_impl_leqr/.
    apply /invr_positive/ >> auto.
    }
  compat.
  unfold /nonzero_real/.
  extensionality >> auto.
  symmetry.
  apply /absr_of_nonneg/.
  apply /ltr_impl_leqr/ >> auto.
  }
intro /x/.
destruct /x/ /x Hnz/.
unhide.
so /absr_preserves_nonzero _ Hnz/ /Hnz'/.
apply /Stable.excluded_middle_if_stable _ _ (0 <= x)/.
  {
  apply /eq_real_stable/.
  }
intro /(Hpos | Hneg)/.
  {
  apply /Hprop/.
  apply /ltr_from_leqr_neq/ >> auto.
  }

  {
  rewrite /-> not_leqr in Hneg/.
  rewrite /<- absr_negr/.
  rewrite /-> negr_dist_invr/.
  rewrite /-> Hprop/.
    {
    rewrite /<- negr_zero/.
    apply /negr_ltr/ >> auto.
    }
  compat.
  unfold /nonzero_real/.
  symmetry.
  extensionality >> auto.
  symmetry.
  apply /absr_negr/.
  }
qed ();



