  {
  contrapositive /Hnz/.
  apply /real_equality/.
  split.
  unfold /rintro, integer_to_real, rational_to_real/.
  hyp /Hnz/.
  }
clear /Hnz/.
unfold /rintro in concl at all/.
unfold /invr, timesr, integer_to_real, rational_to_real/.
unfold /rintro in Hreg at all, invr in Hreg, timesr in Hreg/.
