(* Relation to rationals *)

lemma "rational_to_real_neq"
/
  forall x y .
    x != y : rational
    -> rational_to_real x != rational_to_real y : real
/;

inference.
intro /x y Hneq/.
intro /Heq/.
witness /Hneq __/.
apply /rational_to_real_injective/ >> auto.
qed ();



lemma "rational_to_real_mono_conv"
/
  forall x y .
    rational_to_real x <= rational_to_real y
    -> x <q= y
/;

inference.
intro /x y Hleq/.
apply /not_ltq/.
intro /Hyx/.
so /rational_to_real_mono_lt _ _ Hyx/ /Hlt/.
apply /ltr_irrefl (rational_to_real x)/.
apply /leqr_ltr_trans/ >> auto.
qed ();



lemma "rational_to_real_mono_lt_conv"
/
  forall x y .
    rational_to_real x < rational_to_real y
    -> x <q y
/;

inference.
intro /x y Hlt/.
apply /not_leqq/.
intro /Hyx/.
so /rational_to_real_mono _ _ Hyx/ /Hleq/.
apply /ltr_irrefl (rational_to_real x)/.
apply /ltr_leqr_trans/ >> auto.
qed ();



lemma "rational_to_real_nonzero"
/
  forall x .
    x != q`0 : rational
    -> rational_to_real x != r`0 : real
/;

inference.
intro /x Hx/.
contrapositive /Hx/.
unfold /integer_to_real in Hx/.
exact /rational_to_real_injective _# 2 Hx/.
qed ();



lemma "invq_to_real"
/
  forall x .
    x != q`0 : rational
    -> rational_to_real (invq x) = invr (rational_to_real x) : real
/;

inference.
intro /x Hnz/.
so /rational_to_real_nonzero _ Hnz/ /Hnz'/.
assert /invr (rational_to_real x) = invr (rational_to_real x) : real/ /H/.
  {
  reflexivity.
  }
rewrite /<- timesr_id_l (invr _) in H/.
unfold /integer_to_real in H/.
rewrite /<- timesq_inverse_l x in H/ >> auto.
rewrite /-> timesq_to_real in H/.
rewrite /-> timesr_assoc in H/.
rewrite /-> timesr_inverse_r in H/.
rewrite /-> timesr_id_r in H/.
hyp /H/.
qed ();



lemma "minusq_to_real"
/
  forall x y .
    rational_to_real (x -q y) = rational_to_real x - rational_to_real y : real
/;

inference.
intro /x y/.
unfold /minusq, minusr/.
rewrite /-> plusq_to_real/.
rewrite /-> negq_to_real/.
reflexivity.
qed ();



lemma "divq_to_real"
/
  forall x y .
    y != q`0 : rational
    -> rational_to_real (x |q y) = rational_to_real x |r rational_to_real y : real
/;

inference.
intro /x y Hy/.
unfold /divq, divr/.
assert /rational_to_real y != 0 : real/ /Hnz/.
  {
  unfold /integer_to_real/.
  apply /rational_to_real_neq/ >> auto.
  }
rewrite /-> timesq_to_real/.
rewrite /-> invq_to_real/ >> auto.
qed ();



(* Relation to integers *)

lemma "integer_to_real_nonzero"
/
  forall x .
    x != z`0 : integer
    -> integer_to_real x != r`0 : real
/;

inference.
intro /x Hx/.
unfold /integer_to_real at 0 0/.
apply /rational_to_real_neq/.
apply /integer_to_rational_neq/.
auto.
qed ();



lemma "integer_to_real_mono"
/
  forall x y .
    x <z= y
    -> integer_to_real x <= integer_to_real y
/;

inference.
intro /x y Hlt/.
unfold /integer_to_real at 0 0/.
apply /rational_to_real_mono/.
apply /integer_to_rational_mono/ >> auto.
qed ();



lemma "integer_to_real_mono_lt"
/
  forall x y .
