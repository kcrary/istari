lemma "all_nonzero"
/
  forall x N .
    regular x
    -> n`0 <n N 
    -> (forall t . N <n= t -> invq (nat_to_rational N) <= absq (x t))
    -> forall t . N <n= t -> x t != 0 : rational
/;

