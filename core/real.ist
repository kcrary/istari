lemma "timesr_cancel_leqr_l"
/
  forall x y z .
    r`0 <r z
    -> z *r x <r= z *r y
    -> x <r= y
/;

inference.
intro /x y z Hposz Hler/.
so /ltr_impl_neq _# 2 Hposz/ /Hneqz/.
symmetryIn /Hneqz/.
so /timesr_leqr_l (invr z) _ _ __ Hler/ /H/.
  {
  apply /ltr_impl_leqr/.
  apply /invr_positive/ >> auto.
  }
rewrite /<- timesr_assoc in H at 0 0/.
rewrite /-> timesr_inverse_l in H at 0 0/ >> autoWith /ltr_impl_neq/.
rewrite /-> timesr_id_l in H at 0 0/.
hyp /H/.
qed ();



