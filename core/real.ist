(* Times and inverse inequalities *)

lemma "timesr_ltr_l"
/
  forall x y y' .
    0 < x
    -> y < y'
    -> x * y < x * y'
/;

inference.
intro /x y z Hx Hyz/.
unfold /ltr in Hx in Hyz/.
unfold /minusr in Hx in Hyz/.
rewrite /-> negr_zero in Hx/.
rewrite /-> plusr_id_r in Hx/.
so /timesr_positive _ _ Hx Hyz/ /H/.
rewrite /-> timesr_dist_plusr_r in H/.
rewrite /<- negr_dist_timesr_r in H/.
unfold /ltr, minusr/.
hyp /H/.
qed ();



lemma "timesr_ltr_r"
/
  forall x x' y .
    r`0 <r y
    -> x <r x'
    -> x *r y <r x' *r y
/;

inference.
intro /x y y' Hposx Hlty/.
rewrite /-> timesr_commute at 0 1/.
apply /timesr_ltr_l/ >> auto.
qed ();



lemma "timesr_leqr_l"
/
  forall x y y' .
    0 <= x
    -> y <= y'
    -> x * y <= x * y'
/;

inference.
intro /x y z Hx Hyz/.
apply /Stable.excluded_middle_if_stable _ _ (y = z : real)/.
  {
  apply /leqr_stable/.
  }
intro /(Heq | Hneqyz)/.
  {
  subst /z/.
  apply /leqr_refl/.
  }
apply /Stable.excluded_middle_if_stable _ _ (x = 0 : real)/.
  {
  apply /leqr_stable/.
  }
intro /(Heq | Hnz)/.
  {
  subst /x/.
  rewrite /-> timesr_ann_l at 0 0/.
  apply /leqr_refl/.
  }
apply /ltr_impl_leqr/.
apply /timesr_ltr_l/.
  {
  apply /ltr_from_leqr_neq/ >> auto.
  }

  {
  apply /ltr_from_leqr_neq/ >> auto.
  }
qed ();



lemma "timesr_leqr_r"
/
  forall x x' y .
    x <r= x'
    -> r`0 <r= y
    -> x *r y <r= x' *r y
/;

inference.
intro /x x' y Hx Hy/.
rewrite /-> timesr_commute at 0 1/.
apply /timesr_leqr_l/ >> auto.
qed ();



lemma "timesr_leqr"
/
  forall x x' y y' .
    0 <= x
    -> 0 <= y
    -> x <= x'
    -> y <= y'
    -> x * y <= x' * y'
/;

inference.
intro /x x' y y' Hposx Hposy Hleqx Hleqy/.
apply /leqr_trans _ (x * y')/.
  {
  apply /timesr_leqr_l/ >> auto.
  }

  {
  apply /timesr_leqr_r/ >> auto.
  apply /leqr_trans/ >> auto.
  }
qed ();



lemma "timesr_ltr_leqr"
/
  forall x y x' y' .
    r`0 <r= x
    -> r`0 <r y
    -> x <r x'
    -> y <r= y'
    -> x *r y <r x' *r y'
/;

inference.
intro /x y x' y' Hposx Hposy Hx Hy/.
apply /leqr_ltr_trans _ (x *r y')/.
  {
  apply /timesr_leqr_l/ >> auto.
  }

  {
  apply /timesr_ltr_r/ >> auto.
  apply /ltr_leqr_trans/ >> auto.
  }
qed ();



lemma "timesr_leqr_ltr"
/
  forall x y x' y' .
    r`0 <r x
    -> r`0 <r= y
    -> x <r= x'
    -> y <r y'
    -> x *r y <r x' *r y'
/;

inference.
intro /x y x' y' Hposx Hposy Hx Hy/.
apply /ltr_leqr_trans _ (x *r y')/.
  {
  apply /timesr_ltr_l/ >> auto.
  }

  {
  apply /timesr_leqr_r/ >> auto.
  apply /leqr_trans/ >> autoWith /ltr_impl_leqr/.
  }
qed ();



lemma "timesr_ltr"
/
  forall x y x' y' .
    r`0 <r= x
    -> r`0 <r= y
    -> x <r x'
    -> y <r y'
    -> x *r y <r x' *r y'
/;

inference.
intro /x y x' y' Hposx Hposy Hx Hy/.
apply /leqr_ltr_trans _ (x *r y')/.
  {
  apply /timesr_leqr_l/ >> autoWith /ltr_impl_leqr/.
  }

  {
  apply /timesr_ltr_r/ >> auto.
  apply /leqr_ltr_trans/ >> auto.
  }
qed ();



aliasExport /timesr_leqr_pos_pos/ /timesr_leqr/;



lemma "timesr_leqr_neg_neg"
/
  forall x x' y y' .
    x' <r= r`0
    -> y' <r= r`0
    -> x <r= x'
    -> y <r= y'
    -> x' *r y' <r= x *r y
/;

inference.
intro /x x' y y' Hposx Hposy Hx Hy/.
apply /negr_leqr'/.
apply /negr_leqr'/.
rewrite /-> negr_dist_timesr_l/.
rewrite /-> negr_dist_timesr_r/.
rewrite /-> negr_dist_timesr_l/.
rewrite /-> negr_dist_timesr_r/.
apply /timesr_leqr/ >> autoWith /negr_leqr/.
  {
  rewrite /<- negr_zero/.
  apply /negr_leqr/ >> auto.
  }

  {
  rewrite /<- negr_zero/.
  apply /negr_leqr/ >> auto.
  }
qed ();



lemma "timesr_leqr_pos_neg"
/
  forall x x' y y' .
    r`0 <r= x
    -> y' <r= r`0
    -> x <r= x'
    -> y <r= y'
    -> x' *r y <r= x *r y'
/;

inference.
intro /x x' y y' Hposx Hposy Hx Hy/.
apply /negr_leqr'/.
rewrite /-> negr_dist_timesr_r/.
rewrite /-> negr_dist_timesr_r/.
apply /timesr_leqr/ >> autoWith /negr_leqr/.
  {
  rewrite /<- negr_zero/.
  apply /negr_leqr/ >> auto.
  }
qed ();



lemma "timesr_leqr_neg_pos"
/
  forall x x' y y' .
    x' <r= r`0
    -> r`0 <r= y
    -> x <r= x'
    -> y <r= y'
    -> x *r y' <r= x' *r y
/;

inference.
intro /x x' y y' Hposx Hposy Hx Hy/.
rewrite /-> timesr_commute at 0 1/.
