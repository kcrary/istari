lemma "minq_dist_maxq_l"
/
  forall a b c . minq (maxq a b) c = maxq (minq a c) (minq b c) : rational
/;

inference.
intro /a b c/.
revert /a b/.
assert /forall a b . a <q= b -> minq (maxq a b) c = maxq (minq a c) (minq b c) : rational/ /H/.
  {
  inference.
  intro /a b Hab/.
  rewrite /-> maxq_eq_r a b/ >> auto.
  so /rational_dichotomy_weak b c/ /Hbc | Hcb/.
    {
    rewrite /-> minq_eq_l b c at all/ >> auto.
    rewrite /-> minq_eq_l a c/ >> autoWith /leqq_trans/.
    rewrite /-> maxq_eq_r/ >> auto.
    }

    {
    rewrite /-> minq_eq_r b c at all/ >> auto.
    so /rational_dichotomy_weak a c/ /Hac | Hca/.
      {
      rewrite /-> minq_eq_l/ >> auto.
      rewrite /-> maxq_eq_r/ >> auto.
      }

      {
      rewrite /-> minq_eq_r/ >> auto.
      symmetry.
      apply /maxq_idem/.
      }
    }
  }
intro /a b/.
so /rational_dichotomy_weak a b/ /Hab | Hba/.
  {
  apply /H/ >> auto.
  }

  {
  rewrite /-> maxq_commute at 0 1/.
  apply /H/ >> auto.
  }
qed ();



