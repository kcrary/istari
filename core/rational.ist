/;

intro /x y/.
apply /Stable.decidable_impl_stable/.
apply /ltq_decide/.
qed ();



lemma "rational_trichotomy"
/
  forall x y .
    x <q y % x = y : rational % y <q x
/;

inference.
intro /x y/.
so /rational_representative x/ /[Hx]/.
so /rational_representative y/ /[Hy]/.
unfold /ltq at 0 0/.
boolCase /x <q? y/ /Hlt/.
  {
  left.
  apply /Bool.istrue_true/.
  }
boolCase /y <q? x/ /Hgt/.
  {
  right >> right.
