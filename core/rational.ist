rewrite /-> plusq_commute at 0 1/.
hyp /Heq/.
qed ();



lemma "plusq_shift_lll"
/
  forall x y z .
    x = y +q z : rational <-> ~q y +q x = z : rational
/;

inference.
intro /x y z/.
split.
  {
  intro /Heq/.
  apply /plusq_cancel_l _ _ y/.
  rewrite /<- plusq_assoc/.
  rewrite /-> plusq_inverse_r/.
  rewrite /-> plusq_id_l/.
  hyp /Heq/.
  }

  {
  intro /Heq/.
  apply /plusq_cancel_l _ _ (~q y)/.
  rewrite /<- plusq_assoc/.
  rewrite /-> plusq_inverse_l/.
  rewrite /-> plusq_id_l/.
  hyp /Heq/.
  }
qed ();



