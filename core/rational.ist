lemma "minq_commute"
/
  forall a b . minq a b = minq b a : rational
/;

inference.
intro /a b/.
unfold /minq at all/.
boolCase /leqqb a b/ /Hab/ >> boolCase /leqqb b a/ /Hba/ >> attempt reflexivity.
  {
  apply /leqq_antisymm/ >> auto.
  }

  {
  so /Hab __/ /0/.
  rewrite /-> not_leqq in Hba/.
  apply /ltq_impl_leqq/ >> auto.
  }
qed ();



lemma "maxq_commute"
/
  forall a b . maxq a b = maxq b a : rational
/;

inference.
intro /a b/.
rewrite /-> maxq_as_minq at all/.
compat.
apply /minq_commute/.
qed ();



lemma "minq_assoc"
/
  forall a b c . minq (minq a b) c = minq a (minq b c) : rational
/;

inference.
intro /a b c/.
unfold /minq at all/.
boolCase /leqqb b c/ /Hbc/ >> reduce // >> boolCase /leqqb a b/ /Hab/ >> attempt reflexivity >> reduce //.
  {
  boolCase /leqqb a c/ /Hac/.
    {
    reflexivity.
    }
  so /Hac __/ /0/.
  apply /leqq_trans/ >> auto.
  }

  {
  boolCase /leqqb b c/ /Hbc'/.
    {
    reflexivity.
    }
  so /Hbc' Hbc/ /0/.
  }

  {
  boolCase /leqqb b c/ /Hbc'/.
    {
    so /Hbc Hbc'/ /0/.
    }
  boolCase /leqqb a c/ /Hac/.
  1:{
    reflexivity.
    }
  rewrite /-> not_leqq in Hbc/.
  rewrite /-> not_leqq in Hab/.
  apply /leqq_antisymm/ >> auto.
  apply /ltq_impl_leqq/.
  apply /ltq_trans/ >> auto.
  }
qed ();



lemma "maxq_assoc"
/
  forall a b c . maxq (maxq a b) c = maxq a (maxq b c) : rational
/;

inference.
intro /a b c/.
rewrite /-> maxq_as_minq at all/.
rewrite /-> negq_invol at all/.
compat.
apply /minq_assoc/.
qed ();





