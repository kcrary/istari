rewrite /-> Bool.notb_invol/.
reflexivity.
qed ();



lemma "notb_leqqb"
/
  forall x y .
    Bool.notb (leqqb x y) = ltqb y x : bool
/;

inference.
intro /x y/.
so /rational_representative x/ /[Hx]/.
so /rational_representative y/ /[Hy]/.
unhide.
destruct /Hx/ /x' Hx ?/.
destruct /Hy/ /y' Hy ?/.
subst /x y/.
unfold /qintro at all/.
unfold /leqqb, ltqb/.
apply /notb_leqzb/.
qed ();



lemma "notb_ltqb"
/
  forall x y .
    Bool.notb (ltqb x y) = leqqb y x : bool
/;

inference.
intro /x y/.
rewrite /<- notb_leqqb/.
apply /Bool.notb_invol/.
qed ();



lemma "not_leqq"
/
  forall x y .
    not (x <q= y) <-> y <q x
/;

inference.
intro /x y/.
unfold /leqq, ltq/.
rewrite /<- Bool.istrue_notb/.
rewrite /-> notb_leqqb/.
reflexivity.
qed ();



lemma "not_ltq"
/
