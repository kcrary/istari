(* Effective comparisons *)

lemma "notb_eqqb"
/
  forall x y .
    Bool.notb (eqqb x y) = neqqb x y : bool
/;

inference.
intro /x y/.
unfold /neqqb/.
reflexivity.
qed ();



lemma "notb_neqqb"
/
  forall x y .
