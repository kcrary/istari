  rewrite /-> Integer.maxz_eq_l/ >> auto.
  rewrite /-> maxq_eq_l/ >> auto.
  apply /integer_to_rational_mono/ >> auto.
  }
intro /m n/.
so /Integer.integer_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
rewrite /-> Integer.maxz_commute/.
rewrite /-> maxq_commute/.
apply /H/ >> auto.
qed ();



(* Floor and Ceiling *)

define /floor x/
/
  divz (x #1) (x #2)
//
  rational -> integer
/;

introOf /x/.
unfold /rational in x/.
destruct /x/ /[x x' Hx]/.
destruct /x/ /a b/.
destruct /x'/ /a' b'/.
reduce /Hx/.
destruct /Hx/ /Hb Hb' Heq/.
unfold /floor at 0 0/.
reduce //.
assert /b != z`0 : integer/ /Hnonzerob/.
  {
  omega.
  }
assert /b' != z`0 : integer/ /Hnonzerob'/.
  {
  omega.
  }
so /divz_spec a' b'/ /H/.
revert /H/.
so /divz_spec a b/ /H/.
revert /H/.
so /modz_spec a' b'/ /H/.
revert /H/.
so /modz_spec a b/ /H/.
revert /H/.
generalize /divz a b/ /_/ /q/.
generalize /divz a' b'/ /_/ /q'/.
generalize /modz a b/ /_/ /r/.
generalize /modz a' b'/ /_/ /r'/.
intro /(Hrlo Hrhi) (Hrlo' Hrhi') Hq Hq'/.
so /timesz_compat _ _ b' b' Hq ()/ /H/.
rewrite /-> timesz_dist_plusz_l in H/.
rewrite /-> Heq in H/.
rewrite /-> plusz_commute in H/.
rewrite /-> plusz_shift_rrr in H/.
witness /division_unique a' b' q q' (a' +z ~z (q *z b')) r' __ __ __ __ __ __ #1/ >> auto.
  {
  rewrite /-> plusz_commute at 1/.
  rewrite /<- plusz_assoc/.
  rewrite /-> plusz_inverse_r/.
  rewrite /-> plusz_id_l/.
  reflexivity.
  }

  {
  apply /timesz_cancel_leqz_r _ _ b/ >> auto.
  rewrite /-> timesz_ann_l/.
  rewrite /-> timesz_dist_plusz_l/.
  rewrite /<- negz_dist_timesz_l/.
  rewrite /-> timesz_assoc/.
  rewrite /-> timesz_commute at 2/.
  rewrite /<- timesz_assoc/.
  rewrite /<- H/.
  apply /timesz_leqz_zero_pos_pos/ >> autoWith /ltz_impl_leqz/.
  }

  {
  apply /timesz_cancel_ltz_r _ _ b/ >> auto.
  rewrite /-> timesz_dist_plusz_l/.
  rewrite /<- negz_dist_timesz_l/.
  rewrite /-> timesz_assoc/.
  rewrite /-> timesz_commute at 2/.
  rewrite /<- timesz_assoc/.
  rewrite /<- H/.
  rewrite /-> timesz_commute at 1/.
  rewrite /-> absz_of_nonneg/ >> autoWith /ltz_impl_leqz/.
  rewrite /-> absz_of_nonneg in Hrhi/ >> autoWith /ltz_impl_leqz/.
  apply /timesz_ltz_r/ >> auto.
  }
qed ();



lemma "floor_lb"
/
  forall x . integer_to_rational (floor x) <q= x
/;

inference.
intro /x/.
so /rational_representative x/ /[Hx]/.
unhide.
destruct /Hx/ /(a b) Hx ?/.
subst /x/.
reduce /Hx/.
assert /b != z`0 : integer/ /Hnonzerob/.
  {
  omega.
  }
apply /rational_leqq/.
split.
unfold /qintro at all, floor, integer_to_rational at all/.
reduce //.
rewrite /-> timesz_id_r/.
rewrite /<- divz_spec a b at 1/.
rewrite /<- plusz_id_r (_ *z _)/.
apply /plusz_leqz/ >> auto.
apply /modz_nonneg/.
qed ();



lemma "floor_glb"
/
  forall x y . 
    integer_to_rational y <q= x 
    -> y <z= floor x
/;

inference.
intro /x y Hyx/.
so /rational_representative x/ /[Hx]/.
unhide.
destruct /Hx/ /(a b) Hx ?/.
subst /x/.
reduce /Hx/.
assert /b != z`0 : integer/ /Hnonzerob/.
  {
  omega.
  }
so /leqq_invert _# 2 Hyx/ /H/.
unfold /integer_to_rational in H at all, qintro in H at all/.
destruct /H/ /[Hleq]/.
unhide.
rewrite /-> timesz_id_r in Hleq/.
unfold /qintro, floor/.
reduce //.
rewrite /<- divz_spec a b in Hleq/.
apply /timesz_cancel_leqz_r_remainder _ _ b (modz a b)/ >> auto.
rewrite /<- absz_of_nonneg b at 1/ >> autoWith /ltz_impl_leqz/.
apply /modz_ltz_r/.
qed ();



define /ceiling x/
/
  negz (floor (negq x))
//
  rational -> integer
/;

unfold /ceiling/.
typecheck.
qed ();



lemma "ceiling_ub"
/
  forall x . x <q= integer_to_rational (ceiling x)
/;

inference.
intro /x/.
unfold /ceiling/.
rewrite /-> negz_to_rational/.
rewrite /<- negq_invol x/.
apply /negq_leqq/.
apply /floor_lb/.
qed ();



lemma "ceiling_lub"
/
  forall x y .
    x <q= integer_to_rational y
    -> ceiling x <z= y
/;

inference.
intro /x y Hxy/.
unfold /ceiling/.
rewrite /<- negz_invol y/.
apply /negz_leqz/.
apply /floor_glb/.
rewrite /-> negz_to_rational/.
apply /negq_leqq/ >> auto.
qed ();



lemma "floor_mono"
/
  forall x y .
    x <q= y
    -> floor x <z= floor y
/;

inference.
intro /x y Hxy/.
apply /floor_glb/.
apply /leqq_trans/ >> auto.
apply /floor_lb/.
qed ();



lemma "ceiling_mono"
/
  forall x y .
    x <q= y
    -> ceiling x <z= ceiling y
/;

inference.
intro /x y Hxy/.
apply /ceiling_lub/.
apply /leqq_trans/ >> auto.
apply /ceiling_ub/.
qed ();



lemma "floor_integer_to_rational"
/
  forall x .
    floor (integer_to_rational x) = x : integer
/;

inference.
intro /x/.
apply /leqz_antisymm/.
  {
  apply /integer_to_rational_mono_conv/.
  apply /floor_lb/.
  }

  {
  apply /floor_glb/.
  apply /leqq_refl/.
  }
qed ();



lemma "ceiling_integer_to_rational"
/
  forall x .
    ceiling (integer_to_rational x) = x : integer
/;

inference.
intro /x/.
apply /leqz_antisymm/.
  {
  apply /ceiling_lub/.
  apply /leqq_refl/.
  }

  {
  apply /integer_to_rational_mono_conv/.
  apply /ceiling_ub/.
  }
qed ();



lemma "floor_plus_r"
/
  forall x y .
    floor (x +q integer_to_rational y) = floor x +z y : integer
/;

inference.
intro /x y/.
apply /leqz_antisymm/.
  {
  apply /plusz_shift_leqz_lrr/.
  apply /floor_glb/.
  rewrite /-> plusz_to_rational/.
  rewrite /-> negz_to_rational/.
  apply /plusq_shift_leqq_lrr/.
  apply /floor_lb/.
  }

  {
  apply /floor_glb/.
  rewrite /-> plusz_to_rational/.
  apply /plusq_leqq/.
    {
    apply /floor_lb/.
    }

    {
    apply /leqq_refl/.
    }
  }
qed ();



lemma "floor_plus_l"
/
  forall x y .
    floor (integer_to_rational y +q x) = y +z floor x : integer
/;

inference.
intro /x y/.
rewrite /-> plusz_commute/.
rewrite /-> plusq_commute/.
apply /floor_plus_r/.
qed ();



lemma "ceiling_plus_r"
/
  forall x y .
    ceiling (x +q integer_to_rational y) = ceiling x +z y : integer
/;

inference.
intro /x y/.
unfold /ceiling at 0 0/.
rewrite /<- negz_invol y at 1/.
rewrite /<- negz_plusz/.
compat.
rewrite /-> negq_plusq/.
rewrite /<- negz_to_rational/.
apply /floor_plus_r/.
qed ();



lemma "ceiling_plus_l"
/
  forall x y .
    ceiling (integer_to_rational y +q x) = y +z ceiling x : integer
/;

inference.
intro /x y/.
rewrite /-> plusz_commute/.
rewrite /-> plusq_commute/.
apply /ceiling_plus_r/.
qed ();



lemma "floor_mono_lt"
/
  forall x y .
    q`1 +q x <q= y
    -> floor x <z floor y
/;

inference.
intro /x y Hq/.
so /floor_mono _# 2 Hq/ /Hz/.
rewrite /-> floor_plus_l in Hz/.
unfold /ltz/.
hyp /Hz/.
qed ();



lemma "ceiling_mono_lt"
/
  forall x y .
    q`1 +q x <q= y
    -> ceiling x <z ceiling y
/;

inference.
intro /x y Hq/.
so /ceiling_mono _# 2 Hq/ /Hz/.
rewrite /-> ceiling_plus_l in Hz/.
unfold /ltz/.
hyp /Hz/.
qed ();



lemma "floor_negq"
/
  forall x . floor (negq x) = negz (ceiling x) : integer
/;

inference.
intro /x/.
unfold /ceiling/.
rewrite /-> negz_invol/.
reflexivity.
qed ();



lemma "ceiling_negq"
/
  forall x . ceiling (negq x) = negz (floor x) : integer
/;

inference.
intro /x/.
unfold /ceiling/.
rewrite /-> negq_invol/.
reflexivity.
qed ();



lemma "floor_nonneg"
/
  forall x .
    q`0 <q= x
    -> z`0 <z= floor x
/;

inference.
intro /x Hleq/.
apply /floor_glb/ >> auto.
qed ();



lemma "floor_nonpos"
/
  forall x .
    x <q= q`0
    -> floor x <z= z`0
/;

inference.
intro /x Hleq/.
apply /integer_to_rational_mono_conv/.
apply /leqq_trans/ >> auto.
apply /floor_lb/.
qed ();



lemma "ceiling_nonneg"
/
  forall x .
    q`0 <q= x
    -> z`0 <z= ceiling x
/;

inference.
intro /x Hleq/.
apply /integer_to_rational_mono_conv/.
apply /leqq_trans/ >> auto.
apply /ceiling_ub/.
qed ();



lemma "ceiling_nonpos"
/
  forall x .
    x <q= q`0
    -> ceiling x <z= z`0
/;

inference.
intro /x Hleq/.
apply /ceiling_lub/ >> auto.
qed ();



lemma "floor_from_bounds"
/
  forall x y .
    integer_to_rational x <q= y
    -> y <q integer_to_rational (z`1 +z x)
    -> floor y = x : integer
/;

inference.
intro /x y Hlo Hhi/.
apply /leqz_antisymm/.
1:{
  apply /floor_glb/ >> auto.
  }
apply /not_ltz/.
unfold /ltz/.
intro /H/.
apply /ltq_irrefl (integer_to_rational (floor y))/.
apply /leqq_ltq_trans _ y/.
  {
  apply /floor_lb/.
  }
apply /ltq_leqq_trans/ >> auto.
apply /integer_to_rational_mono/ >> auto.
qed ();



lemma "ceiling_from_bounds"
/
  forall x y .
    y <q= integer_to_rational x
    -> integer_to_rational (z`-1 +z x) <q y
    -> ceiling y = x : integer
/;

inference.
intro /x y Hhi Hlo/.
apply /leqz_antisymm/.
  {
  apply /ceiling_lub/ >> auto.
  }
apply /not_ltz/.
unfold /ltz/.
intro /H/.
apply /ltq_irrefl (integer_to_rational (ceiling y))/.
apply /ltq_leqq_trans _ y/.
1:{
  apply /ceiling_ub/.
  }
apply /leqq_ltq_trans/ >> auto.
apply /integer_to_rational_mono/.
apply /plusz_shift_leqz_rll z`1/ >> auto.
qed ();



lemma "floor_ceiling_leqz"
/
  forall x .
    floor x <z= ceiling x
/;

inference.
intro /x/.
apply /integer_to_rational_mono_conv/.
apply /leqq_trans _ x/.
  {
  apply /floor_lb/.
  }

  {
  apply /ceiling_ub/.
  }
qed ();



endModule ();
