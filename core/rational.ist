intro /x y z/.
rewrite /-> plusq_commute at 1/.
apply /plusq_shift_leqq_lll/.
qed ();



lemma "plusq_shift_leqq_lrl"
/
  forall x y z .
    x <q= y +q z <-> ~q z +q x <q= y
/;

inference.
intro /x y z/.
rewrite /-> plusq_commute at 0/.
apply /plusq_shift_leqq_lll/.
qed ();



lemma "plusq_shift_leqq_rrr"
/
  forall x y z .
    x +q y <q= z <-> x <q= z +q ~q y
/;

inference.
intro /x y z/.
symmetry.
rewrite /-> plusq_commute at 0 1/.
rewrite /<- negq_invol y at 1/.
apply /plusq_shift_leqq_lll/.
qed ();



lemma "plusq_shift_leqq_rll"
/
  forall x y z .
    x +q y <q= z <-> y <q= ~q x +q z
/;

inference.
intro /x y z/.
rewrite /-> plusq_commute at 0 1/.
apply /plusq_shift_leqq_rrr/.
qed ();



