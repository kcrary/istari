(* Miscellaneous *)

lemma "ltq_0_1"
/
  q`0 <q q`1
/;

apply /integer_to_rational_mono_lt/.
apply /ltz_0_1/.
qed ();



lemma "leqq_0_1"
/
  q`0 <q= q`1
/;

apply /ltq_impl_leqq/.
apply /ltq_0_1/.
qed ();



lemma "ltq_neg1_0"
/
  q`-1 <q q`0
/;

apply /integer_to_rational_mono_lt/.
apply /ltz_neg1_0/.
qed ();



lemma "leqq_neg1_0"
/
  q`-1 <q= q`0
/;

apply /ltq_impl_leqq/.
apply /ltq_neg1_0/.
qed ();



lemma "neqq_neg1_0"
/
  q`-1 != q`0 : rational
/;

apply /ltq_impl_neq/.
apply /ltq_neg1_0/.
qed ();



lemma "rational_dense"
/
  forall a b .
    a <q b
    -> exists c .
         a <q c & c <q b
/;

inference.
intro /a b Hab/.
exists /(a +q b) |q q`2/.
split.
  {
  unfold /divq/.
  apply /leqq_ltq_trans _ (q`2 *q a *q invq q`2)/.
    {
    rewrite /-> timesq_commute/.
    rewrite /<- timesq_assoc/.
    rewrite /-> timesq_inverse_l/.
      {
      apply /integer_to_rational_neq/.
      omega.
      }
    rewrite /-> timesq_id_l/.
    apply /leqq_refl/.
    }

    {
    apply /timesq_ltq_r/.
      {
      apply /invq_positive/.
      apply /integer_to_rational_mono_lt/.
      omega.
      }
    rewrite /-> plusz_to_rational z`1 z`1/.
    rewrite /-> timesq_dist_plusq_l/.
    rewrite /-> timesq_id_l at all/.
    apply /plusq_ltq_r/ >> auto.
    apply /leqq_refl/.
    }
  }

  {
  unfold /divq/.
  apply /ltq_leqq_trans _ (q`2 *q b *q invq q`2)/.
  1:{
    rewrite /-> timesq_commute/.
    rewrite /<- timesq_assoc/.
    rewrite /-> timesq_inverse_l/.
      {
      apply /integer_to_rational_neq/.
      omega.
      }
    rewrite /-> timesq_id_l/.
    apply /leqq_refl/.
    }

    {
    apply /timesq_ltq_r/.
      {
      apply /invq_positive/.
      apply /integer_to_rational_mono_lt/.
      omega.
      }
    rewrite /-> plusz_to_rational z`1 z`1/.
    rewrite /-> timesq_dist_plusq_l/.
    rewrite /-> timesq_id_l at all/.
    apply /plusq_ltq_l/ >> auto.
    apply /leqq_refl/.
    }
  }
qed ();



lemma "leqq_from_upper_bounds"
/
  forall x y .
    (forall z . y <q z -> x <q= z)
    -> x <q= y
/;

inference.
intro /x y Hub/.
apply /not_ltq/.
intro /Hyx/.
so /rational_dense _# 2 Hyx/ /z Hyz Hzx/.
so /Hub _ Hyz/ /Hxz/.
so /ltq_irrefl _ (ltq_leqq_trans _# 3 Hzx Hxz)/ /0/.
qed ();



lemma "rational_total"
/
  Partial.total rational
/;

unfold /rational/.
RuleTactic.quotientTotal >> auto.
fold /rational/.
typecheck.
qed ();



lemma "rational_strict"
/
  Partial.strict rational
/;

so /rational_total/ /H/.
unfold /Partial.total in H/.
exact /H #1/.
qed ();



(* Absolute value *)

structure Nothing = AfterRationalTests ();



define /absq a/
/
  if q`0 <q=? a then a else negq a
//
  rational -> rational
/;

unfold /absq/.
typecheck.
qed ();



lemma "absq_nonneg"
/
  forall a . q`0 <q= absq a
/;

inference.
intro /a/.
unfold /absq/.
boolCase /q`0 <q=? a/ /Ha/ >> auto.
rewrite /<- negq_zero/.
apply /negq_leqq/.
apply /ltq_impl_leqq/ >> auto.
apply /not_leqq/ >> auto.
qed ();



lemma "absq_of_nonneg"
/
  forall a . q`0 <q= a -> absq a = a : rational
/;

inference.
intro /a Hpos/.
unfold /absq/.
boolEq true /q`0 <q=? a/ >> auto.
qed ();



lemma "absq_of_nonpos"
/
  forall a . a <q= q`0 -> absq a = negq a : rational
/;

inference.
intro /a Hneg/.
unfold /absq/.
boolCase /q`0 <q=? a/ /Hpos/ >> auto.
so /leqq_antisymm _# 2 Hneg Hpos/ /H/.
subst /a/.
rewrite /-> negq_zero/.
reflexivity.
qed ();



lemma "absq_ub"
/
  forall x . x <q= absq x
/;

inference.
intro /x/.
so /rational_dichotomy_weak q`0 x/ /Hpos | Hneg/.
  {
  rewrite /-> absq_of_nonneg/ >> autoWith /leqq_refl/.
  }

  {
  rewrite /-> absq_of_nonpos/ >> auto.
  apply /leqq_trans _ q`0/ >> auto.
  apply /negq_leqq'/.
  rewrite /-> negq_invol/.
  rewrite /-> negq_zero/.
  auto.
  }
qed ();



lemma "absq_idem"
/
  forall x . absq (absq x) = absq x : rational
/;

inference.
intro /x/.
rewrite /-> absq_of_nonneg/ >> auto.
apply /absq_nonneg/.
qed ();



lemma "absq_negq"
/
  forall a . absq (negq a) = absq a : rational
/;

inference.
intro /a/.
so /rational_dichotomy_weak q`0 a/ /Ha | Ha/.
  {
  rewrite /-> absq_of_nonneg at 1/ >> auto.
  rewrite /-> absq_of_nonpos/.
    {
    rewrite /<- negq_zero/.
    apply /negq_leqq/ >> auto.
    }

    {
    apply /negq_invol/.
    }
  }

  {
  rewrite /-> absq_of_nonneg/ >> auto.
    {
    rewrite /<- negq_zero/.
    apply /negq_leqq/ >> auto.
    }
  rewrite /-> absq_of_nonpos/ >> auto.
  }
qed ();



lemma "absq_timesq"
/
  forall a b .
    absq (a *q b) = absq a *q absq b : rational
/;

inference.
assert /forall a b . q`0 <q= a -> q`0 <q= b -> absq (a *q b) = absq a *q absq b : rational/ /Hprop/.
  {
  inference.
  intro /a b Ha Hb/.
  unfold /absq at all/.
  boolEq true /q`0 <q=? a/ >> auto.
  boolEq true /q`0 <q=? b/ >> auto.
  boolEq true /q`0 <q=? a *q b/ >> auto.
  rewrite /<- timesq_ann_l q`0/.
  apply /timesq_leqq/ >> autoWith /leqq_refl/.
  }
intro /a b/.
so /rational_dichotomy q`0 a/ /Ha | Ha/.
  {
  so /rational_dichotomy q`0 b/ /Hb | Hb/ >> auto.
    {
    so /ltq_impl_leqq _ _ (negq_ltq _# 2 Hb)/ /Hb'/.
    rewrite /-> negq_zero in Hb'/.
    rewrite /<- absq_negq/.
    rewrite /-> negq_dist_timesq_r/.
    rewrite /-> Hprop/ >> auto.
    rewrite /-> absq_negq/ >> auto.
    }
  }
so /ltq_impl_leqq _ _ (negq_ltq _# 2 Ha)/ /Ha'/.
rewrite /-> negq_zero in Ha'/.
so /rational_dichotomy q`0 b/ /Hb | Hb/ >> auto.
  {
  rewrite /<- absq_negq/.
  rewrite /-> negq_dist_timesq_l/.
  rewrite /-> Hprop/ >> auto.
  rewrite /-> absq_negq/ >> auto.
  }

  {
  so /ltq_impl_leqq _ _ (negq_ltq _# 2 Hb)/ /Hb'/.
  rewrite /-> negq_zero in Hb'/.
  rewrite /<- absq_negq/.
  rewrite /<- absq_negq/.
  rewrite /-> negq_dist_timesq_l/.
  rewrite /-> negq_dist_timesq_r/.
  rewrite /-> Hprop/ >> auto.
  rewrite /-> absq_negq at 0 0/ >> auto.
  }
qed ();



lemma "absq_plusq_leqq"
/
  forall a b . absq (a +q b) <q= absq a +q absq b
/;

inference.
intro /a b/.
unfold /absq at all/.
boolCase /q`0 <q=? a/ /Ha/.
  {
  boolCase /q`0 <q=? b/ /Hb/.
    {
    boolEq true /q`0 <q=? a +q b/.
      {
      rewrite /<- plusq_id_l q`0/.
      apply /plusq_leqq/ >> auto.
      }
    apply /leqq_refl/.
    }

    {
    rewrite /-> not_leqq in Hb/.
    boolCase /q`0 <q=? a +q b/ /Hab/.
      {
      apply /plusq_leqq/.
        {
        apply /leqq_refl/.
        }

        {
        apply /leqq_trans _ q`0/ >> autoWith /ltq_impl_leqq/.
        rewrite /<- negq_zero/.
        apply /negq_leqq/.
        apply /ltq_impl_leqq/ >> auto.
        }
      }

      {
      rewrite /-> negq_plusq/.
      apply /plusq_leqq/ >> autoWith /leqq_refl/.
      apply /leqq_trans _ q`0/ >> auto.
      rewrite /<- negq_zero/.
      apply /negq_leqq/ >> auto.
      }
    }
  }

  {
  rewrite /-> not_leqq in Ha/.
  boolCase /q`0 <q=? b/ /Hb/.
    {
    boolCase /q`0 <q=? a +q b/ /Hab/.
      {
      apply /plusq_leqq/ >> autoWith /leqq_refl/.
      apply /leqq_trans _ q`0/.
        {
        apply /ltq_impl_leqq/ >> auto.
        }

        {
        rewrite /<- negq_zero/.
        apply /negq_leqq/.
        apply /ltq_impl_leqq/ >> auto.
        }
      }

      {
      rewrite /-> not_leqq in Hab/.
      rewrite /-> negq_plusq/.
      apply /plusq_leqq/ >> autoWith /leqq_refl/.
      apply /leqq_trans _ q`0/ >> auto.
      rewrite /<- negq_zero/.
      apply /negq_leqq/ >> auto.
      }
    }

    {
    rewrite /-> not_leqq in Hb/.
    boolEq false /q`0 <q=? a +q b/.
      {
      apply /not_leqq/.
      rewrite /<- plusq_id_l q`0/.
      apply /plusq_ltq/ >> auto.
      }
    rewrite /-> negq_plusq/.
    apply /leqq_refl/.
    }
  }
qed ();



lemma "absq_minusq_leqq"
/
  forall a b . absq (a -q b) <q= absq a +q absq b
/;

inference.
intro /a b/.
unfold /minusq/.
rewrite /<- absq_negq b/.
apply /absq_plusq_leqq/.
qed ();



lemma "absz_to_rational"
/
  forall a . integer_to_rational (absz a) = absq (integer_to_rational a) : rational
/;

inference.
intro /a/.
so /integer_dichotomy_weak z`0 a/ /Ha | Ha/.
  {
  rewrite /-> absz_of_nonneg/ >> auto.
  rewrite /-> absq_of_nonneg/ >> auto.
  apply /integer_to_rational_mono/ >> auto.
  }

  {
  rewrite /-> absz_of_nonpos/ >> auto.
  rewrite /-> absq_of_nonpos/.
    {
    apply /integer_to_rational_mono/ >> auto.
    }
  apply /negz_to_rational/.
  }
qed ();



lemma "absq_zero"
/
  absq q`0 = q`0 : rational
/;

apply /absq_of_nonneg/.
apply /leqq_refl/.
qed ();



lemma "absq_one"
/
  absq q`1 = q`1 : rational
