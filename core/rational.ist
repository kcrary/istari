apply /absq_of_nonneg/.
apply /leqq_0_1/.
qed ();



lemma "absq_minus_one"
/
  absq q`-1 = q`1 : rational
/;

rewrite /-> absq_of_nonpos/.
  {
  apply /leqq_neg1_0/.
  }

  {
  rewrite /<- negz_to_rational/.
  reduce //.
  reflexivity.
  }
qed ();



lemma "absq_minusq_commute"
/
  forall a b .
    absq (a -q b) = absq (b -q a) : rational
/;

inference.
intro /a b/.
rewrite /<- absq_negq/.
rewrite /-> negq_minusq/.
reflexivity.
qed ();



lemma "absq_minusq_upper_bound"
/
  forall a b c .
    absq (a -q b) <q= c
    -> a <q= b +q c
/;

intro /a b c Hleq/.
rewrite /-> plusq_shift_leqq_lll/.
rewrite /-> plusq_commute/.
fold /minusq _ _/.
so /rational_dichotomy_weak (a -q b) q`0/ /Hnonpos | Hnonneg/.
  {
  apply /leqq_trans _ q`0/ >> auto.
  apply /leqq_trans _ (absq (a -q b))/ >> auto.
  apply /absq_nonneg/.
  }

  {
  rewrite /-> absq_of_nonneg in Hleq/ >> auto.
  }
qed ();



lemma "absq_minusq_lower_bound"
/
  forall a b c .
    absq (a -q b) <q= c
    -> b -q c <q= a
/;

intro /a b c Hleq/.
unfold /minusq/.
rewrite /<- plusq_shift_leqq_lrr/.
apply /absq_minusq_upper_bound/.
rewrite /-> absq_minusq_commute/.
hyp /Hleq/.
qed ();



lemma "absq_minusq_absq"
/
  forall a b .
    absq (absq a -q absq b) <q= absq (a -q b)
/;

inference.
assert /forall a b . q`0 <q= a -> b <q= q`0 -> absq (absq a -q absq b) <q= absq (a -q b)/ /Hacross/.
  {
  inference.
  intro /a b Hposa Hnegb/.
  rewrite /-> absq_of_nonneg at 1/ >> auto.
  rewrite /-> absq_of_nonpos at 1/ >> auto.
  unfold /minusq/.
  rewrite /-> negq_invol/.
  rewrite /-> absq_of_nonneg at 1/.
    {
    unfold /minusq/.
    rewrite /<- plusq_id_l q`0/.
    apply /plusq_leqq/ >> auto.
    apply /negq_leqq'/.
    rewrite /-> negq_invol/.
    rewrite /-> negq_zero/.
    auto.
    }
  apply /leqq_trans/.
    {
    apply /absq_plusq_leqq/.
    }

    typechecker ();
  rewrite /-> absq_of_nonneg/ >> auto.
  rewrite /-> absq_of_nonpos/ >> auto.
  unfold /minusq/.
  apply /leqq_refl/.
  }
intro /a b/.
so /rational_dichotomy_weak q`0 a/ /Hnnega | Hnposa/ >> so /rational_dichotomy_weak q`0 b/ /Hnnegb | Hnposb/.
  {
  rewrite /-> absq_of_nonneg at 1 1/ >> autoWith /leqq_refl/.
  }

  {
  apply /Hacross/ >> auto.
  }

  {
  rewrite /-> absq_minusq_commute at 0 1/.
  apply /Hacross/ >> auto.
  }

  {
  rewrite /-> absq_of_nonpos at 1 1/ >> auto.
  unfold /minusq/.
  rewrite /-> negq_invol/.
  rewrite /-> plusq_commute/.
  fold /minusq _ _/.
  rewrite /-> absq_minusq_commute/.
  apply /leqq_refl/.
  }
qed ();

  

(* Minimum and Maximum *)

define /minq a b/
/
  if leqqb a b then a else b
//
  rational -> rational -> rational
/;

unfold /minq/.
typecheck.
qed ();

Define.registerNative 0 2 (Define.unfold1 (parseConstant /minq/) 2);



define /maxq a b/
/
  if leqqb a b then b else a
//
  rational -> rational -> rational
/;

unfold /maxq/.
typecheck.
qed ();

Define.registerNative 0 2 (Define.unfold1 (parseConstant /maxq/) 2);



lemma "negq_minq"
/
  forall a b . ~q (minq a b) = maxq (~q a) (~q b) : rational
/;

inference.
intro /a b/.
unfold /minq , maxq/.
boolCase /leqqb a b/ /Hab/ >> boolCase /leqqb (~q a) (~q b)/ /Hba/ >> attempt reflexivity.
  {
  reduce //.
  compat.
  apply /leqq_antisymm/ >> auto.
  apply /negq_leqq'/ >> auto.
  }

  {
  rewrite /-> not_leqq in Hab/.
  rewrite /-> not_leqq in Hba/.
  so /negq_ltq' _ _ Hba/ /Hba'/.
  so /ltq_irrefl _ (ltq_trans _ _ _ Hba' Hab)/ /0/.
  }
qed ();



lemma "maxq_as_minq"
/
  forall a b . maxq a b = ~q (minq (~q a) (~q b)) : rational
/;

inference.
intro /a b/.
rewrite /-> negq_minq/.
rewrite /-> negq_invol at all/.
reflexivity.
qed ();



