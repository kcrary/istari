so /rational_dichotomy_weak b c/ /Hbc | Hcb/.
  {
  rewrite /-> maxq_eq_r/ >> auto.
  rewrite /-> maxq_eq_r/ >> auto.
  apply /plusq_leqq/ >> auto.
  apply /leqq_refl/.
  }

  {
  rewrite /-> maxq_eq_l/ >> auto.
  rewrite /-> maxq_eq_l/ >> auto.
  apply /plusq_leqq/ >> auto.
  apply /leqq_refl/.
  }
