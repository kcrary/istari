lemma "minz_to_rational"
/
  forall m n . integer_to_rational (Integer.minz m n) = minq (integer_to_rational m) (integer_to_rational n) : rational
/;

inference.
assert /forall m n . m <z= n -> integer_to_rational (Integer.minz m n) = minq (integer_to_rational m) (integer_to_rational n) : rational/ /H/.
  {
  inference.
  intro /m n Hmn/.
  rewrite /-> Integer.minz_eq_l/ >> auto.
  rewrite /-> minq_eq_l/ >> auto.
  apply /integer_to_rational_mono/ >> auto.
  }
intro /m n/.
so /Integer.integer_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
rewrite /-> Integer.minz_commute/.
rewrite /-> minq_commute/.
apply /H/ >> auto.
qed ();



