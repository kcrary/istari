(* Decidability *)

lemma "neq_rational_decide"
/
  forall x y .
    Decidable.decidable (x != y : rational)
/;

inference.
intro /x y/.
unfold /neq/.
apply /Decidable.decidable_not/.
apply /eq_rational_decide/.
qed ();



