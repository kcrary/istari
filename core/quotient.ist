
File.import "logic-load.iml";
File.import "sqstable-load.iml";
File.import "syntactic-equality-load.iml";

File.import "quotient-aux.iml";


beginModule "Quotient";



define /PER A R/
/
  (forall x y . R x y -> R y x)
  & (forall x y z . R x y -> R y z -> R x z)
//
  intersect i . forall (A : U i) . (A -> A -> U i) -> U i
/;

unfold /PER/.
typecheck.
qed ();



define /ER A R/
/
  (forall x . R x x)
  & (forall x y . R x y -> R y x)
  & (forall x y z . R x y -> R y z -> R x z)
//
  intersect i . forall (A : U i) . (A -> A -> U i) -> U i
/;

unfold /ER/.
typecheck.
qed ();



lemma "per_impl_er"
/
  forall i (A : U i) R . ER A R -> PER A R
/;

inference.
intro /i A R H/.
destruct /H/ /_ Hs Ht/.
unfold /PER/.
auto.
qed ();



lemma "quotient_formation"
/
  forall i (A : U i) R .
    PER A R
    -> (quotient (x y : A) . R x y) : U i
/;

inference.
intro /i A R Hper/.
destruct /Hper/ /Hsymm Htrans/.
typecheck >> auto.
qed ();



define /quotient1 A R Hper/
/
  quotient (x y : A) . R x y
//
  intersect i . forall (A : U i) (R : A -> A -> U i) .
    PER A R -> U i
/;

inference.
introOf /i A R Hper/.
unfold /quotient1/.
destruct /Hper/ /Hsymm Htrans/.
typecheck >> auto.
qed ();

recordIrrelevance /quotient1/ [2];



define /qintro1 A R Hper x Hx/
/
  x
//
  intersect i .
  forall (A : U i) (R : A -> A -> U i) (Hper : PER A R) (x : A) .
    R x x
    -> quotient1 A R Hper
/;

inference.
introOf /i A R Hper x Hx/.
unfold /qintro1, quotient1/.
destruct /Hper/ /Hsymm Htrans/.
typecheck >> auto.
qed ();

recordIrrelevance /qintro1/ [0, 1, 2, 4];



lemma "per_refl_left"
/
  intersect i . forall (A : U i) (R : A -> A -> U i) .
    PER A R 
    -> forall x y . R x y -> R x x
/;

inference.
intro /i A R (Hsymm Htrans) x y Hxy/.
apply /Htrans _ y/ >> auto.
qed ();



lemma "per_refl_right"
/
  intersect i . forall (A : U i) (R : A -> A -> U i) .
    PER A R 
    -> forall x y . R x y -> R y y
/;

inference.
intro /i A R (Hsymm Htrans) x y Hxy/.
apply /Htrans _ x/ >> auto.
qed ();



lemma "per_refl_left'"
/
  forall i (A : U i) (R : A -> A -> U i) .
    PER A R
    -> forall x y . R x y -> R x x
/;

inference.
intro /i A R Hper x y Hxy/.
apply /`per_refl_left A R/ >> auto.
qed ();



lemma "per_refl_right'"
/
  forall i (A : U i) (R : A -> A -> U i) .
    PER A R
    -> forall x y . R x y -> R y y
/;

inference.
intro /i A R Hper x y Hxy/.
apply /`per_refl_right A R/ >> auto.
qed ();



define /quotient1r A R Her/
/
  quotient (x y : A) . R x y
//
  intersect i . forall (A : U i) (R : A -> A -> U i) .
    ER A R -> U i
/;

inference.
introOf /i A R Her/.
unfold /quotient1r/.
destruct /Her/ /_ Hsymm Htrans/.
typecheck >> auto.
qed ();

recordIrrelevance /quotient1r/ [2];



define /qintro1r A R Her x/
/
  x
//
  intersect i .
  forall (A : U i) (R : A -> A -> U i) (Hper : ER A R) (x : A) .
    quotient1r A R Hper
/;

inference.
introOf /i A R Her x/.
unfold /qintro1r, quotient1r/.
destruct /Her/ /Hrefl Hsymm Htrans/.
typecheck >> auto.
qed ();

recordIrrelevance /qintro1r/ [0, 1, 2];



define /PER2 A Q R/
/
  (forall x . Q x -> R x x)
  & (forall x y . Q x -> Q y -> R x y -> R y x)
  & (forall x y z . Q x -> Q y -> Q z -> R x y -> R y z -> R x z)
//
  intersect i . forall (A : U i) . (A -> U i) -> (A -> A -> U i) -> U i
/;

unfold /PER2/.
typecheck.
qed ();



lemma "quotient2_formation"
/
  forall i (A : U i) Q R .
    PER2 A Q R
    -> (quotient (x y : A) . Q x & Q y & R x y) : U i
/;

inference.
intro /i A Q R Hper/.
destruct /Hper/ /_ Hsymm Htrans/.
typecheck >> auto.
  {
  reintro /x y Hxy/.
  destruct /Hxy/ /Hx Hy Hxy/.
  auto.
  }

  {
  reintro /x y z Hxy Hyz/.
  destruct /Hxy/ /Hx Hy Hxy/.
  destruct /Hyz/ /_ Hz Hyz/.
  splitn 2 >> auto.
  apply /Htrans _ y/ >> auto.
  }
qed ();



define /quotient2 A Q R Hper/
/
  quotient (x y : A) . Q x & Q y & R x y
//
  intersect i .
  forall (A : U i) (Q : A -> U i) (R : A -> A -> U i) .
    PER2 A Q R -> U i
/;

inference.
introOf /i A Q R Hper/.
unfold /quotient2/.
exact /quotient2_formation i A Q R Hper/.
qed ();

recordIrrelevance /quotient2/ [3];



define /qintro2 A Q R Hper x Hx/
/
  x
//
  intersect i . 
  forall (A : U i) (Q : A -> U i) (R : A -> A -> U i) (Hper : PER2 A Q R) (x : A) .
    Q x
    -> quotient2 A Q R Hper
/;

inference.
introOf /i A Q R Hper x Hx/.
unfold /qintro2/.
infer /quotient2 A Q R Hper/ /Hof/.
unfold /quotient2 in Hof in concl/.
typecheck.
destruct /Hper/ /Hrefl _/.
splitn 2 >> auto.
qed ();

recordIrrelevance /qintro2/ [0, 1, 2, 3, 5];



structure Nothing = AfterQuotient ();



lemma "quotient1_representative"
/
  forall i (A : U i) (R : A -> A -> U i) (Hper : PER A R) (x : quotient1 A R Hper) .
    isquash 
      (exists y h .
         x = qintro1 A R Hper y h : quotient1 A R Hper)
/;

inference.
intro /i A R Hper x/.
destruct /x/ /[x Hx]/.
split.
existsAuto.
qed ();



lemma "quotient1r_representative"
/
  forall i (A : U i) (R : A -> A -> U i) (Her : ER A R) (x : quotient1r A R Her) .
    isquash 
      (exists y .
         x = qintro1r A R Her y : quotient1r A R Her)
/;

inference.
intro /i A R Her x/.
destruct /x/ /[x]/.
split.
existsAuto.
qed ();



lemma "quotient2_representative"
/
  forall i (A : U i) (Q : A -> U i) (R : A -> A -> U i) (Hper : PER2 A Q R) (x : quotient2 A Q R Hper) .
    isquash 
      (exists y h .
         x = qintro2 A Q R Hper y h : quotient2 A Q R Hper)
/;

inference.
intro /i A Q R Hper x/.
destruct /x/ /[x Hx]/.
split.
existsAuto.
qed ();



lemma "quotient1_equality"
/
  forall i (A : U i) (R : A -> A -> U i) (Hper : PER A R) (x y : quotient1 A R Hper) .
    { R x y }
    -> x = y : quotient1 A R Hper
/;

inference.
intro /i A R Hper x y/.
introRaw /Hxy/.
  {
  destruct /x/ /[x x' Hxx]/.
  destruct /y/ /[y y' Hyy]/.
  typecheck.
  destruct /Hper/ /Hsymm Htrans/.
  unfold /qintro1 at all/.
  split.
    {
    intro /Hxy/.
    apply /Htrans _ x/ >> nauto 3.
    }

    {
    intro /Hxy/.
    apply /Htrans _ x'/ >> nauto 3.
    }
  }
destruct /x/ /[x Hx]/.
destruct /y/ /[y Hy]/.
unfold /qintro1 in Hxy at all/.
destruct /Hxy/ /[Hxy]/.
unhide.
unfold /qintro1 at all/.
extensionality >> auto.
qed ();



lemma "quotient1r_equality"
/
  forall i (A : U i) (R : A -> A -> U i) (Her : ER A R) (x y : quotient1r A R Her) .
    { R x y }
    -> x = y : quotient1r A R Her
/;

inference.
intro /i A R Her x y/.
introRaw /Hxy/.
  {
  destruct /x/ /[x x' Hxx]/.
  destruct /y/ /[y y' Hyy]/.
  typecheck.
  destruct /Her/ /Hrefl Hsymm Htrans/.
  unfold /qintro1r at all/.
  split.
    {
    intro /Hxy/.
    apply /Htrans _ x/ >> nauto 3.
    }

    {
    intro /Hxy/.
    apply /Htrans _ x'/ >> nauto 3.
    }
  }
destruct /x/ /[x]/.
destruct /y/ /[y]/.
unfold /qintro1r in Hxy at all/.
destruct /Hxy/ /[Hxy]/.
unhide.
unfold /qintro1r at all/.
extensionality >> auto.
qed ();



lemma "quotient2_equality"
/
  forall i (A : U i) (Q : A -> U i) (R : A -> A -> U i) (Hper : PER2 A Q R) (x y : quotient2 A Q R Hper) .
    { R x y }
    -> x = y : quotient2 A Q R Hper
/;

inference.
intro /i A Q R Hper x y/.
introRaw /Hxy/.
  {
  destruct /x/ /[x Hx x' Hx' Hxx]/.
  destruct /y/ /[y Hy y' Hy' Hyy]/.
  typecheck.
  destruct /Hper/ /Hrefl Hsymm Htrans/.
  unfold /qintro2 at all/.
  split.
    {
    intro /Hxy/.
    apply /Htrans _ x/ >> nauto 3.
    apply /Htrans _ y/ >> nauto 3.
    }

    {
    intro /Hxy/.
    apply /Htrans _ x'/ >> nauto 3.
    }
  }
destruct /x/ /[x Hx]/.
destruct /y/ /[y Hy]/.
unfold /qintro2 in Hxy at all/.
destruct /Hxy/ /[Hxy]/.
unhide.
unfold /qintro2 at all/.
extensionality >> auto.
qed ();



lemma "arrow_quotient_commute"
/
  forall i (A B : U i) (R : B -> B -> U i) .
    PER B R
    -> (quotient (f g : A -> B) . forall (x : A) . R (f x) (g x))
       <:
       (A -> quotient (x y : B) . R x y)
/;

inference.
intro /i A B R Hper/.
assert /PER (A -> B) (fn f g . forall (x : A) . R (f x) (g x))/ /Hperarr/.
  {
  unfold /PER in Hper in concl/.
  destruct /Hper/ /Hsymm Htrans/.
  split.
    {
    reduce //.
    intro /f g Hfg x/.
    apply /Hsymm/ >> auto.
    }

    {
    reduce //.
    intro /f g h Hfg Hgh x/.
    apply /Htrans/ >> auto.
    }
  }
fold /quotient1 B R Hper/.
fold /quotient1 (A -> B) (fn f g . forall (x : A) . R (f x) (g x)) Hperarr/.
intro /f/.
introOfRaw /x/ >> auto.
  {
  change /concl/ /_ : forall (_ : void) . B/.
  fold /void -> B/.
  destruct /f/ /[f g Hfg]/.
  unfold /qintro1 at all/.
  clear /Hfg/.
  introEq /v/.
  destruct /v/ /0/.
  }
destruct /f/ /[f g Hfg]/.
reduce /Hfg/.
unfold /qintro1 at all/.
extensionality.
apply /Hfg/.
qed ();



aliasExport /symmetrical/ Prim.symmetrical;



lemma "symmetrical_type"
/
  symmetrical : intersect i . U i -> U i
/;

inference.
RuleTactic.symmetricalType.
qed ();
recordTyping "symmetrical_type";



lemma "unitary_symmetrical"
/
  forall i (A : U i) .
    A <: unit
    -> symmetrical A
/;

inference.
intro /i A Hsub/.
RuleTactic.unitarySymmetrical >> auto.
qed ();



lemma "unit_symmetrical"
/
  symmetrical unit
/;

RuleTactic.unitSymmetrical.
qed ();



lemma "void_symmetrical"
/
  symmetrical void
/;

RuleTactic.voidSymmetrical.
qed ();



lemma "bool_symmetrical"
/
  symmetrical bool
/;

RuleTactic.boolSymmetrical.
qed ();



lemma "integer_symmetrical"
/
  symmetrical integer
/;

RuleTactic.integerSymmetrical.
qed ();



lemma "symbol_symmetrical"
/
  symmetrical Symbol.symbol
/;

RuleTactic.symbolSymmetrical.
qed ();



lemma "nat_symmetrical"
/
  symmetrical nat
/;

RuleTactic.natSymmetrical.
qed ();



lemma "eq_symmetrical"
/
  forall i (A : U i) (m n : A) .
    symmetrical (m = n : A)
/;

inference.
intro /i A m n/.
apply /unitary_symmetrical/.
intro /()/.
typecheck.
qed ();



lemma "arrow_symmetrical"
/
  forall i (A B : U i) .
    symmetrical A
    -> symmetrical B
    -> symmetrical (A -> B)
/;

inference.
intro /i A B Ha Hb/.
RuleTactic.arrowSymmetrical >> auto.
qed ();



lemma "forall_symmetrical"
/
  forall i (A : U i) (B : A -> U i) .
    symmetrical A
    -> (forall (x : A) . symmetrical (B x))
    -> symmetrical (forall (x : A) . B x)
/;

inference.
intro /i A B Ha Hb/.
RuleTactic.forallSymmetrical >> auto.
qed ();



lemma "intersect_symmetrical"
/
  forall i (A : U i) (B : A -> U i) .
    symmetrical A
    -> (forall (x : A) . symmetrical (B x))
    -> symmetrical (intersect (x : A) . B x)
/;

inference.
intro /i A B Ha Hb/.
RuleTactic.intersectSymmetrical >> auto.
qed ();



lemma "prod_symmetrical"
/
  forall i (A B : U i) .
    symmetrical A
    -> symmetrical B
    -> symmetrical (A & B)
/;

inference.
intro /i A B Ha Hb/.
RuleTactic.prodSymmetrical >> auto.
qed ();



lemma "exists_symmetrical"
/
  forall i (A : U i) (B : A -> U i) .
    symmetrical A
    -> (forall (x : A) . symmetrical (B x))
    -> symmetrical (exists (x : A) . B x)
/;

inference.
intro /i A B Ha Hb/.
RuleTactic.existsSymmetrical >> auto.
qed ();



lemma "sum_symmetrical"
/
  forall i (A B : U i) .
    symmetrical A
    -> symmetrical B
    -> symmetrical (A % B)
/;

inference.
intro /i A B Ha Hb/.
RuleTactic.sumSymmetrical >> auto.
qed ();



lemma "set_symmetrical"
/
  forall i (A : U i) (B : A -> U i) .
    symmetrical A
    -> symmetrical { x : A | B x }
/;

inference.
intro /i A B Ha/.
RuleTactic.setSymmetrical >> auto.
qed ();



lemma "quotient_symmetrical"
/
  forall i (A : U i) (R : A -> A -> U i) .
    PER A R
    -> symmetrical A
    -> symmetrical (quotient (x y : A) . R x y)
/;

inference.
intro /i A R Hper Hmet/.
RuleTactic.quotientSymmetrical >> auto.
so /quotient_formation _# 3 Hper/ /H/.
typecheck.
qed ();



lemma "partial_symmetrical"
/
  forall i (A : U i) .
    symmetrical A 
    -> symmetrical (partial A)
/;

inference.
intro /i A Ha/.
RuleTactic.partialSymmetrical >> auto.
qed ();



(* This proof can be adapted to other domains by changing the
   "set /dom/ /nat/" line, and fixing the proofs of a couple of
   subsequent assertions.  Alas, we cannot just make this proof
   hypothetical over the domain, because we need to know that the
   domain is elemental, and elemental-ness is not negatable.
*)

lemma "forall_nat_quotient_commute_conv"
/
  forall i (B : nat -> U i) (R : forall (x : nat) . B x -> B x -> U i) .
    (forall (x : nat) . PER (B x) (R x))
    -> (forall (x : nat) . symmetrical (B x))
    -> (forall (x : nat) (y z : B x) . Sqstable.sqstable (R x y z))
    -> (forall (x : nat) . quotient (y z : B x) . R x y z)
       <:
       (quotient (f g : forall (x : nat) . B x) . forall (x : nat) . R x (f x) (g x))
/;

inference.
set /A/ /nat/.
fold /A at all/.
intro /i/.
assert /A : U i/ /Hofdom/.
  {
  unfold /A/.
  typecheck.
  }
intro /B R Hper Hmet Hstable/.
assert /symmetrical A/ /HmetA/.
  {
  unfold /A/.
  apply /nat_symmetrical/.
  }
assert /forall (x y : A) . x = y : A -> SyntacticEquality.sequal x y/ /Helemental/.
  {
  unfold /A at all/.
  intro /x y/.
  apply /SyntacticEquality.nat_elemental/ >> auto.
  }
assert /forall (x : A) . PER (B x) (fn y z . { R x y z })/ /Hpersq/.
  {
  intro /x/.
  so /Hper x/ /Hsymm Htrans/.
  unfold /PER/.
  split.
    {
    reduce //.
    intro /y z [Hyz]/.
    split.
    apply /Hsymm/ >> auto.
    }

    {
    reduce //.
    intro /y z w [Hyz] [Hzw]/.
    split.
    apply /Htrans/ >> auto.
    }
  }
assert /PER (forall (x : A) . B x) (fn f g . forall (x : A) . R x (f x) (g x))/ /Hperarr/.
  {
  unfold /PER/.
  split.
    {
    reduce //.
    intro /f g Hfg x/.
    apply /Hper x #1/ >> auto.
    }

    {
    reduce //.
    intro /f g h Hfg Hgh x/.
    apply /Hper x #2/ >> auto.
    }
  }
assert /PER (forall (x : A) . B x) (fn f g . forall (x : A) . { R x (f x) (g x) })/ /Hpersqarr/.
  {
  unfold /PER/.
  split.
    {
    reduce //.
    intro /f g Hfg x/.
    so /Hfg x/ /[H]/.
    split.
    apply /Hper x #1/ >> auto.
    }

    {
    reduce //.
    intro /f g h Hfg Hgh x/.
    so /Hfg x/ /[Hfg']/.
    so /Hgh x/ /[Hgh']/.
    split.
    apply /Hper x #2/ >> auto.
    }
  }
fold /quotient1 (B x) (R x) (Hper x) within x/.
fold /quotient1 (forall (x : A) . B x) (fn f g . forall (x : A) . R x (f x) (g x)) Hperarr/.
intro /h/.
eqtp /quotient1 (forall (x : A) . B x) (fn f g . forall (x : A) . { R x (f x) (g x) }) Hpersqarr/.
  {
  unfold /quotient1 at 0 0/.
  typecheck.
    {
    reintro /f g Hfg/.
    reduce /Hfg concl/.
    intro /x/.
    so /Hfg x/ /[Hfg']/.
    squashConcl >> auto.
    }

    {
    reintro /f g Hfg/.
    reduce /Hfg concl/.
    intro /x/.
    split >> auto.
    }

    {
    reintro /f g Hfg/.
    reduce /Hfg concl/.
    intro /x/.
    so /Hfg x/ /[Hfg']/.
    split.
    apply /Hper x #1/ >> auto.
    }

    {
    reintro /f g k Hfg Hgk/.
    reduce /Hfg Hgk concl/.
    intro /x/.
    so /Hfg x/ /[Hfg']/.
    so /Hgk x/ /[Hgk']/.
    split.
    apply /Hper x #2 _ (g x)/ >> auto.
    }
  }
unfold /quotient1/.
reduce //.
unfold /of/.
RuleTactic.forallQuotientCommute (parseCurr /additional` x y z . { R x y z }/) >> auto.
  {
  reintro /x y z Hyz/.
  destruct /Hyz/ /[Hyz]/.
  split.
  apply /Hper x #1/ >> auto.
  }

  {
  reintro /x y z w Hyz Hzw/.
  destruct /Hyz/ /[Hyz]/.
  destruct /Hzw/ /[Hzw]/.
  split.
  apply /Hper x #2/ >> auto.
  }
fold /of _ h/.
fold /quotient1 (B x) (fn y z . { R x y z }) Hpersq within x/.
eqtp /forall (x : A) . quotient1 (B x) (R x) (Hper x)/ >> auto.
unfold /quotient1 at 0 0/.
typecheck.
  {
  reintro /x y z Hyz/.
  squashConcl >> auto.
  }

  {
  reintro /x y z Hyz/.
  apply /Hper x #1/ >> auto.
  }

  {
  reintro /x y z w Hyz Hzw/.
  apply /Hper x #2/ >> auto.
  }
qed ();



lemma "nat_arrow_quotient_commute_conv"
/
  forall i (B : U i) (R : B -> B -> U i) .
    PER B R
    -> symmetrical B
    -> (forall (y z : B) . Sqstable.sqstable (R y z))
    -> (nat -> quotient (y z : B) . R y z)
       <:
       (quotient (f g : nat -> B) . forall (x : nat) . R (f x) (g x))
/;

inference.
intro /i B R Hper Hmet Hstable/.
unfold /arrow at 0 0/.
apply /forall_nat_quotient_commute_conv/ >> auto.
qed ();



endModule ();
