
File.import "../core/autoQ.iml";

openModule /Rational/;
openModule /Quotient/;
openModule /Integer/;
openModule /Nat/;
openModule /Real/;
openModule /Squish/;

alias /regular/ /Real.Primitive.regular/;
alias /realequiv/ /Real.Primitive.realequiv/;
alias /rintro/ /Real.Primitive.rintro/;
alias /real_representative/ /Real.Primitive.real_representative/;
alias /real_impl_regular/ /Real.Primitive.real_impl_regular/;
alias /real_equality/ /Real.Primitive.real_equality/;
alias /realequiv_refl/ /Real.Primitive.realequiv_refl/;
alias /realequiv_symm/ /Real.Primitive.realequiv_symm/;
alias /prepositive/ /Real.Primitive.prepositive/;
alias /positive/ /Real.Primitive.positive/;
alias /prepositive_enduring/ /Real.Primitive.prepositive_enduring/;
alias /negr_regular/ /Real.Primitive.negr_regular/;

setOpacity /real/ Constant.HARD;
setOpacity /prereal/ Constant.HARD;
setOpacity /rational_to_real/ Constant.HARD;
setOpacity /plusr/ Constant.HARD;
setOpacity /negr/ Constant.HARD;
setOpacity /timesr/ Constant.HARD;
setOpacity /invr/ Constant.HARD;
setOpacity /absr/ Constant.HARD;
setOpacity /maxr/ Constant.HARD;
setOpacity /ltr/ Constant.HARD;


beginModule "CantorTheorem";


(* SET PARSING TO REAL *)
setArithReal ();



lemma "ltr_impl_ltr_approximation"
/
  forall (x : real) (y : nat -> rational) (yr : regular y) .
    x < rintro y yr
    -> { exists n . n`0 <n n & x < rational_to_real (y n) }
/;

inference.
intro /x' y Hy Hlt/.
so /real_representative x'/ /[(x xr ?)]/.
subst /x'/.
unfold /rintro in Hlt at 0 0 in concl/.
unfold /ltr in Hlt in concl, minusr in Hlt in concl, negr in Hlt in concl, plusr in Hlt in concl/.
unfold /rational_to_real/.
unfold /positive in Hlt in concl/.
destruct /Hlt/ /[(n Hposn Hlt)]/.
split.
rewrite /-> times_commute n`2 within _ in Hlt at 0 0 in concl/.
exists /n *n n`2/.
split.
  {
  apply /times_lt_zero/ >> auto.
  omega.
  }
unfold /prepositive/.
split.
exists /n/.
split >> auto.
qed ();



lemma "leqr_by_approximations_l"
/
  forall (x : real) (y : nat -> rational) (yr : regular y) .
    (forall n . n`0 <n n -> rational_to_real (y n) <= x)
    -> rintro y yr <= x
/;

inference.
intro /x y yr Hleqs/.
apply /not_ltr/.
intro /Hlt/.
so /ltr_impl_ltr_approximation _# 3 Hlt/ /[(n Hposn Hltn)]/.
so /Hleqs n Hposn/ /Hleq/.
rewrite /<- not_ltr in Hleq/.
exact /Hleq Hltn/.
qed ();



lemma "leqr_by_approximations_r"
/
  forall (x : real) (y : nat -> rational) (yr : regular y) .
    (forall n . n`0 <n n -> x <= rational_to_real (y n))
    -> x <= rintro y yr
/;

inference.
intro /x y yr Hleqs/.
so /leqr_by_approximations_l (negr x) (fn i . negq (y i)) (negr_regular _ yr) __/ /H/.
  {
  intro /i Hposi/.
  reduce //.
  rewrite /-> negq_to_real/.
  apply /negr_leqr/.
  auto.
  }
apply /negr_leqr'/.
forceExact /H/.
compat.
unfold /negr/.
unfold /rintro at 1/.
fold /rintro (fn i . ~q (y i)) (negr_regular y yr) at 1/.
reflexivity.
qed ();



lemma "increasing_approximations_upper_bound"
/
  forall (x : nat -> rational) (xr : regular x) (y : real) .
    (forall i j . n`0 <n i -> i <n= j -> x i <q= x j)
    -> rintro x xr < y
    -> forall i . n`0 <n i -> rational_to_real (x i) < y
/;

inference.
intro /x xr y' Hinc Hlt/.
intro /i Hposi/.
so /real_representative y'/ /[H]/.
squashConcl.
unhide.
split.
destruct /H/ /y yr ?/.
subst /y'/.
unfold /ltr in Hlt in concl, positive in Hlt in concl, minusr in Hlt in concl, negr in Hlt in concl, plusr in Hlt in concl/.
unfold /rintro in Hlt at 0 0 in concl/.
unfold /rational_to_real/.
destruct /Hlt/ /[Hlt]/.
unhide.
so /real_impl_regular (rintro y yr - rintro x xr)/ /Hregplus/.
unfold /rintro in Hregplus at 0 0, minusr in Hregplus, negr in Hregplus, plusr in Hregplus/.
destruct /Hregplus/ /[Hregplus]/.
unhide.
rewrite /-> prepositive_enduring in Hlt/ >> auto.
destruct /Hlt/ /j Hposj Hj/.
rewrite /-> times_commute n`2 within _ in Hj at 0 0 in concl at 0 0/.
reduce /Hj concl/.
split.
unfold /prepositive/.
setEq /k/ /succ (max i j)/ /_/ /Heqk/.
exists /k/.
split.
  {
  omega.
  }
reduce //.
so /Hj k __/ /H/.
  {
  omega.
  }
apply /ltq_leqq_trans _ (invq (nat_to_rational j))/.
  {
  apply /invq_ltq_pos/.
    {
    autoQ.
    }

    {
    autoQ.
    }
  }
rewrite /-> H/.
apply /plusq_leqq/ >>> [apply /leqq_refl/, idtac].
apply /negq_leqq/.
apply /Hinc/ >> auto.
rewrite /<- times_1_r i/.
apply /times_leq/ >> omega.
qed ();



lemma "increasing_approximations_lub"
/
  forall (x : nat -> rational) (xr : regular x) .
    (forall i j . n`0 <n i -> i <n= j -> x i <q= x j)
    -> forall i . n`0 <n i -> rational_to_real (x i) <= rintro x xr
/;

inference.
intro /x xr Hinc i Hposi/.
rewrite /<- not_ltr/.
intro /Hlt/.
so /increasing_approximations_upper_bound _# 3 Hinc Hlt i Hposi/ /H/.
exact /ltr_irrefl _ H/.
qed ();



lemma "decreasing_approximations_glb"
/
  forall (x : nat -> rational) (xr : regular x) .
    (forall i j . n`0 <n i -> i <n= j -> x j <q= x i)
    -> forall i . n`0 <n i -> rintro x xr <= rational_to_real (x i)
/;

inference.
intro /x xr Hdec i Hposi/.
so /increasing_approximations_lub (fn i . ~q (x i)) (negr_regular _ xr) __ i Hposi/ /H/.
  {
  clear /i Hposi/.
  intro /i j Hposi Hposj/.
  reduce //.
  apply /negq_leqq/.
  apply /Hdec/ >> auto.
  }
reduce /H/.
rewrite /-> negq_to_real in H/.
so /negr_leqr _ _ H/ /H'/.
rewrite /-> negr_invol in H'/.
forceExact /H'/.
compat.
apply /real_equality/.
split.
unfold /negr, rintro at 0 0/.
rewrite /-> negq_invol within _/.
rewrite /(fn i . x i) = x : (nat -> rational)/.
  {
  introEq /j/ >> auto.
  }
apply /realequiv_refl/.
qed ();






lemma "cantors_theorem_prereal"
/
  forall x y (f : nat -> prereal) .
    realintro x < realintro y
    -> exists z .
         realintro x <= realintro z
         & realintro z <= realintro y
         & (forall i . realintro z != realintro (f i) : real)
/;

inference.
intro /x0 y0 f Hxy0/.
assert /exists (x y : nat -> rational)  .
          (forall i j . n`0 <n i -> i <n= j -> x i <q= x j & y j <q= y i)
          & (forall i . n`0 <n i ->
               realintro x0 <= rational_to_real (x i)
               & rational_to_real (y i) <= realintro y0
               & x i <q y i
               & y i -q x i <q invq (nat_to_rational i))
          & (forall i . n`1 <n i ->
               realintro (f (i -n n`2)) < rational_to_real (x i) % rational_to_real (y i) < realintro (f (i -n n`2)))/ /Hprop/
>>> [inference, idtac].
1:{
  destruct /Hprop/ /x y Hinc Hall Havoid/.
  assert /regular x/ /Hx/.
    {
    unfold /regular/.
    assert /forall m n . n`0 <n m -> m <n= n -> absq (x m -q x n) <q= invq (nat_to_rational m) +q invq (nat_to_rational n)/ /Hprop/ >>> [inference, idtac].
    1:{
      intro /m n Hposm Hposn/.
      so /nat_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
      rewrite /-> absq_minusq_commute/.
      rewrite /-> plusq_commute/.
      apply /Hprop/ >> auto.
      }
    intro /m n Hposm Hmn/.
    so /Hall m Hposm/ /_ _ _ Hm/.
    so /Hall n __/ /_ _ Hn _/.
      {
      omega.
      }
    so /Hinc m n Hposm Hmn/ /Hxmn Hynm/.
    apply /leqq_trans _ (invq (nat_to_rational m))/.
    1:{
      rewrite /<- plusq_id_r (invq _)/.
      apply /plusq_leqq/ >> auto.
      autoQ.
      }
    rewrite /-> absq_minusq_commute/.
    rewrite /-> absq_of_nonneg/.
      {
      rewrite /<- minusq_shift_leqq_rr/.
      rewrite /-> plusq_id_l/.
      auto.
      }
    rewrite /<- ltq_impl_leqq _ _ Hm/.
    apply /minusq_leqq/ >> auto.
    apply /leqq_trans _ (y n)/ >> auto.
    apply /ltq_impl_leqq/ >> auto.
    }
  assert /regular y/ /Hy/.
    {
    unfold /regular/.
    assert /forall m n . n`0 <n m -> m <n= n -> absq (y m -q y n) <q= invq (nat_to_rational m) +q invq (nat_to_rational n)/ /Hprop/ >>> [inference, idtac].
    1:{
      intro /m n Hposm Hposn/.
      so /nat_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
      rewrite /-> absq_minusq_commute/.
      rewrite /-> plusq_commute/.
      apply /Hprop/ >> auto.
      }
    intro /m n Hposm Hmn/.
    so /Hall m Hposm/ /_ _ _ Hm/.
    so /Hall n __/ /_ _ Hn _/.
      {
      omega.
      }
    so /Hinc m n Hposm Hmn/ /Hxmn Hynm/.
    apply /leqq_trans _ (invq (nat_to_rational m))/.
    1:{
      rewrite /<- plusq_id_r (invq _)/.
      apply /plusq_leqq/ >> auto.
      autoQ.
      }
    rewrite /-> absq_of_nonneg/.
      {
      rewrite /<- minusq_shift_leqq_rr/.
      rewrite /-> plusq_id_l/.
      auto.
      }
    rewrite /<- ltq_impl_leqq _ _ Hm/.
    apply /minusq_leqq/ >> auto.
    apply /leqq_trans _ (x n)/ >> auto.
    apply /ltq_impl_leqq/ >> auto.
    }
  assert /realequiv x y/ /Heq/.
    {
    apply /realequiv_symm/.
    unfold /realequiv/.
    intro /n Hposn/.
    apply /leqq_trans _ (invq (nat_to_rational n))/.
      {
      apply /ltq_impl_leqq/.
      rewrite /-> absq_of_nonneg/.
        {
        rewrite /<- minusq_shift_leqq_rr/.
        rewrite /-> plusq_id_l/.
        apply /ltq_impl_leqq/.
        apply /Hall/ >> auto.
        }
      apply /Hall/ >> auto.
      }
    rewrite /<- timesq_id_l (invq _)/.
    apply /timesq_leqq_r/ >> autoQ.
    }
  existsRaw /x/ >> auto.
    {
    unfold /prereal/ >> auto.
    }
  unfold /realintro at 4 2 1/.
  fold /rintro x Hx at 0 1 2/.
  splitn 2.
    {
    apply /leqr_by_approximations_r/.
    intro /n Hposn/.
    apply /Hall/ >> auto.
    }

    {
    rewrite /rintro x Hx = rintro y Hy : real/.
      {
      apply /real_equality/.
      unfold /rintro at 0 0/.
      auto.
      }
    apply /leqr_by_approximations_l/.
    intro /n Hposn/.
    apply /Hall/ >> auto.
    }

    {
    intro /i/.
    so /Havoid (n`2 +n i) __/ /H | H/.
      {
      omega.
      }

      {
      reduce /H/.
      symmetry.
      apply /ltr_impl_neq/.
      witness /ltr_leqr_trans _# 3 H __/.
      clear /H/.
      apply /increasing_approximations_lub x Hx/ >> autoWith /lt_0_succ/.
      }

      {
      rewrite /rintro x Hx = rintro y Hy : real/.
        {
        apply /real_equality/.
        unfold /rintro at 0 0/.
        auto.
        }
      apply /ltr_impl_neq/.
      witness /leqr_ltr_trans _# 3 __ H/.
      clear /H/.
      apply /decreasing_approximations_glb y Hy/ >> autoWith /lt_0_succ/.
      }
    }
  }
so /rational_dense_within_real_prereal x0 y0 Hxy0/ /a Hxa Hay/.
so /rational_dense_within_real_prereal (rational_to_prereal a) y0 __/ /b Hab Hby/.
  {
  rewrite /-> rational_to_prereal_to_real/.
  auto.
  }
setEq /c/ /minq (a +q invq q`2) b/ /_/ /Heqc/.
exploit /RealSupremum.infinite_sequence lzero (rational & rational)
           (fn k p .
              p #1 <q p #2
              & (p #2 -q p #1 <q invq (nat_to_rational (succ k)))
              & (forall i .
                   i <n k
                   -> realintro (f i) < rational_to_real (p #1)
                      % rational_to_real (p #2) < realintro (f i)))
           (fn p q .
              p #1 <q= q #1
              & q #2 <q= p #2)
           (a, c)/ /H/
>> reduce //.
  {
  splitn 2.
    {
    subst /c/.
    rewrite /-> rational_to_prereal_to_real in Hab/.
    apply /minq_glb_strict/.
      {
      rewrite /<- plusq_id_r a/.
      apply /plusq_ltq_r/ >> auto.
      autoQ.
      }

      {
      apply /rational_to_real_mono_lt_conv/ >> auto.
      }
    }

    {
    unfold /nat_to_rational/.
    reduce //.
    apply /leqq_ltq_trans _ (invq q`2)/.
      {
      rewrite /<- minusq_shift_leqq_ll/.
      subst /c/.
      apply /minq_leq_l/.
      }

      {
      apply /invq_ltq_pos/ >> autoQ.
      }
    }

    {
    intro /i Hi/.
    omega.
    }
  }

  {
  clear /a Hxa Hay b Hab Hby c Heqc/.
  intro /k p (Hsep Hdist Havoid)/.
  assert /forall x y a .
            x <q y
            -> realintro a < rational_to_real y
            -> exists x' .
                 x <q= x'
                 & x' <q y
                 & realintro a < rational_to_real x'
                 & y -q x' <q invq (nat_to_rational (succ (succ k)))/ /Hprop/.
    {
    inference.
    intro /x y a Hxy Hay/.
    so /rational_dense_within_real_prereal a (rational_to_prereal y) __/ /u Hau Huy/.
      {
      rewrite /-> rational_to_prereal_to_real/.
      hyp /Hay/.
      }
    rewrite /-> rational_to_prereal_to_real in Huy/.
    exists /maxq x (maxq u (y -q invq (nat_to_rational (succ (succ (succ k))))))/.
    splitn 3.
      {
      apply /maxq_leq_l/.
      }
  
      {
      apply /maxq_lub_strict/ >> auto.
      apply /maxq_lub_strict/.
        {
        apply /rational_to_real_mono_lt_conv/ >> auto.
        }
  
        {
        rewrite /<- minusq_id_r y at 1/.
        unfold /minusq at 0 0/.
        apply /plusq_ltq_r/ >> auto.
        apply /negq_ltq/.
        autoQ.
        }
      }
  
      {
      apply /ltr_leqr_trans _ (rational_to_real u)/ >> auto.
      apply /rational_to_real_mono/.
      apply /leqq_trans/.
      1:{
        apply /maxq_leq_r/.
        }
  
        {
        apply /maxq_leq_l/.
        }
        
        typechecker ();
      }
  
      {
      apply /leqq_ltq_trans _ (invq (nat_to_rational (succ (succ (succ k)))))/.
      1:{
        apply /invq_ltq_pos/ >> autoQ.
        }
      apply /negq_leqq'/.
      rewrite /-> negq_minusq/.
      unfold /minusq at all/.
      rewrite /-> plusq_dist_maxq_l/.
      rewrite /-> plusq_dist_maxq_l/.
      apply /leqq_trans/.
      1:{
        apply /maxq_leq_r/.
        }
  
        typechecker ();
      apply /leqq_trans/.
      1:{
        apply /maxq_leq_r/.
        }
  
        typechecker ();
      apply /negq_leqq'/.
      rewrite /-> negq_plusq at all/.
      rewrite /-> negq_invol at all/.
      rewrite /-> plusq_commute at 1/.
      rewrite /-> plusq_assoc/.
      rewrite /-> plusq_inverse_l/.
      rewrite /-> plusq_id_r/.
      apply /leqq_refl/.
      }
    }
  so /overlapping_ranges_prereal (f k) (rational_to_prereal (p #1)) (rational_to_prereal (p #2)) __/ /Hleft | Hright/.
    {
    rewrite /-> rational_to_prereal_to_real at 0 0/.
    apply /rational_to_real_mono_lt/ >> auto.
    }

    {
    rewrite /-> rational_to_prereal_to_real in Hleft/.
    so /Hprop (p #1) (p #2) (f k) Hsep Hleft/ /z Hxz Hzy Hmiss Hdist'/.
    exists /(z, p #2)/.
    reduce //.
    splitn 2 >> auto.
    splitn 2 >> auto.
    intro /i Hi/.
    so /Nat.eq_nat_decide i k/ /? | Hneq/.
      {
      subst /i/.
      left >> auto.
      }
    so /Havoid i __/ /Hbelow | Habove/ >> auto.
      {
      omega.
      }
   
      {
      left.
      apply /ltr_leqr_trans _ (rational_to_real (p #1))/ >> auto.
      apply /rational_to_real_mono/ >> auto.
      }
    }

    {
    rewrite /-> rational_to_prereal_to_real in Hright/.
    so /Hprop (negq (p #2)) (negq (p #1)) (prenegr (f k)) __ __/ /z Hyz Hzx Hmiss Hdist'/.
      {
      apply /negq_ltq/ >> auto.
      }

      {
      rewrite /-> prenegr_to_real/.
      rewrite /-> negq_to_real/.
      apply /negr_ltr/ >> auto.
      }
    exists /(p #1, negq z)/.
    reduce //.
    splitn 2 >> auto.
      {
      splitn 2.
        {
        apply /negq_ltq'/.
        rewrite /-> negq_invol/ >> auto.
        }

        {
        unfold /minusq in Hdist' in concl/.
        rewrite /-> plusq_commute/.
        hyp /Hdist'/.
        }

        {
        intro /i Hi/.
        so /Nat.eq_nat_decide i k/ /? | Hneq/.
          {
          subst /i/.
          right.
          rewrite /-> prenegr_to_real in Hmiss/.
          apply /negr_ltr'/.
          rewrite /-> negq_to_real/.
          rewrite /-> negr_invol/.
          hyp /Hmiss/.
          }
        so /Havoid i __/ /Hbelow | Habove/ >> auto.
          {
          omega.
          }
          
          {
          right.
          apply /leqr_ltr_trans _ (rational_to_real (p #2))/ >> auto.
          apply /negr_leqr'/.
          rewrite /<- negq_to_real at 0 0/.
          apply /rational_to_real_mono/.
          rewrite /-> negq_invol/.
          hyp /Hyz/.
          }
        }
      }

      {
      apply /negq_leqq'/.
      rewrite /-> negq_invol/.
      hyp /Hyz/.
      }
    }
  }
destruct /H/ /g Hg0 Hg/.
reduce /Hg/.
exists /(fn i . if i =n? n`0 then q`0 else g (pred i) #1)/.
exists /(fn i . if i =n? n`0 then q`0 else g (pred i) #2)/.
reduce //.
assert /forall i j . i <n= j -> g i #1 <q= g j #1 & g j #2 <q= g i #2/ /Hinc/.
  {
  inference.
  intro /i j/.
  sinduction /j/.
  reintro /IH/.
  intro /Hij/.
  rewrite /-> Nat.leq_iff_lt_or_eq in Hij/.
  destruct /Hij/ /Hij | ?/.
    {
    so /IH (pred j) __ __/ /Hind Hind'/ >>> [omega, omega, idtac].
    so /Hg (pred j) #2/ /Hstep Hstep'/.
    rewriteThen /succ (pred j) = j : nat in Hstep/ omega.
    rewriteThen /succ (pred j) = j : nat in Hstep'/ omega.
    split >> apply /leqq_trans/ >> auto.
    }

    {
    subst /j/.
    auto.
    }
  }
splitn 2.
  {
  intro /i j Hi Hij/.
  boolEq false /i =n? n`0/ >>> [omega, idtac].
  boolEq false /j =n? n`0/ >>> [omega, idtac].
  apply /Hinc/.
  omega.
  }

  {
  intro /i Hi/.
  destruct /i/ /| i/.
    {
    omega.
    }
  reduce //.
  splitn 3 >> auto.
    {
    transitivity /rational_to_real a/.
      {
      apply /ltr_impl_leqr/ >> auto.
      }
    apply /rational_to_real_mono/.
    rewrite /a = g n`0 #1 : rational/.
      {
      rewrite /-> Hg0/.
      reflexivity.
      }
    apply /Hinc/.
    omega.
    }

    {
    transitivity /rational_to_real b/.
    1:{
      apply /ltr_impl_leqr/ >> auto.
      }
    apply /rational_to_real_mono/.
    transitivity /c/.
    1:{
      subst /c/.
      apply /minq_leq_r/.
      }
    rewrite /c = g n`0 #2 : rational/.
      {
      rewrite /-> Hg0/.
      reflexivity.
      }
    apply /Hinc/.
    omega.
    }
  }

  {
  intro /i Hi/.
  destruct /i/ /|(| i)/ >>> [omega, omega, idtac].
  reduce //.
  apply /Hg/.
  omega.
  }
qed ();



lemma "cantors_theorem"
/
  forall x y (f : nat -> real) .
    x < y
    -> squish
         (exists z .
            x <= z
            & z <= y
            & (forall i . z != f i : real))
/;

inference.
intro /x' y' f' Hxy/.
so /real_to_prereal x'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(x ?)/.
so /real_to_prereal y'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(y ?)/.
so /real_sequence_to_prereal_sequence f'/ /H/.
witness /squish_bind H __/.
clear /H/.
intro /(f ?)/.
subst /x' y' f'/.
apply /squish_ret/.
so /cantors_theorem_prereal x y f Hxy/ /z Hxz Hzy Hneqs/.
exists /realintro z/.
auto.
qed ();



endModule ();
