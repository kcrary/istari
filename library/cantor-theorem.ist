
File.import "../core/autoQ.iml";

openModule /Rational/;
openModule /Quotient/;
openModule /Integer/;
openModule /Nat/;
openModule /Real/;

alias /regular/ /Real.Primitive.regular/;
alias /realequiv/ /Real.Primitive.realequiv/;
alias /rintro/ /Real.Primitive.rintro/;
alias /real_representative/ /Real.Primitive.real_representative/;
alias /real_impl_regular/ /Real.Primitive.real_impl_regular/;
alias /real_equality/ /Real.Primitive.real_equality/;
alias /realequiv_refl/ /Real.Primitive.realequiv_refl/;
alias /realequiv_symm/ /Real.Primitive.realequiv_symm/;
alias /prepositive/ /Real.Primitive.prepositive/;
alias /positive/ /Real.Primitive.positive/;
alias /prepositive_enduring/ /Real.Primitive.prepositive_enduring/;
alias /negr_regular/ /Real.Primitive.negr_regular/;

setOpacity /real/ Constant.HARD;
setOpacity /prereal/ Constant.HARD;
setOpacity /rational_to_real/ Constant.HARD;
setOpacity /plusr/ Constant.HARD;
setOpacity /negr/ Constant.HARD;
setOpacity /timesr/ Constant.HARD;
setOpacity /invr/ Constant.HARD;
setOpacity /absr/ Constant.HARD;
setOpacity /maxr/ Constant.HARD;
setOpacity /ltr/ Constant.HARD;


beginModule "CantorTheorem";


lemma "infinite_sequence"
/
  forall lv (A : U lv) (P : (nat -> A) -> nat -> U lv) .
    A
    -> (forall f g k . (forall i . i < k -> f i = g i : A) -> P f k -> P g k)
    -> (forall f . P f 0)
    -> (forall k (f : nat -> A) .
          P f k
          -> exists x . P (fn i . if i =? k then x else f i) (succ k))
    -> exists (f : nat -> A) . forall (k : nat) . P f k
/;

inference.
intro /lv A P x0 Hext Hbase Hind/.
set /F/
  /(fnind F : forall (k : nat) . exists (f : nat -> A) . P f k of
    | zero . ((fn _ . x0), Hbase _)

    | succ n .
        let y = Hind n (F n #1) (F n #2)
        in
          ((fn i . if i =? n then y #1 else (F n #1 i)), y #2))/.
assert /F : forall (k : nat) . exists (f : nat -> A) . P f k/ /HofF/.
  {
  unfold /F/.
  typecheck.
  }
exists /fn i . F (succ i) #1 i/.
intro /k/.
so /F k #2/ /HFk/.
witness /Hext _ _ _ __ HFk/.
intro /i Hik/.
reduce //.
revert /i Hik/.
clear /HFk/.
sinduction /k/.
reintro /IH/.
intro /i Hik/.
assertThen /succ i <= k/ /H/ omega.
rewrite /-> Nat.leq_iff_lt_or_eq in H/.
destruct /H/ /Hik' | Heq/.
1:{
  subst /k/.
  reflexivity.
  }
destruct /k/ /| k/.
  {
  omega.
  }
unfold /F/.
fold /F at all/.
unfold /let/.
boolEq false /i =? k/.
  {
  omega.
  }
apply /IH/ >> omega.
qed ();



(* SET PARSING TO REAL *)
setArithReal ();



lemma "ltr_impl_ltr_approximation"
/
  forall (x : real) (y : nat -> rational) (yr : regular y) .
    x < rintro y yr
    -> { exists n . n`0 <n n & x < rational_to_real (y n) }
/;

inference.
intro /x' y Hy Hlt/.
so /real_representative x'/ /[(x xr ?)]/.
subst /x'/.
unfold /rintro in Hlt at 0 0 in concl/.
unfold /ltr in Hlt in concl, minusr in Hlt in concl, negr in Hlt in concl, plusr in Hlt in concl/.
unfold /rational_to_real/.
unfold /positive in Hlt in concl/.
destruct /Hlt/ /[(n Hposn Hlt)]/.
split.
rewrite /-> times_commute n`2 within _ in Hlt at 0 0 in concl/.
exists /n *n n`2/.
split.
  {
  apply /times_lt_zero/ >> auto.
  omega.
  }
unfold /prepositive/.
split.
exists /n/.
split >> auto.
qed ();



lemma "leqr_by_approximations_l"
/
  forall (x : real) (y : nat -> rational) (yr : regular y) .
    (forall n . n`0 <n n -> rational_to_real (y n) <= x)
    -> rintro y yr <= x
/;

inference.
intro /x y yr Hleqs/.
apply /not_ltr/.
intro /Hlt/.
so /ltr_impl_ltr_approximation _# 3 Hlt/ /[(n Hposn Hltn)]/.
so /Hleqs n Hposn/ /Hleq/.
rewrite /<- not_ltr in Hleq/.
exact /Hleq Hltn/.
qed ();



lemma "leqr_by_approximations_r"
/
  forall (x : real) (y : nat -> rational) (yr : regular y) .
    (forall n . n`0 <n n -> x <= rational_to_real (y n))
    -> x <= rintro y yr
/;

inference.
intro /x y yr Hleqs/.
so /leqr_by_approximations_l (negr x) (fn i . negq (y i)) (negr_regular _ yr) __/ /H/.
  {
  intro /i Hposi/.
  reduce //.
  rewrite /-> negq_to_real/.
  apply /negr_leqr/.
  auto.
  }
apply /negr_leqr'/.
forceExact /H/.
compat.
unfold /negr/.
unfold /rintro at 1/.
fold /rintro (fn i . ~q (y i)) (negr_regular y yr) at 1/.
reflexivity.
qed ();



lemma "increasing_approximations_upper_bound"
/
  forall (x : nat -> rational) (xr : regular x) (y : real) .
    (forall i j . n`0 <n i -> i <n= j -> x i <q= x j)
    -> rintro x xr < y
    -> forall i . n`0 <n i -> rational_to_real (x i) < y
/;

inference.
intro /x xr y' Hinc Hlt/.
intro /i Hposi/.
so /real_representative y'/ /[H]/.
squashConcl.
unhide.
split.
destruct /H/ /y yr ?/.
subst /y'/.
unfold /ltr in Hlt in concl, positive in Hlt in concl, minusr in Hlt in concl, negr in Hlt in concl, plusr in Hlt in concl/.
unfold /rintro in Hlt at 0 0 in concl/.
unfold /rational_to_real/.
destruct /Hlt/ /[Hlt]/.
unhide.
so /real_impl_regular (rintro y yr - rintro x xr)/ /Hregplus/.
unfold /rintro in Hregplus at 0 0, minusr in Hregplus, negr in Hregplus, plusr in Hregplus/.
destruct /Hregplus/ /[Hregplus]/.
unhide.
rewrite /-> prepositive_enduring in Hlt/ >> auto.
destruct /Hlt/ /j Hposj Hj/.
rewrite /-> times_commute n`2 within _ in Hj at 0 0 in concl at 0 0/.
reduce /Hj concl/.
split.
unfold /prepositive/.
setEq /k/ /succ (max i j)/ /_/ /Heqk/.
exists /k/.
split.
  {
  omega.
  }
reduce //.
so /Hj k __/ /H/.
  {
  omega.
  }
apply /ltq_leqq_trans _ (invq (nat_to_rational j))/.
  {
  apply /invq_ltq_pos/.
    {
    autoQ.
    }

    {
    autoQ.
    }
  }
rewrite /-> H/.
apply /plusq_leqq/ >>> [apply /leqq_refl/, idtac].
apply /negq_leqq/.
apply /Hinc/ >> auto.
rewrite /<- times_1_r i/.
apply /times_leq/ >> omega.
qed ();



lemma "increasing_approximations_lub"
/
  forall (x : nat -> rational) (xr : regular x) .
    (forall i j . n`0 <n i -> i <n= j -> x i <q= x j)
    -> forall i . n`0 <n i -> rational_to_real (x i) <= rintro x xr
/;

inference.
intro /x xr Hinc i Hposi/.
rewrite /<- not_ltr/.
intro /Hlt/.
so /increasing_approximations_upper_bound _# 3 Hinc Hlt i Hposi/ /H/.
exact /ltr_irrefl _ H/.
qed ();



lemma "decreasing_approximations_glb"
/
  forall (x : nat -> rational) (xr : regular x) .
    (forall i j . n`0 <n i -> i <n= j -> x j <q= x i)
    -> forall i . n`0 <n i -> rintro x xr <= rational_to_real (x i)
/;

inference.
intro /x xr Hdec i Hposi/.
so /increasing_approximations_lub (fn i . ~q (x i)) (negr_regular _ xr) __ i Hposi/ /H/.
  {
  clear /i Hposi/.
  intro /i j Hposi Hposj/.
  reduce //.
  apply /negq_leqq/.
  apply /Hdec/ >> auto.
  }
reduce /H/.
rewrite /-> negq_to_real in H/.
so /negr_leqr _ _ H/ /H'/.
rewrite /-> negr_invol in H'/.
forceExact /H'/.
compat.
apply /real_equality/.
split.
unfold /negr, rintro at 0 0/.
rewrite /-> negq_invol within _/.
rewrite /(fn i . x i) = x : (nat -> rational)/.
  {
  introEq /j/ >> auto.
  }
apply /realequiv_refl/.
qed ();



lemma "cantors_theorem"
/
  forall x y (f : nat -> prereal) .
    realintro x < realintro y
    -> exists z .
         realintro x <= realintro z
         & realintro z <= realintro y
         & (forall i . realintro z != realintro (f i) : real)
/;

inference.
intro /x0 y0 f Hxy0/.
assert /exists (x y : nat -> rational)  .
          (forall i j . n`0 <n i -> i <n= j -> x i <q= x j & y j <q= y i)
          & (forall i . n`0 <n i ->
               realintro x0 <= rational_to_real (x i)
               & rational_to_real (y i) <= realintro y0
               & x i <q y i
               & y i -q x i <q invq (nat_to_rational i))
          & (forall i . n`1 <n i ->
               realintro (f (i -n n`2)) < rational_to_real (x i) % rational_to_real (y i) < realintro (f (i -n n`2)))/ /Hprop/
>>> [inference, idtac].
1:{
  destruct /Hprop/ /x y Hinc Hall Havoid/.
  assert /regular x/ /Hx/.
    {
    unfold /regular/.
    assert /forall m n . n`0 <n m -> m <n= n -> absq (x m -q x n) <q= invq (nat_to_rational m) +q invq (nat_to_rational n)/ /Hprop/ >>> [inference, idtac].
    1:{
      intro /m n Hposm Hposn/.
      so /nat_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
      rewrite /-> absq_minusq_commute/.
      rewrite /-> plusq_commute/.
      apply /Hprop/ >> auto.
      }
    intro /m n Hposm Hmn/.
    so /Hall m Hposm/ /_ _ _ Hm/.
    so /Hall n __/ /_ _ Hn _/.
      {
      omega.
      }
    so /Hinc m n Hposm Hmn/ /Hxmn Hynm/.
    apply /leqq_trans _ (invq (nat_to_rational m))/.
    1:{
      rewrite /<- plusq_id_r (invq _)/.
      apply /plusq_leqq/ >> auto.
      autoQ.
      }
    rewrite /-> absq_minusq_commute/.
    rewrite /-> absq_of_nonneg/.
      {
      rewrite /<- minusq_shift_leqq_rr/.
      rewrite /-> plusq_id_l/.
      auto.
      }
    rewrite /<- ltq_impl_leqq _ _ Hm/.
    apply /minusq_leqq/ >> auto.
    apply /leqq_trans _ (y n)/ >> auto.
    apply /ltq_impl_leqq/ >> auto.
    }
  assert /regular y/ /Hy/.
    {
    unfold /regular/.
    assert /forall m n . n`0 <n m -> m <n= n -> absq (y m -q y n) <q= invq (nat_to_rational m) +q invq (nat_to_rational n)/ /Hprop/ >>> [inference, idtac].
    1:{
      intro /m n Hposm Hposn/.
      so /nat_dichotomy_weak m n/ /Hmn | Hnm/ >> auto.
      rewrite /-> absq_minusq_commute/.
      rewrite /-> plusq_commute/.
      apply /Hprop/ >> auto.
      }
    intro /m n Hposm Hmn/.
    so /Hall m Hposm/ /_ _ _ Hm/.
    so /Hall n __/ /_ _ Hn _/.
      {
      omega.
      }
    so /Hinc m n Hposm Hmn/ /Hxmn Hynm/.
    apply /leqq_trans _ (invq (nat_to_rational m))/.
    1:{
      rewrite /<- plusq_id_r (invq _)/.
      apply /plusq_leqq/ >> auto.
      autoQ.
      }
    rewrite /-> absq_of_nonneg/.
      {
      rewrite /<- minusq_shift_leqq_rr/.
      rewrite /-> plusq_id_l/.
      auto.
      }
    rewrite /<- ltq_impl_leqq _ _ Hm/.
    apply /minusq_leqq/ >> auto.
    apply /leqq_trans _ (x n)/ >> auto.
    apply /ltq_impl_leqq/ >> auto.
    }
  assert /realequiv x y/ /Heq/.
    {
    apply /realequiv_symm/.
    unfold /realequiv/.
    intro /n Hposn/.
    apply /leqq_trans _ (invq (nat_to_rational n))/.
      {
      apply /ltq_impl_leqq/.
      rewrite /-> absq_of_nonneg/.
        {
        rewrite /<- minusq_shift_leqq_rr/.
        rewrite /-> plusq_id_l/.
        apply /ltq_impl_leqq/.
        apply /Hall/ >> auto.
        }
      apply /Hall/ >> auto.
      }
    rewrite /<- timesq_id_l (invq _)/.
    apply /timesq_leqq_r/ >> autoQ.
    }
  existsRaw /x/ >> auto.
    {
    unfold /prereal/ >> auto.
    }
  unfold /realintro at 4 2 1/.
  fold /rintro x Hx at 0 1 2/.
  splitn 2.
    {
    apply /leqr_by_approximations_r/.
    intro /n Hposn/.
    apply /Hall/ >> auto.
    }

    {
    rewrite /rintro x Hx = rintro y Hy : real/.
      {
      apply /real_equality/.
      unfold /rintro at 0 0/.
      auto.
      }
    apply /leqr_by_approximations_l/.
    intro /n Hposn/.
    apply /Hall/ >> auto.
    }

    {
    intro /i/.
    so /Havoid (n`2 +n i) __/ /H | H/.
      {
      omega.
      }

      {
      reduce /H/.
      symmetry.
      apply /ltr_impl_neq/.
      witness /ltr_leqr_trans _# 3 H __/.
      clear /H/.
      apply /increasing_approximations_lub x Hx/ >> autoWith /lt_0_succ/.
      }

      {
      rewrite /rintro x Hx = rintro y Hy : real/.
        {
        apply /real_equality/.
        unfold /rintro at 0 0/.
        auto.
        }
      apply /ltr_impl_neq/.
      witness /leqr_ltr_trans _# 3 __ H/.
      clear /H/.
      apply /decreasing_approximations_glb y Hy/ >> autoWith /lt_0_succ/.
      }
    }
  }
exploit /infinite_sequence lzero (rational & rational)
           (fn p k .
              (forall (i j : nat) . n`0 <n i -> i <n= j -> j <n k -> p i #1 <q= p j #1 & p j #2 <q= p i #2)
              &
              (forall (i : nat) .
                 n`0 <n i
                 -> i <n k
                 -> realintro x0 <= rational_to_real (p i #1)
                    & rational_to_real (p i #2) <= realintro y0
                    & p i #1 <q p i #2
                    & p i #2 -q p i #1 <q invq (nat_to_rational i))
              &
              (forall (i : nat) .
                 n`1 <n i
                 -> i <n k
                 -> realintro (f (i -n n`2)) < rational_to_real (p i #1)
                    % rational_to_real (p i #2) < realintro (f (i -n n`2))))/ /H/.
  {
  exact /(q`0, q`0)/.
  }

  {
  reduce //.
  intro /g h k Heq Hg/.
  splitn 2.
    {
    destruct /Hg/ /Hg _/.
    intro /i j Hi Hij Hjk/.
    so /Hg i j Hi Hij Hjk/ /H/.
    forceExact /H/.
    clear /H/.
    typecheck.
      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }

      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }

      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }

      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }
    }

    {
    destruct /Hg/ /_ Hg _/.
    intro /i Hi Hik/.
    assert /g i #1 = h i #1 : rational/ /Heq1/.
      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }
    assert /g i #2 = h i #2 : rational/ /Heq2/.
      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }
    so /Hg i Hi Hik/ /H/.
    forceExact /H/.
    clear /H/.
    typecheck >> auto.
    }

    {
    destruct /Hg/ /_ _ Hg/.
    intro /i Hi Hik/.
    assert /g i #1 = h i #1 : rational/ /Heq1/.
      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }
    assert /g i #2 = h i #2 : rational/ /Heq2/.
      {
      decompEq 1 /rational & rational/.
      apply /Heq/.
      omega.
      }
    so /Hg i Hi Hik/ /H/.
    forceExact /H/.
    clear /H/.
    typecheck >> auto.
    }
  }

  (* fake base case *)
  {
  intro /g/.
  reduce //.
  splitn 2 >> intros >> omega.
  }

  (* wrapup *)
1:{
  destruct /H/ /g Hg/.
  reduce /Hg/.
  exists /(fn i . g i #1)/.
  exists /(fn i . g i #2)/.
  splitn 2.
    {
    reduce //.
    intro /i j Hi Hij/.
    apply /Hg (succ j) #1/ >> auto.
    omega.
    }

    {
    reduce //.
    intro /i Hi/.
    apply /Hg (succ i) #2 #1/ >> auto.
    omega.
    }

    {
    intro /i Hi/.
    apply /Hg (succ i) #2 #2/ >> auto.
    omega.
    }
  }
(* inductive case *)
reduce //.
intro /k h (Hinc Hall Havoid)/.
so /eq_nat_decide k n`0/ /? | Hnot0/.
  {
  exists /(q`0, q`0)/.
  splitn 2 >> intros >> omega.
  }
so /eq_nat_decide k n`1/ /? | Hnot1/.
  (* real base case *)
  {
  subst /k/.
  clear /Hnot0/.
  so /rational_dense_within_real_prereal x0 y0 Hxy0/ /a Hxa Hay/.
  so /rational_dense_within_real_prereal (rational_to_prereal a) y0 __/ /b Hab Hby/.
    {
    rewrite /-> rational_to_prereal_to_real/.
    auto.
    }
  setEq /c/ /minq (a +q invq q`2) b/ /_/ /Heqc/.
  exists /(a, c)/.
  assert /(a, c) : rational & rational/ /Hofac/.
    {
    typecheck.
    }
  splitn 2.
    {
    intro /i j Hi Hij Hjk/.
    assertThen /i = n`1 : nat/ /?/ omega.
    assertThen /j = n`1 : nat/ /?/ omega.
    subst /i j/.
    auto.
    }

    {
    intro /i Hi Hik/.
    assertThen /i = n`1 : nat/ /?/ omega.
    subst /i/.
    reduce //.
    splitn 3.
      {
      apply /ltr_impl_leqr/ >> auto.
      }

      {
      apply /leqr_trans _ (rational_to_real b)/.
      1:{
        apply /ltr_impl_leqr/ >> auto.
        }
      subst /c/.
      rewrite /-> minq_to_real/.
      apply /minr_leq_r/.
      }

      {
      subst /c/.
      rewrite /-> rational_to_prereal_to_real in Hab/.
      apply /minq_glb_strict/.
        {
        rewrite /<- plusq_id_r a/.
        apply /plusq_ltq_r/ >> auto.
        autoQ.
        }

        {
        apply /rational_to_real_mono_lt_conv/ >> auto.
        }
      }

      {
      unfold /nat_to_rational/.
      reduce //.
      apply /leqq_ltq_trans _ (invq q`2)/.
        {
        rewrite /<- minusq_shift_leqq_ll/.
        subst /c/.
        apply /minq_leq_l/.
        }

        {
        apply /invq_ltq_pos/ >> autoQ.
        }
      }
    }

    {
    intro /i Hi Hik/.
    exfalso.
    omega.
    }
  }
(* real inductive case *)
assert /forall x y a .
          x <q y
          -> realintro a < rational_to_real y
          -> exists x' .
               x <q= x'
               & x' <q y
               & realintro a < rational_to_real x'
               & y -q x' <q invq (nat_to_rational k)/ /Hprop/.
  {
  inference.
  intro /x y a Hxy Hay/.
  so /rational_dense_within_real_prereal a (rational_to_prereal y) __/ /u Hau Huy/.
    {
    rewrite /-> rational_to_prereal_to_real/.
    hyp /Hay/.
    }
  rewrite /-> rational_to_prereal_to_real in Huy/.
  exists /maxq x (maxq u (y -q invq (nat_to_rational (succ k))))/.
  splitn 3.
    {
    apply /maxq_leq_l/.
    }

    {
    apply /maxq_lub_strict/ >> auto.
    apply /maxq_lub_strict/.
      {
      apply /rational_to_real_mono_lt_conv/ >> auto.
      }

      {
      rewrite /<- minusq_id_r y at 1/.
      unfold /minusq at 0 0/.
      apply /plusq_ltq_r/ >> auto.
      apply /negq_ltq/.
      autoQ.
      }
    }

    {
    apply /ltr_leqr_trans _ (rational_to_real u)/ >> auto.
    apply /rational_to_real_mono/.
    apply /leqq_trans/.
    1:{
      apply /maxq_leq_r/.
      }

      {
      apply /maxq_leq_l/.
      }
      
      typechecker ();
    }

    {
    apply /leqq_ltq_trans _ (invq (nat_to_rational (succ k)))/.
    1:{
      apply /invq_ltq_pos/ >> autoQ.
      }
    apply /negq_leqq'/.
    rewrite /-> negq_minusq/.
    unfold /minusq at all/.
    rewrite /-> plusq_dist_maxq_l/.
    rewrite /-> plusq_dist_maxq_l/.
    apply /leqq_trans/.
    1:{
      apply /maxq_leq_r/.
      }

      typechecker ();
    apply /leqq_trans/.
    1:{
      apply /maxq_leq_r/.
      }

      typechecker ();
    apply /negq_leqq'/.
    rewrite /-> negq_plusq at all/.
    rewrite /-> negq_invol at all/.
    rewrite /-> plusq_commute at 1/.
    rewrite /-> plusq_assoc/.
    rewrite /-> plusq_inverse_l/.
    rewrite /-> plusq_id_r/.
    apply /leqq_refl/.
    }
  }
so /Hall (pred k) __ __/ /_ _ Hxy _/ >> attempt omega.
so /overlapping_ranges_prereal (f (k -n n`2)) (rational_to_prereal (h (pred k) #1)) (rational_to_prereal (h (pred k) #2)) __/ /Hleft | Hright/.
  {
  rewrite /-> rational_to_prereal_to_real at 0 0/.
  apply /rational_to_real_mono_lt/.
  apply /Hall/ >> omega.
  }

  {
  rewrite /-> rational_to_prereal_to_real in Hleft/.
  so /Hprop (h (pred k) #1) (h (pred k) #2) (f (k -n n`2)) Hxy Hleft/ /z Hxz Hzy Hmiss Hdist/.
  assertThen /(z, h (pred k) #2) : rational & rational/ /Hof/ typecheck.
  exists /(z, h (pred k) #2)/.
  splitn 2.
    {
    intro /i j Hi Hij Hjk/.
    boolCase /i =n? k/ /Hik/.
      {
      subst /i/.
      assertThen /j = k : nat/ /?/ omega.
      subst /j/.
      boolEq true /k =n? k/ >> auto.
      }
    boolCase /j =n? k/ /Hjk'/.
      {
      subst /j/.
      split.
        {
        apply /leqq_trans _ (h (pred k) #1)/ >> auto.
        apply /Hinc/ >> omega.
        }

        {
        apply /Hinc/ >> omega.
        }
      }
    apply /Hinc/ >> omega.
    }

    {
    intro /i Hi Hik/.
    boolCase /i =n? k/ /Hik'/.
      {
      subst /i/.
      splitn 3 >> auto.
        {
        apply /leqr_trans _ (rational_to_real (h (pred k) #1))/.
          {
          apply /Hall/ >> omega.
          }
        apply /rational_to_real_mono/ >> auto.
        }

        {
        apply /Hall/ >> omega.
        }
      }
    apply /Hall/ >> omega.
    }

    {
    intro /i Hi Hik/.
    boolCase /i =n? k/ /Hik'/.
      {
      subst /i/.
      left.
      hyp /Hmiss/.
      }
    apply /Havoid/ >> omega.
    }
  }

  {
  rewrite /-> rational_to_prereal_to_real in Hright/.
  so /Hprop (negq (h (pred k) #2)) (negq (h (pred k) #1)) (prenegr (f (k -n n`2))) __ __/ /z Hyz Hzx Hmiss Hdist/.
    {
    apply /negq_ltq/ >> auto.
    }

    {
    rewrite /-> prenegr_to_real/.
    rewrite /-> negq_to_real/.
    apply /negr_ltr/ >> auto.
    }
  assertThen /(h (pred k) #1, negq z) : rational & rational/ /Hof/ typecheck.
  exists /(h (pred k) #1, negq z)/.
  splitn 2.
    {
    intro /i j Hi Hij Hjk/.
    boolCase /i =n? k/ /Hik/.
      {
      subst /i/.
      assertThen /j = k : nat/ /?/ omega.
      subst /j/.
      boolEq true /k =n? k/ >> auto.
      }
    boolCase /j =n? k/ /Hjk'/.
      {
      subst /j/.
      split.
        {
        apply /Hinc/ >> omega.
        }

        {
        apply /leqq_trans _ (h (pred k) #2)/.
          {
          apply /negq_leqq'/.
          rewrite /-> negq_invol/.
          auto.
          }

          {
          apply /Hinc/ >> omega.
          }
        }
      }
    apply /Hinc/ >> omega.
    }

    {
    intro /i Hi Hik/.
    boolCase /i =n? k/ /Hik'/.
      {
      subst /i/.
      splitn 3.
        {
        apply /Hall/ >> omega.
        }

        {
        apply /leqr_trans _ (rational_to_real (h (pred k) #2))/.
          {
          apply /rational_to_real_mono/ >> auto.
          apply /negq_leqq'/.
          rewrite /-> negq_invol/.
          auto.
          }

          {
          apply /Hall/ >> omega.
          }
        }

        {
        apply /negq_ltq'/.
        rewrite /-> negq_invol/.
        auto.
        }

        {
        unfold /minusq/.
        rewrite /-> plusq_commute/.
        fold /minusq _ _/.
        auto.
        }
      }
    apply /Hall/ >> omega.
    }

    {
    intro /i Hi Hik/.
    boolCase /i =n? k/ /Hik'/.
      {
      subst /i/.
      right.
      rewrite /-> prenegr_to_real in Hmiss/.
      rewrite /-> negq_to_real/.
      apply /negr_ltr'/.
      rewrite /-> negr_invol/.
      auto.
      }
    apply /Havoid/ >> omega.
    }
  }
qed ();



endModule ();
