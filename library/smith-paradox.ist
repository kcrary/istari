
openModule /Nat/;
openModule /Partial/;
openModule /SyntacticEquality/;

beginModule "SmithParadox";


lemma "inadmissible_type"
/
  exists (a : U 0) . not (admiss a)
/;

set /T/ /{ h : nat -> partial unit | not (forall x . halts (h x)) }/.
set /f/ /fn g x . if x =? 0 then () else g (x - 1)/.
assert /T : U 0/ /HofT/.
  {
  unfold /T/.
  typecheck.
  }
assert /f : partial T -> nat -> partial unit/ /Hoffpre/.
  {
  unfold /f , T/.
  introOf /g x/.
  reduce //.
  fold /g :> (partial (nat -> partial unit))/.
  typecheck.
  }
assert /forall (g : partial T) . not (forall (x : nat) . halts (f g x))/ /Hpartial/.
  {
  intro /g Htotal/.
  unfold /T in g/.
  assert /halts g/ /Hhalts/.
    {
    so /Htotal 1/ /H/.
    unfold /f in H/.
    reduce /H/.
    termination /H/.
    auto.
    }
  tighten /g/ /{h : _ | _}/.
    {
    partiality /g/ >> auto.
    }
  destruct /g/ /[g Hpartial]/.
  unhide.
  witness /Hpartial __/.
  intro /x/.
  so /Htotal (succ x)/ /H/.
  unfold /f in H/.
  reduce /H/.
  hyp /H/.
  }
assert /f : partial T -> partial T/ /Hoff/.
  {
  unfold /T at 1/.
  introOf /g/.
  partiality /concl/.
  typecheck.
  split.
  apply /Hpartial/.
  }
exists /T/.
intro /Hadmiss/.
assert /fix f : partial T/ /Hfix/.
  {
  typecheckFixpoint.
  typecheck.
  }
assert /halts (fix f)/ /Hhaltsfix/.
  {
  unfold /f/.
  unroll /fix/.
  reduce //.
  termination /concl/.
  }
assert /fix f : T/ /Hfix'/.
  {
  partiality /concl/ >> auto.
  }
unfold /T in Hfix'/.
destructSet /Hfix'/ /Hpartialfix/.
unhide.
witness /Hpartialfix __/.
intro /x/.
sinduction /x/.
reintro /IH/.
unroll /fix/.
unfold /f/.
destruct /x/ /| x/.
  {
  reduce //.
  termination /concl/.
  }

  {
  reduce //.
  apply /IH/.
  omega.
  }
qed ();


endModule ();
